# R147 Task 4, shape 12: a slice of a kosh passed through two prakriyas in sequence, the inner one growing the kosh.
# An escape prints 7 (the old elements) where k[0] is 99. v307 compiled shapes 1-3, 5-7, 9 and 13 and printed 7.
prakriya inner(vibhag s, kosh k) {
    kosh_kship(k, 8)
    k[0] = 99
    nivartanam s[0]
}
prakriya outer(vibhag s, kosh k) {
    nivartanam inner(s, k)
}
mukhya() {
    kosh k[1]
    kosh_kship(k, 7)
    vitti obstacle = nirmmita(16)
    likha(outer(k[0:1], k))
    likha(k[0])
}
