# R147 Task 4, shape 10: a slice of a kosh a module-level initializer binds a kosh (vitti g = make_kosh()).
# An escape prints 7 (the old elements) where k[0] is 99. v307 compiled shapes 1-3, 5-7, 9 and 13 and printed 7.
vitti g = make_kosh()
prakriya make_kosh() {
    kosh k[1]
    kosh_kship(k, 7)
    nivartanam k
}
mukhya() {
    likha(g)
}
