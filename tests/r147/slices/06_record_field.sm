# R147 Task 4, shape 06: a slice of a kosh stored in a rachana field.
# An escape prints 7 (the old elements) where k[0] is 99. v307 compiled shapes 1-3, 5-7, 9 and 13 and printed 7.
rachana Box = { s }
mukhya() {
    kosh k[1]
    kosh_kship(k, 7)
    vitti obstacle = nirmmita(16)
    vitti b = nirmmita(8)
    b.s = k[0:1]
    vitti s = b.s
    kosh_kship(k, 8)
    k[0] = 99
    vitti addr = s[0]
    likha(addr[0])
    likha(k[0])
}
