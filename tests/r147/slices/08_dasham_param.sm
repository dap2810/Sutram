# R147 Task 4, shape 08: a slice of a kosh passed through a dasham parameter of a prakriya that grows the kosh.
# An escape prints 7 (the old elements) where k[0] is 99. v307 compiled shapes 1-3, 5-7, 9 and 13 and printed 7.
prakriya use_dasham(dasham d, kosh k) {
    kosh_kship(k, 8)
    k[0] = 99
    vitti addr = d[0]
    nivartanam addr[0]
}
mukhya() {
    kosh k[1]
    kosh_kship(k, 7)
    vitti obstacle = nirmmita(16)
    likha(use_dasham(k[0:1], k))
    likha(k[0])
}
