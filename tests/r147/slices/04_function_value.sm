# R147 Task 4, shape 04: a slice of a kosh passed to a prakriya called through a variable, which grows the kosh.
# An escape prints 7 (the old elements) where k[0] is 99. v307 compiled shapes 1-3, 5-7, 9 and 13 and printed 7.
prakriya grow(x, kosh k) {
    kosh_kship(k, 8)
    k[0] = 99
    vitti addr = x[0]
    nivartanam addr[0]
}
mukhya() {
    kosh k[1]
    kosh_kship(k, 7)
    vitti obstacle = nirmmita(16)
    vitti f = grow
    likha(f(k[0:1], k))
    likha(k[0])
}
