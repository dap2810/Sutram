# R147 Task 4, shape 14: a slice of a kosh given to yantra (inline machine code), which takes only a string of bytes.
# An escape prints 7 (the old elements) where k[0] is 99. v307 compiled shapes 1-3, 5-7, 9 and 13 and printed 7.
mukhya() {
    kosh k[1]
    kosh_kship(k, 7)
    vitti obstacle = nirmmita(16)
    vitti s = k[0:1]
    yantra(s)
    likha(s[0])
}
