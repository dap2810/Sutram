# R147 Task 4, shape 01: a slice of a kosh stored in a fixed-size array cell, then the kosh grows.
# An escape prints 7 (the old elements) where k[0] is 99. v307 compiled shapes 1-3, 5-7, 9 and 13 and printed 7.
mukhya() {
    kosh k[1]
    kosh_kship(k, 7)
    vitti obstacle = nirmmita(16)
    mala box[2]
    box[0] = k[0:1]
    vitti s = box[0]
    kosh_kship(k, 8)
    k[0] = 99
    vitti addr = s[0]
    likha(addr[0])
    likha(k[0])
}
