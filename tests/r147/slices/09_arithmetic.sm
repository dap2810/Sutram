# R147 Task 4, shape 09: a slice of a kosh used in arithmetic (k[0:1] + zero) and kept.
# An escape prints 7 (the old elements) where k[0] is 99. v307 compiled shapes 1-3, 5-7, 9 and 13 and printed 7.
prakriya keep(x) {
    nivartanam x
}
mukhya() {
    kosh k[1]
    kosh_kship(k, 7)
    vitti obstacle = nirmmita(16)
    vitti zero = 0
    vitti s = keep(k[0:1] + zero)
    kosh_kship(k, 8)
    k[0] = 99
    vitti addr = s[0]
    likha(addr[0])
    likha(k[0])
}
