# R74 (ChatGPT R146 F2): a chain of three names needs three trips round the loop - refused.
mukhya()
    vitti outside = 0
    mandapa
        vitti b = nirmmita(8)
        vitti p = 0
        vitti q = 0
        vitti r = 0
        vitti i = 0
        yavat (i < 4)
            outside = p
            p = q
            q = r
            r = b
            i = i + 1
