# R74 (ChatGPT R146 F4): negative sizes inside a block are 0, as outside one; the outer block is untouched.
mukhya()
    mandapa
        vitti owner = nirmmita(16)
        owner[0] = 123
        owner[1] = 456
        mandapa
            vitti a = nirmmita(0 - 1)
            vitti b = nirmmita(0 - 8)
            vitti c = nirmmita(0 - 16)
            vitti d = nirmmita(0 - 9223372036854775807)
            vitti e = nirmmita(0)
            likha(a, " ", b, " ", c, "\n")
            likha(d, " ", e, "\n")
        likha(owner[0], " ", owner[1], "\n")
