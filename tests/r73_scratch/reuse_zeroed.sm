# R73: scratch memory is reused after a rewind, and arrives zeroed like any
# nirmmita block; nirmmita(0) is 0 inside a block too.
# R77: this test used nirmmita(13) and wrote b[1] - 16 bytes into 13, the byte-versus-qword trap;
# v274's check refused it. Two cells are 2 * 8 bytes.
mukhya()
    vitti s = 0
    mandapa
        vitti b = nirmmita(2 * 8)
        b[0] = 5
        b[1] = 6
        s = b[0] + b[1]
    mandapa
        vitti c = nirmmita(2 * 8)
        s = s + c[0] + c[1]
        likha(nirmmita(0), "\n")
    likha(s, "\n")
