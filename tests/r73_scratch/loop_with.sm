# R73: 1,000,000 allocations of 64 bytes, each in a mandapa inside the loop.
# The block rewinds every pass: peak memory stays flat.
mukhya()
    vitti i = 0
    vitti s = 0
    yavat (i < 1000000)
        mandapa
            vitti b = nirmmita(64)
            b[0] = i
            s = s + b[0]
        i = i + 1
    likha(s, "\n")
