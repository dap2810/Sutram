# R74 (ChatGPT R146 F2): the store is written before the assignment that taints its value; the loop carries it round - refused.
mukhya()
    vitti m = nirmmita(8)
    mandapa
        vitti b = nirmmita(8)
        vitti q = 0
        vitti i = 0
        yavat (i < 2)
            m[0] = q
            q = b
            i = i + 1
