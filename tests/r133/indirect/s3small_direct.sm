# R133: Control: the direct call - refused since v304 (E_KOSH_VIBHAG).
prakriya badal(vibhag s, ignored) {
    s[0] = 99
    nivartanam 0
}
mukhya() {
    kosh k[1]
    kosh_kship(k, 7)
    vitti obstacle = nirmmita(16)
    vitti f = badal
    likha(badal(k[0:1], kosh_kship(k, 8)))
    likha(k[0])
}
