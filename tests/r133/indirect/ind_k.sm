# R133: Control: a whole kosh to a function value - refused (E_KOSH_DVARA).
prakriya gr(vibhag s, kosh b) {
    kosh_kship(b, 8)
    s[0] = 99
    nivartanam 0
}
mukhya() {
    kosh k[1]
    kosh_kship(k, 7)
    vitti obstacle = nirmmita(16)
    vitti f = gr
    likha(f(k[0:1], k))
    likha(k[0])
}
