yoj khand
yoj varna
mukhya() {
    likha(khand_anwesh_akshar("hello world", 5, 119))
    likha("\n")
    likha(anwesh_akshar("hello world", 119))
    likha("\n")
    likha(khand_gan_swar("hello world", 5))
    likha("\n")
    likha(gan_swar("hello world"))
    likha("\n")
    likha(khand_asti_sarv_ank("123abc", 3))
    likha("\n")
    likha(asti_sarv_ank("123abc"))
    likha("\n")
    vitti out = nirmmita(64)
    vitti slice = nirmmita(16)
    vitti base = "hello world"
    khand_pratilip(base + 6, 5, slice)
    likha(khand_pratisthap("aaa bbb aaa", 11, "aaa", 3, slice, out))
    likha("\n")
    likha(khand_sam(out, 15, "world bbb world", 15))
    likha("\n")
    likha("slices23-done\n")
}
