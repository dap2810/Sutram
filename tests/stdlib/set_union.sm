yoj sangrah
yoj khand
mukhya() {
    vitti a = rakh_srij(16)
    rakh_yuj(a, 16, "pear", 4)
    rakh_yuj(a, 16, "apple", 5)
    vitti b = rakh_srij(16)
    rakh_yuj(b, 16, "apple", 5)
    rakh_yuj(b, 16, "fig", 3)
    vitti u = rakh_srij(32)
    likha(rakh_sangam(a, 16, b, 16, u))
    likha("\n")
    # sorted dump: apple, fig, pear
    vitti arr = nirmmita(64 * 8)
    vitti buf = nirmmita(64)
    vitti n = rakh_tak_mala(u, 32, arr)
    vitti pos = 0
    vitti i = 0
    vitti sl = 0
    yavat (i < n) {
        sl = arr[pos]
        khand_bandh(arr + (pos + 1) * 8, sl, buf)
        likha(1, buf, sl)
        likha("\n")
        pos = pos + 1 + sl
        i = i + 1
    }
    # union with an empty sangrah: just a's elements
    vitti e = rakh_srij(16)
    vitti u2 = rakh_srij(32)
    likha(rakh_sangam(a, 16, e, 16, u2))
    likha("\n")
}
