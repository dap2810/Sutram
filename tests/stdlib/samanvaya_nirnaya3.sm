ayojan samanvaya
mukhya() {
    kosh dasham ident[9]
    kosh_push(ident, 1.0)
    kosh_push(ident, 0.0)
    kosh_push(ident, 0.0)
    kosh_push(ident, 0.0)
    kosh_push(ident, 1.0)
    kosh_push(ident, 0.0)
    kosh_push(ident, 0.0)
    kosh_push(ident, 0.0)
    kosh_push(ident, 1.0)
    likha(nirnaya3(ident))
    likha("\n")
    kosh dasham sing[9]
    kosh_push(sing, 1.0)
    kosh_push(sing, 2.0)
    kosh_push(sing, 3.0)
    kosh_push(sing, 4.0)
    kosh_push(sing, 5.0)
    kosh_push(sing, 6.0)
    kosh_push(sing, 7.0)
    kosh_push(sing, 8.0)
    kosh_push(sing, 9.0)
    likha(nirnaya3(sing))
    likha("\n")
}
