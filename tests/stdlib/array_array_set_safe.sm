yoj mala
mukhya() {
    vitti a = mala_nava(3)
    likha(mala_sangrah_surakshit(a, 0, 42, 3))
    likha("\n")
    likha(mala_sangrah_surakshit(a, 2, 43, 3))
    likha("\n")
    likha(mala_sangrah_surakshit(a, 3, 44, 3))
    likha("\n")
    likha(mala_sangrah_surakshit(a, 0 - 1, 44, 3))
    likha("\n")
    likha(mala_grah(a, 0))
    likha("\n")
    likha(mala_grah(a, 2))
    likha("\n")
}
