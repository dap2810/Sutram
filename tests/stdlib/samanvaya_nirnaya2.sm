ayojan samanvaya
mukhya() {
    kosh dasham a[4]
    kosh_push(a, 1.0)
    kosh_push(a, 2.0)
    kosh_push(a, 3.0)
    kosh_push(a, 4.0)
    likha(nirnaya2(a))
    likha("\n")
    kosh dasham ident[4]
    kosh_push(ident, 1.0)
    kosh_push(ident, 0.0)
    kosh_push(ident, 0.0)
    kosh_push(ident, 1.0)
    likha(nirnaya2(ident))
    likha("\n")
}
