yoj sangrah
mukhya() {
    vitti a = rakh_srij(16)
    likha(rakh_yuj(a, 16, "pear", 4))
    likha("\n")
    likha(rakh_yuj(a, 16, "apple", 5))
    likha("\n")
    # duplicate add: succeeds, size unchanged
    likha(rakh_yuj(a, 16, "apple", 5))
    likha("\n")
    likha(rakh_maap(a))
    likha("\n")
    likha(rakh_antah(a, 16, "apple", 5))
    likha("\n")
    likha(rakh_antah(a, 16, "fig", 3))
    likha("\n")
    likha(rakh_apanay(a, 16, "pear", 4))
    likha("\n")
    # remove absent: 0, size unchanged
    likha(rakh_apanay(a, 16, "pear", 4))
    likha("\n")
    likha(rakh_maap(a))
    likha("\n")
    # full sangrah: third add fails, size stays 2
    vitti f = rakh_srij(2)
    likha(rakh_yuj(f, 2, "x", 1))
    likha("\n")
    likha(rakh_yuj(f, 2, "y", 1))
    likha("\n")
    likha(rakh_yuj(f, 2, "z", 1))
    likha("\n")
    likha(rakh_maap(f))
    likha("\n")
}
