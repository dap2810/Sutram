ayojan set
mukhya() {
    vitti a = set_init(16)
    likha(set_add(a, 16, "pear", 4))
    likha("\n")
    likha(set_add(a, 16, "apple", 5))
    likha("\n")
    # duplicate add: succeeds, size unchanged
    likha(set_add(a, 16, "apple", 5))
    likha("\n")
    likha(set_size(a))
    likha("\n")
    likha(set_contains(a, 16, "apple", 5))
    likha("\n")
    likha(set_contains(a, 16, "fig", 3))
    likha("\n")
    likha(set_remove(a, 16, "pear", 4))
    likha("\n")
    # remove absent: 0, size unchanged
    likha(set_remove(a, 16, "pear", 4))
    likha("\n")
    likha(set_size(a))
    likha("\n")
    # full set: third add fails, size stays 2
    vitti f = set_init(2)
    likha(set_add(f, 2, "x", 1))
    likha("\n")
    likha(set_add(f, 2, "y", 1))
    likha("\n")
    likha(set_add(f, 2, "z", 1))
    likha("\n")
    likha(set_size(f))
    likha("\n")
}
