ayojan set
ayojan list
mukhya() {
    vitti ok = nirmmita(8)
    # set_clear
    vitti s = set_init(8)
    set_add(s, 8, "x", 1)
    set_add(s, 8, "y", 1)
    likha(set_size(s))
    likha("\n")
    set_clear(s)
    likha(set_size(s))
    likha("\n")
    likha(set_contains(s, 8, "x", 1))
    likha("\n")
    set_add(s, 8, "z", 1)
    likha(set_size(s))
    likha("\n")
    # list_clear zeroes the data cells (read through l[2])
    vitti l = list_init(4)
    list_push(l, 7)
    list_push(l, 8)
    list_push(l, 9)
    list_clear(l)
    likha(list_len(l))
    likha("\n")
    vitti ld = l[2]
    likha(ld[0])
    likha("\n")
    likha(ld[1])
    likha("\n")
    list_push(l, 5)
    likha(list_get(l, 0))
    likha("\n")
    # queue_clear zeroes the ring data and resets head
    vitti q = queue_init(4)
    queue_enqueue(q, 11)
    queue_enqueue(q, 22)
    queue_dequeue(q, ok)
    queue_clear(q)
    likha(queue_len(q))
    likha("\n")
    likha(queue_dequeue(q, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    vitti qd = q[2]
    likha(qd[0])
    likha("\n")
    queue_enqueue(q, 33)
    likha(queue_dequeue(q, ok))
    likha("\n")
    likha("containers-done\n")
}
