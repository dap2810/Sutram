yoj sangrah
yoj suchi
mukhya() {
    vitti ok = nirmmita(8)
    # rakh_rikta
    vitti s = rakh_srij(8)
    rakh_yuj(s, 8, "x", 1)
    rakh_yuj(s, 8, "y", 1)
    likha(rakh_maap(s))
    likha("\n")
    rakh_rikta(s)
    likha(rakh_maap(s))
    likha("\n")
    likha(rakh_antah(s, 8, "x", 1))
    likha("\n")
    rakh_yuj(s, 8, "z", 1)
    likha(rakh_maap(s))
    likha("\n")
    # suchi_rikta zeroes the data cells (read through l[2])
    vitti l = suchi_srij(4)
    suchi_khip(l, 7)
    suchi_khip(l, 8)
    suchi_khip(l, 9)
    suchi_rikta(l)
    likha(suchi_maap(l))
    likha("\n")
    vitti ld = l[2]
    likha(ld[0])
    likha("\n")
    likha(ld[1])
    likha("\n")
    suchi_khip(l, 5)
    likha(suchi_grah(l, 0))
    likha("\n")
    # avali_rikta zeroes the ring data and resets head
    vitti q = avali_srij(4)
    avali_pravesh(q, 11)
    avali_pravesh(q, 22)
    avali_nishkas(q, ok)
    avali_rikta(q)
    likha(avali_maap(q))
    likha("\n")
    likha(avali_nishkas(q, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    vitti qd = q[2]
    likha(qd[0])
    likha("\n")
    avali_pravesh(q, 33)
    likha(avali_nishkas(q, ok))
    likha("\n")
    likha("containers-done\n")
}
