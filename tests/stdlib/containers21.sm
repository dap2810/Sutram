ayojan map
ayojan list
mukhya() {
    vitti ok = nirmmita(8)
    vitti l = list_init(4)
    list_push(l, 5)
    list_push(l, 2)
    list_push(l, 8)
    list_push(l, 1)
    list_push(l, 2)
    likha(list_sum(l))
    likha("\n")
    likha(list_count(l, 2))
    likha("\n")
    likha(list_count(l, 9))
    likha("\n")
    likha(list_min(l, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    likha(list_max(l, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    list_sort(l)
    likha(list_get(l, 0))
    likha("\n")
    likha(list_get(l, 1))
    likha("\n")
    likha(list_get(l, 2))
    likha("\n")
    likha(list_get(l, 3))
    likha("\n")
    likha(list_get(l, 4))
    likha("\n")
    vitti e = list_init(2)
    likha(list_min(e, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    likha(list_max(e, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    likha(list_sum(e))
    likha("\n")
    likha(list_count(e, 1))
    likha("\n")
    vitti q = queue_init(4)
    queue_enqueue(q, 11)
    queue_enqueue(q, 22)
    queue_dequeue(q, ok)
    likha(queue_contains(q, 22))
    likha("\n")
    likha(queue_contains(q, 11))
    likha("\n")
    likha(queue_contains(q, 99))
    likha("\n")
    vitti m = map_init(8)
    map_put(m, 8, "a", 1, 10)
    map_put(m, 8, "b", 1, 20)
    map_put(m, 8, "c", 1, 0 - 5)
    vitti vals = nirmmita(8 * 8)
    likha(map_values(m, vals))
    likha("\n")
    likha(vals[0] + vals[1] + vals[2])
    likha("\n")
    likha("containers21-done\n")
}
