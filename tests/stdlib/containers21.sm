yoj nighantu
yoj suchi
mukhya() {
    vitti ok = nirmmita(8)
    vitti l = suchi_srij(4)
    suchi_khip(l, 5)
    suchi_khip(l, 2)
    suchi_khip(l, 8)
    suchi_khip(l, 1)
    suchi_khip(l, 2)
    likha(suchi_yog(l))
    likha("\n")
    likha(suchi_gan(l, 2))
    likha("\n")
    likha(suchi_gan(l, 9))
    likha("\n")
    likha(suchi_laghu(l, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    likha(suchi_adhik(l, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    suchi_shreni(l)
    likha(suchi_grah(l, 0))
    likha("\n")
    likha(suchi_grah(l, 1))
    likha("\n")
    likha(suchi_grah(l, 2))
    likha("\n")
    likha(suchi_grah(l, 3))
    likha("\n")
    likha(suchi_grah(l, 4))
    likha("\n")
    vitti e = suchi_srij(2)
    likha(suchi_laghu(e, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    likha(suchi_adhik(e, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    likha(suchi_yog(e))
    likha("\n")
    likha(suchi_gan(e, 1))
    likha("\n")
    vitti q = avali_srij(4)
    avali_pravesh(q, 11)
    avali_pravesh(q, 22)
    avali_nishkas(q, ok)
    likha(avali_antah(q, 22))
    likha("\n")
    likha(avali_antah(q, 11))
    likha("\n")
    likha(avali_antah(q, 99))
    likha("\n")
    vitti m = nighantu_srij(8)
    nighantu_khip(m, 8, "a", 1, 10)
    nighantu_khip(m, 8, "b", 1, 20)
    nighantu_khip(m, 8, "c", 1, 0 - 5)
    vitti vals = nirmmita(8 * 8)
    likha(nighantu_mulya(m, vals))
    likha("\n")
    likha(vals[0] + vals[1] + vals[2])
    likha("\n")
    likha("containers21-done\n")
}
