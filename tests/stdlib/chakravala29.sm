ayojan ganita
mukhya() {
    vitti out = nirmmita(8 * 8)
    vitti r = chakravala(out, 4)
    likha(r)
    likha("\n")
    likha(out[0])
    likha("\n")
    likha(out[1])
    likha("\n")
    r = chakravala(out, 2)
    likha(r)
    likha("\n")
    likha(out[0])
    likha("\n")
    likha(out[1])
    likha("\n")
    r = chakravala(out, 61)
    likha(r)
    likha("\n")
    likha(out[0])
    likha("\n")
    likha(out[1])
    likha("\n")
    r = chakravala(out, 9223372036854775807)
    likha(r)
    likha("\n")
    likha("chakravala29-done\n")
}
