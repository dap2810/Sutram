yoj brihat
mukhya() {
    vitti a = nirmmita(8 * 8)
    vitti b = nirmmita(8 * 8)
    vitti r = nirmmita(8 * 8)
    brihat_ank_se_anka(12345, a, 8)
    brihat_ank_se_anka(6789, b, 8)
    likha(brihat_yuj(a, b, r, 8))
    likha("\n")
    likha(brihat_ank_tak_anka(r, 8))
    likha("\n")
    # carry across all digits: 999 + 1 = 1000
    brihat_ank_se_anka(999, a, 8)
    brihat_ank_se_anka(1, b, 8)
    likha(brihat_yuj(a, b, r, 8))
    likha("\n")
    likha(brihat_ank_tak_anka(r, 8))
    likha("\n")
    # overflow beyond 8 digits: 99999999 + 1 -> carry 1, low digits 0
    brihat_ank_se_anka(99999999, a, 8)
    brihat_ank_se_anka(1, b, 8)
    likha(brihat_yuj(a, b, r, 8))
    likha("\n")
    likha(brihat_ank_tak_anka(r, 8))
    likha("\n")
}
