yoj mala
mukhya() {
    vitti a = mala_nava(2)
    mala_sangrah(a, 0, 11)
    mala_sangrah(a, 1, 22)
    likha(mala_grah_surakshit(a, 0, 2))
    likha("\n")
    likha(mala_grah_surakshit(a, 1, 2))
    likha("\n")
    likha(mala_grah_surakshit(a, 2, 2))
    likha("\n")
    likha(mala_grah_surakshit(a, 0 - 1, 2))
    likha("\n")
}
