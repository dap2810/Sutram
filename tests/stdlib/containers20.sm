yoj nighantu
yoj sangrah
yoj suchi
mukhya() {
    vitti m = nighantu_srij(4)
    nighantu_khip(m, 4, "a", 1, 10)
    nighantu_khip(m, 4, "b", 1, 20)
    likha(nighantu_maap(m))
    likha("\n")
    m = nighantu_vardh(m, 16)
    likha(m[0])
    likha("\n")
    likha(nighantu_maap(m))
    likha("\n")
    likha(nighantu_grah(m, 16, "a", 1))
    likha("\n")
    likha(nighantu_grah(m, 16, "b", 1))
    likha("\n")
    likha(nighantu_vardh(m, 1))
    likha("\n")
    likha(nighantu_maap(m))
    likha("\n")
    vitti s = rakh_srij(4)
    rakh_yuj(s, 4, "x", 1)
    s = rakh_vardh(s, 16)
    likha(s[0])
    likha("\n")
    likha(rakh_antah(s, 16, "x", 1))
    likha("\n")
    vitti l = suchi_srij(4)
    suchi_khip(l, 1)
    suchi_khip(l, 2)
    suchi_khip(l, 3)
    likha(suchi_vinimay(l, 0, 2))
    likha("\n")
    likha(suchi_grah(l, 0))
    likha("\n")
    likha(suchi_grah(l, 2))
    likha("\n")
    likha(suchi_vinimay(l, 0, 5))
    likha("\n")
    likha(suchi_grah(l, 0))
    likha("\n")
    suchi_viparyay(l)
    likha(suchi_grah(l, 0))
    likha("\n")
    likha(suchi_grah(l, 1))
    likha("\n")
    likha(suchi_grah(l, 2))
    likha("\n")
    likha("demo2-done\n")
}
