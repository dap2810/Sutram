ayojan map
ayojan set
ayojan list
mukhya() {
    vitti m = map_init(4)
    map_put(m, 4, "a", 1, 10)
    map_put(m, 4, "b", 1, 20)
    likha(map_size(m))
    likha("\n")
    m = map_resize(m, 16)
    likha(m[0])
    likha("\n")
    likha(map_size(m))
    likha("\n")
    likha(map_get(m, 16, "a", 1))
    likha("\n")
    likha(map_get(m, 16, "b", 1))
    likha("\n")
    likha(map_resize(m, 1))
    likha("\n")
    likha(map_size(m))
    likha("\n")
    vitti s = set_init(4)
    set_add(s, 4, "x", 1)
    s = set_resize(s, 16)
    likha(s[0])
    likha("\n")
    likha(set_contains(s, 16, "x", 1))
    likha("\n")
    vitti l = list_init(4)
    list_push(l, 1)
    list_push(l, 2)
    list_push(l, 3)
    likha(list_swap(l, 0, 2))
    likha("\n")
    likha(list_get(l, 0))
    likha("\n")
    likha(list_get(l, 2))
    likha("\n")
    likha(list_swap(l, 0, 5))
    likha("\n")
    likha(list_get(l, 0))
    likha("\n")
    list_reverse(l)
    likha(list_get(l, 0))
    likha("\n")
    likha(list_get(l, 1))
    likha("\n")
    likha(list_get(l, 2))
    likha("\n")
    likha("demo2-done\n")
}
