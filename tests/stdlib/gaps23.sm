yoj nighantu
yoj sangrah
mukhya() {
    vitti a = nighantu_srij(8)
    vitti b = nighantu_srij(8)
    nighantu_khip(a, 8, "x", 1, 1)
    nighantu_khip(a, 8, "y", 1, 2)
    nighantu_khip(b, 8, "y", 1, 20)
    nighantu_khip(b, 8, "z", 1, 30)
    likha(nighantu_mil(a, 8, b, 8))
    likha("\n")
    likha(nighantu_grah(a, 8, "y", 1))
    likha("\n")
    likha(nighantu_grah(a, 8, "z", 1))
    likha("\n")
    likha(nighantu_maap(a))
    likha("\n")
    vitti s1 = rakh_srij(8)
    vitti s2 = rakh_srij(8)
    vitti s3 = rakh_srij(16)
    rakh_yuj(s1, 8, "a", 1)
    rakh_yuj(s1, 8, "b", 1)
    rakh_yuj(s1, 8, "c", 1)
    rakh_yuj(s2, 8, "b", 1)
    rakh_yuj(s2, 8, "d", 1)
    likha(rakh_samroop_diff(s1, 8, s2, 8, s3))
    likha("\n")
    likha(rakh_antah(s3, 16, "a", 1))
    likha("\n")
    likha(rakh_antah(s3, 16, "b", 1))
    likha("\n")
    likha(rakh_antah(s3, 16, "c", 1))
    likha("\n")
    likha(rakh_antah(s3, 16, "d", 1))
    likha("\n")
    likha("gaps23-done\n")
}
