ayojan map
ayojan set
mukhya() {
    vitti a = map_init(8)
    vitti b = map_init(8)
    map_put(a, 8, "x", 1, 1)
    map_put(a, 8, "y", 1, 2)
    map_put(b, 8, "y", 1, 20)
    map_put(b, 8, "z", 1, 30)
    likha(map_merge(a, 8, b, 8))
    likha("\n")
    likha(map_get(a, 8, "y", 1))
    likha("\n")
    likha(map_get(a, 8, "z", 1))
    likha("\n")
    likha(map_size(a))
    likha("\n")
    vitti s1 = set_init(8)
    vitti s2 = set_init(8)
    vitti s3 = set_init(16)
    set_add(s1, 8, "a", 1)
    set_add(s1, 8, "b", 1)
    set_add(s1, 8, "c", 1)
    set_add(s2, 8, "b", 1)
    set_add(s2, 8, "d", 1)
    likha(set_sym_diff(s1, 8, s2, 8, s3))
    likha("\n")
    likha(set_contains(s3, 16, "a", 1))
    likha("\n")
    likha(set_contains(s3, 16, "b", 1))
    likha("\n")
    likha(set_contains(s3, 16, "c", 1))
    likha("\n")
    likha(set_contains(s3, 16, "d", 1))
    likha("\n")
    likha("gaps23-done\n")
}
