yoj ganita
mukhya() {
    vitti ok = nirmmita(8)
    vitti minv = (0 - 9223372036854775807) - 1
    likha(ganita_paripurna_bhaj(7, 2))
    likha("\n")
    likha(ganita_paripurna_bhaj(0 - 7, 2))
    likha("\n")
    likha(ganita_paripurna_bhaj(minv, 0 - 1))
    likha("\n")
    likha(ganita_paripurna_bhaj(5, 0))
    likha("\n")
    likha(ganita_paripurna_shesh(7, 3))
    likha("\n")
    likha(ganita_paripurna_shesh(0 - 7, 3))
    likha("\n")
    likha(ganita_paripurna_shesh(minv, 0 - 1))
    likha("\n")
    likha(ganita_paripurna_shesh(5, 0))
    likha("\n")
    likha(ganita_janchit_nirapeksh(5, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    likha(ganita_janchit_nirapeksh(0 - 5, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    likha(ganita_janchit_nirapeksh(minv, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    likha(ganita_paripurna_nirapeksh(5))
    likha("\n")
    likha(ganita_paripurna_nirapeksh(0 - 5))
    likha("\n")
    likha(ganita_paripurna_nirapeksh(minv))
    likha("\n")
    likha("safety-done\n")
}
