ayojan ganita
mukhya() {
    vitti ok = nirmmita(8)
    vitti minv = (0 - 9223372036854775807) - 1
    likha(ganita_sat_div(7, 2))
    likha("\n")
    likha(ganita_sat_div(0 - 7, 2))
    likha("\n")
    likha(ganita_sat_div(minv, 0 - 1))
    likha("\n")
    likha(ganita_sat_div(5, 0))
    likha("\n")
    likha(ganita_sat_mod(7, 3))
    likha("\n")
    likha(ganita_sat_mod(0 - 7, 3))
    likha("\n")
    likha(ganita_sat_mod(minv, 0 - 1))
    likha("\n")
    likha(ganita_sat_mod(5, 0))
    likha("\n")
    likha(ganita_checked_abs(5, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    likha(ganita_checked_abs(0 - 5, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    likha(ganita_checked_abs(minv, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    likha(ganita_sat_abs(5))
    likha("\n")
    likha(ganita_sat_abs(0 - 5))
    likha("\n")
    likha(ganita_sat_abs(minv))
    likha("\n")
    likha("safety-done\n")
}
