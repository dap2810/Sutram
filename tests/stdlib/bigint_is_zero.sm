yoj brihat
mukhya() {
    vitti a = nirmmita(8 * 8)
    brihat_shunyank(a, 8)
    likha(brihat_asti_shunyank(a, 8))
    likha("\n")
    brihat_ank_se_int(1, a, 8)
    likha(brihat_asti_shunyank(a, 8))
    likha("\n")
    # only high digit sangrah
    brihat_shunyank(a, 8)
    likh8(a + 7 * 8, 1)
    likha(brihat_asti_shunyank(a, 8))
    likha("\n")
}
