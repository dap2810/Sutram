yoj mala
mukhya() {
    vitti a = mala_nava(4)
    mala_purn(a, 5, 4)
    likha(mala_yog(a, 4))
    likha("\n")
    mala_sangrah(a, 0, 1)
    mala_sangrah(a, 1, 2)
    mala_sangrah(a, 2, 3)
    mala_sangrah(a, 3, 4)
    likha(mala_yog(a, 4))
    likha("\n")
    likha(mala_yog(a, 0))
    likha("\n")
}
