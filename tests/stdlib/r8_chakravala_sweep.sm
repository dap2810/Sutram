# R8: chakravala(out, n) for every n from 2 to 99 that is not a square.
# Each line: n, the return flag, x, y. The expectation is the least solution
# of x^2 - n*y^2 = 1, computed independently (continued fractions), or flag 0
# where x does not fit in 64 bits.
# Until R10 this called chakravala through a wrapper, because chakravala has 29
# variables and F1 made it overwrite its caller's saved registers. Since the R10
# fix it is called directly from the loop, as a user would; on v191 this file
# crashes.
yoj ganita
mukhya() {
    vitti out = nirmmita(2 * 8)
    vitti c = nirmmita(8)
    c[0] = 2
    yavat (c[0] < 100) {
        yadi (ganita_vargmool(c[0]) * ganita_vargmool(c[0]) != c[0]) {
            out[0] = 0
            out[1] = 0
            likha(c[0])
            likha(chakravala(out, c[0]))
            likha(out[0])
            likha(out[1])
        }
        c[0] = c[0] + 1
    }
}
