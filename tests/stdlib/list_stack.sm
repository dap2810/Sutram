yoj suchi
mukhya() {
    vitti s = suchi_srij(1)
    vitti ok = nirmmita(8)
    likha(chay_rikta(s))
    likha("\n")
    likha(chay_khip(s, 1))
    likha("\n")
    likha(chay_khip(s, 2))
    likha("\n")
    likha(chay_khip(s, 3))
    likha("\n")
    # peek does not remove
    likha(chay_avalok(s, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    likha(chay_avalok(s, ok))
    likha("\n")
    # LIFO order
    likha(chay_apanay(s, ok))
    likha("\n")
    likha(chay_apanay(s, ok))
    likha("\n")
    likha(chay_apanay(s, ok))
    likha("\n")
    likha(chay_rikta(s))
    likha("\n")
    # empty pop / peek: value 0, ok 0
    likha(chay_apanay(s, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    likha(chay_avalok(s, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
}
