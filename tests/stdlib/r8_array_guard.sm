# R8: shreni array functions must stop at n. Each array has one more cell,
# a guard, holding a value that changes the answer if it is read.
yoj shreni
mukhya() {
    vitti a = nirmmita(4 * 8)
    a[0] = 5
    a[1] = 3
    a[2] = 9
    a[3] = 0 - 100
    likha(laghu(a, 3))
    likha(gan(a, 3, 0 - 100))
    likha(anwesh_sarak(a, 3, 0 - 100))
    a[3] = 100
    likha(adhik(a, 3))
    likha(yog(a, 3))
    # n = 0: no element exists, so 0, even though a[0] holds 5
    likha(laghu(a, 0))
    likha(adhik(a, 0))
    likha(yog(a, 0))
}
