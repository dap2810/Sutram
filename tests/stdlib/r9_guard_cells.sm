# R9 (Step 5): the loop-bound proofs. Each function is given n cells (or n
# bytes) and one more after them, a guard, holding a value that changes the
# answer if the function reads it, or that the function must not overwrite.
# A loop that ran once more (i <= n) fails here; every earlier proof missed it.
yoj brihat
yoj khand
yoj anukram
mukhya() {
    # --- brihat (digits LSB first) ---
    vitti a = nirmmita(4 * 8)
    a[3] = 5
    likha(brihat_asti_shunyank(a, 3))          # digits 0 0 0 | guard 5
    a[3] = 77
    likha(brihat_shunyank(a, 3))
    likha(a[3])                                # guard untouched
    vitti s = nirmmita(4 * 8)
    s[0] = 1
    s[1] = 2
    s[2] = 3
    s[3] = 9
    brihat_pratilip(a, s, 3)
    likha(a[2])
    likha(a[3])
    # 321 - 123 = 198; guard digits 9 / 0 would borrow or write
    vitti x = nirmmita(4 * 8)
    vitti y = nirmmita(4 * 8)
    vitti r = nirmmita(4 * 8)
    x[0] = 1
    x[1] = 2
    x[2] = 3
    x[3] = 9
    y[0] = 3
    y[1] = 2
    y[2] = 1
    y[3] = 0
    r[3] = 77
    likha(brihat_nyun(x, y, r, 3))
    likha(r[0] + r[1] * 10 + r[2] * 100)
    likha(r[3])
    # 12 * 34 = 408 in 4 result digits; its documented return is 0
    vitti p = nirmmita(2 * 8)
    vitti q = nirmmita(2 * 8)
    vitti pr = nirmmita(5 * 8)
    p[0] = 2
    p[1] = 1
    q[0] = 4
    q[1] = 3
    pr[4] = 77
    likha(brihat_gun(p, q, pr, 2))
    likha(pr[0] + pr[1] * 10 + pr[2] * 100 + pr[3] * 1000)
    likha(pr[4])
    # --- khand (bytes) ---
    likha(khand_anwesh_akshar("abcX", 3, 88))
    likha(khand_gan_akshar("abcX", 3, 88))
    likha(khand_asti_sarv_ank("09", 2))
    likha(khand_asti_sarv_ank("0/", 2))
    likha(khand_asti_sarv_ank(":", 1))
    # --- anukram: 8 bytes that exactly fill the buffer, and the sign byte ---
    vitti buf = nirmmita(16)
    akshar_rakh(buf, 8, 77)
    likha(anukram_khip_i64(buf, 0, 8, 258))
    likha(akshar(buf, 8))
    vitti out = nirmmita(8)
    likha(anukram_grah_i64(buf, 0, 8, out))
    likha(out[0])
    vitti minv = (0 - 9223372036854775807) - 1
    anukram_khip_i64(buf, 0, 16, minv)
    likha(akshar(buf, 7))
    anukram_grah_i64(buf, 0, 16, out)
    likha(out[0] == minv)
}
