yoj brihat
mukhya() {
    vitti a = nirmmita(8 * 8)
    vitti b = nirmmita(8 * 8)
    vitti r = nirmmita(8 * 8)
    brihat_ank_se_int(12345, a, 8)
    brihat_ank_se_int(6789, b, 8)
    likha(brihat_nyun(a, b, r, 8))
    likha("\n")
    likha(brihat_ank_tak_int(r, 8))
    likha("\n")
    # borrow chain: 1000 - 1 = 999
    brihat_ank_se_int(1000, a, 8)
    brihat_ank_se_int(1, b, 8)
    likha(brihat_nyun(a, b, r, 8))
    likha("\n")
    likha(brihat_ank_tak_int(r, 8))
    likha("\n")
    # equal: 500 - 500 = 0
    brihat_ank_se_int(500, a, 8)
    brihat_ank_se_int(500, b, 8)
    likha(brihat_nyun(a, b, r, 8))
    likha("\n")
    likha(brihat_ank_tak_int(r, 8))
    likha("\n")
}
