ayojan string
mukhya() {
    vitti parts = nirmmita(30 * 8)
    vitti nc = strb_split("a,b,c", ",", parts, 10)
    likha(nc)
    likha("\n")
    vitti out = nirmmita(20 * 8)
    vitti jn = strb_join(parts, nc, ",", out)
    likha(jn)
    likha("\n")
    vitti i = 0
    yavat (i < jn) {
        likha(char_at(out, i))
        likha("\n")
        i = i + 1
    }
}
