ayojan kalana
mukhya() {
    kosh dasham xs[3]
    kosh dasham ys[3]
    kosh_push(xs, 0.0)
    kosh_push(xs, 1.0)
    kosh_push(xs, 2.0)
    kosh_push(ys, 0.0)
    kosh_push(ys, 1.0)
    kosh_push(ys, 4.0)
    likha(slope(xs, ys, 1))
    likha("\n")
    likha(slope(xs, ys, 0))
    likha("\n")
    likha(slope(xs, ys, 2))
    likha("\n")
}
