ayojan samanvaya
mukhya() {
    kosh dasham a[4]
    kosh_push(a, 1.0)
    kosh_push(a, 2.0)
    kosh_push(a, 3.0)
    kosh_push(a, 4.0)
    kosh dasham b[4]
    kosh_push(b, 5.0)
    kosh_push(b, 6.0)
    kosh_push(b, 7.0)
    kosh_push(b, 8.0)
    kosh dasham out[4]
    kosh_push(out, 0.0)
    kosh_push(out, 0.0)
    kosh_push(out, 0.0)
    kosh_push(out, 0.0)
    likha(mat_yoga(a, b, 2, 2, out))
    likha("\n")
    likha(out[0])
    likha("\n")
    likha(out[1])
    likha("\n")
    likha(out[2])
    likha("\n")
    likha(out[3])
    likha("\n")
}
