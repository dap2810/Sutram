yoj nighantu
yoj sangrah
yoj khand
yoj ganita
mukhya() {
    vitti ok = nirmmita(8)
    # nighantu_grah_mool: default for absent, real value (even -1) for present
    vitti m = nighantu_srij(8)
    nighantu_khip(m, 8, "neg", 3, 0 - 1)
    nighantu_khip(m, 8, "pos", 3, 42)
    likha(nighantu_grah_mool(m, 8, "neg", 3, 99))
    likha("\n")
    likha(nighantu_grah_mool(m, 8, "pos", 3, 99))
    likha("\n")
    likha(nighantu_grah_mool(m, 8, "absent", 6, 99))
    likha("\n")
    # rakh_sam: order-independent equality, both directions
    vitti a = rakh_srij(8)
    vitti b = rakh_srij(8)
    vitti c = rakh_srij(8)
    rakh_yuj(a, 8, "x", 1)
    rakh_yuj(a, 8, "y", 1)
    rakh_yuj(b, 8, "y", 1)
    rakh_yuj(b, 8, "x", 1)
    rakh_yuj(c, 8, "x", 1)
    likha(rakh_sam(a, 8, b, 8))
    likha("\n")
    likha(rakh_sam(a, 8, c, 8))
    likha("\n")
    likha(rakh_sam(c, 8, a, 8))
    likha("\n")
    # khand_viparyay: distinct out, in place, even length — byte values
    vitti out = nirmmita(32)
    vitti i = 0
    likha(khand_viparyay("abcde", 5, out))
    likha("\n")
    yavat (i < 5) {
        likha(akshar(out, i))
        likha("\n")
        i = i + 1
    }
    vitti buf = nirmmita(32)
    khand_pratilip("hello", 5, buf)
    likha(khand_viparyay(buf, 5, buf))
    likha("\n")
    i = 0
    yavat (i < 5) {
        likha(akshar(buf, i))
        likha("\n")
        i = i + 1
    }
    # khand_gan: non-overlapping (aaaa/aa = 2, not 3)
    likha(khand_gan("aaaa", 4, "aa", 2))
    likha("\n")
    likha(khand_gan("ababab", 6, "ab", 2))
    likha("\n")
    likha(khand_gan("hello", 5, "z", 1))
    likha("\n")
    likha(khand_gan("hello", 5, "", 0))
    likha("\n")
    # ganita_janchit_ghat
    likha(ganita_janchit_ghat(2, 10, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    likha(ganita_janchit_ghat(2, 63, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    likha(ganita_janchit_ghat(5, 0, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    likha(ganita_janchit_ghat(0 - 2, 3, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    likha(ganita_janchit_ghat(2, 0 - 1, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    likha(ganita_janchit_ghat(0, 0, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    likha("gaps-done\n")
}
