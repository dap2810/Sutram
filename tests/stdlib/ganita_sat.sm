yoj ganita
mukhya() {
    vitti max = 9223372036854775807
    vitti min = (0 - 9223372036854775807) - 1
    likha(ganita_paripurna_yuj(max, 1))
    likha("\n")
    likha(ganita_paripurna_yuj(min, 0 - 1))
    likha("\n")
    likha(ganita_paripurna_nyun(max, 0 - 1))
    likha("\n")
    likha(ganita_paripurna_nyun(min, 1))
    likha("\n")
    likha(ganita_paripurna_gun(max, 2))
    likha("\n")
    likha(ganita_paripurna_gun(min, 2))
    likha("\n")
    # INT64_MIN * -1 saturates tak MAX (true product is +2^63)
    likha(ganita_paripurna_gun(min, 0 - 1))
    likha("\n")
    likha(ganita_paripurna_gun(min, 0 - 2))
    likha("\n")
    # no overflow: exact values
    likha(ganita_paripurna_gun(6, 7))
    likha("\n")
    likha(ganita_paripurna_yuj(2, 3))
    likha("\n")
    likha(ganita_paripurna_nyun(2, 3))
    likha("\n")
}
