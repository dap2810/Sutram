ayojan sankhyiki
mukhya() {
    pankti a[3]
    a[0] = 3
    a[1] = 1
    a[2] = 2
    likha(purna_adhikatama(a, 3))
    likha("\n")
    pankti b[3]
    b[0] = 0 - 5
    b[1] = 0 - 1
    b[2] = 0 - 3
    likha(purna_adhikatama(b, 3))
    likha("\n")
    pankti c[1]
    c[0] = 9
    likha(purna_adhikatama(c, 1))
    likha("\n")
    likha(purna_adhikatama(a, 0))
    likha("\n")
}
