yoj khand
mukhya() {
    # byte-varna find/contains, driven by literals
    likha(khand_anwesh("hello world", 11, "world", 5))
    likha("\n")
    likha(khand_antah("hello world", 11, "world", 5))
    likha("\n")
    # absent needle
    likha(khand_anwesh("hello world", 11, "xyz", 3))
    likha("\n")
    likha(khand_antah("hello world", 11, "xyz", 3))
    likha("\n")
    # empty needle matches at 0
    likha(khand_anwesh("hello", 5, "", 0))
    likha("\n")
    # needle longer than haystack
    likha(khand_anwesh("hi", 2, "hello", 5))
    likha("\n")
    # khand_maap on a literal
    likha(khand_maap("hello"))
    likha("\n")
    # akshar_rakh-built byte varna
    vitti b = nirmmita(16)
    akshar_rakh(b, 0, 104)
    akshar_rakh(b, 1, 105)
    akshar_rakh(b, 2, 0)
    likha(khand_maap(b))
    likha("\n")
    likha(khand_anwesh(b, 2, "i", 1))
    likha("\n")
}
