    likha("\n")
    likha(mahattam_samapavartak(0, 0))
    likha("\n")
    likha(laghuttam_samapavartya(0, 0))
    likha("\n")
    likha(laghuttam_samapavartya(0, 5))
    likha("\n")
    likha(laghuttam_samapavartya(6, 4))
    likha("\n")
    likha(laghuttam_samapavartya(0 - 6, 4))
    likha("\n")
    likha(laghuttam_samapavartya(6, 0 - 4))
