yoj ganit
mukhya() {
    likha(mahattam(0 - 6, 4))
    likha("\n")
    likha(mahattam(6, 0 - 4))
    likha("\n")
    likha(mahattam(0 - 6, 0 - 4))
    likha("\n")
    likha(mahattam(0, 0))
    likha("\n")
    likha(laghuttam(0, 0))
    likha("\n")
    likha(laghuttam(0, 5))
    likha("\n")
    likha(laghuttam(6, 4))
    likha("\n")
    likha(laghuttam(0 - 6, 4))
    likha("\n")
    likha(laghuttam(6, 0 - 4))
    likha("\n")
    likha("math-gcd-lcm-edge-done\n")
}
