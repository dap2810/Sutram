yoj khand
mukhya() {
    vitti out = nirmmita(32)
    # trim
    likha(khand_chhid("  hi  ", 6, out))
    likha("\n")
    likha(khand_tul(out, 2, "hi", 2))
    likha("\n")
    # all spaces -> empty
    likha(khand_chhid("   ", 3, out))
    likha("\n")
    # upper / lower
    likha(khand_unnat("aBc xYz", 7, out))
    likha("\n")
    likha(khand_tul(out, 7, "ABC XYZ", 7))
    likha("\n")
    likha(khand_avanat("aBc xYz", 7, out))
    likha("\n")
    likha(khand_tul(out, 7, "abc xyz", 7))
    likha("\n")
}
