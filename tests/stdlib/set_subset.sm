ayojan set
mukhya() {
    vitti a = set_init(16)
    set_add(a, 16, "apple", 5)
    set_add(a, 16, "pear", 4)
    vitti b = set_init(16)
    set_add(b, 16, "apple", 5)
    set_add(b, 16, "pear", 4)
    set_add(b, 16, "fig", 3)
    vitti c = set_init(16)
    set_add(c, 16, "apple", 5)
    set_add(c, 16, "plum", 4)
    vitti e = set_init(16)
    likha(set_is_subset(a, 16, a, 16))
    likha("\n")
    likha(set_is_subset(a, 16, b, 16))
    likha("\n")
    likha(set_is_subset(b, 16, a, 16))
    likha("\n")
    likha(set_is_subset(e, 16, b, 16))
    likha("\n")
    likha(set_is_subset(c, 16, b, 16))
    likha("\n")
    likha(set_is_subset(b, 16, b, 16))
    likha("\n")
}
