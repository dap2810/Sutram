yoj sangrah
mukhya() {
    vitti a = rakh_srij(16)
    rakh_yuj(a, 16, "apple", 5)
    rakh_yuj(a, 16, "pear", 4)
    vitti b = rakh_srij(16)
    rakh_yuj(b, 16, "apple", 5)
    rakh_yuj(b, 16, "pear", 4)
    rakh_yuj(b, 16, "fig", 3)
    vitti c = rakh_srij(16)
    rakh_yuj(c, 16, "apple", 5)
    rakh_yuj(c, 16, "plum", 4)
    vitti e = rakh_srij(16)
    likha(rakh_asti_upasamuh(a, 16, a, 16))
    likha("\n")
    likha(rakh_asti_upasamuh(a, 16, b, 16))
    likha("\n")
    likha(rakh_asti_upasamuh(b, 16, a, 16))
    likha("\n")
    likha(rakh_asti_upasamuh(e, 16, b, 16))
    likha("\n")
    likha(rakh_asti_upasamuh(c, 16, b, 16))
    likha("\n")
    likha(rakh_asti_upasamuh(b, 16, b, 16))
    likha("\n")
}
