yoj khand
mukhya() {
    # pack cells [104, 105] ("hi") -> bytes
    vitti cells = nirmmita(8 * 8)
    cells[0] = 104
    cells[1] = 105
    vitti out = nirmmita(16)
    likha(khand_bandh(cells, 2, out))
    likha("\n")
    likha(akshar(out, 0))
    likha("\n")
    likha(akshar(out, 1))
    likha("\n")
    # unpack the bytes back into cells
    vitti back = nirmmita(8 * 8)
    likha(khand_mukt(out, 2, back))
    likha("\n")
    likha(back[0])
    likha("\n")
    likha(back[1])
    likha("\n")
    # round trip on a longer input: unpack(pack(x)) == x
    cells[0] = 97
    cells[1] = 98
    cells[2] = 99
    cells[3] = 100
    khand_bandh(cells, 4, out)
    khand_mukt(out, 4, back)
    likha(back[0])
    likha("\n")
    likha(back[1])
    likha("\n")
    likha(back[2])
    likha("\n")
    likha(back[3])
    likha("\n")
    # empty edge: only the terminator is written
    likha(khand_bandh(cells, 0, out))
    likha("\n")
    likha(khand_mukt(out, 0, back))
    likha("\n")
}
