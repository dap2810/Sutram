yoj brihat
mukhya() {
    vitti a = nirmmita(4 * 8)
    vitti b = nirmmita(4 * 8)
    vitti q = nirmmita(4 * 8)
    vitti r = nirmmita(4 * 8)
    brihat_ank_se_laghu(10, a, 4)
    brihat_ank_se_laghu(0, b, 4)
    brihat_bhajshesh(a, b, q, r, 4)
    likha(brihat_ank_tak_laghu(q, 4))
    likha("\n")
    likha(brihat_ank_tak_laghu(r, 4))
    likha("\n")
    brihat_ank_se_laghu(10, a, 4)
    brihat_ank_se_laghu(3, b, 4)
    brihat_bhajshesh(a, b, q, r, 4)
    likha(brihat_ank_tak_laghu(q, 4))
    likha("\n")
    likha(brihat_ank_tak_laghu(r, 4))
    likha("\n")
    brihat_ank_se_laghu(2, a, 4)
    brihat_ank_se_laghu(0, b, 4)
    brihat_ghatmod(a, 10, b, r, 4)
    likha(brihat_ank_tak_laghu(r, 4))
    likha("\n")
    likha("bigint-divzero-done\n")
}
