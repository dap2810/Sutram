    likha("\n")
    result_checked_div(r, 1, 0)
    likha(result_is_ok(r))
    likha("\n")
    result_checked_div(r, (0 - 9223372036854775807) - 1, 0 - 1)
    likha(result_is_ok(r))
    likha("\n")
    result_checked_mod(r, 7, 3)
    likha(result_is_ok(r))
    likha("\n")
    likha(result_value(r))
    likha("\n")
