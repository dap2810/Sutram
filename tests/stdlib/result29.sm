    likha("\n")
    likha(result_value(r))
    likha("\n")
    result_checked_sub(r, (0 - 9223372036854775807) - 1, 1)
    likha(result_is_ok(r))
    likha("\n")
    result_checked_mul(r, 4294967296, 4294967296)
    likha(result_is_ok(r))
    likha("\n")
