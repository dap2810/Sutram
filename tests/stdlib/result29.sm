    likha("\n")
    ok[0] = 0
    result_from_ok(r, 7, ok)
    likha(result_is_ok(r))
    likha("\n")
    likha(result_value_or(r, 99))
    likha("\n")
    result_checked_add(r, 2, 3)
    likha(result_is_ok(r))
    likha("\n")
    likha(result_value(r))
    likha("\n")
    result_checked_add(r, 9223372036854775807, 1)
