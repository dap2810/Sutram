yoj khand
mukhya() {
    likha(khand_aadi("hello", 5, "he", 2))
    likha("\n")
    likha(khand_aadi("hello", 5, "lo", 2))
    likha("\n")
    likha(khand_ant("hello", 5, "lo", 2))
    likha("\n")
    likha(khand_ant("hello", 5, "he", 2))
    likha("\n")
    likha(khand_tul("abc", 3, "abc", 3))
    likha("\n")
    likha(khand_tul("abc", 3, "abd", 3))
    likha("\n")
    likha(khand_tul("abd", 3, "abc", 3))
    likha("\n")
    likha(khand_tul("ab", 2, "abc", 3))
    likha("\n")
    likha(khand_tul("abc", 3, "ab", 2))
    likha("\n")
}
