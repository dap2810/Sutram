ayojan strb
mukhya() {
    likha(strb_starts("hello", 5, "he", 2))
    likha("\n")
    likha(strb_starts("hello", 5, "lo", 2))
    likha("\n")
    likha(strb_ends("hello", 5, "lo", 2))
    likha("\n")
    likha(strb_ends("hello", 5, "he", 2))
    likha("\n")
    likha(strb_compare("abc", 3, "abc", 3))
    likha("\n")
    likha(strb_compare("abc", 3, "abd", 3))
    likha("\n")
    likha(strb_compare("abd", 3, "abc", 3))
    likha("\n")
    likha(strb_compare("ab", 2, "abc", 3))
    likha("\n")
    likha(strb_compare("abc", 3, "ab", 2))
    likha("\n")
}
