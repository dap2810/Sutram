yoj nighantu
mukhya() {
    vitti m = nighantu_srij(8)
    # put / get round trip with literal keys
    likha(nighantu_khip(m, 8, "apple", 5, 42))
    likha("\n")
    likha(nighantu_khip(m, 8, "pear", 4, 7))
    likha("\n")
    likha(nighantu_khip(m, 8, "plum", 4, 99))
    likha("\n")
    likha(nighantu_grah(m, 8, "apple", 5))
    likha("\n")
    likha(nighantu_grah(m, 8, "pear", 4))
    likha("\n")
    likha(nighantu_grah(m, 8, "plum", 4))
    likha("\n")
    likha(nighantu_maap(m))
    likha("\n")
    # absent key: sentinel -1, contains 0
    likha(nighantu_grah(m, 8, "fig", 3))
    likha("\n")
    likha(nighantu_antah(m, 8, "fig", 3))
    likha("\n")
    likha(nighantu_antah(m, 8, "apple", 5))
    likha("\n")
    # update: size unchanged, new value visible
    likha(nighantu_khip(m, 8, "apple", 5, 100))
    likha("\n")
    likha(nighantu_maap(m))
    likha("\n")
    likha(nighantu_grah(m, 8, "apple", 5))
    likha("\n")
}
