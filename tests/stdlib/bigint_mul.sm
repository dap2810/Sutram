yoj brihat
mukhya() {
    vitti a = nirmmita(8 * 8)
    vitti b = nirmmita(8 * 8)
    vitti r = nirmmita(16 * 8)
    brihat_ank_se_int(12345, a, 8)
    brihat_ank_se_int(6789, b, 8)
    brihat_gun(a, b, r, 8)
    likha(brihat_ank_tak_int(r, 16))
    likha("\n")
    # 999 * 999 = 998001
    brihat_ank_se_int(999, a, 8)
    brihat_ank_se_int(999, b, 8)
    brihat_gun(a, b, r, 8)
    likha(brihat_ank_tak_int(r, 16))
    likha("\n")
    # multiply by zero
    brihat_ank_se_int(12345, a, 8)
    brihat_ank_se_int(0, b, 8)
    brihat_gun(a, b, r, 8)
    likha(brihat_ank_tak_int(r, 16))
    likha("\n")
    likha(brihat_asti_shunyank(r, 16))
    likha("\n")
}
