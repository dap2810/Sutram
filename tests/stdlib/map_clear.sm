ayojan map
mukhya() {
    vitti m = map_init(8)
    vitti keys = nirmmita(200)
    map_put(m, 8, "apple", 5, 42)
    map_put(m, 8, "pear", 4, 7)
    likha(map_size(m))
    likha("\n")
    map_clear(m)
    # same handle, same capacity (m[0]), empty contents
    likha(m[0])
    likha("\n")
    likha(map_size(m))
    likha("\n")
    likha(map_contains(m, 8, "apple", 5))
    likha("\n")
    likha(map_keys_bytes(m, keys))
    likha("\n")
    # stale key bytes: first key-region byte is zeroed
    likha(char_at(m, 208))
    likha("\n")
    # reuse in place: re-put works, old keys stay absent
    map_put(m, 8, "plum", 4, 99)
    likha(map_size(m))
    likha("\n")
    likha(map_get(m, 8, "plum", 4))
    likha("\n")
    likha(map_contains(m, 8, "apple", 5))
    likha("\n")
    # clear twice: second clear is a no-op
    map_clear(m)
    map_clear(m)
    likha(map_size(m))
    likha("\n")
    likha("clear-done\n")
}
