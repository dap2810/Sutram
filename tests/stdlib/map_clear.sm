yoj nighantu
mukhya() {
    vitti m = nighantu_srij(8)
    vitti keys = nirmmita(200)
    nighantu_khip(m, 8, "apple", 5, 42)
    nighantu_khip(m, 8, "pear", 4, 7)
    likha(nighantu_maap(m))
    likha("\n")
    nighantu_rikta(m)
    # same handle, same capacity (m[0]), empty contents
    likha(m[0])
    likha("\n")
    likha(nighantu_maap(m))
    likha("\n")
    likha(nighantu_antah(m, 8, "apple", 5))
    likha("\n")
    likha(nighantu_kunjika_ashtak(m, keys))
    likha("\n")
    # stale key bytes: first key-region byte is zeroed
    likha(akshar(m, 208))
    likha("\n")
    # reuse in place: re-put works, old keys stay absent
    nighantu_khip(m, 8, "plum", 4, 99)
    likha(nighantu_maap(m))
    likha("\n")
    likha(nighantu_grah(m, 8, "plum", 4))
    likha("\n")
    likha(nighantu_antah(m, 8, "apple", 5))
    likha("\n")
    # clear twice: second clear is a no-op
    nighantu_rikta(m)
    nighantu_rikta(m)
    likha(nighantu_maap(m))
    likha("\n")
    likha("clear-done\n")
}
