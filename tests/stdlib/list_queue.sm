ayojan list
mukhya() {
    vitti q = queue_init(2)
    vitti ok = nirmmita(8)
    likha(queue_empty(q))
    likha("\n")
    likha(queue_enqueue(q, 1))
    likha("\n")
    likha(queue_enqueue(q, 2))
    likha("\n")
    likha(queue_dequeue(q, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    # enqueue wraps around the ring (head = 1, tail slot 0)
    likha(queue_enqueue(q, 3))
    likha("\n")
    # full again: growth re-packs in logical order, head resets
    likha(queue_enqueue(q, 4))
    likha("\n")
    likha(queue_peek(q, ok))
    likha("\n")
    likha(queue_len(q))
    likha("\n")
    # FIFO order
    likha(queue_dequeue(q, ok))
    likha("\n")
    likha(queue_dequeue(q, ok))
    likha("\n")
    likha(queue_dequeue(q, ok))
    likha("\n")
    likha(queue_empty(q))
    likha("\n")
    # empty dequeue / peek: value 0, ok 0
    likha(queue_dequeue(q, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    likha(queue_peek(q, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
}
