yoj suchi
mukhya() {
    vitti q = avali_srij(2)
    vitti ok = nirmmita(8)
    likha(avali_shunya(q))
    likha("\n")
    likha(avali_pravesh(q, 1))
    likha("\n")
    likha(avali_pravesh(q, 2))
    likha("\n")
    likha(avali_nishkas(q, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    # enqueue wraps around the ring (head = 1, tail slot 0)
    likha(avali_pravesh(q, 3))
    likha("\n")
    # full again: growth re-packs in logical order, head resets
    likha(avali_pravesh(q, 4))
    likha("\n")
    likha(avali_avalok(q, ok))
    likha("\n")
    likha(avali_maap(q))
    likha("\n")
    # FIFO order
    likha(avali_nishkas(q, ok))
    likha("\n")
    likha(avali_nishkas(q, ok))
    likha("\n")
    likha(avali_nishkas(q, ok))
    likha("\n")
    likha(avali_shunya(q))
    likha("\n")
    # empty dequeue / peek: value 0, ok 0
    likha(avali_nishkas(q, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    likha(avali_avalok(q, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
}
