yoj brihat
yoj aadhar
mukhya() {
    vitti x = nirmmita(8 * 8)
    vitti digits = nirmmita(70 * 8)
    vitti y = nirmmita(8 * 8)
    # 255 in hex, binary, octal
    brihat_ank_se_int(255, x, 8)
    vitti l1 = brihat_ank_tak(x, 8, 16, digits)
    likha(l1)
    likha("\n")
    likha(digits[0])
    likha("\n")
    likha(digits[1])
    likha("\n")
    vitti l2 = brihat_ank_tak(x, 8, 2, digits)
    likha(l2)
    likha("\n")
    vitti l3 = brihat_ank_tak(x, 8, 8, digits)
    likha(l3)
    likha("\n")
    # round-trip via base 16
    brihat_ank_tak(x, 8, 16, digits)
    brihat_ank_se(digits, 2, 16, y, 8)
    likha(brihat_ank_tak_int(y, 8))
    likha("\n")
}
