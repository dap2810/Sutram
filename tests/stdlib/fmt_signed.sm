yoj roop
mukhya() {
    vitti out = nirmmita(128)
    vitti n = 0
    n = roop_chinhit(42, out)
    likha(1, out, n)
    likha("\n")
    n = roop_chinhit(0 - 42, out)
    likha(1, out, n)
    likha("\n")
    n = roop_chinhit(0, out)
    likha(1, out, n)
    likha("\n")
    # caller-chosen util_chinha char: blank for non-negative
    n = roop_sign_akshar(42, 32, out)
    likha(1, out, n)
    likha("\n")
    n = roop_sign_akshar(0 - 42, 32, out)
    likha(1, out, n)
    likha("\n")
    # caller-chosen util_chinha char: '*' for non-negative
    n = roop_sign_akshar(7, 42, out)
    likha(1, out, n)
    likha("\n")
}
