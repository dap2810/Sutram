yoj roop
mukhya() {
    vitti out = nirmmita(128)
    vitti n = 0
    n = roop_varg_bharatiya("1234567", 7, out)
    likha(1, out, n)
    likha("\n")
    n = roop_varg_vishwa("1234567", 7, out)
    likha(1, out, n)
    likha("\n")
    # default grouping is Indian
    n = roop_varg("123456", 6, out)
    likha(1, out, n)
    likha("\n")
    # negative + decimal fraction copied verbatim
    n = roop_varg_bharatiya("-1234567.89", 11, out)
    likha(1, out, n)
    likha("\n")
    n = roop_varg_vishwa("-1234567.89", 11, out)
    likha(1, out, n)
    likha("\n")
    # short inputs: no commas
    n = roop_varg_bharatiya("123", 3, out)
    likha(1, out, n)
    likha("\n")
    n = roop_varg_vishwa("12", 2, out)
    likha(1, out, n)
    likha("\n")
    # empty input
    n = roop_varg_bharatiya("", 0, out)
    likha(n)
    likha("\n")
    # integer convenience: Indian + international
    n = roop_varg_ank(0 - 1234567, 1, out)
    likha(1, out, n)
    likha("\n")
    n = roop_varg_ank(1234567, 0, out)
    likha(1, out, n)
    likha("\n")
    n = roop_varg_ank(999, 1, out)
    likha(1, out, n)
    likha("\n")
}
