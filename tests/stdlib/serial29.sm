ayojan serial
mukhya() {
    vitti buf = nirmmita(64 * 8)
    vitti out = nirmmita(8)
    vitti dst = nirmmita(16 * 8)
    vitti n = nirmmita(8)
    vitti p = serial_put_i64(buf, 0, 64, 0)
    p = serial_put_i64(buf, p, 64, 1)
    p = serial_put_i64(buf, p, 64, 0 - 1)
    p = serial_put_i64(buf, p, 64, 9223372036854775807)
    p = serial_put_i64(buf, p, 64, (0 - 9223372036854775807) - 1)
    p = serial_put_i64(buf, p, 64, 0 - 123456789012345)
    likha(p)
    likha("\n")
    vitti q = serial_get_i64(buf, 0, 64, out)
    likha(out[0])
    likha("\n")
    q = serial_get_i64(buf, 8, 64, out)
    likha(out[0])
    likha("\n")
    q = serial_get_i64(buf, 16, 64, out)
    likha(out[0])
    likha("\n")
    q = serial_get_i64(buf, 24, 64, out)
    likha(out[0])
    likha("\n")
    q = serial_get_i64(buf, 32, 64, out)
    likha(out[0])
    likha("\n")
    q = serial_get_i64(buf, 40, 64, out)
    likha(out[0])
    likha("\n")
    likha(serial_put_i64(buf, 60, 64, 1))
    likha("\n")
    likha(serial_get_i64(buf, 60, 64, out))
    likha("\n")
    likha(serial_len_bytes(5))
    likha("\n")
    vitti src = nirmmita(16 * 8)
    set_char(src, 0, 104)
    set_char(src, 1, 101)
    set_char(src, 2, 108)
    set_char(src, 3, 108)
    set_char(src, 4, 111)
    p = serial_put_bytes(buf, 0, 64, src, 5)
    likha(p)
    likha("\n")
    q = serial_get_bytes(buf, 0, 64, dst, n)
    likha(q)
    likha("\n")
    likha(n[0])
    likha("\n")
    vitti i = 0
    yavat (i < n[0]) {
        likha(char_at(dst, i))
        likha("\n")
        i = i + 1
    }
    p = serial_put_bytes(buf, 0, 64, src, 0)
    likha(p)
    likha("\n")
    q = serial_get_bytes(buf, 0, 64, dst, n)
    likha(n[0])
    likha("\n")
    likha(serial_put_bytes(buf, 60, 64, src, 5))
    likha("\n")
    vitti bad = nirmmita(16 * 8)
    vitti pb = serial_put_i64(bad, 0, 16, 0 - 1)
    likha(serial_get_bytes(bad, 0, 16, dst, n))
    likha("\n")
    likha("serial29-done\n")
}
