ayojan array
mukhya() {
    vitti s = array_new(3)
    vitti d = array_new(3)
    array_set(s, 0, 11)
    array_set(s, 1, 22)
    array_set(s, 2, 33)
    likha(array_copy(d, s, 3))
    likha("\n")
    likha(array_get(d, 0))
    likha("\n")
    likha(array_get(d, 1))
    likha("\n")
    likha(array_get(d, 2))
    likha("\n")
}
