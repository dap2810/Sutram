yoj mala
mukhya() {
    vitti s = mala_nava(3)
    vitti d = mala_nava(3)
    mala_sangrah(s, 0, 11)
    mala_sangrah(s, 1, 22)
    mala_sangrah(s, 2, 33)
    likha(mala_pratilip(d, s, 3))
    likha("\n")
    likha(mala_grah(d, 0))
    likha("\n")
    likha(mala_grah(d, 1))
    likha("\n")
    likha(mala_grah(d, 2))
    likha("\n")
}
