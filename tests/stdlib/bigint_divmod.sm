yoj brihat
mukhya() {
    vitti a = nirmmita(8 * 8)
    vitti b = nirmmita(8 * 8)
    vitti q = nirmmita(8 * 8)
    vitti r = nirmmita(8 * 8)
    # 12345 / 67 = 184 r 17
    brihat_ank_se_laghu(12345, a, 8)
    brihat_ank_se_laghu(67, b, 8)
    brihat_bhajshesh(a, b, q, r, 8)
    likha(brihat_ank_tak_laghu(q, 8))
    likha("\n")
    likha(brihat_ank_tak_laghu(r, 8))
    likha("\n")
    # exact division: 100 / 4 = 25 r 0
    brihat_ank_se_laghu(100, a, 8)
    brihat_ank_se_laghu(4, b, 8)
    brihat_bhajshesh(a, b, q, r, 8)
    likha(brihat_ank_tak_laghu(q, 8))
    likha("\n")
    likha(brihat_ank_tak_laghu(r, 8))
    likha("\n")
    # dividend < divisor: 5 / 10 = 0 r 5
    brihat_ank_se_laghu(5, a, 8)
    brihat_ank_se_laghu(10, b, 8)
    brihat_bhajshesh(a, b, q, r, 8)
    likha(brihat_ank_tak_laghu(q, 8))
    likha("\n")
    likha(brihat_ank_tak_laghu(r, 8))
    likha("\n")
}
