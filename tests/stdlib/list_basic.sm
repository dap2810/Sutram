yoj suchi
mukhya() {
    vitti l = suchi_srij(2)
    likha(suchi_maap(l))
    likha("\n")
    likha(suchi_khip(l, 10))
    likha("\n")
    likha(suchi_khip(l, 20))
    likha("\n")
    # third push grows capacity 2 -> 4
    likha(suchi_khip(l, 30))
    likha("\n")
    likha(suchi_maap(l))
    likha("\n")
    likha(suchi_grah(l, 0))
    likha("\n")
    likha(suchi_grah(l, 2))
    likha("\n")
    # out of bounds reads return 0
    likha(suchi_grah(l, 9))
    likha("\n")
    likha(suchi_grah(l, 0 - 1))
    likha("\n")
    likha(suchi_sangrah(l, 1, 99))
    likha("\n")
    likha(suchi_grah(l, 1))
    likha("\n")
    likha(suchi_sangrah(l, 9, 1))
    likha("\n")
    likha(suchi_antah(l, 99))
    likha("\n")
    likha(suchi_antah(l, 20))
    likha("\n")
    likha(suchi_kramank(l, 30))
    likha("\n")
    likha(suchi_kramank(l, 7))
    likha("\n")
    likha(suchi_nivesh(l, 1, 15))
    likha("\n")
    likha(suchi_grah(l, 1))
    likha("\n")
    likha(suchi_maap(l))
    likha("\n")
    # insert at the end appends; insert out of bounds fails
    likha(suchi_nivesh(l, 4, 40))
    likha("\n")
    likha(suchi_nivesh(l, 6, 1))
    likha("\n")
    likha(suchi_apanay(l, 0))
    likha("\n")
    likha(suchi_grah(l, 0))
    likha("\n")
    likha(suchi_apanay(l, 9))
    likha("\n")
    likha(suchi_rikta(l))
    likha("\n")
    likha(suchi_maap(l))
    likha("\n")
    # clear keeps capacity: push works again
    likha(suchi_khip(l, 5))
    likha("\n")
    likha(suchi_grah(l, 0))
    likha("\n")
}
