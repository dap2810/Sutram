# Bridge fixture (ROUND-10): a literal flows through the byte-string
# toolkit with no hand-built array. "foo bar foo" -> strb_replace -> "baz bar baz".
ayojan string
mukhya() {
    vitti out = nirmmita(30 * 8)
    vitti n = strb_replace("foo bar foo", "foo", "baz", out)
    likha(n)
    likha("\n")
    vitti i = 0
    yavat (i < n) {
        likha(char_at(out, i))
        likha("\n")
        i = i + 1
    }
}
