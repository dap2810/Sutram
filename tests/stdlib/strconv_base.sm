yoj vakyank
mukhya() {
    vitti buf = nirmmita(70 * 8)
    vitti ok = nirmmita(1 * 8)
    # 255 in hex
    vitti h = ank_tak_aadhar_varna(255, 16, buf)
    likha(h)
    likha("\n")
    likha(buf[0])
    likha("\n")
    likha(buf[1])
    likha("\n")
    likha(varna_tak_ank_aadhar(buf, h, 16, ok))
    likha("\n")
    # 255 in binary (8 digits)
    vitti b = ank_tak_aadhar_varna(255, 2, buf)
    likha(b)
    likha("\n")
    likha(varna_tak_ank_aadhar(buf, b, 2, ok))
    likha("\n")
    # 64 in octal
    vitti o = ank_tak_aadhar_varna(64, 8, buf)
    likha(o)
    likha("\n")
    likha(varna_tak_ank_aadhar(buf, o, 8, ok))
    likha("\n")
    # invalid digit for base
    buf[0] = 102
    buf[1] = 0
    likha(varna_tak_ank_aadhar(buf, 1, 10, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
}
