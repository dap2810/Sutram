yoj ganita
yoj ganit
yoj ank
yoj roop
mukhya() {
    likha(kuttaka(0 - 7819279541048604735, 0 - 2881118045913156764, 0 - 150))
    likha("\n")
    vitti out = nirmmita(8 * 8)
    samasa(out, 1099511627776, 0, 1099511627776, 0, 0)
    likha(out[0])
    likha("\n")
    likha(out[1])
    likha("\n")
    likha(brahmagupta_kshetr(4611686018427387904, 4611686018427387904, 4611686018427387904, 4611686018427387904))
    likha("\n")
    likha(varg(4294967296))
    likha("\n")
    likha(vargit(3037000500))
    likha("\n")
    likha(ghan(2097152))
    likha("\n")
    likha(ghan(2097153))
    likha("\n")
    likha(dvigun(9223372036854775807))
    likha("\n")
    likha(trigun(9223372036854775807))
    likha("\n")
    likha(vardh(9223372036854775807))
    likha("\n")
    likha(ghat(2, 63))
    likha("\n")
    likha(ghat(3, 40))
    likha("\n")
    likha(kramgun(21))
    likha("\n")
    likha(fib(93))
    likha("\n")
    likha(viparyay_ank(1234567890123456789))
    likha("\n")
    vitti buf = nirmmita(40 * 8)
    likha(roop_sthir(1000000000000000000.0, 2, buf))
    likha("\n")
    likha(roop_sthir(0 - 1000000000000000000.0, 2, buf))
    likha("\n")
    vitti w = roop_sthir(9223372036854774784.0, 0, buf)
    likha(w)
    likha("\n")
    vitti i = 0
    yavat (i < w) {
        likha(akshar(buf, i))
        likha("\n")
        i = i + 1
    }
    likha("numeric29-done\n")
}
