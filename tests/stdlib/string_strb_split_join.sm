yoj khand
mukhya() {
    vitti parts = nirmmita(64 * 8)
    vitti out = nirmmita(32)
    # split "a,b,c" on ","
    vitti nc = khand_bhed("a,b,c", 5, ",", 1, parts, 8)
    likha(nc)
    likha("\n")
    # join round trip
    vitti jn = khand_yuj(parts, nc, ",", 1, out)
    likha(jn)
    likha("\n")
    likha(khand_tul(out, jn, "a,b,c", 5))
    likha("\n")
    # empty separator: no split
    likha(khand_bhed("abc", 3, "", 0, parts, 8))
    likha("\n")
    # empty input: one empty segment
    likha(khand_bhed("", 0, ",", 1, parts, 8))
    likha("\n")
    # adjacent separators give an empty middle segment
    vitti nc2 = khand_bhed("a,,b", 4, ",", 1, parts, 8)
    likha(nc2)
    likha("\n")
    vitti jn2 = khand_yuj(parts, nc2, ",", 1, out)
    likha(khand_tul(out, jn2, "a,,b", 4))
    likha("\n")
}
