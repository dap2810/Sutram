yoj patra
mukhya() {
    vitti buf = nirmmita(64)
    vitti i = 0
    # write 5 bytes tak a scratch path in /tmp (never the repo
    # tree), then read them back and verify the round-trip
    akshar_rakh(buf, 0, 83)
    akshar_rakh(buf, 1, 117)
    akshar_rakh(buf, 2, 116)
    akshar_rakh(buf, 3, 114)
    akshar_rakh(buf, 4, 97)
    vitti w = patra_likh_sarv("/tmp/sutram_file_write_test.txt", buf, 5)
    likha(w)
    likha("\n")
    vitti n = patra_path_sarv("/tmp/sutram_file_write_test.txt", buf, 64)
    likha(n)
    likha("\n")
    yavat (i < n) {
        likha(akshar(buf, i))
        likha("\n")
        i = i + 1
    }
    # overwrite with 0 bytes: patra becomes empty, returns 0
    likha(patra_likh_sarv("/tmp/sutram_file_write_test.txt", buf, 0))
    likha("\n")
    likha(patra_path_sarv("/tmp/sutram_file_write_test.txt", buf, 64))
    likha("\n")
    # negative count: -1, patra not created/touched
    likha(patra_likh_sarv("/tmp/sutram_file_write_test.txt", buf, 0 - 2))
    likha("\n")
    # unwritable path (missing directory): -1
    likha(patra_likh_sarv("/tmp/no_such_dir_xyz/file.txt", buf, 5))
    likha("\n")
    likha("file-write-done\n")
}
