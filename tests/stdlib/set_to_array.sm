yoj sangrah
yoj khand
mukhya() {
    # inserted cherry, apple, banana — dump is sorted, not insertion order
    vitti s = rakh_srij(16)
    rakh_yuj(s, 16, "cherry", 6)
    rakh_yuj(s, 16, "apple", 5)
    rakh_yuj(s, 16, "banana", 6)
    vitti arr = nirmmita(64 * 8)
    vitti buf = nirmmita(64)
    vitti n = rakh_tak_mala(s, 16, arr)
    likha(n)
    likha("\n")
    vitti pos = 0
    vitti i = 0
    vitti sl = 0
    yavat (i < n) {
        sl = arr[pos]
        khand_bandh(arr + (pos + 1) * 8, sl, buf)
        likha(1, buf, sl)
        likha("\n")
        pos = pos + 1 + sl
        i = i + 1
    }
    # empty sangrah dumps tak zero elements
    vitti e = rakh_srij(16)
    likha(rakh_tak_mala(e, 16, arr))
    likha("\n")
    # single element
    vitti one = rakh_srij(16)
    rakh_yuj(one, 16, "solo", 4)
    likha(rakh_tak_mala(one, 16, arr))
    likha("\n")
    likha(arr[0])
    likha("\n")
}
