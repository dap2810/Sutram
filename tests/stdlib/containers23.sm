yoj suchi
mukhya() {
    vitti l = suchi_srij(8)
    suchi_khip(l, 5)
    suchi_khip(l, 2)
    suchi_khip(l, 8)
    suchi_khip(l, 2)
    likha(suchi_anwesh(l, 2))
    likha("\n")
    likha(suchi_anwesh(l, 9))
    likha("\n")
    likha(suchi_asti_sorted(l))
    likha("\n")
    suchi_shreni(l)
    likha(suchi_asti_sorted(l))
    likha("\n")
    likha(suchi_dwi_anwesh(l, 5))
    likha("\n")
    likha(suchi_dwi_anwesh(l, 9))
    likha("\n")

    vitti q = avali_srij(4)
    avali_pravesh(q, 11)
    avali_pravesh(q, 22)
    avali_pravesh(q, 33)
    avali_nishkas(q, nirmmita(8))
    avali_pravesh(q, 44)
    vitti arr = nirmmita(8 * 8)
    likha(avali_tak_mala(q, arr))
    likha("\n")
    likha(arr[0])
    likha("\n")
    likha(arr[1])
    likha("\n")
    likha(arr[2])
    likha("\n")
    likha(avali_maap(q))
    likha("\n")
        likha("containers23-done\n")
}
