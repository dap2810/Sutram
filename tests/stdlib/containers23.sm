ayojan list
mukhya() {
    vitti l = list_init(8)
    list_push(l, 5)
    list_push(l, 2)
    list_push(l, 8)
    list_push(l, 2)
    likha(list_find(l, 2))
    likha("\n")
    likha(list_find(l, 9))
    likha("\n")
    likha(list_is_sorted(l))
    likha("\n")
    list_sort(l)
    likha(list_is_sorted(l))
    likha("\n")
    likha(list_binary_search(l, 5))
    likha("\n")
    likha(list_binary_search(l, 9))
    likha("\n")

    vitti q = queue_init(4)
    queue_enqueue(q, 11)
    queue_enqueue(q, 22)
    queue_enqueue(q, 33)
    queue_dequeue(q, nirmmita(8))
    queue_enqueue(q, 44)
    vitti arr = nirmmita(8 * 8)
    likha(queue_to_array(q, arr))
    likha("\n")
    likha(arr[0])
    likha("\n")
    likha(arr[1])
    likha("\n")
    likha(arr[2])
    likha("\n")
    likha(queue_len(q))
    likha("\n")
        likha("containers23-done\n")
}
