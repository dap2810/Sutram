yoj khand
yoj varna
mukhya() {
    vitti hay = nirmmita(32)
    khand_pratilip("hello world", 11, hay)
    likha(khand_gan_swar(hay, 5))
    likha("\n")
    likha(khand_gan_swar(hay, 11))
    likha("\n")
    likha(khand_gan_akshar(hay, 11, 108))
    likha("\n")
    likha(khand_anwesh_akshar(hay, 11, 119))
    likha("\n")
    likha(khand_anwesh_akshar(hay, 5, 119))
    likha("\n")
    likha(khand_asti_sarv_ank("12345", 5))
    likha("\n")
    likha(khand_asti_sarv_ank("12a45", 5))
    likha("\n")
    likha(khand_asti_sarv_ank("12345", 0))
    likha("\n")
    likha(khand_sam("abc", 3, "abc", 3))
    likha("\n")
    likha(khand_sam("abc", 3, "abd", 3))
    likha("\n")
    vitti cells = nirmmita(6 * 8)
    vitti out = nirmmita(6 * 8)
    cells[0] = 104
    cells[1] = 105
    cells[2] = 33
    likha(varna_viparyay(cells, 3, out))
    likha("\n")
    likha(out[0])
    likha("\n")
    likha(out[1])
    likha("\n")
    likha(out[2])
    likha("\n")
    vitti hc = nirmmita(6 * 8)
    vitti nd = nirmmita(2 * 8)
    hc[0] = 97
    hc[1] = 97
    hc[2] = 97
    hc[3] = 97
    nd[0] = 97
    nd[1] = 97
    likha(varna_gan(hc, 4, nd, 2))
    likha("\n")
    likha("demo1-done\n")
}
