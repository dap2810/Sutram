    likha("\n")
    likha(ganita_checked_fact(0, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    likha(ganita_checked_fact(0 - 1, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    likha(ganita_sat_pow(2, 63))
    likha("\n")
