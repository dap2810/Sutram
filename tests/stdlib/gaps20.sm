    likha("\n")
    likha(ganita_janchit_kramgun(20, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    likha(ganita_janchit_kramgun(21, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    likha(ganita_janchit_kramgun(0, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    likha(ganita_janchit_kramgun(0 - 1, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    likha(ganita_paripurna_ghat(2, 63))
    likha("\n")
    likha(ganita_paripurna_ghat(2, 1000000))
    likha("\n")
    likha(ganita_paripurna_ghat(0 - 2, 64))
