ayojan ganita
mukhya() {
    vitti max = 9223372036854775807
    vitti min = (0 - 9223372036854775807) - 1
    vitti ok = nirmmita(8)
    vitti v = 0
    # plain + still wraps (operators unchanged); checked reports it
    likha(max + 1)
    likha("\n")
    v = ganita_checked_add(max, 1, ok)
    likha(v)
    likha("\n")
    likha(ok[0])
    likha("\n")
    v = ganita_checked_add(2, 3, ok)
    likha(v)
    likha("\n")
    likha(ok[0])
    likha("\n")
    v = ganita_checked_sub(min, 1, ok)
    likha(v)
    likha("\n")
    likha(ok[0])
    likha("\n")
    v = ganita_checked_sub(max, 0 - 1, ok)
    likha(v)
    likha("\n")
    likha(ok[0])
    likha("\n")
    v = ganita_checked_mul(max, 2, ok)
    likha(v)
    likha("\n")
    likha(ok[0])
    likha("\n")
    v = ganita_checked_mul(6, 7, ok)
    likha(v)
    likha("\n")
    likha(ok[0])
    likha("\n")
    # the idiv edge: INT64_MIN * -1 overflows, no SIGFPE
    v = ganita_checked_mul(min, 0 - 1, ok)
    likha(v)
    likha("\n")
    likha(ok[0])
    likha("\n")
    # division by zero: ok 0, program continues
    v = ganita_checked_div(7, 0, ok)
    likha(v)
    likha("\n")
    likha(ok[0])
    likha("\n")
    # the idiv edge: INT64_MIN / -1 would SIGFPE; checked reports it
    v = ganita_checked_div(min, 0 - 1, ok)
    likha(v)
    likha("\n")
    likha(ok[0])
    likha("\n")
    v = ganita_checked_div(0 - 7, 2, ok)
    likha(v)
    likha("\n")
    likha(ok[0])
    likha("\n")
    v = ganita_checked_mod(0 - 7, 2, ok)
    likha(v)
    likha("\n")
    likha(ok[0])
    likha("\n")
    v = ganita_checked_mod(7, 0, ok)
    likha(v)
    likha("\n")
    likha(ok[0])
    likha("\n")
    likha("continued\n")
}
