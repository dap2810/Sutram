yoj brihat
mukhya() {
    vitti base = nirmmita(8 * 8)
    vitti shesh = nirmmita(8 * 8)
    vitti res = nirmmita(8 * 8)
    # 2^10 shesh 1000 = 24
    brihat_ank_se_int(2, base, 8)
    brihat_ank_se_int(1000, shesh, 8)
    brihat_ghatmod(base, 10, shesh, res, 8)
    likha(brihat_ank_tak_int(res, 8))
    likha("\n")
    # 3^5 shesh 100 = 43
    brihat_ank_se_int(3, base, 8)
    brihat_ank_se_int(100, shesh, 8)
    brihat_ghatmod(base, 5, shesh, res, 8)
    likha(brihat_ank_tak_int(res, 8))
    likha("\n")
    # x^0 shesh m = 1
    brihat_ank_se_int(7, base, 8)
    brihat_ank_se_int(100, shesh, 8)
    brihat_ghatmod(base, 0, shesh, res, 8)
    likha(brihat_ank_tak_int(res, 8))
    likha("\n")
    # 5^3 shesh 13 = 8 (125 shesh 13)
    brihat_ank_se_int(5, base, 8)
    brihat_ank_se_int(13, shesh, 8)
    brihat_ghatmod(base, 3, shesh, res, 8)
    likha(brihat_ank_tak_int(res, 8))
    likha("\n")
}
