yoj roop
mukhya() {
    vitti out = nirmmita(128)
    vitti n = 0
    # decimal, negative
    n = roop_dash(0 - 255, out)
    likha(1, out, n)
    likha("\n")
    # hex lower / upper
    n = roop_shodash(255, out)
    likha(1, out, n)
    likha("\n")
    n = roop_shodash_unnat(255, out)
    likha(1, out, n)
    likha("\n")
    # prefixed, negative + upper digits, prefix stays lowercase
    n = roop_ank_pre(255, 16, 0, out)
    likha(1, out, n)
    likha("\n")
    n = roop_ank_pre(0 - 255, 16, 1, out)
    likha(1, out, n)
    likha("\n")
    # binary + prefix, octal
    n = roop_dwi(5, out)
    likha(1, out, n)
    likha("\n")
    n = roop_ank_pre(5, 2, 0, out)
    likha(1, out, n)
    likha("\n")
    n = roop_asht(511, out)
    likha(1, out, n)
    likha("\n")
    n = roop_ank_pre(511, 8, 0, out)
    likha(1, out, n)
    likha("\n")
    # base 36, zero, bad base
    n = roop_ank_aadhar2(35, 36, out)
    likha(1, out, n)
    likha("\n")
    n = roop_ank_aadhar2(36, 36, out)
    likha(1, out, n)
    likha("\n")
    n = roop_dash(0, out)
    likha(1, out, n)
    likha("\n")
    n = roop_ank_aadhar2(255, 1, out)
    likha(n)
    likha("\n")
    # flags: prefix + upper together (0x + FF)
    n = roop_ank_dhvaj(255, 16, 3, out)
    likha(1, out, n)
    likha("\n")
}
