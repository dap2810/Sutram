ayojan fmt
mukhya() {
    vitti out = nirmmita(128)
    vitti n = 0
    # decimal, negative
    n = fmt_dec(0 - 255, out)
    likha(1, out, n)
    likha("\n")
    # hex lower / upper
    n = fmt_hex(255, out)
    likha(1, out, n)
    likha("\n")
    n = fmt_hex_upper(255, out)
    likha(1, out, n)
    likha("\n")
    # prefixed, negative + upper digits, prefix stays lowercase
    n = fmt_int_pre(255, 16, 0, out)
    likha(1, out, n)
    likha("\n")
    n = fmt_int_pre(0 - 255, 16, 1, out)
    likha(1, out, n)
    likha("\n")
    # binary + prefix, octal
    n = fmt_bin(5, out)
    likha(1, out, n)
    likha("\n")
    n = fmt_int_pre(5, 2, 0, out)
    likha(1, out, n)
    likha("\n")
    n = fmt_oct(511, out)
    likha(1, out, n)
    likha("\n")
    n = fmt_int_pre(511, 8, 0, out)
    likha(1, out, n)
    likha("\n")
    # base 36, zero, bad base
    n = fmt_int_base(35, 36, out)
    likha(1, out, n)
    likha("\n")
    n = fmt_int_base(36, 36, out)
    likha(1, out, n)
    likha("\n")
    n = fmt_dec(0, out)
    likha(1, out, n)
    likha("\n")
    n = fmt_int_base(255, 1, out)
    likha(n)
    likha("\n")
    # flags: prefix + upper together (0x + FF)
    n = fmt_int_flags(255, 16, 3, out)
    likha(1, out, n)
    likha("\n")
}
