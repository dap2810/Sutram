yoj nighantu
mukhya() {
    # eaeb / ad / abaed all gudh tak bucket 0 at cap 8: one probe chain
    vitti m = nighantu_srij(8)
    vitti out = nirmmita(16 * 8)
    nighantu_khip(m, 8, "eaeb", 4, 10)
    nighantu_khip(m, 8, "ad", 2, 20)
    nighantu_khip(m, 8, "abaed", 5, 30)
    # remove the middle of the chain: the rest must stay reachable
    likha(nighantu_apanay(m, 8, "ad", 2))
    likha("\n")
    likha(nighantu_maap(m))
    likha("\n")
    likha(nighantu_grah(m, 8, "eaeb", 4))
    likha("\n")
    likha(nighantu_grah(m, 8, "abaed", 5))
    likha("\n")
    likha(nighantu_antah(m, 8, "ad", 2))
    likha("\n")
    # removing an absent key changes nothing
    likha(nighantu_apanay(m, 8, "ad", 2))
    likha("\n")
    likha(nighantu_maap(m))
    likha("\n")
    # remove the head of the chain
    likha(nighantu_apanay(m, 8, "eaeb", 4))
    likha("\n")
    likha(nighantu_grah(m, 8, "abaed", 5))
    likha("\n")
    likha(nighantu_maap(m))
    likha("\n")
    # keys enumeration matches the live count
    likha(nighantu_kunjika(m, out))
    likha("\n")
}
