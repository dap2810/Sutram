yoj vakyank
mukhya() {
    vitti buf = nirmmita(30 * 8)
    vitti ok = nirmmita(1 * 8)
    # positive
    vitti n1 = ank_tak_varna(12345, buf)
    likha(n1)
    likha("\n")
    likha(varna_tak_ank(buf, n1, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
    # negative
    vitti n2 = ank_tak_varna(0 - 987, buf)
    likha(n2)
    likha("\n")
    likha(varna_tak_ank(buf, n2, ok))
    likha("\n")
    # zero
    vitti n3 = ank_tak_varna(0, buf)
    likha(n3)
    likha("\n")
    likha(buf[0])
    likha("\n")
    # malformed: empty
    likha(varna_tak_ank(buf, 0, ok))
    likha("\n")
    likha(ok[0])
    likha("\n")
}
