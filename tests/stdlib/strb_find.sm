ayojan string
mukhya() {
    likha(strb_find("hello world", "world"))
    likha("\n")
    likha(strb_contains("hello world", "world"))
    likha("\n")
    likha(strb_find("hello world", "xyz"))
    likha("\n")
    likha(strb_find("hello", ""))
    likha("\n")
    likha(strb_len("hello"))
    likha("\n")
}
