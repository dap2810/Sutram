yoj shreni
mukhya() {
    mala a[4]
    a[0] = 4
    a[1] = 1
    a[2] = 3
    a[3] = 2
    shankh_shreni(a, 4)
    chakra i = 0 tak 3 {
        likha(a[i])
    }
    likha("\n")
    mala b[5]
    b[0] = 9
    b[1] = 7
    b[2] = 5
    b[3] = 3
    b[4] = 1
    shankh_shreni(b, 5)
    chakra j = 0 tak 4 {
        likha(b[j])
    }
    likha("\n")
}
