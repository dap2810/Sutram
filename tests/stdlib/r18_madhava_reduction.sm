# R18 (R15-03 witnesses): the argument reduction's lower half and atan's negative
# branch. No proof reached them; a sign error there passed every proof.
yoj madhava
mukhya() {
    likha(madhava_sin(3.0))
    likha("\n")
    likha(madhava_sin(0.0 - 18.0))
    likha("\n")
    likha(madhava_sin(0.0 - 4.0))
    likha("\n")
    likha(madhava_cos(2.0))
    likha("\n")
    likha(madhava_cos(0.0 - 18.0))
    likha("\n")
    likha(madhava_cos(0.0 - 4.0))
    likha("\n")
    likha(madhava_atan(0.0 - 20.0))
    likha("\n")
    likha(madhava_atan(0.0 - 1.5))
    likha("\n")
    likha(madhava_atan(20.0))
    likha("\n")
}
