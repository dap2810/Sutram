ayojan sankhyiki
mukhya() {
    pankti a[3]
    a[0] = 3
    a[1] = 1
    a[2] = 2
    likha(purna_vyapti(a, 3))
    likha("\n")
    pankti b[2]
    b[0] = 0 - 5
    b[1] = 5
    likha(purna_vyapti(b, 2))
    likha("\n")
    pankti c[1]
    c[0] = 9
    likha(purna_vyapti(c, 1))
    likha("\n")
    likha(purna_vyapti(a, 0))
    likha("\n")
}
