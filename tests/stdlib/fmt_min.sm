yoj roop
mukhya() {
    vitti out = nirmmita(80 * 8)
    vitti minv = (0 - 9223372036854775807) - 1
    vitti n = roop_ank_aadhar2(minv, 10, out)
    likha(n)
    likha("\n")
    vitti i = 0
    yavat (i < n) {
        likha(akshar(out, i))
        likha("\n")
        i = i + 1
    }
    vitti m = roop_ank_aadhar2(minv, 16, out)
    likha(m)
    likha("\n")
    i = 0
    yavat (i < m) {
        likha(akshar(out, i))
        likha("\n")
        i = i + 1
    }
    vitti k = roop_ank_dhvaj(minv, 16, 1, out)
    likha(k)
    likha("\n")
    i = 0
    yavat (i < k) {
        likha(akshar(out, i))
        likha("\n")
        i = i + 1
    }
    vitti d = roop_ank_aadhar(0 - 5, 10, 0, out)
    likha(d)
    likha("\n")
    likha(akshar(out, 0))
    likha("\n")
    vitti g = roop_ank(minv, out)
    likha(g)
    likha("\n")
    i = 0
    yavat (i < g) {
        likha(akshar(out, i))
        likha("\n")
        i = i + 1
    }
    vitti b = roop_ank_aadhar2(minv, 2, out)
    likha(b)
    likha("\n")
    likha(akshar(out, 0))
    likha("\n")
    likha(akshar(out, 1))
    likha("\n")
    likha(akshar(out, 64))
    likha("\n")
    likha("fmt-min-done\n")
}
