yoj phal
# Early-return chain (R30 WS3): multi-step checked computation
# that propagates the first failure by returning at once.
prakriya safe_compute(out, a, b, c) {
    # (a + b) * c, checked; early return on the first failure.
    vitti t = nirmmita(2 * 8)
    phal_janchit_yuj(t, a, b)
    yadi (phal_asti_siddhi(t) == 0) {
        phal_dosh(out)
        prati 0
    }
    phal_janchit_gun(out, phal_mulya(t), c)
    prati phal_asti_siddhi(out)
}

prakriya safe_pow_fact(out, a, e) {
    # kramgun(pow(a, e)), checked; early return on the first failure.
    vitti t = nirmmita(2 * 8)
    phal_janchit_ghat(t, a, e)
    yadi (phal_asti_siddhi(t) == 0) {
        phal_dosh(out)
        prati 0
    }
    phal_janchit_kramgun(out, phal_mulya(t))
    prati phal_asti_siddhi(out)
}

mukhya() {
    vitti r = nirmmita(2 * 8)
    vitti minv = (0 - 9223372036854775807) - 1
    # new producers
    likha(phal_janchit_ghat(r, 2, 10))
    likha("\n")
    likha(phal_mulya(r))
    likha("\n")
    likha(phal_janchit_ghat(r, 2, 63))
    likha("\n")
    likha(phal_asti_siddhi(r))
    likha("\n")
    likha(phal_janchit_ghat(r, 2, 0 - 1))
    likha("\n")
    likha(phal_janchit_kramgun(r, 20))
    likha("\n")
    likha(phal_mulya(r))
    likha("\n")
    likha(phal_janchit_kramgun(r, 21))
    likha("\n")
    likha(phal_janchit_kramgun(r, 0 - 1))
    likha("\n")
    likha(phal_janchit_nirapeksh(r, 0 - 5))
    likha("\n")
    likha(phal_mulya(r))
    likha("\n")
    likha(phal_janchit_nirapeksh(r, minv))
    likha("\n")
    # add -> mul chain: success, add-fail, mul-fail
    likha(safe_compute(r, 10, 20, 3))
    likha("\n")
    likha(phal_mulya(r))
    likha("\n")
    likha(safe_compute(r, 9223372036854775807, 1, 3))
    likha("\n")
    likha(phal_asti_siddhi(r))
    likha("\n")
    likha(safe_compute(r, 10, 20, 4611686018427387904))
    likha("\n")
    likha(phal_asti_siddhi(r))
    likha("\n")
    # pow -> kramgun chain: success, pow-fail, kramgun-fail
    likha(safe_pow_fact(r, 2, 3))
    likha("\n")
    likha(phal_mulya(r))
    likha("\n")
    likha(safe_pow_fact(r, 2, 63))
    likha("\n")
    likha(phal_asti_siddhi(r))
    likha("\n")
    likha(safe_pow_fact(r, 3, 5))
    likha("\n")
    likha(phal_asti_siddhi(r))
    likha("\n")
    likha("result-chain-done\n")
}
