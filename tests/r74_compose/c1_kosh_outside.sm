# R74 composition 1: a block inside a loop, growing a kosh declared OUTSIDE the block.
# The kosh and its growth are persistent; the block's scratch is released every pass.
# Prints the kosh's length, its sum, and its first and last element.
mukhya()
    kosh k[1]
    vitti i = 0
    yavat (i < 1000000)
        mandapa
            vitti b = nirmmita(64)
            b[0] = i
            b[7] = i * 2
            kosh_push(k, b[0] + b[7])
        i = i + 1
    likha(kosh_len(k), "\n")
    vitti s = 0
    vitti j = 0
    yavat (j < kosh_len(k))
        s = s + k[j]
        j = j + 1
    likha(s, "\n")
    likha(k[0], " ", k[999999], "\n")
