# R74 composition 1, control: the same program with the block replaced by yadi (1 == 1).
mukhya()
    kosh k[1]
    vitti i = 0
    yavat (i < 1000000)
        yadi (1 == 1)
            vitti b = nirmmita(64)
            b[0] = i
            b[7] = i * 2
            kosh_push(k, b[0] + b[7])
        i = i + 1
    likha(kosh_len(k), "\n")
    vitti s = 0
    vitti j = 0
    yavat (j < kosh_len(k))
        s = s + k[j]
        j = j + 1
    likha(s, "\n")
    likha(k[0], " ", k[999999], "\n")
