# R74 composition 5: a prakriya with a block inside, recursing 1,000 deep, the whole descent
# repeated 1,000 times (1,000,000 blocks). Each frame checks after the inner calls return that
# its own buffer still holds its own number (the mark is per frame); the sum proves every frame ran.
prakriya gahan(n)
    yadi (n == 0)
        nivartanam 0
    vitti r = 0
    mandapa
        vitti b = nirmmita(64)
        b[0] = n
        b[7] = n * 3
        r = gahan(n - 1)
        yadi (b[0] != n || b[7] != n * 3)
            nivartanam 0 - 1000000000
        r = r + b[0]
    nivartanam r

mukhya()
    vitti k = 0
    vitti s = 0
    yavat (k < 1000)
        s = s + gahan(1000)
        k = k + 1
    likha(s, "\n")
