mukhya() {
    vitti b = nirmmita(128)
    smaran(b, 0, 128)
    likh8(b, 258)
    likha(pad8(b))
    likha(pad(b))
    likh(b + 8, 66)
    likha(pad8(b + 8))
    likh8c(b + 16, 77, b + 128)
    likha(pad8c(b + 16, b + 128))
    likha(pad8c(b + 128, b + 128))
    akshar_rakh(b, 24, 65)
    likha(akshar(b, 24))
    likha(aksharank(b, 24))
    smaran_cp(b + 32, "OK", 3)
    likha(akshar(b, 32))
    likha(akshar(b, 33))
    vartani_cp(b + 48, "YES")
    likha(akshar(b, 48))
    vartani_cat(b + 48, "!")
    likha(vartani_len(b + 48))
}
