# R63 native typed kosh builtins: clear, empty, peek, enqueue.
mukhya() {
    kosh a[1]
    likha(kosh_empty(a))
    likha(kosh_clear(a))
    likha(kosh_empty(a))
    likha(kosh_enqueue(a, 10))
    likha(kosh_peek(a))
    likha(kosh_len(a))
    likha(kosh_push(a, 20))
    likha(kosh_peek(a))
    likha(kosh_pop(a))
    likha(kosh_len(a))
    likha(kosh_clear(a))
    likha(kosh_empty(a))
    likha(kosh_len(a))
    likha(kosh_cap(a))
    likha(kosh_enqueue(a, 30))
    likha(kosh_peek(a))
    likha(kosh_len(a))
}
