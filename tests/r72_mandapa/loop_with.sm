# R72 pair 3 (with): a block holding a loop that allocates, in a prakriya that
# returns a scalar computed in the block (allowed: the value, not the address).
prakriya yoga(n)
    vitti t = 0
    mandapa
        vitti i = 0
        yavat (i < n)
            vitti b = nirmmita(64)
            b[0] = i
            t = t + b[0]
            i = i + 1
        nivartanam t
    nivartanam 0

mukhya()
    likha(yoga(100), "\n")
