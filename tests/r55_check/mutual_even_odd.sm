# R55: two-function mutual recursion, tighter cycle than the Muse R12 triple.
prakriya is_even(n);
prakriya is_odd(n);

prakriya is_even(n) {
    yadi (n == 0) { pratiyati 1 }
    pratiyati is_odd(n - 1)
}

prakriya is_odd(n) {
    yadi (n == 0) { pratiyati 0 }
    pratiyati is_even(n - 1)
}

mukhya() {
    likha(is_even(12))
    likha(is_odd(11))
    likha(is_even(7))
    likha(is_odd(8))
}
