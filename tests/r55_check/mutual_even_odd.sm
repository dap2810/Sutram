# R55: two-function mutual recursion, tighter cycle than the Muse R12 trigun.
prakriya asti_yugm(n);
prakriya asti_visham(n);

prakriya asti_yugm(n) {
    yadi (n == 0) { nivartanam 1 }
    nivartanam asti_visham(n - 1)
}

prakriya asti_visham(n) {
    yadi (n == 0) { nivartanam 0 }
    nivartanam asti_yugm(n - 1)
}

mukhya() {
    likha(asti_yugm(12))
    likha(asti_visham(11))
    likha(asti_yugm(7))
    likha(asti_visham(8))
}
