# R136: Muse R136's probe r136_ws2_dasham_param (Muse-to-Sarvam/r136_ws2_dasham_param.sm, unchanged below). v306 and v307 compile the escapes; v308 refuses them.
prakriya use_dasham(dasham d, kosh k) {
    kosh_kship(k, 99)
    vitti addr = d[0]
    addr[0] = 77
    nivartanam addr[0]
}
mukhya() {
    kosh k[1]
    kosh_kship(k, 7)
    vitti obstacle = nirmmita(16)
    likha(use_dasham(k[0:1], k))
    likha(k[0])
}
