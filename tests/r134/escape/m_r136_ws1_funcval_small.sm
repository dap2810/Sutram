# R136: Muse R136's probe r136_ws1_funcval_small (Muse-to-Sarvam/r136_ws1_funcval_small.sm, unchanged below). v306 and v307 compile the escapes; v308 refuses them.
prakriya badal(vibhag s, ignored) {
    s[0] = 99
    nivartanam 0
}
mukhya() {
    kosh k[1]
    kosh_kship(k, 7)
    vitti obstacle = nirmmita(16)
    vitti f = badal
    likha(f(k[0:1], kosh_kship(k, 8)))
    likha(k[0])
}
