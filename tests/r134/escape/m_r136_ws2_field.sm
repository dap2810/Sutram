# R136: Muse R136's probe r136_ws2_field (Muse-to-Sarvam/r136_ws2_field.sm, unchanged below). v306 and v307 compile the escapes; v308 refuses them.
rachana Box = { s }
mukhya() {
    kosh k[1]
    kosh_kship(k, 7)
    vitti obstacle = nirmmita(16)
    vitti b = nirmmita(8)
    b.s = k[0:1]
    kosh_kship(k, 8)
    k[0] = 99
    vitti s = b.s
    vitti addr = s[0]
    likha(addr[0])
    likha(k[0])
}
