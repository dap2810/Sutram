# R136: Muse R136's probe r136_ws2_rawmem (Muse-to-Sarvam/r136_ws2_rawmem.sm, unchanged below). v306 and v307 compile the escapes; v308 refuses them.
mukhya() {
    kosh k[1]
    kosh_kship(k, 7)
    vitti obstacle = nirmmita(16)
    vitti p = nirmmita(16)
    p[0] = k[0:1]
    kosh_kship(k, 8)
    k[0] = 99
    vitti s = p[0]
    vitti addr = s[0]
    likha(addr[0])
    likha(k[0])
}
