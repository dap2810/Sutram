# R136: Muse R136's probe r136_ws2_dasham_diag (Muse-to-Sarvam/r136_ws2_dasham_diag.sm, unchanged below). v306 and v307 compile the escapes; v308 refuses them.
prakriya show_dasham(dasham d) {
    likha(d)
    nivartanam 0
}
mukhya() {
    kosh k[1]
    kosh_kship(k, 7)
    vitti obstacle = nirmmita(16)
    likha(show_dasham(k[0:1]))
}
