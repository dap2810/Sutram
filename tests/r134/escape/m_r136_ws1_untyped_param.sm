# R136: Muse R136's probe r136_ws1_untyped_param (Muse-to-Sarvam/r136_ws1_untyped_param.sm, unchanged below). v306 and v307 compile the escapes; v308 refuses them.
prakriya use_untyped(x, kosh k) {
    kosh_kship(k, 99)
    vitti addr = x[0]
    addr[0] = 77
    nivartanam addr[0]
}
mukhya() {
    kosh k[1]
    kosh_kship(k, 7)
    vitti obstacle = nirmmita(16)
    likha(use_untyped(k[0:1], k))
    likha(k[0])
}
