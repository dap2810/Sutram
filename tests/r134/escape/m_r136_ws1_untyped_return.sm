# R136: Muse R136's probe r136_ws1_untyped_return (Muse-to-Sarvam/r136_ws1_untyped_return.sm, unchanged below). v306 and v307 compile the escapes; v308 refuses them.
prakriya keep(x) {
    nivartanam x
}
mukhya() {
    kosh k[1]
    kosh_kship(k, 7)
    vitti obstacle = nirmmita(16)
    vitti t = keep(k[0:1])
    kosh_kship(k, 8)
    k[0] = 99
    vitti addr = t[0]
    likha(addr[0])
    likha(k[0])
}
