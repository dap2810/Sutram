+# '+', no "inf"/"nan" — those are ok = 0 (same conventions as
+# str_to_int). On success ok[0] = 1 and the dasham value is returned.
+# On malformed input or overflow (|value| > ~1.8e308) ok[0] = 0 and the
+# return is 0.0. Extreme underflow returns 0.0 with ok[0] = 1 (as
+# strtod does). Mantissa is accumulated in int64 (up to 18 significant
+# digits); further digits only move the decimal exponent.
+prakriya str_to_float(buf, n, ok) {
+    vitti src = buf
+    vitti cnt = n
+    vitti okp = ok
+    okp[0] = 1
+    yadi (cnt == 0) {
+        okp[0] = 0
+        pratiyati 0.0
+    }
+    vitti neg = 0
+    vitti p = 0
+    yadi (src[0] == 45) {
+        neg = 1
+        p = 1
+        yadi (cnt == 1) {
+            okp[0] = 0
+            pratiyati 0.0
+        }
+    }
+    vitti mant = 0
+    vitti ndig = 0
+    vitti exp10 = 0
+    vitti seen = 0
+    vitti done = 0
+    yavat ((p < cnt) && (done == 0)) {
+        vitti c1 = src[p]
+        yadi ((c1 == 46) || (c1 == 101) || (c1 == 69)) {
+            done = 1
+        } anyatra {
+            yadi (c1 < 48) {
+                okp[0] = 0
+                pratiyati 0.0
+            }
+            yadi (c1 > 57) {
+                okp[0] = 0
+                pratiyati 0.0
+            }
+            yadi (ndig < 18) {
+                mant = mant * 10 + (c1 - 48)
+                ndig = ndig + 1
+            } anyatra {
+                exp10 = exp10 + 1
+            }
+            seen = seen + 1
+            p = p + 1
+        }
+    }
+    yadi (p < cnt) {
+        yadi (src[p] == 46) {
+            p = p + 1
+            done = 0
+            yavat ((p < cnt) && (done == 0)) {
+                vitti c2 = src[p]
+                yadi ((c2 == 101) || (c2 == 69)) {
+                    done = 1
+                } anyatra {
+                    yadi (c2 < 48) {
+                        okp[0] = 0
+                        pratiyati 0.0
+                    }
+                    yadi (c2 > 57) {
+                        okp[0] = 0
+                        pratiyati 0.0
+                    }
+                    yadi (ndig < 18) {
+                        mant = mant * 10 + (c2 - 48)
+                        ndig = ndig + 1
+                        exp10 = exp10 - 1
+                    }
+                    seen = seen + 1
+                    p = p + 1
+                }
+            }
+        }
+    }
+    yadi (seen == 0) {
+        okp[0] = 0
+        pratiyati 0.0
+    }
+    yadi (p < cnt) {
+        yadi (src[p] == 101) {
+            p = p + 1
+        } anyatra {
+            yadi (src[p] == 69) {
+                p = p + 1
+            } anyatra {
+                okp[0] = 0
+                pratiyati 0.0
+            }
+        }
+        vitti eneg = 0
+        yadi (p < cnt) {
+            yadi (src[p] == 45) {
+                eneg = 1
+                p = p + 1
+            }
+        }
+        yadi (p >= cnt) {
+            okp[0] = 0
+            pratiyati 0.0
+        }
+        vitti e = 0
+        vitti eseen = 0
+        yavat (p < cnt) {
+            vitti c3 = src[p]
+            yadi (c3 < 48) {
+                okp[0] = 0
+                pratiyati 0.0
+            }
+            yadi (c3 > 57) {
+                okp[0] = 0
+                pratiyati 0.0
+            }
+            yadi (e < 1000) {
+                e = e * 10 + (c3 - 48)
+            }
+            eseen = eseen + 1
+            p = p + 1
+        }
+        yadi (eseen == 0) {
+            okp[0] = 0
+            pratiyati 0.0
+        }
+        yadi (eneg == 1) {
+            exp10 = exp10 - e
+        } anyatra {
+            exp10 = exp10 + e
+        }
+    }
+    yadi (p != cnt) {
+        okp[0] = 0
+        pratiyati 0.0
+    }
+    yadi (mant == 0) {
+        pratiyati 0.0
+    }
+    yadi (exp10 > 308) {
+        okp[0] = 0
+        pratiyati 0.0
+    }
+    yadi (exp10 < -308) {
+        pratiyati 0.0
+    }
+    dasham val = mant
+    yadi (exp10 > 0) {
+        vitti k = 0
+        yavat (k < exp10) {
+            val = val * 10.0
+            k = k + 1
+        }
+    } anyatra {
+        vitti k2 = 0
+        yavat (k2 < (0 - exp10)) {
+            val = val / 10.0
+            k2 = k2 + 1
+        }
+    }
+    yadi (neg == 1) { val = 0.0 - val }
+    pratiyati val
+}
