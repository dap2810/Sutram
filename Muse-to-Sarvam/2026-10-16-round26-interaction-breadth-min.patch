+    def lit(v):
+        return "maxv" if v == maxv else ("minv" if v == minv else
+                                         (f"(0 - {-v})" if v < 0 else str(v)))
+
+    def trunc_div(a, b):
+        q = abs(a) // abs(b)
+        return q if (a < 0) == (b < 0) else -q
+
+    def trunc_mod(a, b):
+        return a - trunc_div(a, b) * b
+
