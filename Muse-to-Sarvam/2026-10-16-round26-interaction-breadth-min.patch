+def _base_repr(n, b):
+    digits = "0123456789abcdefghijklmnopqrstuvwxyz"
+    if n == 0:
+        return "0"
+    out = ""
+    while n > 0:
+        out = digits[n % b] + out
+        n //= b
+    return out
