mukhya() {
    likha("before ", parimana(), "\n")
    mandapa {
        kosh k[1]
        kosh_push(k, 7)
        likha("cap1 ", parimana(), "\n")
        kosh_push(k, 8)
        likha("cap2 ", parimana(), "\n")
        kosh_push(k, 9)
        likha("cap4 ", parimana(), "\n")
    }
    likha("after ", parimana(), "\n")
}
