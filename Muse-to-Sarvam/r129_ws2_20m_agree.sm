mukhya() {
    kosh k[4]
    vitti a = k
    vitti i = 0
    yavat (i < 20000000) {
        kosh_kship(k, i)
        i = i + 1
    }
    vitti bad = 0
    i = 0
    yavat (i < 20000000) {
        yadi (a[i] != k[i]) {
            bad = bad + 1
        }
        i = i + 1
    }
    likha(a[0])
    likha(k[0])
    likha(a[19999999])
    likha(k[19999999])
    likha(bad)
}
