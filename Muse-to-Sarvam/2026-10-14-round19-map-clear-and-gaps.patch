+    needle = "".join(rng.choice(alpha) for _ in range(rng.randint(1, 3)))
+    src = "".join(rng.choice(alpha) for _ in range(rng.randint(0, 8)))
+
+    def lit(v):
+        return f"(0 - {-v})" if v < 0 else str(v)
+
+    # Python non-overlapping count
