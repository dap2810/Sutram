prakriya yog(vibhag s) {
    vitti t = 0
    chakra i = 0 tak pankti_gan(s) - 1 {
        t = t + s[i]
    }
    nivartanam t
}
mukhya() {
    kosh k[4]
    kosh_kship(k, 10)
    kosh_kship(k, 20)
    kosh_kship(k, 30)
    kosh_kship(k, 40)
    kosh_kship(k, 50)
    likha(yog(k[2:5]))
    likha(pankti_gan(k[2:5]))
    likha(yog(k[2:]))
    likha(pankti_gan(k[2:]))
}
