mukhya() {
    kosh a[3]
    kosh_push(a, 5)
    kosh_push(a, 6)
    kosh_push(a, 7)
    likha(sankhya_bindu(a, a, 3))
    kosh b[2]
    kosh_push(b, 4)
    kosh_push(b, 5)
    kosh c[3]
    kosh_push(c, 1)
    kosh_push(c, 2)
    kosh_push(c, 3)
    likha(sankhya_bindu(c, b, 2))
    kosh e[1]
    likha(sankhya_bindu(e, e, 0))
    mala m[3]
    m[0] = 5
    m[1] = 6
    m[2] = 7
    likha(sankhya_bindu(m, m, 3))
}
