+def _fmt_group_py(digits, indian):
+    """Python mirror of the grouping rules, digits only (no sign/dot)."""
+    if len(digits) <= 3:
+        return digits
+    parts = []
+    if indian:
+        # rightmost group 3, then 2s
+        rest = digits[:-3]
+        parts.append(digits[-3:])
+        while rest:
+            parts.append(rest[-2:])
+            rest = rest[:-2]
+    else:
+        rest = digits
+        while len(rest) > 3:
+            parts.append(rest[-3:])
+            rest = rest[:-3]
+        parts.append(rest)
+    return ",".join(reversed(parts))
+
