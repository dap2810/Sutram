+        lines.append('        likha("FAIL merge assoc value\\n")')
+        lines.append("        pratiyati 1")
+        lines.append("    }")
+        lines.append(f'    yadi (map_get(m1, 16, "{k}", {len(k)}) != {lit(v)}) {{')
+        lines.append('        likha("FAIL merge src-wins\\n")')
+        lines.append("        pratiyati 1")
