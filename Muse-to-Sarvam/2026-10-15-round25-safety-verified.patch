+    lines.append("    map_merge(tmp, 16, a, 8)")
+    lines.append("    map_merge(tmp, 16, b, 8)")
+    lines.append("    map_merge(m1, 16, tmp, 16)")
+    lines.append("    map_merge(m1, 16, c, 8)")
+    lines.append("    map_merge(tmp2, 16, b, 8)")
