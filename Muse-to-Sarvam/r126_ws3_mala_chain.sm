yoj mala
mukhya() {
    vitti m = mala_nava(1024)
    vitti i = 0
    yavat (i < 1024) {
        m[i] = i + 1
        i = i + 1
    }
    m[1023] = 0
    vitti p = 0
    vitti s = 0
    vitti j = 0
    yavat (j < 10000000) {
        p = m[p]
        s = s + p
        j = j + 1
    }
    likha(s)
    likha("\n")
}
