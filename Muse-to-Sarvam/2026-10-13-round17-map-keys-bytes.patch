+ayojan map
+ayojan strb
+# seg_found(buf, nk, key, keyn) — 1 if any of the nk length-prefixed
+# byte segments in buf equals (key, keyn).
+prakriya seg_found(buf, nk, key, keyn) {
+    vitti pos = 0
+    vitti i = 0
+    vitti seglen = 0
+    yavat (i < nk) {
+        seglen = char_at(buf, pos)
+        yadi (seglen == keyn) {
+            yadi (strb_compare(buf + pos + 1, seglen, key, keyn) == 0) { pratiyati 1 }
+        }
+        pos = pos + 1 + seglen
+        i = i + 1
+    }
+    pratiyati 0
+}
+mukhya() {
+    vitti m = map_init(8)
+    map_put(m, 8, "apple", 5, 1)
+    map_put(m, 8, "fig", 3, 2)
+    map_put(m, 8, "pear", 4, 3)
+    map_put(m, 8, "abcdefghijklmnopqrstuvwxyz123456", 32, 4)
+    vitti tmp = nirmmita(8 * 33 + 1)
+    vitti nk = map_keys_bytes(m, tmp)
+    likha(nk)
+    likha("\n")
+    # total bytes: (1+5) + (1+3) + (1+4) + (1+32) = 48
+    vitti pos = 0
+    vitti i = 0
+    vitti total = 0
+    yavat (i < nk) {
+        total = total + 1 + char_at(tmp, pos)
+        pos = pos + 1 + char_at(tmp, pos)
+        i = i + 1
+    }
+    likha(total)
+    likha("\n")
+    yadi (seg_found(tmp, nk, "apple", 5) == 1) {
+        likha("found apple\n")
+    }
+    yadi (seg_found(tmp, nk, "fig", 3) == 1) {
+        likha("found fig\n")
+    }
+    yadi (seg_found(tmp, nk, "pear", 4) == 1) {
