yoj suchi
mukhya() {
    vitti l = suchi_srij(4)
    vitti m = nirmmita(8)
    m[0] = 777
    suchi_khip(l, 11)
    suchi_khip(l, 22)
    suchi_khip(l, 33)
    suchi_khip(l, 44)
    likha(m[0])
    likha("\n")
    likha(suchi_grah(l, 0))
    likha("\n")
    likha(suchi_grah(l, 1))
    likha("\n")
    likha(suchi_grah(l, 2))
    likha("\n")
    likha(suchi_grah(l, 3))
    likha("\n")
    vitti q = avali_srij(4)
    vitti n = nirmmita(8)
    n[0] = 777
    avali_pravesh(q, 11)
    avali_pravesh(q, 22)
    avali_pravesh(q, 33)
    avali_pravesh(q, 44)
    likha(n[0])
    likha("\n")
    vitti ok = nirmmita(8)
    likha(avali_nishkas(q, ok))
    likha("\n")
    likha(avali_nishkas(q, ok))
    likha("\n")
    likha(avali_nishkas(q, ok))
    likha("\n")
    likha(avali_nishkas(q, ok))
    likha("\n")
}
