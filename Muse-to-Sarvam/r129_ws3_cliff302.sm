mukhya() {
    kosh k[4]
    kosh_kship(k, 41)
    vitti a = k
    vitti i = 0
    yavat (i < 4194305) {
        kosh_kship(k, i)
        i = i + 1
    }
    k[0] = 99
    likha(a[0])
    i = 0
    yavat (i < 15805695) {
        kosh_kship(k, i)
        i = i + 1
    }
    k[0] = 88
    likha(a[0])
    likha(k[0])
}
