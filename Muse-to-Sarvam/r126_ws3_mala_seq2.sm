yoj mala
mukhya() {
    vitti m = mala_nava(1024)
    vitti i = 0
    yavat (i < 1024) {
        m[i] = i
        i = i + 1
    }
    vitti s = 0
    vitti idx = 0
    vitti j = 0
    yavat (j < 10000000) {
        s = s + m[idx]
        idx = idx + 1
        yadi (idx == 1024) {
            idx = 0
        }
        j = j + 1
    }
    likha(s)
    likha("\n")
}
