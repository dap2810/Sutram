; ============================================================
; Sutram Compiler — Sutram Compiler — Sanskrit → x86-64
; ============================================================
; Pure x86-64 assembly. No libc, no C, no Python.
; Reads .sk source, produces a raw ELF executable.
;
; CALLING CONVENTION:
;   - Arguments in rdi, rsi, rdx, rcx, r8, r9
;   - Return value in rax
;   - Callee-saved: rbx, r12, r13, r14, r15, rbp
;   - Caller-saved: rax, rcx, rdx, rsi, rdi, r8-r11
;   - Every function must push/pop any callee-saved reg it uses
;   - Stack must be 16-byte aligned before every CALL
;
; Build: nasm -f elf64 Sutram Compiler -o sc.o && ld -o sc sc.o
; Run:   ./Sutram compiler input.sk output.bin
; ============================================================

BITS 64

BASE_ADDR    equ 0x400000
ELF_HDR_SIZE equ 64
PHDR_SIZE    equ 56
HEADERS_SIZE equ 120
TOKEN_SIZE   equ 40
R4_SEEN_CAP  equ 8192
R4_PEND_CAP  equ 256
R7_CLOSED_CAP equ 1024
R7_CALL_CAP  equ 8192
R7_DEF_CAP   equ 2048
TOKEN_CAP    equ 65537      ; max one token per source byte + EOF
STR_POOL_CAP equ 65537      ; max lexeme bytes + terminators for 64 KiB source
IMPORT_BUF_CAP equ 65536    ; expanded source cannot exceed source_buf
AST_NODE_SIZE equ 72
BLOCK_STMT_CAP equ 256        ; B11: max statements stored in one AST_BLOCK
AST_BLOCK_EXTRA equ (BLOCK_STMT_CAP * 8) - (AST_NODE_SIZE - 16)
AST_HEAP_CAP equ 3145728      ; R53: 3 MiB compile-time AST heap for expanded modern stdlib (no runtime/codegen ABI change)
FUNC_PARAMS_CAP equ 8192      ; 1024 parameter-name slots; >= 128 funcs * 6 args
VAR_TABLE_CAP equ 256         ; entries; 16 bytes each
FUNC_TABLE_CAP equ 128        ; entries; matches func_defs capacity
PATCH_LIST_CAP equ 512        ; entries; 16 bytes each
FUNC_DEFS_CAP equ 128         ; entries; 8 bytes each
CODE_BUF_CAP equ 262144       ; generated machine-code bytes; 4x guarded headroom
BLOB_CALL_CAP equ CODE_BUF_CAP / 5 + 1 ; R34: every runtime call is 5 code bytes, so this never fills
BREAK_PATCH_CAP equ 1024      ; active break patch entries across nested loops
CONTINUE_PATCH_CAP equ 1024   ; active continue patch entries across nested loops
RACHANA_CAP equ 16            ; 256-byte entries in 4096-byte table
RACHANA_FIELDS_CAP equ 15     ; 16-byte header + 15*16-byte fields = 256 bytes
BLOCK_NESTING_CAP equ 128     ; parser recursion guard for nested blocks
EXPR_NESTING_CAP  equ 1024    ; R17 R6: parser recursion guard for nested expressions ( ( ( ... ) ) )
NS_FUNC_CAP equ 128         ; max exported user functions in an aliased module
NS_FUNC_NAME_CAP equ 63    ; max function name bytes for module rewrite
NS_ALIAS_CAP equ 31        ; ASCII alias bound, excluding terminator
IMPORT_NAMES_CAP equ 16       ; 64-byte dedupe slots
KOSH_VAR_CAP equ 256          ; growable-array names tracked per generated scope
KOSH_PARAM_VAR_CAP equ 6      ; user functions accept at most six parameters
PARAM_RAW equ 0               ; untyped/integer scalar parameter
PARAM_DASHAM equ 1            ; scalar IEEE-754 binary64 parameter
PARAM_KOSH equ 2              ; integer/raw-qword growable-array parameter
PARAM_KOSH_DASHAM equ 3       ; binary64 growable-array parameter
PARAM_VIBHAG equ 4            ; R23 WS3: a slice (descriptor pointer) parameter

; Token types
TOK_KEYWORD   equ 1
TOK_IDENT     equ 2
TOK_NUMBER    equ 3
TOK_OPERATOR  equ 4
TOK_DELIMITER equ 5
TOK_BUILTIN   equ 6
TOK_EOF       equ 0
TOK_STRING    equ 7
TOK_FLOAT     equ 8    ; T12 IEEE-754 binary64 literal

; AST node types
AST_NUM       equ 1
AST_VAR       equ 2
AST_ASSIGN    equ 3
AST_BINOP     equ 4
AST_IF        equ 5
AST_WHILE     equ 6
AST_RETURN    equ 7
AST_CALL      equ 8
AST_DECL      equ 9
AST_BLOCK     equ 10
AST_FUNC      equ 11
AST_HALT      equ 12
AST_WRITEMEM  equ 13
AST_STR       equ 14
AST_VEC       equ 15
AST_FUNCDEF   equ 16
AST_FUNCALL   equ 17
AST_INDEX     equ 18    ; array read: [type][name_ptr][index_node]
AST_FIELD     equ 19    ; field access: [type][name_ptr][field_offset]
AST_FOR       equ 20    ; for loop: [type][var_name][start_expr][end_expr][body][0]
AST_BREAK     equ 21    ; break: [type][0][0][0][0]
AST_CONTINUE  equ 22    ; continue: [type][0][0][0][0]
AST_ASSERT    equ 23    ; assert: [type][cond_expr][0][0][0]
AST_TERNARY   equ 27    ; conditional expr: [type][cond][true_expr][false_expr]
AST_DO_WHILE  equ 28    ; do-while stmt: [type][body][cond]
AST_FLOAT     equ 29    ; T12 IEEE-754 binary64 bits in field1
AST_FUNCREF   equ 40    ; R23 WS1: a prakriya name as a value: [type][name_ptr]
AST_SLICE     equ 41    ; R23 WS3: base[lo:hi]: [type][base_name][lo][hi][desc_offset]
AST_PRASAR    equ 42    ; R25: prasar call: [type][AST_FUNCALL]
R28_RELOC_CAP equ 4096
%define R28_PE_PAD db 0          ; R28: one byte past the 16-byte boundary, the parity v237 had (see the template)
AST_HANDLE    equ 43    ; R26: yadi dosh (q = call) {fail} anya {ok}: [type][name][call][fail][ok]
R25_PHAL_CAP  equ 512
R23_METHOD_CAP equ 256
R23_MCALL_CAP  equ 2048
R56_GLOBAL_CAP equ 128
R56_PATCH_CAP equ 16384
R9_GUNA_CAP equ 1024        ; R9: hidden guna values per compilation
FUNC_SPILL_BYTES equ 2048 ; reserved stack spill area per generated function/main
; R31 experimental, disabled by default. Enable only with NASM:
;   -DSUTRAM_EXPERIMENTAL_XMM_CACHE=1
; This is a *compiler build* feature flag, not a source-language flag.
; When omitted, zero generated-code paths or data change. Stage 1 uses only
; volatile XMM2-XMM5, never XMM6-XMM15 (Windows nonvolatile).


; R65 opt-in source mode: nasm -DSUTRAM_R65_TRAP_INT=1
; Default build (without -D) follows the accepted wrap semantics.
; Independent peephole mode: -DSUTRAM_R65_PEEPHOLES=1.
; Operator IDs
OP_ADD equ 1
OP_SUB equ 2
OP_MUL equ 3
OP_DIV equ 4
OP_EQ  equ 5
OP_LE  equ 6
OP_LT  equ 7
OP_GT  equ 8
OP_GE  equ 9
OP_NE  equ 10
OP_MOD equ 11   ; modulo (%)
OP_AND equ 12   ; bitwise AND (&)
OP_OR  equ 13   ; bitwise OR (|)
OP_XOR equ 14   ; bitwise XOR (^)
OP_LAND equ 15  ; logical AND (&&)
OP_LOR equ 16   ; logical OR (||)
OP_SHL equ 17   ; shift left (<<)
OP_SHR equ 18   ; shift right (>>)

; Keyword IDs
KW_MUKHYA  equ 2
KW_VITTI   equ 3
KW_ANKA    equ 4
KW_YADI    equ 6
KW_YAVAT   equ 8
KW_PRATIYATI equ 9
KW_SANKHYA   equ 10
KW_ANYATRA  equ 11
KW_PRAKRIYA equ 12
KW_AYOJAN  equ 13
KW_RACHANA equ 14
KW_PUNARAVARTANA equ 15
KW_ATHA equ 16    ; atha = then/to (contextual keyword for for-loop)
KW_SUTRA    equ 17    ; sutra = compile-time constant (rule/formula)
KW_NISHEDHA equ 18    ; abhava = negation (absence)
KW_KRAMA    equ 19    ; krama = break (order/sequence - stop)
KW_UDDESHYA equ 20    ; agrim = continue (onward)
KW_PURNA   equ 21    ; purna = true (complete/full)
KW_SHUNYA  equ 22    ; shunya = false (void/empty)
KW_PARIGRAH equ 23   ; satya = bool type (truth)
KW_SRIJANA  equ 24   ; ganana = enum (enumeration)
KW_GUNA     equ 25   ; guna = switch (quality/attribute)
KW_BHAVANA  equ 26   ; bhavana = case (state/condition)
KW_NISHKRIYA equ 27   ; yantra = inline assembly (machine)
KW_PANKTI    equ 28   ; mala = array (garland/row)
KW_KURU      equ 29   ; kuru = do (imperative Sanskrit, for do-while)
KW_DASHAM    equ 30   ; dasham / दशम = scalar IEEE-754 binary64
KW_KOSH      equ 31   ; kosh / कोश = growable qword array
KW_VIBHAG    equ 32   ; R23 WS3: vibhag / विभाग = a slice parameter
KW_SIDDHI    equ 33   ; R25: siddhi / सिद्धि = return success
KW_DOSH      equ 34   ; R25: dosh / दोष = return failure
KW_PRASAR    equ 35   ; R25: prasar / प्रसार = propagate a failure
AST_NISHKRIYA equ 26  ; inline asm statement node

; Builtin IDs
BN_LIKH     equ 1
BN_STHAGITA equ 3
BN_PAD      equ 4
BN_DVARAM   equ 5
BN_PAADH    equ 6
BN_LIKHA    equ 7
BN_BAND     equ 8
BN_NETSOCK  equ 9
BN_NETBIND  equ 10
BN_NETLIST  equ 11
BN_NETACC   equ 12
BN_NIRMRITA equ 13
BN_LIKH8    equ 14
BN_PAD8     equ 15
BN_VARTLEN  equ 16
BN_VARTCMP  equ 17
BN_VARTCAT  equ 18
BN_VECADD  equ 19
BN_VECMUL  equ 20
BN_VECDOT  equ 21
BN_LKFMT   equ 22
BN_CHARAT  equ 23
BN_CHARCD  equ 24
BN_CHARFR  equ 25
BN_CHARUP  equ 26
BN_CHARLO  equ 27
BN_LIKH8C  equ 28
BN_PAD8C   equ 29
BN_MEMSET  equ 30
BN_MEMCPY  equ 31
BN_VARTCP  equ 32
BN_GRAHAN  equ 33   ; grahan = read number from stdin
BN_LKHB     equ 34   ; lkhb = print number without newline
BN_SHABDA   equ 35   ; shabda = print a NUL-terminated string (variable)
BN_PANKTILEN equ 36   ; pankti_len = array length for declared arrays
BN_KOSHPUSH equ 37   ; kosh_push(k, value) -> new length
BN_KOSHPOP  equ 38   ; kosh_pop(k) -> removed value
BN_KOSHLEN  equ 39   ; kosh_len(k) -> logical length
BN_KOSHCAP  equ 40   ; kosh_cap(k) -> current capacity
BN_SETCHAR  equ 41   ; R50 one-byte store into byte-packed text
BN_KOSHCLEAR equ 42 ; R63 kosh_clear(k) -> 0; reset logical length in place
BN_KOSHEMPTY equ 43 ; R63 kosh_empty(k) -> 1 when length=0
BN_KOSHPEEK equ 44  ; R63 kosh_peek(k) -> last element (without popping)
BN_KOSHDEQUEUE equ 45 ; R63 kosh_dequeue(k) -> first element (FIFO)

; ============================================================
; DATA
; ============================================================
section .data
str_dot_exe  db ".exe", 0
    msg_usage    db "Sutram - sampurna sutra", 10
                  db "Prayog:", 10
                  db "  sutram <nivesh.sm> <nirgat.bin>         sankalan", 10
                  db "  sutram --check <nivesh.sm>              pariksha matram, nirgatam na", 10
                  db "  sutram --lang <pak> <nivesh.sm> <nirgat.bin>  bhasha-pakena saha", 10
                  db "  sutram -i                               khol (samvad)", 10
                  db "  sutram --version                        sanskaran", 10, 0
    msg_version  db "Sutram 1.0 (v248) - sampurna sutra", 10
                  db "Samskrita-mukhya bhasha -> x86-64 yantra-bhasha", 10, 0
    r48_flag db "--check",0
    r28_flag_object db "--object",0
    r29_flag_separate db "--separate",0
    r32_flag_ffi db "--ffi",0
    r32_empty db 0
    r38_flag_fail db "--fail-alloc",0
    r48_msg_near db ": Sutram Error [E_PARSE]: shabd '",0
    r48_msg_end db "'",10,0
    r48_msg_ok db "Sutram pariksha: shuddham (nirgata-patram na rachitam)",10,0
    r48_msg_errors db "Sutram pariksha: doshah praptah; nirgata-patram na rachitam",10,0
    r48_msg_eof db "<patra-ant>",0
    r50_msg_setchar_arity db "Sutram Error: akshar_rakh: 3 tark avashyak",10,0
    r52_msg_dvaram_arity db "Sutram Error: dvaram: 2 va 3 tark avashyak",10,0
    r52_msg_charat_arity db "Sutram Error: akshar: 2 tark avashyak",10,0
    r52_msg_charcode_arity db "Sutram Error: aksharank: 1 va 2 tark avashyak",10,0
    r54_msg_arity db "Sutram Error: tark sankhya hastakshar se bhinn",10,0
    ; R54 builtin signature min,max in declaration ID order.
r54_builtin_arity_table:
    db 0,0               ; 0 reserved0
    db 2,2               ; 1 likh
    db 0,0               ; 2 reserved2
    db 0,0               ; 3 sthagita
    db 1,1               ; 4 pad
    db 2,3               ; 5 dvaram
    db 3,3               ; 6 paadh
    db 1,3               ; 7 likha
    db 1,1               ; 8 band
    db 0,0               ; 9 netsock
    db 2,2               ; 10 netbind
    db 1,1               ; 11 netlisten
    db 1,1               ; 12 netaccept
    db 1,1               ; 13 nirmmita
    db 2,2               ; 14 likh8
    db 1,1               ; 15 pad8
    db 1,1               ; 16 vartani_len
    db 2,2               ; 17 vartani_cmp
    db 2,2               ; 18 vartani_cat
    db 3,3               ; 19 sankhya_yog
    db 3,3               ; 20 sankhya_gunan
    db 2,2               ; 21 sankhya_dot
    db 2,2               ; 22 likha_fmt
    db 2,2               ; 23 char_at
    db 1,2               ; 24 char_code
    db 1,1               ; 25 char_from
    db 1,1               ; 26 char_upper
    db 1,1               ; 27 char_lower
    db 3,3               ; 28 likh8c
    db 2,2               ; 29 pad8c
    db 3,3               ; 30 smaran
    db 3,3               ; 31 smaran_cp
    db 2,2               ; 32 vartani_cp
    db 0,0               ; 33 grahan
    db 1,1               ; 34 lkhb
    db 1,1               ; 35 shabda
    db 1,1               ; 36 pankti_len
    db 2,2               ; 37 kosh_push
    db 1,1               ; 38 kosh_pop
    db 1,1               ; 39 kosh_len
    db 1,1               ; 40 kosh_cap
    db 3,3               ; 41 set_char
    db 1,1               ; 42 kosh_clear
    db 1,1               ; 43 kosh_empty
    db 1,1               ; 44 kosh_peek
    db 1,1               ; 45 kosh_dequeue

    r48_msg_undefined db ": Sutram Error [E_UNDEFINED_FUNCTION]: agyat prakriya '",0
    ; R4: a read of a name that was never declared or assigned is an error
    ; (it used to be auto-allocated and read as 0: a wrong answer, no diagnostic).
    r4_msg_undef db ": Sutram Error [E_UNDEFINED_NAME]: agyat naam '",0
    r4_msg_hint_decl db "Sanket: prayogat purvam ghoshana avashyaki: vitti ",0
    r4_msg_hint_decl2 db " = ...",10,0
    r4_msg_hint_old db "Sanket: '",0
    r4_msg_hint_old2 db "' puratanah kunjishabdah (v157 tah purvam); navinah: '",0
    r4_msg_hint_old3 db "'",10,0
    r5_msg_field db ": Sutram Error [E_UNKNOWN_FIELD]: agyat kshetra '",0
    r7_msg_dup db ": Sutram Error [E_DUPLICATE_NAME]: punah ghoshana '",0
    r7_msg_dup_hint db "' purvam eva ghoshitam; navinam manam datum: ",0
    r7_msg_dup_hint2 db " = ...",10,0
    r7_msg_field_amb db ": Sutram Error [E_AMBIGUOUS_FIELD]: kshetra '",0
    r7_msg_field_amb_hint db "' dvayoh rachanayoh bhinne sthane asti; pratyekasyam rachanayam bhinnam nama dadatu",10,0
    r7_msg_field_dup_hint db "' asyam rachanayam purvam eva asti",10,0
    r7_msg_arity db ": Sutram Error [E_ARITY]: '",0
    r7_msg_arity2 db "' ityasmai ",0
    r7_msg_arity3 db " tarkah dattah; hastakshare ",0
    r7_msg_arity_hint db "Sanket: prakriyayah paribhashayam yavantah tarkah santi, tavantah eva dadatu",10,0
    r7_msg_mod_missing db "Sutram Error [E_MODULE_MISSING]: yoj patra aprapt: ",0
    r7_msg_mod_missing2 db 10,"Sanket: naam.smlib lib/ madhye srota-patrasya nirdeshikayam va bhavet",10,0
    r7_msg_hint_block db "' kasminshchit khande { } chakra-madhye va ghoshitam; tatah bahih na drishyate",10,0
    r5_msg_field_hint db "Sanket: '",0
    r5_msg_field_hint2 db "' kasyashchid api rachanayah kshetram nasti",10,0
    r4_old_kw:
        dq r4_o_anyatra, kw_anyatra, r4_o_punar, kw_punaravartana, r4_o_prati, kw_pratiyati
        dq r4_o_udd, kw_uddeshya, r4_o_pankti, kw_pankti, r4_o_srij, kw_srijana
        dq r4_o_nish, kw_nishedha, r4_o_ayoj, kw_ayojan, r4_o_parig, kw_parigrah
        dq r4_o_nishk, kw_nishkriya, r4_o_to, kw_to_str, 0, 0
    r4_o_anyatra db "anyatra",0
    r4_o_punar db "punaravartana",0
    r4_o_prati db "pratiyati",0
    r4_o_udd db "uddeshya",0
    r4_o_pankti db "pankti",0
    r4_o_srij db "srijana",0
    r4_o_nish db "nishedha",0
    r4_o_ayoj db "ayojan",0
    r4_o_parig db "parigrah",0
    r4_o_nishk db "nishkriya",0
    r4_o_to db "to",0
    msg_err_line db 10, "Sutram Error: vyakaran dosh, pankti ", 0
    msg_err_near db ", shabd '", 0
    msg_err_end  db "'", 10, 0
    msg_err_eof  db "patra-ant", 0
    msg_err_hint db "Sanket: asmin sthane shabdam vyakaranam cha pashyatu.", 10, 0
    msg_err_colon db ":", 0
    msg_diag_indent db "  ", 0
    msg_diag_space db " ", 0
    msg_diag_tab db 9, 0
    msg_diag_nl db 10, 0
    msg_diag_caret db "^", 10, 0
    msg_err_arg_limit db "Sanket: prakriya adhikatamam 6 tarkan grihnati.", 10, 0
    msg_err_duplicate_func db "Sanket: prakriyayah dvih paribhasha (nama-sangharshah).", 10, 0
    msg_duplicate_func db "Sutram Error: punah prakriya paribhasha: ", 0
    msg_undefined_func db "Sutram Error: agyat prakriya: ", 0
    msg_array_oob db "Sutram Error: mala ank seema atikram", 10, 0
    msg_kosh_required db "Sutram Error: kosh prakriya hetu kosh-vitti avashyak", 10, 0
%ifdef SUTRAM_R65_TRAP_INT
    r65_msg_prefix db "Sutram Error [E_INTEGER_TRAP] ",0
    r65_msg_colon db ":",0
    r65_msg_add db ": yog atipravah",10,0
    r65_msg_sub db ": nyun atipravah",10,0
    r65_msg_mul db ": gun atipravah",10,0
    r65_msg_div db ": shunyena bhagah",10,0
    r65_msg_mod db ": shunyena sheshah",10,0
    r65_msg_div_overflow db ": bhajan atipravah",10,0
    r65_msg_mod_overflow db ": shesh atipravah",10,0
%endif
    msg_kosh_empty db "Sutram Error: riktat koshat kosh_pop", 10, 0
    msg_kosh_peek_empty db "Sutram Error: riktat koshat kosh_peek", 10, 0
    msg_kosh_dequeue_empty db "Sutram Error: riktat koshat kosh_dequeue", 10, 0
    msg_kosh_param_type db "Sutram Error: kosh tark: tatv prakar bhinn", 10, 0
    msg_kosh_param_push db "Sutram Error: kosh-tarke kosh_push asamarthitam", 10, 0
    r23_msg_slice_base db "Sutram Error: vibhag: mala, kosh va vibhag apekshita", 10, 0
    r23_msg_slice_return db "Sutram Error: vibhag prakriyayah na pratyarpaniyah", 10, 0
    r24_msg_method_hint db "Sanket: vidheh purvam ghoshana avashyaki: rachana ",0
    r25_msg_phal_return db "Sutram Error: phal-prakriya: prati siddhi va dosh bhavet", 10, 0
    r25_msg_phal_unused db "Sutram Error: phal-prakriya prasar vina ahuta", 10, 0
    r25_msg_prasar_call db "Sutram Error: prasar: phal-prakriya-ahvanam apekshitam", 10, 0
    r25_msg_prasar_where db "Sutram Error: prasar kevalam phal-prakriya-madhye mukhya-madhye va", 10, 0
    r26_msg_handle_call db "Sutram Error: yadi dosh: phal-prakriya-ahvanam apekshitam", 10, 0
    r28_msg_object_globals db "Sutram Error: vastu-patre ghatak-star vitti asamarthita", 10, 0
    r32_msg_ffi_bad db "Sutram Error: videshi-ghoshana-patram dushtam, pankti ", 0
    r32_msg_ffi_clash db "Sutram Error: videshi prakriya-nama anyatra api: ", 0
    r33_msg_ffi_kind db "Sutram Error [E_FFI_KIND]: videshi prakriya ", 0
    r33_msg_ffi_kind2 db ": ghoshitat prakarat bhinnah tarkah ", 0
    r33_msg_ffi_void db ": mulyam na pratyarpayati", 10, 0

    ; The v27 per-pack copies of five parse messages lived here. R11: every message
    ; now has a copy per pack, in lang/<pack>.sandesh, assembled into
    ; src/r11_sandesh.inc by tools/sandesh.py.

    ; Language id: 0 = no --lang (the romanised default), 1..10 these packs,
    ; 11 = sanskrit (R11: its messages are Devanagari Sanskrit).
    lang_names:
        dq 0, ln_bn, ln_gu, ln_hi, ln_kn, ln_ml, ln_mr, ln_or, ln_pa, ln_ta, ln_te, ln_sa
    ln_bn db "bengali", 0
    ln_gu db "gujarati", 0
    ln_hi db "hindi", 0
    ln_kn db "kannada", 0
    ln_ml db "malayalam", 0
    ln_mr db "marathi", 0
    ln_or db "odia", 0
    ln_pa db "punjabi", 0
    ln_ta db "tamil", 0
    ln_te db "telugu", 0
    ln_sa db "sanskrit", 0
%include "src/r22_lang_builtin.inc"

    cur_lang_id dq 0
    msg_lang_ok  db "Bhasha pak prapt: ", 0
    msg_lang_fail db "Chetavani: bhasha-pakah na praptah: ", 0
    msg_nl       db 10, 0
    str_flag_i   db "-i", 0
    str_flag_shell db "--shell", 0
    str_flag_ver db "--version", 0
    str_flag_v   db "-v", 0
    str_flag_lang db "--lang", 0
    str_envlang  db "SUTRAM_LANG=", 0
    str_envhome  db "HOME=", 0
    str_lp1      db "lang/", 0
    str_lp2      db ".lang", 0
    str_lp3      db "/.local/share/sutram/lang/", 0
    str_procself db "/proc/self/exe", 0
%ifdef WINDOWS
    ; Keep REPL scratch files in the current directory on Windows.  The output
    ; suffix intentionally selects the PE backend for the child compilation.
    str_repl_in  db ".sutram_repl.sm", 0
    str_repl_out db ".sutram_repl.exe", 0
    str_repl_quote db '"', 0
    str_repl_space db " ", 0
    wn_repl_createprocess db "CreateProcessA", 0
    wn_repl_wait          db "WaitForSingleObject", 0
    wn_repl_getexit       db "GetExitCodeProcess", 0
%else
    str_repl_in  db "/tmp/.sutram_repl.sm", 0
    str_repl_out db "/tmp/.sutram_repl.bin", 0
%endif
    str_exit1    db "nirgat", 0
    str_exit2    db "exit", 0
    str_exit3    db "quit", 0
    str_help1    db "sahayata", 0
    str_help2    db "help", 0
    str_sarvam   db "sarvam", 0
    msg_shell_banner db "Sutram khol v1.0 - sampurna sutra", 10
                      db "Sutram-kathanam likhatu, Enter nudatu. Sadyah chalishyati.", 10
                      db "Aadeshah: sahayata (sahayata) | nirgat (nirgamanam) | sarvam (sarvam pashyatu)", 10, 10, 0
    msg_shell_prompt db "sutra> ", 0
    msg_shell_bye db "Namaste! Satra samapt.", 10, 0
    msg_shell_help db "Sutram khol sahayata:", 10
                     db '  likha("Namaste\n")            patham likhati', 10
                     db "  vitti x = 5             vitti-ghoshana", 10
                     db "  likha(x + 3)            mulyam likhati", 10
                     db "  chakra i = 0 tak 5 { likha(i) }   avartanam", 10
                     db "  mala arr[5]             mala-ghoshana", 10
                     db "  sarvam                  sampurnam karyakramam pashyatu", 10
                     db "  nirgat                  kholat nirgacchatu", 10, 0
    repl_prog_hdr db "mukhya() {", 10, 0
    repl_prog_ftr db 10, "}", 10, 0
    msg_open_err  db "Sutram Error: nivesh patra aprapt", 10, 0
    msg_ok        db "Siddh: ", 0
    msg_bytes     db " baait sankalit", 10, 0
    dbg_pfb       db 0
    lk_no_nl      dq 0
    for_descend  dq 0      ; 1 = descending for-loop
    newline       db 10, 0

    ; Keyword table: [ptr][type][id] — 24 bytes each
    kw_table:
        dq kw_mukhya,    TOK_KEYWORD, KW_MUKHYA
        dq kw_vitti,     TOK_KEYWORD, KW_VITTI
        dq kw_anka,      TOK_KEYWORD, KW_ANKA
        dq kw_yadi,      TOK_KEYWORD, KW_YADI
        dq kw_yavat,     TOK_KEYWORD, KW_YAVAT
        dq kw_pratiyati, TOK_KEYWORD, KW_PRATIYATI
        ; Vector type
        dq kw_sankhya,   TOK_KEYWORD, KW_SANKHYA
        dq kw_anyatra,  TOK_KEYWORD, KW_ANYATRA
        dq kw_dev_anyatra, TOK_KEYWORD, KW_ANYATRA
        dq kw_prakriya,  TOK_KEYWORD, KW_PRAKRIYA
        dq kw_dev_prakriya, TOK_KEYWORD, KW_PRAKRIYA
        dq kw_ayojan,  TOK_KEYWORD, KW_AYOJAN
        dq kw_rachana,  TOK_KEYWORD, KW_RACHANA
        dq kw_punaravartana, TOK_KEYWORD, KW_PUNARAVARTANA
        dq kw_sutra,      TOK_KEYWORD, KW_SUTRA
        dq kw_nishedha,   TOK_KEYWORD, KW_NISHEDHA
        dq kw_krama,      TOK_KEYWORD, KW_KRAMA
        dq kw_uddeshya,   TOK_KEYWORD, KW_UDDESHYA
        dq kw_purna,      TOK_KEYWORD, KW_PURNA
        dq kw_shunya,     TOK_KEYWORD, KW_SHUNYA
        dq kw_parigrah,   TOK_KEYWORD, KW_PARIGRAH
        dq kw_srijana,    TOK_KEYWORD, KW_SRIJANA
        dq kw_guna,       TOK_KEYWORD, KW_GUNA
        dq kw_bhavana,    TOK_KEYWORD, KW_BHAVANA
        dq kw_pankti,     TOK_KEYWORD, KW_PANKTI
        dq kw_nishkriya,  TOK_KEYWORD, KW_NISHKRIYA
        dq kw_kuru,       TOK_KEYWORD, KW_KURU
        dq kw_dasham,     TOK_KEYWORD, KW_DASHAM
        dq kw_kosh,       TOK_KEYWORD, KW_KOSH
        dq kw_vibhag,     TOK_KEYWORD, KW_VIBHAG
        dq kw_siddhi,     TOK_KEYWORD, KW_SIDDHI
        dq kw_dosh,       TOK_KEYWORD, KW_DOSH
        dq kw_prasar,     TOK_KEYWORD, KW_PRASAR
        ; Devanagari equivalents (optional script)
        dq kw_dev_mukhya,    TOK_KEYWORD, KW_MUKHYA
        dq kw_dev_vitti,     TOK_KEYWORD, KW_VITTI
        dq kw_dev_anka,      TOK_KEYWORD, KW_ANKA
        dq kw_dev_yadi,      TOK_KEYWORD, KW_YADI
        dq kw_dev_yavat,     TOK_KEYWORD, KW_YAVAT
        dq kw_dev_pratiyati, TOK_KEYWORD, KW_PRATIYATI
        dq kw_dev_pankti,    TOK_KEYWORD, KW_PANKTI
        dq kw_dev_kuru,      TOK_KEYWORD, KW_KURU
        dq kw_dev_dasham,    TOK_KEYWORD, KW_DASHAM
        dq kw_dev_kosh,      TOK_KEYWORD, KW_KOSH
        dq kw_dev_vibhag,    TOK_KEYWORD, KW_VIBHAG
        dq kw_dev_siddhi,    TOK_KEYWORD, KW_SIDDHI
        dq kw_dev_dosh,      TOK_KEYWORD, KW_DOSH
        dq kw_dev_prasar,    TOK_KEYWORD, KW_PRASAR
    kw_table_end:

    ; Builtin table
    bn_table:
        dq bn_likh,     TOK_BUILTIN, BN_LIKH
        dq bn_sthagita, TOK_BUILTIN, BN_STHAGITA
        dq bn_pad,      TOK_BUILTIN, BN_PAD
        dq bn_dvaram,   TOK_BUILTIN, BN_DVARAM
        dq bn_paadh,    TOK_BUILTIN, BN_PAADH
        dq bn_likha,    TOK_BUILTIN, BN_LIKHA
        dq bn_band,     TOK_BUILTIN, BN_BAND
        dq bn_netsock,  TOK_BUILTIN, BN_NETSOCK
        dq bn_netbind,  TOK_BUILTIN, BN_NETBIND
        dq bn_netlist,  TOK_BUILTIN, BN_NETLIST
        dq bn_netacc,   TOK_BUILTIN, BN_NETACC
        dq bn_nirm,     TOK_BUILTIN, BN_NIRMRITA
        dq bn_likh8,    TOK_BUILTIN, BN_LIKH8
        dq bn_pad8,     TOK_BUILTIN, BN_PAD8
        dq bn_vartlen,  TOK_BUILTIN, BN_VARTLEN
        dq bn_vartcmp,  TOK_BUILTIN, BN_VARTCMP
        dq bn_vartcat,  TOK_BUILTIN, BN_VARTCAT
        dq bn_vecadd,   TOK_BUILTIN, BN_VECADD
        dq bn_vecmul,   TOK_BUILTIN, BN_VECMUL
        dq bn_vecdot,   TOK_BUILTIN, BN_VECDOT
        dq bn_lkfmt,    TOK_BUILTIN, BN_LKFMT
        dq bn_charat,   TOK_BUILTIN, BN_CHARAT
        dq bn_charcd,   TOK_BUILTIN, BN_CHARCD
        dq bn_charfr,   TOK_BUILTIN, BN_CHARFR
        dq bn_charup,   TOK_BUILTIN, BN_CHARUP
        dq bn_charlo,   TOK_BUILTIN, BN_CHARLO
        dq bn_likh8c,   TOK_BUILTIN, BN_LIKH8C
        dq bn_pad8c,    TOK_BUILTIN, BN_PAD8C
        dq bn_memset,   TOK_BUILTIN, BN_MEMSET
        dq bn_memcpy,   TOK_BUILTIN, BN_MEMCPY
        dq bn_vartcp,   TOK_BUILTIN, BN_VARTCP
        dq bn_grahan,   TOK_BUILTIN, BN_GRAHAN
        dq bn_lkhb,     TOK_BUILTIN, BN_LKHB
        dq bn_shabda,   TOK_BUILTIN, BN_SHABDA
        dq bn_panktilen, TOK_BUILTIN, BN_PANKTILEN
        dq bn_koshpush, TOK_BUILTIN, BN_KOSHPUSH
        dq bn_koshpop,  TOK_BUILTIN, BN_KOSHPOP
        dq bn_koshlen,  TOK_BUILTIN, BN_KOSHLEN
        dq bn_koshcap,  TOK_BUILTIN, BN_KOSHCAP
        dq bn_koshclear, TOK_BUILTIN, BN_KOSHCLEAR
        dq bn_koshempty, TOK_BUILTIN, BN_KOSHEMPTY
        dq bn_koshpeek, TOK_BUILTIN, BN_KOSHPEEK
        dq bn_koshenqueue, TOK_BUILTIN, BN_KOSHPUSH
        dq bn_koshdequeue, TOK_BUILTIN, BN_KOSHDEQUEUE
        dq bn_setchar,  TOK_BUILTIN, BN_SETCHAR
    bn_table_end:

    ; grahan(): read one line from stdin, parse digits, return in rax.
    ; The read operation itself is emitted through emit_syscall.  Linux gets a
    ; native syscall instruction; PE targets get a rel32 call to rt_syscall,
    ; whose syscall-0 path uses kernel32!ReadFile on the cached stdin handle.
    ;
    ; Replacing the 2-byte Linux syscall with a 5-byte PE call changes the
    ; backwards branch distances in the parse loop, so the common prefix and
    ; target-specific tails are stored separately.
    grahan_prefix_bytes:
        db 0x48, 0x83, 0xEC, 0x10            ; sub rsp, 16
        db 0x45, 0x31, 0xC0                  ; xor r8d, r8d
        ; --- .read_loop ---
        db 0x31, 0xC0                        ; xor eax, eax         (sys_read)
        db 0x31, 0xFF                        ; xor edi, edi         (fd=0)
        db 0x48, 0x89, 0xE6                  ; mov rsi, rsp         (buf)
        db 0xBA, 0x01, 0x00, 0x00, 0x00      ; mov edx, 1          (len)
    grahan_prefix_end:
    GRAHAN_PREFIX_LEN equ grahan_prefix_end - grahan_prefix_bytes

    ; Tail for Linux: follows a 2-byte syscall at offset 19.
    grahan_linux_tail:
        db 0x85, 0xC0                        ; test eax, eax
        db 0x7E, 0x24                        ; jle .eof (+36)
        db 0x0F, 0xB6, 0x14, 0x24            ; movzx edx,[rsp]
        db 0x80, 0xFA, 0x0A                  ; cmp dl, 10
        db 0x74, 0x16                        ; je .done (+22)
        db 0x80, 0xFA, 0x30                  ; cmp dl, '0'
        db 0x7C, 0xE0                        ; jl .read_loop (-32)
        db 0x80, 0xFA, 0x39                  ; cmp dl, '9'
        db 0x7F, 0xDB                        ; jg .read_loop (-37)
        db 0x80, 0xEA, 0x30                  ; sub dl, '0'
        db 0x4D, 0x6B, 0xC0, 0x0A            ; imul r8, r8, 10
        db 0x49, 0x01, 0xD0                  ; add r8, rdx
        db 0xEB, 0xCF                        ; jmp .read_loop (-49)
        ; --- .done ---
        db 0x4C, 0x89, 0xC0                  ; mov rax, r8
        db 0xEB, 0x07                        ; jmp .ret (+7)
        ; --- .eof: EOF -> return -1 ---
        db 0x48, 0xC7, 0xC0, 0xFF, 0xFF, 0xFF, 0xFF ; mov rax, -1
        ; --- .ret ---
        db 0x48, 0x83, 0xC4, 0x10            ; add rsp, 16
    grahan_linux_tail_end:
    GRAHAN_TAIL_LEN equ grahan_linux_tail_end - grahan_linux_tail

    ; Tail for PE: follows a 5-byte call to rt_syscall.  Forward branches keep
    ; the same displacement; only the three branches back to .read_loop grow by 3.
    grahan_pe_tail:
        db 0x85, 0xC0                        ; test eax, eax
        db 0x7E, 0x24                        ; jle .eof (+36)
        db 0x0F, 0xB6, 0x14, 0x24            ; movzx edx,[rsp]
        db 0x80, 0xFA, 0x0A                  ; cmp dl, 10
        db 0x74, 0x16                        ; je .done (+22)
        db 0x80, 0xFA, 0x30                  ; cmp dl, '0'
        db 0x7C, 0xDD                        ; jl .read_loop (-35)
        db 0x80, 0xFA, 0x39                  ; cmp dl, '9'
        db 0x7F, 0xD8                        ; jg .read_loop (-40)
        db 0x80, 0xEA, 0x30                  ; sub dl, '0'
        db 0x4D, 0x6B, 0xC0, 0x0A            ; imul r8, r8, 10
        db 0x49, 0x01, 0xD0                  ; add r8, rdx
        db 0xEB, 0xCC                        ; jmp .read_loop (-52)
        db 0x4C, 0x89, 0xC0                  ; mov rax, r8
        db 0xEB, 0x07                        ; jmp .ret (+7)
        db 0x48, 0xC7, 0xC0, 0xFF, 0xFF, 0xFF, 0xFF ; mov rax, -1
        db 0x48, 0x83, 0xC4, 0x10            ; add rsp, 16
    grahan_pe_tail_end:
    GRAHAN_PE_TAIL_LEN equ grahan_pe_tail_end - grahan_pe_tail

    ; T12 fixed-six-decimal float printer. Input: raw binary64 bits in RAX.
    ; Prefix ends immediately before the platform write syscall/call so the
    ; existing emit_syscall abstraction remains valid for ELF and PE.
    float_print_prefix_bytes:
        db 0x66,0x48,0x0F,0x6E,0xC0                  ; movq xmm0, rax
        db 0x48,0xC7,0xC1,0x40,0x42,0x0F,0x00       ; mov rcx, 1000000
        db 0xF2,0x48,0x0F,0x2A,0xC9                  ; cvtsi2sd xmm1, rcx
        db 0xF2,0x0F,0x59,0xC1                       ; mulsd xmm0, xmm1
        db 0xF2,0x4C,0x0F,0x2D,0xC0                  ; cvtsd2si r8, xmm0
        db 0x48,0x83,0xEC,0x40                       ; sub rsp, 64
        db 0x48,0x8D,0x74,0x24,0x3F                  ; lea rsi,[rsp+63]
        db 0xC6,0x06,0x0A                             ; newline
        db 0x48,0xFF,0xCE                             ; dec rsi
        db 0x45,0x31,0xC9                             ; xor r9d,r9d
        db 0x4D,0x85,0xC0,0x79,0x06                  ; test r8,r8 / jns
        db 0x49,0xF7,0xD8,0x41,0xB1,0x01             ; neg r8 / sign=1
        db 0xB9,0x06,0x00,0x00,0x00                  ; six fractional digits
        db 0x31,0xD2,0x4C,0x89,0xC0                  ; frac loop: xor edx,edx; mov rax,r8
        db 0x41,0xBA,0x0A,0x00,0x00,0x00             ; mov r10d,10
        db 0x49,0xF7,0xF2,0x49,0x89,0xC0             ; div r10; mov r8,rax
        db 0x80,0xC2,0x30,0x88,0x16,0x48,0xFF,0xCE  ; digit/store/dec rsi
        db 0xFF,0xC9,0x75,0xE3                       ; dec ecx; jnz frac loop
        db 0xC6,0x06,0x2E,0x48,0xFF,0xCE             ; '.' / dec rsi
        db 0x4D,0x85,0xC0,0x75,0x08                  ; test r8 / jnz integer loop
        db 0xC6,0x06,0x30,0x48,0xFF,0xCE,0xEB,0x1E  ; integer zero / jump done
        db 0x31,0xD2,0x4C,0x89,0xC0                  ; integer loop
        db 0x41,0xBA,0x0A,0x00,0x00,0x00             ; mov r10d,10
        db 0x49,0xF7,0xF2,0x49,0x89,0xC0             ; div r10; mov r8,rax
        db 0x80,0xC2,0x30,0x88,0x16,0x48,0xFF,0xCE  ; digit/store/dec rsi
        db 0x4D,0x85,0xC0,0x75,0xE2                  ; loop while nonzero
        db 0x45,0x84,0xC9,0x74,0x06                  ; test sign / jz
        db 0xC6,0x06,0x2D,0x48,0xFF,0xCE             ; '-' / dec rsi
        db 0x48,0xFF,0xC6                             ; inc rsi
        db 0x48,0x8D,0x54,0x24,0x40,0x48,0x29,0xF2  ; length = rsp+64-rsi
        db 0xBF,0x01,0x00,0x00,0x00                  ; edi=stdout
        db 0xB8,0x01,0x00,0x00,0x00                  ; eax=write
    float_print_prefix_end:
    FLOAT_PRINT_PREFIX_LEN equ float_print_prefix_end - float_print_prefix_bytes
    float_print_suffix_bytes:
        db 0x48,0x83,0xC4,0x40                       ; add rsp,64
    float_print_suffix_end:
    FLOAT_PRINT_SUFFIX_LEN equ float_print_suffix_end - float_print_suffix_bytes

