+    mov rdx, r8
+    shl rdx, 6
+    add rcx, rdx
+    lea rsi, [rel mg_exp]
+    add rsi, rcx
+    mov rcx, r13
+    shl rcx, 11
+    mov rdx, r15
+    shl rdx, 6
+    add rcx, rdx
+    lea rdi, [rel mg_def]
