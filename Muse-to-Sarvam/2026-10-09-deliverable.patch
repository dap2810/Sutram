+.fr_skip:
+    ; skip to end of line
+.fr_sl:
+    cmp r14, r12
+    jae .fr_notfound
+    movzx eax, byte [rbx + r14]
+    inc r14
+    cmp al, 10
+    jne .fr_sl
+    inc r15
+    jmp .fr_loop
+.fr_match:
