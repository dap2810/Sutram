+    mov rax, r15
+    imul rax, rax, 1632
+    mov rcx, r14
+    imul rcx, rcx, 136
+    add rax, rcx
+    lea rsi, [rel mg_imp]
+    add rsi, rax
+    push rsi
+    mov rdi, rsi                  ; name
+    call mg_find_rec
+    pop rsi
+    cmp rax, 0
+    jl .cv_next_imp
+    lea r11, [rel mg_rec_v1]
+    movzx ecx, byte [r11 + rax]
+    test ecx, ecx
+    jz .cv_next_imp
