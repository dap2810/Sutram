+    mov r13, rax
+    push r14
+    lea r14, [rsi + 64]
+    ; rbx, r12 already set
+    call mg_check_edge
+    pop r14
+.cv_next_imp:
+    inc r14
+    jmp .cv_imp
+.cv_next_rec:
+    inc r15
+    jmp .cv_rec
+.cv_done:
+    pop r15
+    pop r14
+    pop r13
+    pop r12
+    pop rbx
+    ret
