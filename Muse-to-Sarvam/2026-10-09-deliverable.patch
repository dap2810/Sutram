+    je .fr_ws_adv
+    cmp cl, 9
+    jne .fr_chk_p
+.fr_ws_adv:
+    inc rax
+    jmp .fr_ws
+.fr_chk_p:
+    cmp cl, '('
+    jne .fr_adv
+    mov rax, r15
+    jmp .fr_done
+.fr_adv:
+    inc r14
+    jmp .fr_loop
+.fr_notfound:
+    xor eax, eax
+.fr_done:
+    pop r15
+    pop r14
+    pop r13
+    pop r12
+    pop rbx
+    ret
