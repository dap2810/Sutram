+    shl rax, 6
+    lea rdi, [rel mg_rec_name]
+    add rdi, rax
+    call print_str_z
+    lea rdi, [rel mg_e_noexp3]
+    call print_str_z
+    mov rdi, 1
+    call os_exit
+.ce_no_ref:
+    pop rsi
+.ce_next_def:
+    inc r15
+    jmp .ce_def
+.ce_done:
+    pop r15
+    pop r14
+    pop r13
+    pop r12
+    pop rbx
+    ret
