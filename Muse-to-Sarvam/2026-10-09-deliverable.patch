+    cmp r15, 0
+    jne .cv_module
+    lea rbx, [rel source_buf]
+    mov r12, [rel source_len]
+    mov rsi, [rel source_path_ptr]
+    lea rdi, [rel mg_cur_path]
+    xor rcx, rcx
+.cv_cproot:
+    mov al, [rsi + rcx]
+    mov [rdi + rcx], al
+    inc rcx
+    test al, al
+    jnz .cv_cproot
+    jmp .cv_buf_ok
+.cv_module:
+    mov rax, r15
+    shl rax, 9
+    lea rsi, [rel mg_rec_path]
+    add rsi, rax
+    lea rdi, [rel mg_cur_path]
+    xor rcx, rcx
+.cv_cpmod:
+    mov al, [rsi + rcx]
+    mov [rdi + rcx], al
+    inc rcx
+    test al, al
+    jnz .cv_cpmod
+    lea rdi, [rel mg_cur_path]
