+    mov rax, r13
+    shl rax, 11
+    mov rdx, r15
+    shl rdx, 6
+    add rax, rdx
+    lea rsi, [rel mg_def]
+    add rsi, rax
+    push rsi                      ; save def ptr
+    xor rdx, rdx
+.ce_pd:
+    mov al, [rsi + rdx]
+    mov [rdi + rcx], al
+    inc rcx
+    inc rdx
+    test al, al
+    jnz .ce_pd
