mukhya() {
    vitti c1 = anka_akshar(66)
    shabda(c1)
    likha("\n")
    vitti c2 = anka_akshar(67)
    shabda(c1)
    likha("\n")
    shabda(c2)
    likha("\n")
    vitti s = vartani_sandhi("ab", "cd")
    shabda(s)
    likha("\n")
    shabda("ab")
    likha("\n")
    shabda("cd")
    likha("\n")
    vitti s2 = vartani_sandhi(vartani_sandhi("a", "b"), "c")
    shabda(s2)
    likha("\n")
    vitti e1 = vartani_sandhi("", "x")
    shabda(e1)
    likha("\n")
}
