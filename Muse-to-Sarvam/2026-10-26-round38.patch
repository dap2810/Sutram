--- /dev/null
+++ b/examples/251_r38_alias_mala_oob.sm
@@ -0,0 +1,10 @@
+# R38: a mala alias must be bounds-checked like the original.
+# Before R38, vitti b = a left b unmarked and b[5] silently read 0.
+mukhya() {
+    mala a[3]
+    a[0] = 10
+    a[1] = 20
+    a[2] = 30
+    vitti b = a
+    likha(b[5])
+}
