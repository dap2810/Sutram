prakriya grow_it(kosh k) {
    kosh_kship(k, 99)
    nivartanam 1
}
prakriya use_slice(vibhag s, dasham x) {
    s[0] = 77
    nivartanam s[0]
}
mukhya() {
    kosh k[4]
    kosh_kship(k, 10)
    kosh_kship(k, 20)
    kosh_kship(k, 30)
    kosh_kship(k, 40)
    kosh_kship(k, 50)
    kosh_kship(k, 60)
    kosh_kship(k, 70)
    kosh_kship(k, 80)
    vitti obstacle = nirmmita(16)
    vitti f = use_slice
    likha(f(k[2:5], grow_it(k)))
    likha(k[2])
}
