mukhya() {
    kosh k[4]
    kosh_push(k, 10)
    kosh_push(k, 20)
    kosh_push(k, 30)
    likha("peek=", kosh_peek(k), "\n")
    likha("len=", kosh_len(k), "\n")
    likha("pop=", kosh_pop(k), "\n")
    likha("len=", kosh_len(k), "\n")
    likha("empty=", kosh_empty(k), "\n")
    kosh_clear(k)
    likha("after clear len=", kosh_len(k), "\n")
    likha("after clear empty=", kosh_empty(k), "\n")
    kosh_enqueue(k, 1)
    kosh_enqueue(k, 2)
    kosh_enqueue(k, 3)
    likha("after enqueue len=", kosh_len(k), "\n")
    likha("after enqueue peek=", kosh_peek(k), "\n")
    likha("dequeue=", kosh_dequeue(k), "\n")
    likha("after dequeue len=", kosh_len(k), "\n")
    likha("after dequeue peek=", kosh_peek(k), "\n")
    likha("pankti_len abc=", pankti_len("abc"), "\n")
    likha("char_lower A=", char_lower(65), "\n")
    likha("char_upper a=", char_upper(97), "\n")
    likha("char_from 66=", char_from(66), "\n")
    lkhb(7)
    likha("\n")
}
