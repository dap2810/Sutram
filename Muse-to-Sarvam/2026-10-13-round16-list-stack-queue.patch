+++ b/tests/stdlib/list_basic.sm
@@ -0,0 +1,64 @@
+ayojan list
+mukhya() {
+    vitti l = list_init(2)
+    likha(list_len(l))
+    likha("\n")
+    likha(list_push(l, 10))
+    likha("\n")
+    likha(list_push(l, 20))
+    likha("\n")
+    # third push grows capacity 2 -> 4
+    likha(list_push(l, 30))
+    likha("\n")
+    likha(list_len(l))
+    likha("\n")
+    likha(list_get(l, 0))
+    likha("\n")
+    likha(list_get(l, 2))
+    likha("\n")
+    # out of bounds reads return 0
+    likha(list_get(l, 9))
+    likha("\n")
+    likha(list_get(l, 0 - 1))
+    likha("\n")
+    likha(list_set(l, 1, 99))
+    likha("\n")
+    likha(list_get(l, 1))
+    likha("\n")
+    likha(list_set(l, 9, 1))
+    likha("\n")
+    likha(list_contains(l, 99))
+    likha("\n")
+    likha(list_contains(l, 20))
+    likha("\n")
+    likha(list_index_of(l, 30))
+    likha("\n")
+    likha(list_index_of(l, 7))
+    likha("\n")
+    likha(list_insert_at(l, 1, 15))
+    likha("\n")
+    likha(list_get(l, 1))
+    likha("\n")
+    likha(list_len(l))
+    likha("\n")
+    # insert at the end appends; insert out of bounds fails
+    likha(list_insert_at(l, 4, 40))
+    likha("\n")
+    likha(list_insert_at(l, 6, 1))
+    likha("\n")
+    likha(list_remove_at(l, 0))
+    likha("\n")
+    likha(list_get(l, 0))
