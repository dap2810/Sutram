index 0000000..79b6116
--- /dev/null
+++ b/lib/list.smlib
@@ -0,0 +1,354 @@
+# lib/list.smlib — Sutram standard library: dynamic lists, stacks, queues
+#
+# Representation decision — QWORD CELLS (the pankti/kosh convention),
+# not byte strings. Reasoning:
+#   - A list is the growable analogue of pankti: same element model
+#     (one qword per element), same indexing, same literal passing
+#     (list_push(l, 42)). A byte-string list would be a string-list
+#     only, and would force every element through copy + length
+#     bookkeeping. Users with byte strings can store POINTERS
+#     (list_push(l, ptr)) — a qword list of pointers is the escape
+#     hatch, and it is the caller's job to keep the pointed-to
+#     buffers alive.
+#   - No mixing: every element in this module is a qword. Do not
+#     pass byte-string buffers here expecting string semantics, and
+#     do not pass fmt/strb outputs as elements.
+#   - dasham elements are NOT supported. An untyped parameter
+#     truncates a dasham argument to its integer part (the R15 trap),
+#     so list_push(l, 3.7) stores 3. There is no way to store a
+#     dasham bit pattern through this API. Format floats first
+#     (fmt) if you need them as text, or keep a parallel structure.
+#
+# Two handle layouts (do NOT mix families on one handle):
+#   - list / stack handle: header [len, cap, data_ptr]; data is a
+#     separate cell array. The HANDLE address is stable across
+#     growth — only the data pointer inside it moves.
+#   - queue handle: header [len, cap, data_ptr, head]; a RING BUFFER
+#     (see queue_enqueue). queue_* on a list handle (or list_* on a
+#     queue handle) reads the wrong header and corrupts memory.
+#
+# Growth rule: when len == cap, capacity DOUBLES (cap *= 2), a new
+# data array is allocated, elements are copied in logical order,
+# and the header's data pointer is updated. The old data array is
+# NOT freed — the language has no deallocation primitive, so growth
+# leaks the previous array (same as every other growing structure
+# in the stdlib). Capacity never shrinks: list_clear and queue
+# dequeue keep the allocated capacity.
+#
+# Allocation failure: if nirmmita returns 0 during growth, the
+# operation returns 0 (or ok[0] = 0) and the structure is UNCHANGED.
+# list_init returns 0 if either allocation fails.
+#
+# Out-of-bounds reads: list_get returns 0 for i outside [0, len).
+# 0 is a legal stored value, so check list_len first when it
+# matters. list_set / list_insert_at / list_remove_at return
+# 1 ok / 0 out of bounds (or allocation failure for insert).
+# stack_pop / stack_peek / queue_dequeue / queue_peek return the
+# value and set ok[0] (a 1-cell pankti) to 1 on success, 0 when
+# empty — the value alone cannot signal emptiness.
+#
+# All signatures stay within the 6-argument cap.
+
+# --- lists ---
+
+# list_init(cap) — allocate an empty list. cap clamped to >= 1.
+# Returns the list handle, or 0 on allocation failure.
+prakriya list_init(cap) {
+    vitti c = cap
+    vitti l = 0
+    vitti d = 0
+    yadi (c < 1) { c = 1 }
+    l = nirmmita(3 * 8)
+    yadi (l == 0) { pratiyati 0 }
+    d = nirmmita(c * 8)
+    yadi (d == 0) { pratiyati 0 }
+    l[0] = 0
+    l[1] = c
+    l[2] = d
+    pratiyati l
+}
+
+# list_grow(l) — private helper: double l's capacity, copying the
+# data. Returns 1 ok / 0 allocation failure (list unchanged).
+prakriya list_grow(l) {
+    vitti lst = l
+    vitti ncap = lst[1] * 2
+    vitti nd = nirmmita(ncap * 8)
+    vitti old = lst[2]
+    vitti i = 0
+    yadi (nd == 0) { pratiyati 0 }
+    yavat (i < lst[0]) {
+        nd[i] = old[i]
+        i = i + 1
+    }
+    lst[2] = nd
+    lst[1] = ncap
+    pratiyati 1
+}
+
+# list_push(l, v) — append v. Returns 1 ok / 0 allocation failure.
+prakriya list_push(l, v) {
+    vitti lst = l
+    vitti val = v
+    yadi (lst[0] == lst[1]) {
+        yadi (list_grow(lst) == 0) { pratiyati 0 }
+    }
+    vitti d = lst[2]
+    d[lst[0]] = val
+    lst[0] = lst[0] + 1
+    pratiyati 1
+}
+
+# list_get(l, i) — element i, or 0 if i is out of bounds.
+prakriya list_get(l, i) {
+    vitti lst = l
+    vitti idx = i
+    yadi (idx < 0) { pratiyati 0 }
+    yadi (idx >= lst[0]) { pratiyati 0 }
+    vitti d = lst[2]
+    pratiyati d[idx]
+}
+
+# list_set(l, i, v) — set element i. Returns 1 ok / 0 out of bounds.
+prakriya list_set(l, i, v) {
+    vitti lst = l
+    vitti idx = i
+    vitti val = v
+    yadi (idx < 0) { pratiyati 0 }
+    yadi (idx >= lst[0]) { pratiyati 0 }
+    vitti d = lst[2]
+    d[idx] = val
+    pratiyati 1
+}
+
+# list_len(l) — element count.
+prakriya list_len(l) {
+    pratiyati l[0]
+}
+
+# list_insert_at(l, i, v) — insert v before index i (i == len
+# appends). Returns 1 ok / 0 out of bounds or allocation failure.
+prakriya list_insert_at(l, i, v) {
+    vitti lst = l
+    vitti idx = i
+    vitti val = v
+    vitti d = 0
+    vitti k = 0
+    yadi (idx < 0) { pratiyati 0 }
+    yadi (idx > lst[0]) { pratiyati 0 }
+    yadi (lst[0] == lst[1]) {
+        yadi (list_grow(lst) == 0) { pratiyati 0 }
+    }
+    d = lst[2]
+    k = lst[0]
+    yavat (k > idx) {
+        d[k] = d[k - 1]
+        k = k - 1
+    }
+    d[idx] = val
+    lst[0] = lst[0] + 1
+    pratiyati 1
+}
+
+# list_remove_at(l, i) — remove element i, shifting the rest left.
+# Returns 1 ok / 0 out of bounds.
+prakriya list_remove_at(l, i) {
+    vitti lst = l
+    vitti idx = i
+    vitti d = 0
+    vitti k = 0
+    yadi (idx < 0) { pratiyati 0 }
+    yadi (idx >= lst[0]) { pratiyati 0 }
+    d = lst[2]
+    k = idx
+    yavat (k < lst[0] - 1) {
+        d[k] = d[k + 1]
+        k = k + 1
+    }
+    lst[0] = lst[0] - 1
+    pratiyati 1
+}
+
+# list_clear(l) — empty the list, keeping the allocated capacity.
+# Returns 1.
+prakriya list_clear(l) {
+    l[0] = 0
+    pratiyati 1
+}
+
+# list_contains(l, v) — 1 if any element equals v, else 0.
+prakriya list_contains(l, v) {
+    vitti lst = l
+    vitti val = v
+    vitti d = lst[2]
+    vitti i = 0
+    yavat (i < lst[0]) {
+        yadi (d[i] == val) { pratiyati 1 }
+        i = i + 1
+    }
+    pratiyati 0
+}
+
+# list_index_of(l, v) — first index with value v, or -1 if absent.
+prakriya list_index_of(l, v) {
+    vitti lst = l
+    vitti val = v
+    vitti d = lst[2]
+    vitti i = 0
+    yavat (i < lst[0]) {
+        yadi (d[i] == val) { pratiyati i }
+        i = i + 1
+    }
+    pratiyati 0 - 1
+}
+
+# --- stacks (built on the same list storage) ---
+
+# stack_push(l, v) — push v. Returns 1 ok / 0 allocation failure.
+prakriya stack_push(l, v) {
+    pratiyati list_push(l, v)
+}
+
+# stack_pop(l, ok) — pop the top value; sets ok[0] to 1 on success,
+# 0 when the stack is empty (returns 0 then).
+prakriya stack_pop(l, ok) {
+    vitti lst = l
+    vitti okp = ok
+    vitti d = 0
+    vitti val = 0
+    yadi (lst[0] == 0) {
+        okp[0] = 0
+        pratiyati 0
+    }
+    d = lst[2]
+    lst[0] = lst[0] - 1
+    val = d[lst[0]]
+    okp[0] = 1
+    pratiyati val
+}
+
+# stack_peek(l, ok) — top value without removing it; ok[0] 1/0.
+prakriya stack_peek(l, ok) {
+    vitti lst = l
+    vitti okp = ok
+    vitti d = 0
+    yadi (lst[0] == 0) {
+        okp[0] = 0
+        pratiyati 0
+    }
+    d = lst[2]
+    okp[0] = 1
+    pratiyati d[lst[0] - 1]
+}
+
+# stack_empty(l) — 1 if the stack is empty, else 0.
+prakriya stack_empty(l) {
+    yadi (l[0] == 0) { pratiyati 1 }
+    pratiyati 0
+}
+
+# --- queues (ring buffer) ---
+#
+# A queue is a RING BUFFER over the same kind of cell array: elements
+# live at data[(head + k) % cap] for logical index k. Enqueue writes
+# at the tail slot, dequeue reads at head and advances head by one
+# (mod cap). Dequeued slots are DEAD SPACE until the ring wraps
+# around and reuses them — no shifting, so dequeue is O(1). Growth
+# (len == cap) allocates a doubled array, copies elements in
+# LOGICAL order, and resets head to 0, so the buffer is re-packed.
+# The buffer only grows, never shrinks.
+
+# queue_init(cap) — allocate an empty queue. cap clamped to >= 1.
+# Returns the queue handle, or 0 on allocation failure.
+prakriya queue_init(cap) {
+    vitti c = cap
+    vitti q = 0
+    vitti d = 0
+    yadi (c < 1) { c = 1 }
+    q = nirmmita(4 * 8)
+    yadi (q == 0) { pratiyati 0 }
+    d = nirmmita(c * 8)
+    yadi (d == 0) { pratiyati 0 }
+    q[0] = 0
+    q[1] = c
+    q[2] = d
+    q[3] = 0
+    pratiyati q
+}
+
+# queue_enqueue(q, v) — append v at the tail.
+# Returns 1 ok / 0 allocation failure.
+prakriya queue_enqueue(q, v) {
+    vitti qu = q
+    vitti val = v
+    vitti d = 0
+    vitti tail = 0
+    vitti ncap = 0
+    vitti nd = 0
+    vitti old = 0
+    vitti k = 0
+    yadi (qu[0] == qu[1]) {
+        # grow: double, copy in logical order, reset head to 0
+        ncap = qu[1] * 2
+        nd = nirmmita(ncap * 8)
+        yadi (nd == 0) { pratiyati 0 }
+        old = qu[2]
+        k = 0
+        yavat (k < qu[0]) {
+            nd[k] = old[(qu[3] + k) % qu[1]]
+            k = k + 1
+        }
+        qu[2] = nd
+        qu[1] = ncap
+        qu[3] = 0
+    }
+    d = qu[2]
+    tail = (qu[3] + qu[0]) % qu[1]
+    d[tail] = val
+    qu[0] = qu[0] + 1
+    pratiyati 1
+}
+
+# queue_dequeue(q, ok) — remove and return the front value; sets
+# ok[0] to 1 on success, 0 when the queue is empty (returns 0 then).
+prakriya queue_dequeue(q, ok) {
+    vitti qu = q
+    vitti okp = ok
+    vitti d = 0
+    vitti val = 0
+    yadi (qu[0] == 0) {
+        okp[0] = 0
+        pratiyati 0
+    }
+    d = qu[2]
+    val = d[qu[3]]
+    qu[3] = (qu[3] + 1) % qu[1]
+    qu[0] = qu[0] - 1
+    okp[0] = 1
+    pratiyati val
+}
+
+# queue_peek(q, ok) — front value without removing it; ok[0] 1/0.
+prakriya queue_peek(q, ok) {
+    vitti qu = q
+    vitti okp = ok
+    vitti d = 0
+    yadi (qu[0] == 0) {
+        okp[0] = 0
+        pratiyati 0
+    }
+    d = qu[2]
+    okp[0] = 1
+    pratiyati d[qu[3]]
+}
+
+# queue_empty(q) — 1 if the queue is empty, else 0.
+prakriya queue_empty(q) {
+    yadi (q[0] == 0) { pratiyati 1 }
+    pratiyati 0
+}
+
+# queue_len(q) — element count.
+prakriya queue_len(q) {
+    pratiyati q[0]
+}
