yoj vakyank
mukhya() {
    vitti ok = nirmmita(8)
    vitti buf = nirmmita(88)
    buf[0] = 49
    buf[1] = 50
    buf[2] = 51
    buf[3] = 52
    buf[4] = 53
    buf[5] = 101
    buf[6] = 45
    buf[7] = 51
    buf[8] = 49
    buf[9] = 48
    dasham w = varna_tak_dashm(buf, 10, ok)
    yadi (w == 0.0) { likha(1) }
    yadi (w != 0.0) { likha(0) }
    likha(ok[0])
}
