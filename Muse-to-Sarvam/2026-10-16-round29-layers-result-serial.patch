new file mode 100644
index 0000000..eff2b39
--- /dev/null
+++ b/lib/result.smlib
@@ -0,0 +1,147 @@
+# lib/result.smlib — Sutram standard library: Result values (R29 WS3)
+# layer: core
+#
+# A Result is a 2-cell pankti supplied by the caller: [ok, value].
+# ok = 1 means success and value holds the answer; ok = 0 means
+# failure and value is 0. The checked functions can produce Results
+# directly (result_checked_*), and result_from_ok bridges the older
+# ok out-parameter convention into a Result.
+#
+# What this buys over the ok convention (docs/ERROR-CONVENTION.md):
+# a single value carries both the flag and the answer, so a Result
+# can be stored, passed, and returned from a function without
+# threading a separate ok cell through every call, and
+# result_value_or handles both branches in one expression.
+#
+# What it still cannot do without compiler support: nothing forces
+# the caller to check result_is_ok (the value can still be read
+# unchecked, exactly like ignoring ok); there is no propagation
+# operator (the caller still branches by hand); and there is no
+# chaining/map/and_then because the language has no callbacks.
+# A Result is a caller-owned mutable array — aliasing and mutation
+# hazards remain (no ownership model).
+
+ayojan ganita
+
+# result_ok(out, v) — write the success Result [1, v] into out.
+prakriya result_ok(out, v) {
+    vitti o = out
+    o[0] = 1
+    o[1] = v
+    pratiyati 1
+}
+
+# result_err(out) — write the failure Result [0, 0] into out.
+prakriya result_err(out) {
+    vitti o = out
+    o[0] = 0
+    o[1] = 0
+    pratiyati 0
+}
+
+# result_is_ok(r) — 1 if r is a success Result, else 0.
+prakriya result_is_ok(r) {
+    pratiyati r[0]
+}
+
+# result_value(r) — the value of a success Result. Caller must
+# check result_is_ok first: on a failure Result this returns 0,
+# which is indistinguishable from a success value of 0.
+prakriya result_value(r) {
+    pratiyati r[1]
+}
+
+# result_value_or(r, def) — the value if r is success, else def.
+# The one-expression way to handle both branches.
+prakriya result_value_or(r, def) {
+    yadi (r[0] == 1) { pratiyati r[1] }
+    pratiyati def
+}
+
+# result_from_ok(out, v, ok) — lift the ok convention into a
+# Result: writes [ok[0], v] into out (value 0 on failure).
+prakriya result_from_ok(out, v, ok) {
+    vitti o = out
+    yadi (ok[0] == 1) {
+        o[0] = 1
+        o[1] = v
+    } anyatra {
+        o[0] = 0
+        o[1] = 0
+    }
+    pratiyati o[0]
+}
+
+# result_checked_add/sub/mul/div/mod(out, a, b) — the ganita
+# checked operation, producing a Result in out instead of an
+# ok out-parameter. On overflow (or div/mod by zero, MIN/-1)
+# the Result is failure [0, 0].
+prakriya result_checked_add(out, a, b) {
+    # out doubles as the ok cell: the ganita checked form writes
+    # out[0] = ok flag and returns the value. No allocation, so
+    # this module stays core.
+    vitti o = out
+    vitti v = ganita_checked_add(a, b, o)
+    yadi (o[0] == 1) {
+        o[1] = v
+    } anyatra {
+        o[1] = 0
+    }
+    pratiyati o[0]
+}
+
+prakriya result_checked_sub(out, a, b) {
+    # out doubles as the ok cell: the ganita checked form writes
+    # out[0] = ok flag and returns the value. No allocation, so
+    # this module stays core.
+    vitti o = out
+    vitti v = ganita_checked_sub(a, b, o)
+    yadi (o[0] == 1) {
+        o[1] = v
+    } anyatra {
+        o[1] = 0
+    }
+    pratiyati o[0]
+}
+
+prakriya result_checked_mul(out, a, b) {
+    # out doubles as the ok cell: the ganita checked form writes
+    # out[0] = ok flag and returns the value. No allocation, so
+    # this module stays core.
+    vitti o = out
+    vitti v = ganita_checked_mul(a, b, o)
+    yadi (o[0] == 1) {
+        o[1] = v
+    } anyatra {
+        o[1] = 0
+    }
+    pratiyati o[0]
+}
+
+prakriya result_checked_div(out, a, b) {
+    # out doubles as the ok cell: the ganita checked form writes
+    # out[0] = ok flag and returns the value. No allocation, so
+    # this module stays core.
+    vitti o = out
+    vitti v = ganita_checked_div(a, b, o)
+    yadi (o[0] == 1) {
+        o[1] = v
+    } anyatra {
+        o[1] = 0
+    }
+    pratiyati o[0]
+}
+
+prakriya result_checked_mod(out, a, b) {
+    # out doubles as the ok cell: the ganita checked form writes
+    # out[0] = ok flag and returns the value. No allocation, so
+    # this module stays core.
+    vitti o = out
+    vitti v = ganita_checked_mod(a, b, o)
+    yadi (o[0] == 1) {
+        o[1] = v
+    } anyatra {
+        o[1] = 0
+    }
+    pratiyati o[0]
+}
diff --git a/lib/serial.smlib b/lib/serial.smlib
new file mode 100644
index 0000000..d0fb36d
--- /dev/null
+++ b/lib/serial.smlib
@@ -0,0 +1,128 @@
+# lib/serial.smlib — Sutram standard library: binary serialisation (R29 WS5)
+# layer: core
+#
+# The library's one new capability area: encode values into a flat
+# byte buffer and decode them back, with bounds checking. Format:
+#
+#   i64    — 8 bytes, little-endian, two's complement
+#   bytes  — 8-byte little-endian length (n) followed by n payload bytes
+#
+# Buffers are byte strings (char_at / set_char), caller-allocated
+# and caller-sized. Every put/get takes (buf, pos, cap): pos is the
+# cursor, cap is the buffer size in bytes. On success the function
+# returns the new cursor; on overrun (or a corrupt negative length
+# when decoding) it returns -1 and the destination buffer is
+# untouched (out_n may hold the decoded length if the length
+# itself was readable). The caller
+# owns the buffer and must check for -1, exactly like checking ok.
+#
+# put_bytes requires src and dst NOT to overlap: it writes the
+# length header before copying the payload, so an overlapping
+# src would be clobbered mid-copy. get_bytes requires buf and
+# dst not to overlap for the same reason.
+#
+# Deliberately not here: floats (the language has no bit-cast
+# primitive to turn a dasham into bits), varints (fixed-width is
+# enough for this first area), and schema/versioning (the caller
+# owns the field order; there is no header).
+
+# serial_len_bytes(n) — encoded size of an n-byte payload: 8 + n.
+prakriya serial_len_bytes(n) {
+    pratiyati 8 + n
+}
+
+# serial_put_i64(out, pos, cap, v) — write v as 8 LE bytes at
+# out+pos. Returns pos + 8, or -1 if it would overrun cap.
+prakriya serial_put_i64(out, pos, cap, v) {
+    vitti dst = out
+    vitti p = pos
+    vitti c = cap
+    vitti val = v
+    yadi (p < 0) { pratiyati 0 - 1 }
+    yadi (p + 8 > c) { pratiyati 0 - 1 }
+    vitti i = 0
+    yavat (i < 8) {
+        # Floor division: Sutram's / and % truncate toward zero,
+        # which would give a negative byte for negative val. The
+        # byte must be in [0, 255] for two's-complement LE.
+        vitti q = val / 256
+        yadi (val < 0) {
+            yadi (val % 256 != 0) { q = q - 1 }
+        }
+        set_char(dst, p + i, val - q * 256)
+        val = q
+        i = i + 1
+    }
+    pratiyati p + 8
+}
+
+# serial_get_i64(buf, pos, cap, out) — read 8 LE bytes at buf+pos,
+# write the value into out[0]. Returns pos + 8, or -1 on overrun.
+prakriya serial_get_i64(buf, pos, cap, out) {
+    vitti src = buf
+    vitti p = pos
+    vitti c = cap
+    vitti o = out
+    yadi (p < 0) { pratiyati 0 - 1 }
+    yadi (p + 8 > c) { pratiyati 0 - 1 }
+    vitti val = 0
+    vitti i = 6
+    yavat (i >= 0) {
+        val = val * 256 + char_at(src, p + i)
+        i = i - 1
+    }
+    # The top byte is signed: byte >= 128 means negative.
+    # val = top_signed * 2^56 + low, all in range, no overflow.
+    vitti top = char_at(src, p + 7)
+    yadi (top >= 128) {
+        top = top - 256
+    }
+    val = top * 72057594037927936 + val
+    o[0] = val
+    pratiyati p + 8
+}
+
+# serial_put_bytes(out, pos, cap, src, n) — write n as an 8-byte
+# LE length followed by n payload bytes from src. Returns the new
+# cursor, or -1 on overrun (n < 0 is also an error: -1).
+prakriya serial_put_bytes(out, pos, cap, src, n) {
+    vitti dst = out
+    vitti p = pos
+    vitti c = cap
+    vitti s = src
+    vitti cnt = n
+    yadi (cnt < 0) { pratiyati 0 - 1 }
+    yadi (p < 0) { pratiyati 0 - 1 }
+    yadi (p + 8 + cnt > c) { pratiyati 0 - 1 }
+    vitti p2 = serial_put_i64(dst, p, c, cnt)
+    vitti i = 0
+    yavat (i < cnt) {
+        set_char(dst, p2 + i, char_at(s, i))
+        i = i + 1
+    }
+    pratiyati p2 + cnt
+}
+
+# serial_get_bytes(buf, pos, cap, dst, out_n) — read a
+# length-prefixed payload: length into out_n[0], payload into dst.
+# Returns the new cursor, or -1 on overrun / negative length.
+prakriya serial_get_bytes(buf, pos, cap, dst, out_n) {
+    vitti src = buf
+    vitti p = pos
+    vitti c = cap
+    vitti d = dst
+    vitti on = out_n
+    # out_n doubles as the length cell for the inner read.
+    vitti p2 = serial_get_i64(src, p, c, on)
+    yadi (p2 == 0 - 1) { pratiyati 0 - 1 }
+    vitti cnt = on[0]
+    yadi (cnt < 0) { pratiyati 0 - 1 }
+    yadi (p2 + cnt > c) { pratiyati 0 - 1 }
+    vitti i = 0
+    yavat (i < cnt) {
+        set_char(d, i, char_at(src, p2 + i))
+        i = i + 1
+    }
+    on[0] = cnt
+    pratiyati p2 + cnt
+}
