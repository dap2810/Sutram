prakriya may_grow(vibhag s, kosh k) {
    kosh_kship(k, 99)
    s[0] = 77
    nivartanam s[0]
}
mukhya() {
    kosh k[4]
    kosh_kship(k, 10)
    kosh_kship(k, 20)
    kosh_kship(k, 30)
    kosh_kship(k, 40)
    kosh_kship(k, 50)
    kosh_kship(k, 60)
    kosh_kship(k, 70)
    kosh_kship(k, 80)
    vitti obstacle = nirmmita(16)
    vitti f = may_grow
    likha(f(k[2:5], k))
    likha(k[2])
}
