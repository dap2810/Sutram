# R127: Muse R127's S1 a kosh name reassigned a raw buffer - SIGSEGV on v300 (Muse-to-Sarvam/r127_ws1_reassign.sm, unchanged below).
# v301 refuses it, or bounds-checks it; this golden keeps it so.
mukhya() {
    kosh k[4]
    kosh_kship(k, 11)
    vitti p = nirmmita(16)
    p[0] = 77
    vitti a = k
    a = p
    likha(a[0])
    likha("\n")
}
