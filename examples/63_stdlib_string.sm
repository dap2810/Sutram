# Standard library: varna utilities (yoj varna)
yoj varna

mukhya()
    likha(varna_maap("hello"))
    likha("\n")
    likha(akshar_sanket("ABC", 0))
    likha("\n")
    likha(asti_ank_akshar("a5b", 1))
    likha(" ")
    likha(asti_ank_akshar("abc", 1))
    likha("\n")
    likha(asti_unnat_akshar("Abc", 0))
    likha(" ")
    likha(asti_avanat_akshar("Abc", 1))
    likha("\n")
    likha(asti_akshar_akshar("1a2", 1))
    likha(" ")
    likha(asti_akshar_akshar("1a2", 0))
    likha("\n")
    likha(gan_swar("sutram"))
    likha("\n")
