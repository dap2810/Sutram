mukhya()
    likha("Nishkriya: Inline Assembly\n")
    likha("==========================\n")
    likha("This program exits with code 42 using raw x86-64 bytes.\n")
    likha("mov eax,60 / mov edi,42 / syscall  is just:\n")
    likha("  nishkriya(\"B8 3C 00 00 00\")\n")
    likha("  nishkriya(\"BF 2A 00 00 00\")\n")
    likha("  nishkriya(\"0F 05\")\n")
    likha("Exiting with code 42...\n")
    nishkriya("B8 3C 00 00 00")
    nishkriya("BF 2A 00 00 00")
    nishkriya("0F 05")
