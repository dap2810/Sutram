mukhya()
    likha("Yantra: Inline Assembly\n")
    likha("==========================\n")
    likha("This program exits with code 42 using raw x86-64 bytes.\n")
    likha("mov eax,60 / mov edi,42 / syscall  is just:\n")
    likha("  yantra(\"B8 3C 00 00 00\")\n")
    likha("  yantra(\"BF 2A 00 00 00\")\n")
    likha("  yantra(\"0F 05\")\n")
    likha("Exiting with code 42...\n")
    yantra("B8 3C 00 00 00")
    yantra("BF 2A 00 00 00")
    yantra("0F 05")
