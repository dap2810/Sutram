# Stage 2 acceptance: a call can mutate shared typed kosh storage.
# Never reorder reads across the call or make assumptions about its effects.
prakriya vardh_avayav(kosh dasham ank_suchi) {
    ank_suchi[0] = ank_suchi[0] + 1.0
    nivartanam ank_suchi[0]
}
mukhya() {
    kosh dasham ank_suchi[1]
    kosh_push(ank_suchi, 2.0)
    dasham a = 3.0
    dasham b = 0.5
    dasham c = 4.0
    dasham d = 5.0
    a = a + b
    c = a + vardh_avayav(ank_suchi)
    d = d + ank_suchi[0]
    a = a + b
    likha(a)
    likha(c)
    likha(d)
    likha(ank_suchi[0])
}
