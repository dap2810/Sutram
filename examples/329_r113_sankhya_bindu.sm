# R115: sankhya_bindu (and the old sankhya_dot) is withdrawn - refused when compiled, E_PRATYAHRITA.
# v292 read four 32-bit floats; v293's integer loop was wrong for a kosh dasham (it multiplied the float
# bits). Two kosh dasham are dotted by the library: yoj sankhyiki, then bindu_gunan(a, b).
mukhya() {
    kosh dasham a[4]
    kosh_kship(a, 2.5)
    kosh_kship(a, 1.5)
    likha(sankhya_bindu(a, a, 2))
}
