# R127: Muse R127's O1 a prakriya's kosh result, unmarked - a[100] printed 0 on v300 (Muse-to-Sarvam/r127_ws1_callresult.sm, unchanged below).
# v301 refuses it, or bounds-checks it; this golden keeps it so.
prakriya make_kosh() {
    kosh k[4]
    kosh_kship(k, 11)
    nivartanam k
}
mukhya() {
    vitti a = make_kosh()
    likha(a[100])
    likha("\n")
}
