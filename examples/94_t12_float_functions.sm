# T12 function interoperability: typed dasham parameters, forward-call return
# inference, integer promotion at calls, mixed returns, and float->int assignment.

prakriya wrapper(dasham x) {
    pratiyati twice(x)
}

prakriya twice(dasham x) {
    pratiyati x * 2
}

prakriya blend(dasham a, दशम b) {
    pratiyati (a + b) / 2.0
}

prakriya mixed(flag) {
    yadi (flag) {
        pratiyati 1.25
    }
    pratiyati 2
}

# Mixed ternary branches must normalize to the inferred float return type.
prakriya choose(flag) {
    pratiyati flag ? 1.5 : 2
}

mukhya() {
    likha(wrapper(1.25))
    likha(blend(1, 4.0))
    likha(mixed(1))
    likha(mixed(0))
    likha(choose(1))
    likha(choose(0))

    vitti whole = blend(1.0, 4.0)
    likha(whole)
}
