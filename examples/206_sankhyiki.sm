# Statistics library over a typed float mala (kosh dasham).
# Textbook dataset [2,4,4,4,5,5,7,9]: mean 5, population variance 4,
# population stddev 2, min 2, max 9, range 7, sum 40.
yoj sankhyiki

mukhya() {
    kosh dasham ank_suchi[4]
    kosh_push(ank_suchi, 2)
    kosh_push(ank_suchi, 4)
    kosh_push(ank_suchi, 4)
    kosh_push(ank_suchi, 4)
    kosh_push(ank_suchi, 5)
    kosh_push(ank_suchi, 5)
    kosh_push(ank_suchi, 7)
    kosh_push(ank_suchi, 9)

    likha(kosh_len(ank_suchi))
    likha(yoga(ank_suchi))
    likha(madhya(ank_suchi))
    likha(prasaran(ank_suchi))
    likha(vichalan(ank_suchi))
    likha(laghutama(ank_suchi))
    likha(adhikatama(ank_suchi))
    likha(vyapti(ank_suchi))
}
