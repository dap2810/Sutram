# An integer kosh holds whole numbers. A dasham stored in one must be whole: 2.0 is stored
# as 2, and a fraction stops the program (E_DASHAM_VITTI, v281). Up to v280, 2.9 was stored
# as 2 and 4.8 as 4, silently.
mukhya() {
    kosh a[1]
    kosh_push(a, 2.0)
    likha(a[0])
    dasham d = 4.8
    a[0] = d
    likha(kosh_pop(a))
}
