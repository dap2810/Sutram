# Dot product and Euclidean norm over typed float arrays.
# a = (3, 4)  -> norm 5 (the 3-4-5 triangle)
# b = (1, 2)  -> dot(a,b) = 3*1 + 4*2 = 11
# c has three numbers against a's two: since R116 (R189 row 14) that is refused -
# E_AKARA_ASAMYA on stderr, exit 1 - where v295 silently used the shorter length (7).
yoj sankhyiki

mukhya() {
    kosh dasham a[2]
    kosh_push(a, 3)
    kosh_push(a, 4)

    kosh dasham b[2]
    kosh_push(b, 1)
    kosh_push(b, 2)

    likha(bindu_gunan(a, b))
    likha(manak(a))

    kosh dasham c[2]
    kosh_push(c, 1)
    kosh_push(c, 1)
    kosh_push(c, 1)
    likha(bindu_gunan(a, c))
}
