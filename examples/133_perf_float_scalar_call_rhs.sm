# PERF-FG1: a register-resident dasham local is the LHS of a float
# operation whose RHS is a function call. The caller-local scalar must
# survive the function call; all four operator orders must be preserved.
prakriya dwigun(dasham x) {
    prati x * 2.0
}
prakriya ardh(dasham x) {
    prati x / 2.0
}
mukhya() {
    dasham s = 10.0
    dasham x = 2.0
    s = s + dwigun(x)
    likha(s)
    s = s - ardh(x)
    likha(s)
    s = s * dwigun(x)
    likha(s)
    s = s / ardh(x)
    likha(s)
    likha(x)
    vitti two = 2
    s = s + two
    likha(s)
    vitti truth = 0
    truth = s > ardh(x)
    likha(truth)
}
