# FizzBuzz — the classic interview problem
mukhya()
    vitti i = 1
    yavat (i <= 30) {
        vitti mod3 = i - i / 3 * 3
        vitti mod5 = i - i / 5 * 5
        yadi (mod3 == 0) {
            yadi (mod5 == 0) {
                likha("FizzBuzz\n")
            } anya {
                likha("Fizz\n")
            }
        } anya {
            yadi (mod5 == 0) {
                likha("Buzz\n")
            } anya {
                likha(i)
                likha("\n")
            }
        }
        i = i + 1
    }
