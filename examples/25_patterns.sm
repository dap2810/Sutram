mukhya()
    likha("Number Pyramid:\n")
    chakra i = 1 tak 5 {
        chakra j = 1 tak i {
            likha("* ")
        }
        likha("\n")
    }
    likha("\nTable of 7:\n")
    chakra n = 1 tak 10 {
        likha(7)
        likha(" x ")
        likha(n)
        likha(" = ")
        likha(7 * n)
        likha("\n")
    }
