# Prime number checker
mukhya()
    vitti n = 2
    yavat (n <= 20) {
        vitti asti_abhajya = 1
        vitti d = 2
        yavat (d < n) {
            vitti rem = n - n / d * d
            yadi (rem == 0) {
                asti_abhajya = 0
            }
            d = d + 1
        }
        likha(n)
        likha(" is ")
        yadi (asti_abhajya == 1) {
            likha("prime\n")
        } anya {
            likha("not prime\n")
        }
        n = n + 1
    }
