# R23 WS2: methods on a rachana. `prakriya Rachana.naam(swa, ...)` declares a
# method; `x.naam(...)` calls it with x as the first argument. A method is found
# by its name, as a field is: two rachanas may not both have a method `naam`.

rachana Bindu = { x, y }
rachana Ayat = { chaudai, lambai }

prakriya Bindu.srij(swa, x, y) {
    swa.x = x
    swa.y = y
    prati swa
}

prakriya Bindu.chal(swa, dx, dy) {
    swa.x = swa.x + dx
    swa.y = swa.y + dy
    prati 0
}

prakriya Bindu.manhattan(swa, anya_bindu) {
    vitti dx = swa.x - anya_bindu.x
    vitti dy = swa.y - anya_bindu.y
    yadi (dx < 0) {
        dx = 0 - dx
    }
    yadi (dy < 0) {
        dy = 0 - dy
    }
    prati dx + dy
}

prakriya Ayat.kshetraphal(swa) {
    prati swa.chaudai * swa.lambai
}

prakriya Ayat.paridhi(swa) {
    prati 2 * (swa.chaudai + swa.lambai)
}

mukhya() {
    vitti p = nirmmita(16)
    vitti q = nirmmita(16)
    p.srij(1, 2)
    q.srij(4, 6)
    likha(p.manhattan(q))
    p.chal(3, 4)
    likha(p.x)
    likha(p.y)
    likha(p.manhattan(q))
    vitti r = nirmmita(16)
    r.chaudai = 3
    r.lambai = 5
    likha(r.kshetraphal())
    likha(r.paridhi() + r.kshetraphal())
}
