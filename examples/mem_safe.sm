# Memory safety demo — bounds-checked read/write
mukhya()
    vitti koshtha = nirmmita(64)
    likh8c(koshtha, 42, koshtha + 64)
    likh8c(koshtha + 8, 99, koshtha + 64)
    vitti v1 = pad8c(koshtha, koshtha + 64)
    likha("v1 = ", v1)
    smaran(koshtha, 0, 64)
    likha("After memset: ", pad8c(koshtha, koshtha + 64))
    likha("Memory safety OK!\n")
