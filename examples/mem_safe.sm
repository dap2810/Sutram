# Memory safety demo — bounds-checked read/write
mukhya()
    vitti buf = nirmmita(64)
    likh8c(buf, 42, buf + 64)
    likh8c(buf + 8, 99, buf + 64)
    vitti v1 = pad8c(buf, buf + 64)
    likha("v1 = ")
    likha(v1)
    likha("\n")
    smaran(buf, 0, 64)
    likha("After memset: ")
    likha(pad8c(buf, buf + 64))
    likha("\n")
    likha("Memory safety OK!\n")
