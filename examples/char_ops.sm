# Character operations demo
mukhya()
    vitti s = "Hello"
    vitti c0 = akshar(s, 0)
    likha("First char code: ", c0)
    vitti code = aksharank("A")
    likha("ASCII of A: ", code)
    vitti lower_a = aksharank("a")
    vitti upper_a = char_upper(lower_a)
    likha("Upper of a: ", upper_a)
    likha("Done!\n")
