# Sutra (constants) and bitwise operators
# sutra = rule/formula in Sanskrit

mukhya()
    sutra MAX_VAL = 100

    likha("=== Sutra & Bitwise ===\n")

    likha("MAX_VAL = ", MAX_VAL)

    vitti rem = 17 % 5
    likha("17 % 5 = ", rem)

    vitti a = 12 & 10
    likha("12 & 10 = ", a)

    vitti b = 12 | 10
    likha("12 | 10 = ", b)

    vitti c = 12 ^ 10
    likha("12 ^ 10 = ", c)

    vitti x = 42
    abhava(x > 0)
    likha("Assert passed\n")

    likha("=== Done ===\n")
