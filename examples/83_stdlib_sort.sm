# Standard library: sorting and searching (yoj shreni)
yoj shreni

mukhya()
    mala a[6]
    a[0] = 5
    a[1] = 2
    a[2] = 9
    a[3] = 1
    a[4] = 7
    a[5] = 3
    likha(asti_sorted(a, 6))
    likha("\n")
    budbud_shreni(a, 6)
    vitti i = 0
    yavat (i < 6) {
        likha(a[i])
        likha(" ")
        i = i + 1
    }
    likha("\n")
    likha(asti_sorted(a, 6))
    likha("\n")
    likha(dwi_anwesh(a, 6, 7))
    likha("\n")
    likha(laghu(a, 6))
    likha(" ")
    likha(adhik(a, 6))
    likha(" ")
    likha(yog(a, 6))
    likha("\n")
    likha(anwesh_sarak(a, 6, 9))
    likha(" ")
    likha(gan(a, 6, 5))
    likha("\n")
    viparyay_mala(a, 6)
    likha(a[0])
    likha("\n")
