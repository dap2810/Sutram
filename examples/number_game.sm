# Number guessing game
mukhya()
    vitti secret = 42
    vitti guess = 50
    likha("Guessing game!\n")
    likha("Secret: ", secret)
    yadi (guess == secret) {
        likha("Correct!\n")
    } anya {
        yadi (guess > secret) {
            likha("Too high!\n")
        } anya {
            likha("Too low!\n")
        }
        likha("The answer was: ", secret)
    }
    likha("Game over!\n")
