mukhya()
    likha("Unit Conversion\n")
    likha("==============\n")
    likha("Kilometers to Miles:\n")
    chakra km = 1 tak 5 {
        vitti miles = km * 62 / 100
        likha_santat(km)
        likha(" km = ")
        likha_santat(miles)
        likha(" miles\n")
    }
    likha("\nKilograms to Pounds:\n")
    chakra kg = 1 tak 5 {
        vitti pounds = kg * 220 / 100
        likha_santat(kg)
        likha(" kg = ")
        likha_santat(pounds)
        likha(" lbs\n")
    }
    likha("\nCelsius to Fahrenheit:\n")
    chakra c = 0 tak 40 {
        vitti f = c * 9 / 5 + 32
        likha_santat(c)
        likha("C = ")
        likha_santat(f)
        likha("F\n")
        c += 9
    }
    likha("\n")
