mukhya()
    likha("Increment / Decrement Demo\n")
    likha("==========================\n")
    vitti x = 5
    likha("x = ", x)
    x++
    likha("x++ -> ", x)
    x++
    likha("x++ -> ", x)
    x--
    likha("x-- -> ", x)
    likha("\nCounting with ++:\n")
    vitti count = 0
    chakra i = 1 tak 5 {
        count++
    }
    likha("count = ", count)
    likha("\nSquares table with ++:\n")
    vitti n = 1
    chakra i = 1 tak 5 {
        vitti varg = n * n
        lkhb(n)
        likha(" squared = ", varg)
        n++
    }
    likha("\n")
