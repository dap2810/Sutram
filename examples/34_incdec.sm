mukhya()
    likha("Increment / Decrement Demo\n")
    likha("==========================\n")
    vitti x = 5
    likha("x = ")
    likha(x)
    likha("\n")
    x++
    likha("x++ -> ")
    likha(x)
    likha("\n")
    x++
    likha("x++ -> ")
    likha(x)
    likha("\n")
    x--
    likha("x-- -> ")
    likha(x)
    likha("\n")
    likha("\nCounting with ++:\n")
    vitti count = 0
    chakra i = 1 tak 5 {
        count++
    }
    likha("count = ")
    likha(count)
    likha("\n")
    likha("\nSquares table with ++:\n")
    vitti n = 1
    chakra i = 1 tak 5 {
        vitti varg = n * n
        lkhb(n)
        likha(" squared = ")
        lkhb(varg)
        likha("\n")
        n++
    }
    likha("\n")
