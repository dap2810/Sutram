# R107/R108: a kosh made in a block given to a prakriya that keeps it (here: returns it). Up to v289
# the program ran and the runtime check (R82) stopped it after the block. From v290 the compiler
# refuses the call - E_KOSH_MANDAPA, the prakriya keeps it - so no reference to a block's kosh can
# outlive the block. A prakriya that only reads its kosh parameter (padh) may be given one.
prakriya rakh(kosh k) {
    nivartanam k
}

prakriya padh(kosh k, i) {
    nivartanam k[i]
}

mukhya() {
    kosh bahar[1]
    mandapa {
        kosh k[4]
        kosh_push(k, 11)
        bahar = rakh(k)
        likha(padh(bahar, 0))
    }
    likha(padh(bahar, 0))
    likha("yah pankti na chalati\n")
}
