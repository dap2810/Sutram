mukhya()
    likha("Compound Assignment Demo\n")
    likha("=======================\n")
    vitti x = 100
    likha("Start: ", x)
    x += 50
    likha("x += 50 -> ", x)
    x -= 30
    likha("x -= 30 -> ", x)
    x *= 2
    likha("x *= 2  -> ", x)
    x /= 4
    likha("x /= 4  -> ", x)
    x %= 7
    likha("x %= 7  -> ", x)
    likha("\nSum 1 to 10 using += :\n")
    vitti sarva_yog = 0
    chakra i = 1 tak 10 {
        sarva_yog += i
    }
    likha("Total: ", sarva_yog)
    likha("\nFactorial of 5 using *= :\n")
    vitti kramgun = 1
    chakra n = 1 tak 5 {
        kramgun *= n
    }
    likha("5! = ", kramgun)
