# brahmagupta_kshetr: exact areas; four sides of 2^63 - 1 give an area past int64 - refused (R116, R189 row 8).
yoj ganita

mukhya() {
    likha(brahmagupta_kshetr(3, 3, 3, 3))
    likha(brahmagupta_kshetr(1, 1, 2, 3))
    likha(brahmagupta_kshetr(2, 3, 4, 0))
    likha(brahmagupta_kshetr(1, 1, 1, 3))
    likha(brahmagupta_kshetr(3037000499, 3037000499, 3037000499, 3037000499))
    likha(brahmagupta_kshetr(9223372036854775807, 9223372036854775807, 9223372036854775807, 9223372036854775807))
    likha(1)
}
