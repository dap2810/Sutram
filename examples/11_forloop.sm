# For loop (chakra) example
# chakra = "repetition/iteration"

mukhya()
    likha("=== For Loop Demo ===\n")
    
    # Count 0 tak 5
    likha("Count: ")
    chakra i = 0 tak 5 {
        likha(i)
        likha(" ")
    }
    likha("\n")
    
    # Sum 1 tak 10
    vitti sum = 0
    chakra j = 1 tak 10 {
        sum = sum + j
    }
    likha("Sum 1-10 = ")
    likha(sum)
    likha("\n")
    
    # Multiplication table for 3
    likha("Table of 3:\n")
    chakra k = 1 tak 5 {
        likha("3 x ")
        likha(k)
        likha(" = ")
        likha(3 * k)
        likha("\n")
    }
    
    likha("=== Done ===\n")
