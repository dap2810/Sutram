# R66 Gujarati example: --lang gujarati; native numerals and U+0AF0 aliases.
ફ૰ બમણું(x) { પા૰ x * ૨ }
મુખ્ય() {
    ચ૰ કુલ = ૦।
    ચ૰ ઇ = ૧।
    જ્યાંસુધી (ઇ <= ૫) {
        કુલ = કુલ + ઇ।
        ઇ = ઇ + ૧॥
    }
    લ૰(કુલ)।
    લ૰(બમણું(૩))।
    કોશ q[૧]
    લ૰(કોશજોડો(q, ૭))
    લ૰(કોશછેલ્લું(q))
    લ૰(કોશપહેલું(q))
    લ૰(કોશખાલી(q))
}
