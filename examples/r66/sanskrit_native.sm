# R66 Sanskrit example: --lang sanskrit; U+0970 aliases, not new punctuation.
प्र॰ दुगुण(x) { प॰ x * २ }
मुख्य() {
    वि॰ योग = ०।
    वि॰ इ = १।
    यावत् (इ <= ५) {
        योग = योग + इ।
        इ = इ + १॥
    }
    लि॰(योग)।
    लि॰(दुगुण(३))।
    कोश q[१]
    लि॰(कोशप्रवेश(q, ७))
    लि॰(कोशशिखर(q))
    लि॰(कोशनिर्गम(q))
    लि॰(कोशरिक्त(q))
}
