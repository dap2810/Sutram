mukhya()
    likha("lkhb: Formatted Output Demo\n")
    likha("===========================\n")
    likha("Multiplication table (aligned):\n")
    chakra i = 1 tak 5 {
        chakra j = 1 tak 5 {
            vitti p = i * j
            yadi (p < 10) {
                lkhb(p)
                likha("  ")
            } anya {
                lkhb(p)
                likha(" ")
            }
        }
        likha("\n")
    }
    likha("\nCountdown: ")
    vitti n = 5
    chakra i = 1 tak 5 {
        lkhb(n)
        likha(" ")
        n--
    }
    likha("Done!\n")
