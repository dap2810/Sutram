prakriya rakh_shunya(a, v) {
    a[0] = v
    prati v
}

mukhya() {
    mala a[1]
    a[0] = 10

    likha(0 && rakh_shunya(a, 20))
    likha(a[0])

    likha(1 || rakh_shunya(a, 30))
    likha(a[0])

    likha(1 && rakh_shunya(a, 40))
    likha(a[0])

    likha(0 || rakh_shunya(a, 50))
    likha(a[0])
}
