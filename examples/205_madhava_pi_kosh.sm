# Madhava's pi series, accumulating each term in a typed growable float mala (kosh dasham).
# pi/4 = 1 - 1/3 + 1/5 - 1/7 + ...   (Kerala school, c. 1400 CE)
# 9 terms -> 4 * 0.813092 = 3.252366 (partial sum; converges to pi as terms grow)
mukhya() {
    kosh dasham pada_kosh[4]
    dasham chinha = 1.0
    vitti k = 0
    yavat (k < 9) {
        dasham denom = 2 * k + 1
        kosh_push(pada_kosh, chinha / denom)
        chinha = chinha * -1.0
        k = k + 1
    }
    likha(kosh_len(pada_kosh))
    dasham sankalan = 0.0
    vitti i = 0
    yavat (i < kosh_len(pada_kosh)) {
        sankalan = sankalan + pada_kosh[i]
        i = i + 1
    }
    likha(sankalan * 4.0)
}
