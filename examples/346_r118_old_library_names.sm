# R118 (1 of 2; the roop names are in 347): the ten library prakriya with an English word in their names. Each is called here by its OLD name:
# it still compiles - to the same bytes as the new name (tests/r118/test_lib_aliases.py checks that) - and
# the compiler prints one warning per name on stderr (the `R118 library names` gate checks them):
#   Sutram suchana: 'bit_gan' purana nama - 'ekanka_gan' likhatu
# New code writes the new names (docs/LANGUAGE-REFERENCE.md section 4c).
yoj ganit
yoj sangrah
yoj vakyank
yoj shreni
yoj suchi

mukhya() {
    likha(bit_gan(255))
    likha(bit_gan(bit_gan(1023)))

    vitti s1 = rakh_srij(8)
    vitti s2 = rakh_srij(8)
    vitti s3 = rakh_srij(16)
    rakh_yuj(s1, 8, "a", 1)
    rakh_yuj(s1, 8, "b", 1)
    rakh_yuj(s2, 8, "b", 1)
    rakh_yuj(s2, 8, "c", 1)
    likha(rakh_samroop_diff(s1, 8, s2, 8, s3))

    vitti buf = nirmmita(10 * 8)
    ank_tak_varna(7, buf)
    likha(pad_vam(buf, 1, 3, 48))

    mala a[4]
    a[0] = 1
    a[1] = 2
    a[2] = 2
    a[3] = 5
    likha(asti_sorted(a, 4))
    a[3] = 0
    likha(asti_sorted(a, 4))

    vitti l = suchi_srij(8)
    suchi_khip(l, 3)
    suchi_khip(l, 9)
    likha(suchi_asti_sorted(l))
}
