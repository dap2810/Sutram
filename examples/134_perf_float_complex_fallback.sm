# PERF-FG1 guards: indexed LHS and nested function-call expressions remain
# on the generic path; scalar local can be read after call expressions.
prakriya dasham_nirm(dasham x) {
    nivartanam x + 0.5
}
mukhya() {
    kosh dasham datt[2]
    kosh_push(datt, 3.0)
    kosh_push(datt, 8.0)
    dasham sarva_yog = 1.0
    sarva_yog = sarva_yog + dasham_nirm(datt[0])
    likha(sarva_yog)
    sarva_yog = sarva_yog * (dasham_nirm(datt[0]) + dasham_nirm(datt[1]))
    likha(sarva_yog)
    sarva_yog = sarva_yog - datt[1]
    likha(sarva_yog)
    sarva_yog = sarva_yog / dasham_nirm(0.5)
    likha(sarva_yog)
    likha(datt[0])
}
