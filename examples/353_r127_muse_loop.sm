# R127: Muse R127's S3 the reassignment inside a loop - SIGSEGV on v300 (Muse-to-Sarvam/r127_ws1_loop.sm, unchanged below).
# v301 refuses it, or bounds-checks it; this golden keeps it so.
mukhya() {
    kosh k[4]
    kosh_kship(k, 11)
    vitti p = nirmmita(16)
    p[0] = 77
    vitti a = k
    vitti i = 0
    yavat (i < 2) {
        a = p
        i = i + 1
    }
    likha(a[0])
    likha("\n")
}
