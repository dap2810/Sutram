# R30: nested expression LHS + safe scalar RHS, including a function call.
prakriya yog_ardh(dasham x) {
    nivartanam x + 0.5
}
mukhya() {
    kosh dasham datt[2]
    kosh_push(datt, 4.0)
    kosh_push(datt, 6.0)
    dasham gun_maap = 2.0
    dasham nirgat = 0.0
    nirgat = (datt[0] + datt[1]) * gun_maap
    likha(nirgat)
    nirgat = (yog_ardh(datt[0]) * yog_ardh(datt[1])) + gun_maap
    likha(nirgat)
    nirgat = yog_ardh(datt[1]) / gun_maap
    likha(nirgat)
    nirgat = (datt[0] + datt[1]) - gun_maap
    likha(nirgat)
}
