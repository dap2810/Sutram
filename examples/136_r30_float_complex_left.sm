# R30: nested expression LHS + safe scalar RHS, including a function call.
prakriya yog_ardh(dasham x) {
    nivartanam x + 0.5
}
mukhya() {
    kosh dasham data[2]
    kosh_push(data, 4.0)
    kosh_push(data, 6.0)
    dasham gun_maap = 2.0
    dasham out = 0.0
    out = (data[0] + data[1]) * gun_maap
    likha(out)
    out = (yog_ardh(data[0]) * yog_ardh(data[1])) + gun_maap
    likha(out)
    out = yog_ardh(data[1]) / gun_maap
    likha(out)
    out = (data[0] + data[1]) - gun_maap
    likha(out)
}
