# Standard library: shell shreni (faster than budbud_shreni for real arrays)
yoj shreni

mukhya()
    mala a[8]
    a[0] = 9
    a[1] = 3
    a[2] = 7
    a[3] = 1
    a[4] = 8
    a[5] = 2
    a[6] = 6
    a[7] = 4
    likha(asti_sorted(a, 8))
    likha("\n")
    shankh_shreni(a, 8)
    vitti i = 0
    yavat (i < 8) {
        likha(a[i])
        likha(" ")
        i = i + 1
    }
    likha("\n")
    likha(asti_sorted(a, 8))
    likha("\n")
