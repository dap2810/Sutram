# Standard library: shell sort (faster than bubble_sort for real arrays)
ayojan sort

mukhya()
    pankti a[8]
    a[0] = 9
    a[1] = 3
    a[2] = 7
    a[3] = 1
    a[4] = 8
    a[5] = 2
    a[6] = 6
    a[7] = 4
    likha(is_sorted(a, 8))
    likha("\n")
    shell_sort(a, 8)
    vitti i = 0
    yavat (i < 8) {
        likha(a[i])
        likha(" ")
        i = i + 1
    }
    likha("\n")
    likha(is_sorted(a, 8))
    likha("\n")
