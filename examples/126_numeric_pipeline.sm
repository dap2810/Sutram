# Representative end-tak-end numerical application, not an isolated micro-kernel.
# Includes two real library modules and typed kosh parameter chains.
yoj sankhyiki
yoj madhava

prakriya maap(kosh dasham mulya) {
    # 5 + 4 + 2 = 11 for the textbook dataset.
    nivartanam madhya(mulya) + prasaran(mulya) + vichalan(mulya)
}

mukhya() {
    kosh dasham mulya[4]
    kosh_kship(mulya, 2)
    kosh_kship(mulya, 4)
    kosh_kship(mulya, 4)
    kosh_kship(mulya, 4)
    kosh_kship(mulya, 5)
    kosh_kship(mulya, 5)
    kosh_kship(mulya, 7)
    kosh_kship(mulya, 9)

    kosh dasham u[2]
    kosh_kship(u, 3)
    kosh_kship(u, 4)
    kosh dasham v[2]
    kosh_kship(v, 1)
    kosh_kship(v, 2)

    # Repeated full statistical pipelines: mala traversals, nested function
    # calls, floating-point arithmetic, Newton sqrt, branches and loops.
    dasham sarva_yog = 0.0
    vitti i = 0
    yavat (i < 100000) {
        sarva_yog = sarva_yog + maap(mulya)
        i = i + 1
    }
    likha(sarva_yog)
    likha(bindu_gunan(u, v))
    likha(manak(u))
    likha(madhava_pi())
}
