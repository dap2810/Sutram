# Function demo — prakriya with call/ret
mukhya()
    likha("=== Function Demo ===\n")
    likha("Calling abhivadan()...\n")
    abhivadan()
    likha("Calling ganit()...\n")
    ganit()
    likha("Calling uttar()...\n")
    vitti x = uttar()
    likha("uttar() = ", x)
    likha("Done!\n")

prakriya abhivadan()
    likha("  Namaste from abhivadan()!\n")

prakriya ganit()
    likha("  10 + 32 = 42\n")

prakriya uttar()
    nivartanam 42
