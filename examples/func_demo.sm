# Function demo — prakriya with call/ret
mukhya()
    likha("=== Function Demo ===\n")
    likha("Calling greet()...\n")
    greet()
    likha("Calling math()...\n")
    ganit()
    likha("Calling answer()...\n")
    vitti x = answer()
    likha("answer() = ")
    likha(x)
    likha("\n")
    likha("Done!\n")

prakriya greet()
    likha("  Namaste from greet()!\n")

prakriya ganit()
    likha("  10 + 32 = 42\n")

prakriya answer()
    prati 42
