# R12 program 2: expression evaluator — khand scanning + integer ganit.
# Grammar: expr := term (('+'|'-') term)* ; term := factor (('*'|'/') factor)*
#          factor := number | '(' expr ')' . Integers only.
# State is an mala [src, len, pos] passed explicitly (no globals in Sutram).
yoj khand

prakriya skip_ws(avastha) {
    yavat (avastha[2] < avastha[1]) {
        yadi (akshar(avastha[0], avastha[2]) != 32) { nivartanam 0 }
        avastha[2] = avastha[2] + 1
    }
    nivartanam 0
}

prakriya parse_num(avastha) {
    vitti v = 0
    vitti c = 0
    skip_ws(avastha)
    yavat (avastha[2] < avastha[1]) {
        c = akshar(avastha[0], avastha[2])
        yadi (c < 48 || c > 57) { nivartanam v }
        v = v * 10 + (c - 48)
        avastha[2] = avastha[2] + 1
    }
    nivartanam v
}

prakriya parse_factor(avastha) {
    vitti v = 0
    skip_ws(avastha)
    yadi (avastha[2] < avastha[1]) {
        yadi (akshar(avastha[0], avastha[2]) == 40) {
            avastha[2] = avastha[2] + 1
            v = parse_expr(avastha)
            skip_ws(avastha)
            yadi (avastha[2] < avastha[1]) {
                yadi (akshar(avastha[0], avastha[2]) == 41) { avastha[2] = avastha[2] + 1 }
            }
            nivartanam v
        }
    }
    nivartanam parse_num(avastha)
}

prakriya parse_term(avastha) {
    vitti v = parse_factor(avastha)
    vitti op = 0
    vitti rhs = 0
    vitti cont = 1
    yavat (cont == 1) {
        skip_ws(avastha)
        cont = 0
        yadi (avastha[2] < avastha[1]) {
            op = akshar(avastha[0], avastha[2])
            yadi (op == 42 || op == 47) {
                avastha[2] = avastha[2] + 1
                rhs = parse_factor(avastha)
                yadi (op == 42) { v = v * rhs } anya { v = v / rhs }
                cont = 1
            }
        }
    }
    nivartanam v
}

prakriya parse_expr(avastha) {
    vitti v = parse_term(avastha)
    vitti op = 0
    vitti rhs = 0
    vitti cont = 1
    yavat (cont == 1) {
        skip_ws(avastha)
        cont = 0
        yadi (avastha[2] < avastha[1]) {
            op = akshar(avastha[0], avastha[2])
            yadi (op == 43 || op == 45) {
                avastha[2] = avastha[2] + 1
                rhs = parse_term(avastha)
                yadi (op == 43) { v = v + rhs } anya { v = v - rhs }
                cont = 1
            }
        }
    }
    nivartanam v
}

prakriya eval(s, n) {
    vitti avastha = nirmmita(3 * 8)
    avastha[0] = s
    avastha[1] = n
    avastha[2] = 0
    nivartanam parse_expr(avastha)
}

mukhya() {
    likha(eval("2+3*4", 5))
    likha("\n")
    likha(eval("(2+3)*4", 7))
    likha("\n")
    likha(eval("10-4/2", 6))
    likha("\n")
    likha(eval("100/(5+5)", 9))
    likha("\n")
}
