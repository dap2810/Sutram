# T18 growable mala: growth, indexing, assignment, pop, len/cap.
mukhya() {
    kosh a[1]
    likha(kosh_gan(a))
    likha(kosh_ksham(a))
    likha(kosh_kship(a, 10))
    likha(kosh_kship(a, 20))
    likha(kosh_ksham(a))
    likha(kosh_kship(a, 30))
    likha(kosh_ksham(a))
    likha(a[0])
    likha(a[1])
    a[1] = 25
    likha(a[1])
    likha(kosh_hri(a))
    likha(kosh_gan(a))
    likha(kosh_ksham(a))
}
