# R30: literals are side-effect-free, safe tak materialize after indexed LHS.
prakriya dwi_gun(dasham x) {
    nivartanam x * 2.0
}
mukhya() {
    kosh dasham mulya[2]
    kosh_push(mulya, 3.0)
    kosh_push(mulya, 5.0)
    dasham nirgat = 0.0
    nirgat = mulya[0] + 2.5
    likha(nirgat)
    nirgat = mulya[1] - 1.5
    likha(nirgat)
    nirgat = (mulya[0] + mulya[1]) * 3.0
    likha(nirgat)
    nirgat = dwi_gun(mulya[0]) / 2
    likha(nirgat)
}
