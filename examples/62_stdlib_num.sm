# Standard library: number utilities (ayojan num)
ayojan num

mukhya()
    likha(is_even(8))
    likha(" ")
    likha(is_odd(8))
    likha("\n")
    likha(digit_count(90210))
    likha("\n")
    likha(digit_sum(90210))
    likha("\n")
    likha(reverse_num(1234))
    likha("\n")
    likha(is_palindrome(1331))
    likha(" ")
    likha(is_palindrome(1234))
    likha("\n")
    likha(clamp(15, 0, 10))
    likha("\n")
