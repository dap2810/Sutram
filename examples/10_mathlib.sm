yoj ganit
mukhya()
    likha("=== Math Library ===\n")
    vitti s = vargit(9)
    likha("square(9) = ")
    likha(s)
    likha("\n")
    vitti d = dvigun(21)
    likha("double(21) = ")
    likha(d)
    likha("\n")
    vitti t = trigun(14)
    likha("triple(14) = ")
    likha(t)
    likha("\n")
    vitti i = vardh(41)
    likha("inc(41) = ")
    likha(i)
    likha("\n")
    likha("=== Done ===\n")
