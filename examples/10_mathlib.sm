ayojan math
mukhya()
    likha("=== Math Library ===\n")
    vitti s = square(9)
    likha("square(9) = ")
    likha(s)
    likha("\n")
    vitti d = double(21)
    likha("double(21) = ")
    likha(d)
    likha("\n")
    vitti t = triple(14)
    likha("triple(14) = ")
    likha(t)
    likha("\n")
    vitti i = inc(41)
    likha("inc(41) = ")
    likha(i)
    likha("\n")
    likha("=== Done ===\n")
