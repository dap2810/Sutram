# R42: an alias of a kosh is the kosh: kosh_kship through it grows the original.
# Before R42 (v248), kosh_kship(w, 4) was refused: kosh-vitti avashyak.
mukhya()
    kosh v[4]
    kosh_kship(v, 3)
    kosh u[1]                      # R126: w is a kosh from its declaration (it was vitti w = 0,
    vitti w = u                    # a number that then held a kosh - refused from v301, E_VITTI_PRAKAR)
    w = v
    kosh_kship(w, 4)
    likha(kosh_gan(v))
    likha(w[1])
