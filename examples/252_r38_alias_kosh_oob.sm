# R38: a kosh alias via assignment must be bounds-checked like the original.
mukhya() {
    kosh dasham v[4]
    kosh_kship(v, 1.5)
    kosh_kship(v, 2.5)
    kosh dasham u[1]               # R126: w is a kosh dasham from its declaration (it was vitti w = 0,
    vitti w = u                    # a number that then held a kosh - refused from v301, E_VITTI_PRAKAR)
    w = v
    w[5] = 9.9
    likha(999)
}
