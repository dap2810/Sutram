# Typed kosh values must participate in T12 prakriya return inference.
prakriya antim_mulya() {
    kosh dasham mulya[1]
    kosh_push(mulya, 2.5)
    nivartanam kosh_pop(mulya)
}

prakriya sanket_mulya() {
    kosh dasham mulya[1]
    kosh_push(mulya, 1.25)
    nivartanam mulya[0]
}

mukhya() {
    likha(antim_mulya())
    likha(sanket_mulya())
}
