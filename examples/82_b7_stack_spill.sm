prakriya dwi_anwesh(a, n, target) {
    vitti lo = 0
    vitti hi = n - 1
    yavat (lo <= hi) {
        vitti mid = (lo + hi) / 2
        yadi (a[mid] == target) { prati mid }
        yadi (a[mid] < target) { lo = mid + 1 } anya { hi = mid - 1 }
    }
    prati 0 - 1
}

prakriya laghu(a, n) {
    vitti m = a[0]
    vitti i = 1
    yavat (i < n) {
        yadi (a[i] < m) { m = a[i] }
        i = i + 1
    }
    prati m
}

mukhya() {
    mala a[6]
    a[0] = 1
    a[1] = 2
    a[2] = 3
    a[3] = 5
    a[4] = 7
    a[5] = 9
    likha(dwi_anwesh(a, 6, 7))
    likha(laghu(a, 6))
}
