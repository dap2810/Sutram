# R82: the same kind of kosh, its address kept in a variable outside the block and read after the
# block has ended. R107 (v289): the compiler sees `bahar = k` and refuses it - E_KOSH_MANDAPA at
# compile time, nothing is built. (Up to v288 the program ran and stopped at padh(bahar, 0) with the
# runtime form of the same error; that form remains for what the compiler cannot see, example 316.)
prakriya padh(kosh k, i) {
    nivartanam k[i]
}

mukhya() {
    vitti bahar = 0
    mandapa {
        kosh k[4]
        kosh_push(k, 11)
        kosh_push(k, 22)
        likha(padh(k, 1))
        bahar = k
    }
    likha(padh(bahar, 0))
    likha("yah pankti na chalati\n")
}
