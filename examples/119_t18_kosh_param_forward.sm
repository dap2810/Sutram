# Typed kosh parameters can be forwarded, participate in float-return inference,
# and safely mutate shared length/data when no pointer replacement is required.
prakriya aavaran(kosh dasham a) {
    nivartanam shirsh(a) + puchh(a)
}

prakriya shirsh(kosh dasham a) {
    nivartanam a[0]
}

prakriya puchh(kosh dasham a) {
    nivartanam kosh_pop(a)
}

mukhya() {
    kosh dasham mulya[2]
    kosh_push(mulya, 1.25)
    kosh_push(mulya, 2.75)
    likha(aavaran(mulya))
    likha(kosh_len(mulya))
}
