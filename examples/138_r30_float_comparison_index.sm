# R30: indexed or complex LHS comparisons preserve ordering and bool output.
prakriya yog_ek(dasham a) { nivartanam a + 1.0 }
mukhya() {
    kosh dasham datt[2]
    kosh_push(datt, 3.0)
    kosh_push(datt, 9.0)
    dasham threshold = 4.0
    vitti yes = 0
    yes = datt[0] < threshold
    likha(yes)
    yes = datt[1] > threshold
    likha(yes)
    yes = yog_ek(datt[0]) == threshold
    likha(yes)
    yes = (datt[1] - datt[0]) <= threshold
    likha(yes)
}
