# R30: indexed or complex LHS comparisons preserve ordering and bool output.
prakriya add_one(dasham a) { pratiyati a + 1.0 }
mukhya() {
    kosh dasham data[2]
    kosh_push(data, 3.0)
    kosh_push(data, 9.0)
    dasham threshold = 4.0
    vitti yes = 0
    yes = data[0] < threshold
    likha(yes)
    yes = data[1] > threshold
    likha(yes)
    yes = add_one(data[0]) == threshold
    likha(yes)
    yes = (data[1] - data[0]) <= threshold
    likha(yes)
}
