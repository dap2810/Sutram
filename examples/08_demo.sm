# Sutram v8 - Combined demo
rachana Person = { age, score }

prakriya dwigun(n)
    nivartanam n * 2

mukhya()
    likha("=== Sutram Demo ===\n")
    vitti x = dwigun(21)
    likha("double(21) = ", x)
    vitti p = nirmmita(16)
    p.age = 25
    p.score = 100
    likha("Age: ", p.age)
    likha("Score: ", p.score)
    vitti i = 1
    yavat (i < 4) {
        likha("Loop: ", i)
        i = i + 1
    }
    likha("=== Done ===\n")
