# T18 typed kosh: binary64 elements, growth, indexing, conversion and pop.
mukhya() {
    kosh dasham a[1]
    likha(kosh_gan(a))
    likha(kosh_kship(a, 1.5))
    likha(kosh_kship(a, 2))
    likha(kosh_ksham(a))
    likha(a[0])
    likha(a[1])
    a[0] = 3
    likha(a[0])
    dasham p = kosh_hri(a)
    likha(p)
    likha(kosh_gan(a))
}
