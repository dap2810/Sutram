# R48: a kosh that is empty. kosh_hri / kosh_iksh / kosh_apanay on an empty kosh
# stop the program with their own diagnostic and exit 1 - a checked error, like
# an index out of bounds. The way to handle it is to ask first: kosh_rikt(k)
# (or kosh_gan(k)). Any value, 0 included, can be in a kosh, so no return value
# could mean "empty".
mukhya() {
    kosh v[4]
    kosh_kship(v, 7)
    vitti i = 0
    yavat (i < 3) {
        yadi (kosh_rikt(v)) {
            likha("rikta\n")
        } anya {
            likha(kosh_hri(v))
        }
        i = i + 1
    }
    likha(kosh_gan(v))
    likha(kosh_hri(v))
    likha(99)
}
