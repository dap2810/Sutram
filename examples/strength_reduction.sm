# Strength reduction demo — x*2 uses shl, x*3 uses imul
mukhya()
    vitti x = 100
    likha("x * 2 = ")
    likha(x * 2)
    likha("\n")
    likha("x * 4 = ")
    likha(x * 4)
    likha("\n")
    likha("x * 8 = ")
    likha(x * 8)
    likha("\n")
    likha("x * 16 = ")
    likha(x * 16)
    likha("\n")
    likha("x * 3 = ")
    likha(x * 3)
    likha("\n")
    likha("x * 5 = ")
    likha(x * 5)
    likha("\n")
