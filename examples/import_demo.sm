# Library import demo — Python-style with yoj
yoj ganit
yoj varna

mukhya()
    likha("=== Library Import Demo ===\n")
    likha("String: Namaste!\n")
    likha("Number: ", 42)
    vitti x = 16
    vitti doubled = x * 2
    likha("x * 2 = ", doubled)
    vitti quad = x * 4
    likha("x * 4 = ", quad)
    vitti s = "Sutram"
    likha("Length: ", vartani_aayam(s))
    likha("=== Done ===\n")
