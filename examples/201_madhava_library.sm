# The Kerala school as a library (yoj madhava)
# Madhava's series: pi, sine, cosine, arctangent - and Newton's vargit root.
yoj madhava

mukhya()
    likha("pi     = ", madhava_pi())
    likha("sin .5 = ", madhava_sin(0.5))
    likha("cos .5 = ", madhava_cos(0.5))
    likha("atan .5= ", madhava_atan(0.5))
    likha("sqrt 2 = ", madhava_vargmool(2.0))
