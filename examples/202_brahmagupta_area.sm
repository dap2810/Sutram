# Brahmagupta's area formula (Brahma-sphuta-siddhanta, 628 CE)
# area = sqrt((s-a)(s-b)(s-c)(s-d)) for a cyclic quadrilateral; with d=0 it is the
# triangle formula. yoj ganita.
yoj ganita

mukhya()
    likha("triangle 3,4,5  = ", brahmagupta_kshetr(3, 4, 5, 0))
    likha("triangle 5,5,6  = ", brahmagupta_kshetr(5, 5, 6, 0))
    likha("cyclic 3,4,5,6  = ", brahmagupta_kshetr(3, 4, 5, 6))
    likha("square side 4   = ", brahmagupta_kshetr(4, 4, 4, 4))
