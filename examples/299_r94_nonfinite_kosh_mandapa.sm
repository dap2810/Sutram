# R94: inf and NaN are 8 bytes like any dasham - through a kosh dasham (push, growth, store, pop),
# a function, and a mandapa block (a kosh made inside, a block-local value). Comparisons stay IEEE.
prakriya ardh(dasham v) {
    nivartanam v / 2.0
}

prakriya pratham(kosh dasham k) {
    nivartanam k[0]
}

mukhya() {
    dasham inf = 100000000000000000000.0
    inf = inf * inf
    inf = inf * inf
    inf = inf * inf
    inf = inf * inf
    dasham nan = inf - inf
    kosh dasham k[1]
    kosh_push(k, inf)
    kosh_push(k, nan)
    kosh_push(k, 0.0 - inf)
    vitti i = 0
    yavat (i < 20) {
        kosh_push(k, nan)
        i = i + 1
    }
    likha("kosh ", k[0], " ", k[1], " ", k[2])
    likha("len ", kosh_len(k), " last ", k[22])
    likha("nan != nan in kosh ", k[1] != k[1], " ", k[22] != k[22], 0)
    k[0] = nan
    likha("store ", k[0], " pop ", kosh_pop(k))
    likha("param ", ardh(inf), " ", pratham(k))
    mandapa {
        kosh dasham m[2]
        kosh_push(m, inf)
        kosh_push(m, nan)
        kosh_push(m, 1.5)
        vitti p = nirmmita(4 * 8)
        dasham sum = m[0] + m[2]
        likha("mandapa ", m[0], " ", m[1], " ", sum)
        likha("mandapa param ", ardh(nan), " ", pratham(m))
        likha("cmp ", m[1] == m[1], " ", m[0] > 1.0, " ", m[2] < m[0])
    }
    mandapa {
        dasham local = inf * 0.0
        likha("block local ", local, " ", local != local, 0)
    }
    likha("after ", inf, " ", nan)
}
