# T12 function interop payoff: the verified scalar Madhava calculations from
# example 93 now cross prakriya boundaries as reusable floating-point functions.

prakriya madhava_pi(pada_ganana) {
    dasham root12 = 3.5
    vitti i = 0
    yavat (i < 12) {
        root12 = (root12 + 12.0 / root12) / 2.0
        i = i + 1
    }
    dasham sankalan = 0.0
    dasham p3 = 1.0
    vitti k = 0
    vitti chinha = 1
    yavat (k < pada_ganana) {
        dasham term = 1.0 / ((2.0 * k + 1.0) * p3)
        yadi (chinha > 0) {
            sankalan = sankalan + term
        } anya {
            sankalan = sankalan - term
        }
        p3 = p3 * 3.0
        chinha = 0 - chinha
        k = k + 1
    }
    nivartanam root12 * sankalan
}

prakriya madhava_sin(dasham x, pada_ganana) {
    dasham s = x
    dasham t = x
    vitti n = 1
    yavat (n < pada_ganana) {
        t = 0.0 - t * x * x / ((2.0 * n) * (2.0 * n + 1.0))
        s = s + t
        n = n + 1
    }
    nivartanam s
}

prakriya madhava_cos(दशम x, pada_ganana) {
    dasham s = 1.0
    dasham t = 1.0
    vitti n = 1
    yavat (n < pada_ganana) {
        t = 0.0 - t * x * x / ((2.0 * n - 1.0) * (2.0 * n))
        s = s + t
        n = n + 1
    }
    nivartanam s
}

mukhya() {
    likha(madhava_pi(30))
    likha(madhava_sin(0.5, 12))
    likha(madhava_cos(0.5, 12))
}
