mukhya()
    vitti i = 0
    vitti sum = 0
    yavat (i < 5) {
        i = i + 1
        yadi (i == 2) { uddeshya }
        yadi (i == 5) { krama }
        sum = sum + i
    }
    likha(sum)
    likha(" ")

    vitti z = 0
    yavat (z < 0) { likha(99) }
    likha(z)
    likha(" ")

    vitti asc = 0
    punaravartana a = 1 to 3 { asc = asc + a }
    likha(asc)
    likha(" ")

    vitti desc = 0
    punaravartana d = 3 to 1 { desc = desc + d }
    likha(desc)
    likha(" ")

    vitti f = 0
    punaravartana j = 1 to 5 {
        yadi (j == 2) { uddeshya }
        yadi (j == 4) { krama }
        f = f + j
    }
    likha(f)
    likha(" ")

    vitti lo = 5
    vitti hi = 3
    vitti empty = 0
    punaravartana k = lo to hi { empty = empty + 1 }
    likha(empty)
    likha("\n")
