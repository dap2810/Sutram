mukhya()
    vitti i = 0
    vitti sum = 0
    yavat (i < 5) {
        i = i + 1
        yadi (i == 2) { agrim }
        yadi (i == 5) { krama }
        sum = sum + i
    }
    likha(sum)
    likha(" ")

    vitti z = 0
    yavat (z < 0) { likha(99) }
    likha(z)
    likha(" ")

    vitti asc = 0
    chakra a = 1 tak 3 { asc = asc + a }
    likha(asc)
    likha(" ")

    vitti desc = 0
    chakra d = 3 tak 1 { desc = desc + d }
    likha(desc)
    likha(" ")

    vitti f = 0
    chakra j = 1 tak 5 {
        yadi (j == 2) { agrim }
        yadi (j == 4) { krama }
        f = f + j
    }
    likha(f)
    likha(" ")

    vitti lo = 5
    vitti hi = 3
    vitti empty = 0
    chakra k = lo tak hi { empty = empty + 1 }
    likha(empty)
    likha("\n")
