# Negative numbers and unary minus
# Sutram supports negative numbers with the - operator

mukhya()
    likha("=== Negative Numbers ===\n")

    # Negative variables
    vitti x = -5
    vitti y = -10
    likha("x = ", x)
    likha("y = ", y)

    # Arithmetic with negatives
    vitti sum = x + y
    likha("x + y = ", sum)

    vitti diff = x - y
    likha("x - y = ", diff)

    vitti prod = x * 3
    likha("x * 3 = ", prod)

    # Unary minus on expressions
    vitti z = -3 + 10
    likha("-3 + 10 = ", z)

    # Negation
    vitti w = 0 - x
    likha("0 - x = ", w)

    # Direct negative print
    likha("-42 = ", -42)

    # Comparison with negatives
    yadi (x < 0) {
        likha("x is negative\n")
    }

    likha("=== Done ===\n")
