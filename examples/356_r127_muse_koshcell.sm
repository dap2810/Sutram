# R127: Muse R127's O3 a kosh stored in a kosh's cell and read back - printed 0 on v300 (Muse-to-Sarvam/r127_ws1_koshcell.sm, unchanged below).
# v301 refuses it, or bounds-checks it; this golden keeps it so.
mukhya() {
    kosh inner[4]
    kosh_kship(inner, 11)
    kosh outer[4]
    kosh_kship(outer, 0)
    outer[0] = inner
    vitti a = outer[0]
    likha(a[100])
    likha("\n")
}
