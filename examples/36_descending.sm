mukhya()
    likha("Countdown: ")
    chakra i = 5 tak 1 {
        lkhb(i)
        likha(" ")
    }
    likha("\n")

    likha("Rocket launch: ")
    chakra t = 10 tak 1 {
        lkhb(t)
        likha(" ")
    }
    likha("Lift off!\n")

    likha("Descending times table (9x): ")
    chakra n = 9 tak 1 {
        lkhb(9 * n)
        likha(" ")
    }
    likha("\n")
