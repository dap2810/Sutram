mukhya()
    likha("Countdown: ")
    punaravartana i = 5 to 1 {
        lkhb(i)
        likha(" ")
    }
    likha("\n")

    likha("Rocket launch: ")
    punaravartana t = 10 to 1 {
        lkhb(t)
        likha(" ")
    }
    likha("Lift off!\n")

    likha("Descending times table (9x): ")
    punaravartana n = 9 to 1 {
        lkhb(9 * n)
        likha(" ")
    }
    likha("\n")
