# Array demo — arr[i] syntax
mukhya()
    likha("=== Array Demo ===\n")
    vitti ank_mala = nirmmita(128)
    ank_mala[0] = 10
    ank_mala[1] = 20
    ank_mala[2] = 30
    ank_mala[3] = 40
    ank_mala[4] = 50
    likha("Array values:\n")
    vitti i = 0
    yavat (i < 5) {
        likha("  arr[")
        likha(i)
        likha("] = ", ank_mala[i])
        i = i + 1
    }
    likha("Sum: ")
    vitti sankalan = 0
    i = 0
    yavat (i < 5) {
        sankalan = sankalan + ank_mala[i]
        i = i + 1
    }
    likha(sankalan)
    likha("\n")
