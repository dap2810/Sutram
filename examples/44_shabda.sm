# 44 — shabda(): print a varna variable (v29)
# likha() prints numbers (and varna literals); shabda() prints a
# NUL-terminated varna held in a variable.
prakriya abhivadana(name) {
    prati name
}
mukhya()
    vitti greeting = "Namaste!"
    shabda(greeting)
    likha(0)
    vitti msg = abhivadana("Strings flow through functions too")
    shabda(msg)
    likha(0)
    shabda("and literals work directly")
