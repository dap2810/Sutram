ide.st_notfound_w	"தேடல்: கிடைக்கவில்லை"
# "swayam"
ide.lang_swayam_w	"தானியங்கி"
# "swayam (sanskrit)"
ide.lang_swayam_sk_w	"தானியங்கி (சம்ஸ்கிருதம்)"
# "mool"
ide.lang_mool_w	"மூலம்"
# "Sajjam. F5: sampadakasya karyakramasya sankalanam chalanam cha.\r\n"
ide.msg_ready	"தயார். F5: திருத்தியில் உள்ள நிரலைத் தொகுத்து இயக்கும்.\r\n"
# "[sankalan asaphal]\r\n"
ide.msg_compile_failed	"[தொகுத்தல் தோல்வி]\r\n"
# "[karyakramah asamanya-rupena samaptah]\r\n"
ide.msg_run_failed	"[நிரல் இயல்பற்ற முறையில் முடிந்தது]\r\n"
# "[patrasya pathane lekhane va asaphalata]\r\n"
ide.msg_file_failed	"[கோப்பைப் படிக்க/எழுத இயலவில்லை]\r\n"
# "[patram atibrihat; sampadaka-seema 64 KiB]\r\n"
ide.msg_input_large	"[கோப்பு மிகப் பெரியது; திருத்தி வரம்பு 64 KiB]\r\n"
# "[kholasya itihasah purnah; prathamam kholam riktam karotu]\r\n"
ide.msg_shell_limit	"[உரையாடல் வரலாறு நிரம்பியது; முதலில் உரையாடலை அழியுங்கள்]\r\n"
# "[prakriya 10 kshanebhyah adhikam chalita; samapita]\r\n"
ide.msg_timeout	"[செயல்முறை 10 வினாடிகளுக்கு மேல் ஓடியது; நிறுத்தப்பட்டது]\r\n"
# "[win\\sutram.exe na praptam: prathamam sankalakam nirmatu]\r\n"
ide.msg_missing_compiler	"[win\\sutram.exe கிடைக்கவில்லை: முதலில் தொகுப்பியை உருவாக்குங்கள்]\r\n"
# "[deshiya-shabda-pakah anupalabdhah: lang\\*.lang pashyatu; mula-shabdah karyam kurvanti]\r\n"
ide.msg_missing_lang	"[உள்நாட்டுச் சொல் தொகுப்புகள் இல்லை: lang\\*.lang பாருங்கள்; மூலச் சொற்கள் இயங்கும்]\r\n"
# "[kechana shabda-pakah anupalabdhah ashuddhah va: lang\\*.lang pashyatu]\r\n"
ide.msg_partial_lang	"[சில சொல் தொகுப்புகள் இல்லை அல்லது தவறானவை: lang\\*.lang பாருங்கள்]\r\n"
# "[prakriya ya nalika nirman asaphal]\r\n"
ide.msg_pipe_fail	"[செயல்முறை அல்லது குழாய் உருவாக்கம் தோல்வி]\r\n"
# "[phalam 32 KiB sthane kartitam]\r\n"
ide.msg_more_output	"[வெளியீடு 32 KiB இல் வெட்டப்பட்டது]\r\n"
