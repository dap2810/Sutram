ide.msg_file_failed	"[फ़ाइल पढ़ने/लिखने में असफल]\r\n"
# "[patra bahut bada; sampadak seema 64 KiB]\r\n"
ide.msg_input_large	"[फ़ाइल बहुत बड़ी; संपादक सीमा 64 KiB]\r\n"
# "[khol ka itihas purna; pahle khol rikta karein]\r\n"
ide.msg_shell_limit	"[संवाद का इतिहास भर गया; पहले संवाद खाली करें]\r\n"
# "[prakriya 10 sekand se adhik; samapt ki gayi]\r\n"
ide.msg_timeout	"[प्रक्रिया 10 सेकंड से अधिक चली; समाप्त की गई]\r\n"
# "[win\\sutram.exe nahi mila: pahle sankalak banayein]\r\n"
ide.msg_missing_compiler	"[win\\sutram.exe नहीं मिला: पहले संकलक बनाएँ]\r\n"
# "[deshi shabda-pak anupalabdh: lang\\*.lang dekhein; mool shabda kaam karte hain]\r\n"
ide.msg_missing_lang	"[देशी शब्द-पैक उपलब्ध नहीं: lang\\*.lang देखें; मूल शब्द काम करते हैं]\r\n"
# "[kuchh shabda-pak anupalabdh ya ashuddh: lang\\*.lang dekhein]\r\n"
ide.msg_partial_lang	"[कुछ शब्द-पैक उपलब्ध नहीं या अशुद्ध: lang\\*.lang देखें]\r\n"
# "[prakriya ya nalika nirman asaphal]\r\n"
ide.msg_pipe_fail	"[प्रक्रिया या नलिका बनाने में असफल]\r\n"
# "[phal 32 KiB par kata]\r\n"
ide.msg_more_output	"[परिणाम 32 KiB पर काटा गया]\r\n"
