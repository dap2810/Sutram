+    imul rcx, rcx, TOKEN_SIZE
+    lea rdx, [rel token_arr]
+    mov rcx, [rdx + rcx + 32]
+    mov [rax+56], rcx
+    pop rcx
     cmp rcx, [rel r4_pend_count]
     jae .r23_pp_not_pending
     cmp rcx, R4_PEND_CAP
@@ -15964,6 +16024,7 @@ gen_stmt:
 
 .gs_decl:
     ; [AST_DECL][name_ptr][init_ptr][array_size_expr_or_0][type_marker]
+    call r83_check_copy       ; R83: vitti a = k (k a kosh) - two names, one buffer
