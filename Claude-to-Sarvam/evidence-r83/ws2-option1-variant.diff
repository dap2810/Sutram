+; ---------------------------------------------------------------- R83
+; r83_check_copy(rbx = AST_DECL or AST_ASSIGN being generated): the value a bare kosh name is
+; E_KOSH_PRATILIPI. A kosh moves when it grows (unless it is the arena's last block), and the
+; second name stays on the old buffer: `vitti a = k` then pushes made a[0] and k[0] differ on
+; Linux only when something was allocated in between, and always on Windows. Preserves all.
+r83_check_copy:
+    push rax
+    push rcx
+    push rdx
+    push rsi
+    push rdi
+    mov rax, [rbx]
+    cmp rax, AST_DECL
+    jne .val
+    cmp qword [rbx+24], 0          ; a mala / kosh declaration: [16] is not a copy
+    jne .out
+.val:
+    mov rax, [rbx+16]
+    test rax, rax
+    jz .out
+    cmp qword [rax], AST_VAR
+    jne .out
+    push rax
+    mov rdi, [rax+8]
+    call is_kosh_var
+    mov rcx, rax
+    pop rax
+    test rcx, rcx
+    jz .out
+    push rax
+    mov rdi, [rax+56]
+    lea rsi, [rel r83_hdr]
+    call r81_begin
+    pop rax
+    mov rdi, [rax+8]
+    call print_str_z
+    lea rdi, [rel r83_txt]
+    call print_str_z
+    lea rdi, [rel r83_hint]
+    jmp r81_end
+.out:
+    pop rdi
+    pop rsi
+    pop rdx
+    pop rcx
+    pop rax
+    ret
+
 ; ---------------------------------------------------------------- R82
 ; A kosh made inside a mandapa lives as long as the block. Only in a program that declares
 ; a kosh inside a mandapa (r82_on; every other program compiles to the same bytes):
@@ -14405,6 +14457,14 @@ parse_primary_inner:
     pop rcx
     mov qword [rax], AST_VAR
