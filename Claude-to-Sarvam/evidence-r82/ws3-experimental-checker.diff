+    mov rax, r12
+    shr rax, 3
+    add rax, rcx
+    lea rdx, [rel func_param_types]
+    movzx eax, byte [rdx + rax]
+    cmp eax, PARAM_KOSH
+    je .k
+    cmp eax, PARAM_KOSH_DASHAM
+    jne .n
+.k:
+    lea rax, [rel func_params]
+    add rax, r12
+    mov rax, [rax + rcx*8]
+    mov rdx, [rel r81_nmala]
+    cmp rdx, 1024
+    jae .n
+    lea rsi, [rel r81_malas]
+    mov [rsi + rdx*8], rax
+    inc qword [rel r81_nmala]
+.n:
+    inc rcx
+    jmp .l
+.o:
+    pop r13
+    pop r12
+    pop rbx
+    ret
