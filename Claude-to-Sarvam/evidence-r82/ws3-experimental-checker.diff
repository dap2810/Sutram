+; r82x_params(rdi = FUNCDEF): its kosh parameters into r81_malas.
+r82x_params:
+    push rbx
+    push r12
+    push r13
+    mov rbx, rdi
+    mov r13, [rbx+16]
+    mov r12, [rbx+32]
+    mov rax, r13
+    shl rax, 3
+    sub r12, rax                   ; byte offset of the first parameter
+    xor ecx, ecx
+.l:
