mukhya() {
    vitti s = 0
    vitti bad = 0
    chakra j = 1 tak 1000 {
        kosh k[1]
        chakra i = 1 tak 200 {
            kosh_kship(k, i + j)
        }
        mandapa {
            vitti t = nirmmita(4096)
            chakra i = 0 tak 511 {
                t[i] = 0 - 1
            }
        }
        mandapa {
            vitti t = nirmmita(8192)
            chakra i = 0 tak 1023 {
                t[i] = 0 - 2
            }
        }
        chakra i = 0 tak 199 {
            yadi (k[i] != i + 1 + j) {
                bad = bad + 1
            }
        }
        s = s + kosh_gan(k)
    }
    likha("c2 kosh made once in a chakra, two mandapa run and end in every pass: wrong elements ", bad, ", lengths summed ", s, " held ", parimana())
    likha("\n")
}
