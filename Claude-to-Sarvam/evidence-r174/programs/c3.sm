mukhya() {
    vitti s = 0
    vitti bad = 0
    mandapa {
        vitti t0 = nirmmita(4096)
        chakra j = 1 tak 1000 {
            kosh k[1]
            chakra i = 1 tak 200 {
                kosh_kship(k, i + j)
            }
            vitti t = nirmmita(512)
            chakra i = 0 tak 63 {
                t[i] = 0 - 1
            }
            chakra i = 0 tak 199 {
                yadi (k[i] != i + 1 + j) {
                    bad = bad + 1
                }
            }
            s = s + kosh_gan(k)
        }
    }
    likha("c3 the chakra is inside a mandapa, the kosh made once, scratch taken in every pass: wrong elements ", bad, ", lengths summed ", s, "\n")
}
