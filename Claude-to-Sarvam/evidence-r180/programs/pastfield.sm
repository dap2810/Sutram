mukhya() {
    vitti big = nirmmita(1073741000)
    vitti s = 0
    vitti zero = 0
    chakra j = 1 tak 100000 {
        vitti t = nirmmita(64)
        yadi (t == 0) {
            zero = zero + 1
        } anya {
            t[0] = j
            s = s + t[0]
        }
    }
    likha(s, " allocations that gave 0: ", zero, "\n")
}
