prakriya ruk(n) {
    likha(n)
    vitti x = grahan()
    nivartanam x
}
mukhya() {
    vitti t = ruk(0)
    mandapa {
        kosh k[1]
        chakra i = 1 tak 8960 {
            kosh_kship(k, i)
        }
        t = ruk(11)
    }
