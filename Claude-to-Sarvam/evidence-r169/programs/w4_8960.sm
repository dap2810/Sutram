    }
    t = ruk(22)
    mandapa {
        kosh k[1]
        chakra i = 1 tak 8960 {
            kosh_kship(k, i)
        }
        t = ruk(31)
    }
    t = ruk(32)
    mandapa {
        kosh k[1]
        chakra i = 1 tak 8960 {
            kosh_kship(k, i)
        }
        t = ruk(41)
