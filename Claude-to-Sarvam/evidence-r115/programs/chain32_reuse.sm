mukhya() {
    kosh bahar[1]
    mandapa {
        kosh k[4]
        kosh_push(k, 11)
        bahar = f1(k)
    }
    mandapa {
        kosh j[4]
        kosh_push(j, 99)
    }
    likha(bahar[0], "\n")
}
