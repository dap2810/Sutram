    s = s + f1(k, 1)
    s = s + f2(k, 2)
    s = s + f3(k, 3)
    s = s + f4(k, 4)
    s = s + f5(k, 5)
    s = s + f6(k, 6)
    s = s + f7(k, 7)
    s = s + f8(k, 8)
    s = s + f9(k, 9)
    s = s + f10(k, 10)
    likha(s)
}
