prakriya ruk(n) {
    likha(n)
    vitti x = grahan()
    nivartanam x
}
mukhya() {
    vitti s = 0
    vitti t = 0
    chakra j = 1 tak 1000 {
        mandapa {
            kosh k[1]
            chakra i = 1 tak 4097 {
                kosh_kship(k, i)
            }
            s = s + 1
            likha(j)
        }
        yadi (j < 0) {
            t = ruk(j)
        }
        yadi (j < 0) {
            t = ruk(j)
        }
    }

    likha(s)
}
