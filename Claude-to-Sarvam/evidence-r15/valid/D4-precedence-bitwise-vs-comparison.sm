# D4: the compiler's precedence is not the documented one (LANGUAGE-REFERENCE.md s3).
# Documented, C order: comparisons bind tighter than & ^ |, and < binds tighter than ==.
# The compiler: & ^ | bind tighter than every comparison, and all six comparisons share one level.
# Found by tools/fuzz_valid.py, seed 1 (programs 1, 12, 14, 24, 31, 35, 47, 49).
#             documented   compiler v208
#   line 1:   1            0     (0 == -1) ^ 1   vs   0 == (-1 ^ 1)
#   line 2:   0            1     (1 != 0) & 0    vs   1 != (0 & 0)
#   line 3:   1            0     (8 <= 70) & 3   vs   8 <= (70 & 3)
#   line 4:   0            1     -2 == (9 < 1)   vs   (-2 == 9) < 1
mukhya() {
    likha(0 == -1 ^ 1)
    likha(1 != 0 & 0)
    likha(8 <= 70 & 3)
    likha(-2 == 9 < 1)
}
