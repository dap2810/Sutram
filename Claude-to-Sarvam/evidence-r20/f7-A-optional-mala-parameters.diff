+; F7 helpers ------------------------------------------------------------
+mark_scalar_var:
+    ; rdi = name ptr: declared with a value that is certainly not an address
+    push rbx
+    push r12
+    mov rbx, rdi
+    mov r12, [rel scalar_var_cnt]
+    cmp r12, 256
+    jae .msv_done
+    lea rcx, [rel scalar_vars]
+    mov [rcx + r12*8], rbx
+    inc qword [rel scalar_var_cnt]
+.msv_done:
+    pop r12
+    pop rbx
+    ret
+
+is_scalar_var:
+    ; rdi = name ptr -> rax = 1 if marked scalar in this function, and not since
+    ; marked as an array (a later `mala x[n]` wins)
+    push rbx
+    push r12
+    push r13
+    mov rbx, rdi
+    call is_array_var
+    test rax, rax
+    jnz .isv_no
+    xor r12, r12
+    mov r13, [rel scalar_var_cnt]
+.isv_loop:
+    cmp r12, r13
+    jae .isv_no
+    lea rcx, [rel scalar_vars]
+    mov rdi, [rcx + r12*8]
+    mov rsi, rbx
+    call strcmp
+    test rax, rax
+    jz .isv_yes
+    inc r12
+    jmp .isv_loop
+.isv_yes:
+    mov rax, 1
+    pop r13
+    pop r12
+    pop rbx
+    ret
+.isv_no:
+    xor rax, rax
+    pop r13
+    pop r12
+    pop rbx
+    ret
+
+expr_is_known_scalar:
+    ; rdi = AST node -> rax = 1 when the value is certainly not an address:
+    ; a number or float literal, a binary operation, a ternary, or a name
+    ; declared with one of those.
+    push rbx
+    mov rbx, rdi
+    mov rax, [rbx]
+    cmp rax, AST_NUM
+    je .eiks_yes
+    cmp rax, AST_FLOAT
+    je .eiks_yes
+    cmp rax, AST_BINOP
+    je .eiks_yes
+    cmp rax, AST_TERNARY
+    je .eiks_yes
+    cmp rax, AST_VAR
+    jne .eiks_no
+    mov rdi, [rbx+8]
+    call is_scalar_var
+    pop rbx
+    ret
+.eiks_yes:
+    mov rax, 1
+    pop rbx
+    ret
+.eiks_no:
+    xor rax, rax
+    pop rbx
+    ret
+
+mark_mala_param_var:
+    ; rdi = name ptr; the current generated function's `mala` parameters
+    push rbx
+    push r12
+    mov rbx, rdi
+    mov r12, [rel mala_param_var_cnt]
+    cmp r12, KOSH_PARAM_VAR_CAP
+    jae .mmpv_done
+    lea rcx, [rel mala_param_vars]
+    mov [rcx + r12*8], rbx
+    inc qword [rel mala_param_var_cnt]
+.mmpv_done:
+    pop r12
+    pop rbx
+    ret
+
+is_mala_param_var:
+    ; rdi = name ptr -> rax = 1 when it is one of this function's `mala` parameters
+    push rbx
+    push r12
+    push r13
+    mov rbx, rdi
+    xor r12, r12
+    mov r13, [rel mala_param_var_cnt]
+.impv_loop:
+    cmp r12, r13
+    jae .impv_no
+    lea rcx, [rel mala_param_vars]
+    mov rdi, [rcx + r12*8]
+    mov rsi, rbx
+    call strcmp
+    test rax, rax
+    jz .impv_yes
+    inc r12
+    jmp .impv_loop
+.impv_yes:
+    mov rax, 1
+    pop r13
+    pop r12
+    pop rbx
+    ret
+.impv_no:
+    xor rax, rax
+    pop r13
+    pop r12
+    pop rbx
+    ret
+
 is_kosh_param_var:
     ; rdi=name ptr -> rax=1 when this kosh is a by-value function parameter.
     push rbx
