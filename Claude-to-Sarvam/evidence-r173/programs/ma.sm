prakriya ruk(n) {
    likha(n)
    vitti x = grahan()
    nivartanam x
}
mukhya() {
    vitti s = 0
    vitti t = ruk(0)
    chakra j = 1 tak 800000 {
        mala m[8]
        s = s + m[0] + m[7]
        m[0] = j
        m[7] = 1
        s = s + m[0]
        yadi (j == 400000) {
            t = ruk(j)
        }
    }
    t = ruk(800000)
    likha(s)
}
