prakriya ruk(n) {
    likha(n)
    vitti x = grahan()
    nivartanam x
}
mukhya() {
    vitti s = 0
    vitti t = ruk(0)
    chakra j = 1 tak 800000 {
        kosh temp[1]
        chakra i = 1 tak 100 {
            kosh_kship(temp, i + j)
        }
        s = s + temp[99] + kosh_gan(temp)
        yadi (j == 200000) {
            t = ruk(j)
        }
        yadi (j == 400000) {
            t = ruk(j)
        }
    }
    t = ruk(800000)
    likha(s)
}
