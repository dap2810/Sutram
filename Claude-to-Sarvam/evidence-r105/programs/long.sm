mukhya() {
    vitti s = "x"
    vitti i = 0
    yavat (i < 16) {
        s = s + s
        i = i + 1
    }
    vitti t = "x"
    i = 0
    yavat (i < 16) {
        t = t + t
        i = i + 1
    }
    likha("equal 65536-char ", s == t, "\n")
    vitti u = s + "y"
    likha("differ at the end ", s == u, " ", u == t + "y", "\n")
}
