mukhya() {
    vitti a = "abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz01"
    vitti b = "abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz01"
    vitti i = 0
    vitti n = 0
    yavat (i < 1000000) {
        yadi (a == b) {
            n = n + 1
        }
        i = i + 1
    }
    likha("n ", n, "\n")
}
