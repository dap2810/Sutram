; ===================================================================
; ROUND-45: --debug, the smallest useful debugger.
;
;   sutram_compiler --debug <in.sm> <out>
;   sutram_compiler --debug --lang <pak> <in.sm> <out>
;
; The same compile, except that before every statement the program prints the
; statement's source line and every scalar variable then in scope, and goes on:
;
;   [shodhan] pankti 7
;       yoga = 10
;       i = 4
;
; How: the trap is not new machine code. It is ordinary Sutram statements -
; likha("[shodhan] pankti 7\n"), likha("    yoga = "), likha(yoga), ... -
; built as AST nodes and generated by gen_stmt, exactly as if they had been
; written in the source before the statement. So a variable held in a register,
; a dasham, a parameter and a PE target all print through the code path that
; already prints them, and every statement-level cache in the code generator is
; invalidated by those statements as by any other.
;
;   * the line: parse_stmt (wrapped here) notes the source position of a
;     statement's first token against the statement node; gen_stmt looks the
;     node up and maps the position to the line of the ORIGINAL file, the way
;     parse errors do (r51_origin_line_col), so `yoj` does not shift it.
;   * the program's own file only: a statement that came in through `yoj`
;     (a library module's) gets no trap, so a library call is one step.
;   * the variables: var_table, the current function's locals and parameters
;     in declaration order. A mala, a kosh and a slice are left out (likha would
;     print an address); a name shadowed by a later entry is shown once, as the
;     later one; a module-level vitti is not in var_table and is not shown.
;   * no trap before a yantra("...") statement: raw machine code may rely on
;     registers the previous yantra set (examples/29_nishkriya.sm splits one
;     mov/mov/syscall over three), and a trap between them would clobber them.
;   * the output goes where likha goes: standard output, interleaved with the
;     program's own output, in order.
;
; Without the flag r45_debug is 0: parse_stmt jumps straight to its body and
; gen_stmt skips the hook, so the ordinary compile is byte-identical.
; ===================================================================

R45_MAP_CAP   equ 65536            ; statements with a recorded line
R45_LABEL_CAP equ 120              ; a string literal is jumped over with jmp rel8

section .bss
    r45_debug     resq 1           ; 1 under --debug
    r45_in_trap   resq 1           ; 1 while a trap's own statements are generated
    r45_map_cnt   resq 1
    r45_map       resq R45_MAP_CAP * 2   ; [node][source position of its first token]
    r45_text      resb 256         ; the trap's current string literal
section .data
    r45_flag      db "--debug", 0
    r45_head      db "[shodhan] pankti ", 0
    r45_indent    db "    ", 0
    r45_equals    db " = ", 0
section .text

; parse_stmt, wrapped: under --debug, note (statement node, line of its first
; token). Otherwise a jump straight to the body - the ordinary parse.
parse_stmt:
    cmp qword [rel r45_debug], 0
    je r45_parse_stmt_body
    call cur_tok
    push qword [rax+32]            ; the first token's source position
    call r45_parse_stmt_body
    pop rdx
    test rax, rax
    jz .done
    mov rcx, [rel r45_map_cnt]
    cmp rcx, R45_MAP_CAP
    jae .done                      ; full: later statements get no trap
    shl rcx, 4
    lea rsi, [rel r45_map]
    mov [rsi + rcx], rax
    mov [rsi + rcx + 8], rdx
    inc qword [rel r45_map_cnt]
.done:
    ret

; r45_gen_trap(rdi = statement node). Called by gen_stmt under --debug only.
; Emits the trap for that statement, if it is one with a recorded line.
; Preserves rbx and r12-r15 (gen_stmt's own state).
r45_gen_trap:
    cmp qword [rel r45_in_trap], 0
    jne .ret
    mov rax, [rdi]
    cmp rax, AST_BLOCK             ; a block, a function definition: no code of their own
    je .ret
    cmp rax, AST_FUNCDEF
    je .ret
    cmp rax, AST_FUNC
    je .ret
    cmp rax, AST_NISHKRIYA         ; yantra("..."): raw bytes may carry registers from the
    je .ret                        ; previous yantra; a trap between them would break that
    ; the line, if parse_stmt noted one for this node
    mov rcx, [rel r45_map_cnt]
    lea rsi, [rel r45_map]
.find:
    test rcx, rcx
    jz .ret
    dec rcx
    mov rdx, rcx
    shl rdx, 4
    cmp [rsi + rdx], rdi
    jne .find
    mov rdi, [rsi + rdx + 8]       ; the position -> the line in the ORIGINAL file (as diagnostics do)
    call r51_origin_line_col       ; rax = line or 0, rcx = that file's path
    test rax, rax
    jz .ret
    cmp rcx, [rel source_path_ptr] ; the program's own file only: a library's statements are not traced
    jne .ret
    push rbx
    push r12
    push r13
    push r14
    push r15
    mov r14, rax                   ; the line (r45_copy uses al)
    mov qword [rel r45_in_trap], 1
    mov r15, [rel ast_ptr]         ; the trap's nodes are reclaimed afterwards
    ; "[shodhan] pankti <line>\n"
    lea rdi, [rel r45_text]
    lea rsi, [rel r45_head]
    call r45_copy
    mov rax, r14
    call r45_decimal               ; rdi = end, rax = line
    mov byte [rdi], 10
    mov byte [rdi + 1], 0
    call r45_likha_text
    ; every scalar variable in var_table, in declaration order
    xor r12d, r12d
.vars:
    cmp r12, [rel var_cnt]
    jae .vars_done
    mov r13, r12
    shl r13, 4
    lea rax, [rel var_table]
    mov r13, [rax + r13]           ; r13 = name
    test r13, r13
    jz .next
    movzx eax, byte [r13]          ; an ordinary name only: a letter, _ or an Indic letter
    cmp al, '_'
    je .name_ok
    cmp al, 0xE0
    je .name_ok
    or al, 0x20
    cmp al, 'a'
    jb .next
    cmp al, 'z'
    ja .next
.name_ok:
    ; shadowed by a later entry? then that one is shown instead
    lea r14, [r12 + 1]
.shadow:
    cmp r14, [rel var_cnt]
    jae .not_shadowed
    mov rax, r14
    shl rax, 4
    lea rcx, [rel var_table]
    mov rsi, [rcx + rax]
    test rsi, rsi
    jz .shadow_next
    mov rdi, r13
    call strcmp
    test rax, rax
    jz .next
.shadow_next:
    inc r14
    jmp .shadow
.not_shadowed:
    mov rdi, r13                   ; an address, not a value: left out
    call is_array_var
    test rax, rax
    jnz .next
    mov rdi, r13
    call is_kosh_var
    test rax, rax
    jnz .next
    mov rdi, r13
    call r23_is_slice_var
    test rax, rax
    jnz .next
    mov rdi, r13
    call strlen
    cmp rax, R45_LABEL_CAP - 8
    ja .next                       ; a name too long for one literal: left out
    ; "    <name> = "
    lea rdi, [rel r45_text]
    lea rsi, [rel r45_indent]
    call r45_copy
    mov rsi, r13
    call r45_copy
    lea rsi, [rel r45_equals]
    call r45_copy
    mov byte [rdi], 0
    call r45_likha_text
    ; likha(<name>)
    call alloc_ast
    mov qword [rax], AST_VAR
    mov [rax + 8], r13
    call r45_likha_node
.next:
    inc r12
    jmp .vars
.vars_done:
    mov [rel ast_ptr], r15
    mov qword [rel r45_in_trap], 0
    pop r15
    pop r14
    pop r13
    pop r12
    pop rbx
.ret:
    ret

; copy the NUL-terminated rsi to rdi; rdi = the end (not terminated)
r45_copy:
    mov al, [rsi]
    test al, al
    jz .end
    mov [rdi], al
    inc rsi
    inc rdi
    jmp r45_copy
.end:
    ret

; write rax in decimal at rdi; rdi = the end
r45_decimal:
    push rbx
    sub rsp, 32
    lea rbx, [rsp + 32]
    mov r10d, 10
.digit:
    xor edx, edx
    div r10
    add dl, '0'
    dec rbx
    mov [rbx], dl
    test rax, rax
    jnz .digit
.copy:
    lea rcx, [rsp + 32]
    cmp rbx, rcx
    jae .out
    mov al, [rbx]
    mov [rdi], al
    inc rbx
    inc rdi
    jmp .copy
.out:
    add rsp, 32
    pop rbx
    ret

; likha(<r45_text>), generated as a statement
r45_likha_text:
    call alloc_ast
    mov qword [rax], AST_STR
    lea rcx, [rel r45_text]
    mov [rax + 8], rcx
    ; fall through
; likha(<rax>), generated as a statement
r45_likha_node:
    push rax
    call alloc_ast
    pop rcx
    mov qword [rax], AST_CALL
    mov qword [rax + 8], BN_LIKHA
    mov qword [rax + 16], 1
    mov [rax + 24], rcx
    call gen_stmt
    ret
