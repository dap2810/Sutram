# Runtime benchmark: multiple stack-only nested function boundaries.
prakriya leaf(x) { prati x + 1 }
prakriya mid(x) { prati leaf(x) }
prakriya outer(x) { prati mid(x) }
mukhya() {
    vitti i = 0
    vitti sum = 0
    yavat (i < 4500000) {
        sum = sum + outer(i)
        i = i + 1
    }
    likha(sum)
}
