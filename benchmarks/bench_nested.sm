# Nested loops with a conditional - branch and loop overhead together.
mukhya()
    vitti total = 0
    vitti i = 0
    yavat (i < 2000) {
        vitti j = 0
        yavat (j < 2000) {
            yadi ((i + j) % 3 == 0) {
                total = total + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    likha(total)
