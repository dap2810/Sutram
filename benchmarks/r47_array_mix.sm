# R47 multiple independently checked array indexed reads per iteration.
mukhya() {
    pankti a[4]
    pankti b[4]
    a[0]=2
    a[1]=3
    a[2]=5
    a[3]=7
    b[0]=11
    b[1]=13
    b[2]=17
    b[3]=19
    vitti i=0
    vitti sum=0
    yavat (i < 5000000) {
        sum = sum + a[i % 4] * b[i % 4]
        i = i + 1
    }
    likha(sum)
}
