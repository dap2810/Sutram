# lib/sankhyiki.smlib — Sutram standard library: सांख्यिकी (statistics)
# layer: core
#
# The first library module built on typed `kosh dasham` parameters (T18).
# Every function takes a float array by parameter and only READS it — no kosh_push,
# because pushing to a kosh parameter is deliberately rejected by the compiler
# (the pointer is passed by value; growth would leave the caller with a stale pointer).
#
# Float arrays are the natural input here: statistics over integers would silently
# truncate. Use `kosh dasham` on the caller's side.
#
# Convention: variance and standard deviation are the POPULATION forms
# (divide by n). Multiply by n/(n-1) if you need the sample forms.

# --- sum ---
prakriya yoga(kosh dasham xs) {
    dasham s = 0.0
    vitti i = 0
    yavat (i < kosh_len(xs)) {
        s = s + xs[i]
        i = i + 1
    }
    nivartanam s
}

# --- arithmetic mean ---
prakriya madhya(kosh dasham xs) {
    vitti n = kosh_len(xs)
    yadi (n == 0) { nivartanam 0.0 }
    nivartanam yoga(xs) / n
}

# --- minimum ---
prakriya laghutama(kosh dasham xs) {
    vitti n = kosh_len(xs)
    yadi (n == 0) { nivartanam 0.0 }
    dasham m = xs[0]
    vitti i = 1
    yavat (i < n) {
        yadi (xs[i] < m) { m = xs[i] }
        i = i + 1
    }
    nivartanam m
}

# --- maximum ---
prakriya adhikatama(kosh dasham xs) {
    vitti n = kosh_len(xs)
    yadi (n == 0) { nivartanam 0.0 }
    dasham m = xs[0]
    vitti i = 1
    yavat (i < n) {
        yadi (xs[i] > m) { m = xs[i] }
        i = i + 1
    }
    nivartanam m
}

# --- range (max - min) ---
prakriya vyapti(kosh dasham xs) {
    nivartanam adhikatama(xs) - laghutama(xs)
}

# --- population variance (प्रसरण) ---
prakriya prasaran(kosh dasham xs) {
    vitti n = kosh_len(xs)
    yadi (n == 0) { nivartanam 0.0 }
    dasham m = madhya(xs)
    dasham acc = 0.0
    vitti i = 0
    yavat (i < n) {
        dasham d = xs[i] - m
        acc = acc + d * d
        i = i + 1
    }
    nivartanam acc / n
}

# --- vargit root, Newton's method (private to this module: distinct name so it
#     never collides with madhava_vargmool or a user function) ---
# 1000 iterations, as madhava_vargmool (20 gave 1279996 for sqrt(1e12)).
prakriya sankhyiki_vargmool(dasham v) {
    yadi (v <= 0.0) { nivartanam 0.0 }
    dasham g = v
    vitti k = 0
    yavat (k < 1000) {
        g = (g + v / g) / 2.0
        k = k + 1
    }
    nivartanam g
}

# --- population standard deviation (मानक विचलन) ---
prakriya vichalan(kosh dasham xs) {
    nivartanam sankhyiki_vargmool(prasaran(xs))
}

# --- dot product of two float arrays (बिंदु गुणनफल) ---
prakriya bindu_gunan(kosh dasham a, kosh dasham b) {
    vitti na = kosh_len(a)
    vitti nb = kosh_len(b)
    vitti n = na
    yadi (nb < n) { n = nb }
    dasham s = 0.0
    vitti i = 0
    yavat (i < n) {
        s = s + a[i] * b[i]
        i = i + 1
    }
    nivartanam s
}

# --- Euclidean norm (magnitude) of a vector ---
prakriya manak(kosh dasham a) {
    nivartanam sankhyiki_vargmool(bindu_gunan(a, a))
}

# ---------------------------------------------------------------------------
# Integer statistics (ROUND-13, Part B): `purna` (whole/integer) variants
# over `mala` integer arrays, same (xs, n) shape as lib/shreni.smlib.
# The float functions above take `kosh dasham`; these take plain integer
# arrays, so integer data no longer needs float conversion.
#
# TRUNCATION: mean and variance are TRUNCATED toward zero (integer
# division), not rounded. Variance uses the truncated mean, so it is
# exact only when the mean is integral; for exact variance use the float
# prasaran. Empty input (n <= 0) returns 0 for every function.
# ---------------------------------------------------------------------------

# --- integer sum ---
prakriya purna_yoga(xs, n) {
    vitti i = 0
    vitti s = 0
    yavat (i < n) {
        s = s + xs[i]
        i = i + 1
    }
    nivartanam s
}

# --- integer mean (truncated toward zero) ---
prakriya purna_madhya(xs, n) {
    yadi (n <= 0) { nivartanam 0 }
    nivartanam purna_yoga(xs, n) / n
}

# --- integer minimum ---
prakriya purna_laghutama(xs, n) {
    vitti m = 0
    vitti i = 1
    yadi (n <= 0) { nivartanam 0 }
    m = xs[0]
    yavat (i < n) {
        yadi (xs[i] < m) { m = xs[i] }
        i = i + 1
    }
    nivartanam m
}

# --- integer maximum ---
prakriya purna_adhikatama(xs, n) {
    vitti m = 0
    vitti i = 1
    yadi (n <= 0) { nivartanam 0 }
    m = xs[0]
    yavat (i < n) {
        yadi (xs[i] > m) { m = xs[i] }
        i = i + 1
    }
    nivartanam m
}

# --- integer range (max - min) ---
prakriya purna_vyapti(xs, n) {
    yadi (n <= 0) { nivartanam 0 }
    nivartanam purna_adhikatama(xs, n) - purna_laghutama(xs, n)
}

# --- integer population variance (truncated toward zero; uses the
# truncated mean, so exact only when the mean is integral); -1 when it
# does not fit in int64, or when one squared deviation alone does not (R80) ---
prakriya purna_prasaran(xs, n) {
    vitti m = 0
    vitti q = 0
    vitti r = 0
    vitti i = 0
    vitti d = 0
    vitti x = 0
    vitti dd = 0
    yadi (n <= 0) { nivartanam 0 }
    m = purna_madhya(xs, n)
    # R80: [2147483648, -2147483648] gave a NEGATIVE variance - the sum of squares (2^63) wrapped,
    # though the variance (2^62) fits. Each square is split into dd / n and dd % n, so the sum is
    # never formed: the answer is exact whenever it fits.
    yavat (i < n) {
        x = xs[i]
        yadi (x >= 0) {
            yadi (m < 0) {
                yadi (x > 9223372036854775807 + m) { nivartanam 0 - 1 }
            }
        } anya {
            yadi (m > 0) {
                yadi (x < (0 - 9223372036854775807) - 1 + m) { nivartanam 0 - 1 }
            }
        }
        d = x - m
        yadi (d < 0) { d = 0 - d }
        yadi (d > 3037000499) { nivartanam 0 - 1 }
        dd = d * d
        yadi (q > 9223372036854775807 - dd / n) { nivartanam 0 - 1 }
        q = q + dd / n
        r = r + dd % n
        yadi (r >= n) {
            yadi (q == 9223372036854775807) { nivartanam 0 - 1 }
            q = q + 1
            r = r - n
        }
        i = i + 1
    }
    nivartanam q
}
