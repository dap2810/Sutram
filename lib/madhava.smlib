# lib/madhava.smlib — Sutram standard library: the Kerala school
#
# After Madhava of Sangamagrama (~1340-1425 CE) and the Kerala school of astronomy and
# mathematics. Madhava gave infinite-series expansions for the sine, cosine and arctangent
# functions, and from the arctangent series a rapidly converging series for pi - more than two
# centuries before Newton, Gregory and Leibniz. These use T12 scalar floats (dasham).

# square root by Newton's method (Babylonian), to float precision
prakriya madhava_sqrt(dasham v) {
    dasham g = v
    yadi (g < 1.0) { g = 1.0 }
    vitti i = 0
    yavat (i < 40) {
        g = (g + v / g) / 2.0
        i = i + 1
    }
    pratiyati g
}

# Madhava's fast series for pi:  pi = sqrt(12) * sum (-1)^k / ((2k+1) * 3^k)
prakriya madhava_pi() {
    dasham root12 = madhava_sqrt(12.0)
    dasham sum = 0.0
    dasham p3 = 1.0
    vitti k = 0
    vitti sign = 1
    yavat (k < 30) {
        dasham term = 1.0 / ((2.0 * k + 1.0) * p3)
        yadi (sign > 0) {
            sum = sum + term
        } anyatra {
            sum = sum - term
        }
        p3 = p3 * 3.0
        sign = 0 - sign
        k = k + 1
    }
    pratiyati root12 * sum
}

# Madhava's sine series:  sin(x) = x - x^3/3! + x^5/5! - ...
prakriya madhava_sin(dasham x) {
    dasham s = x
    dasham t = x
    vitti n = 1
    yavat (n < 16) {
        t = 0.0 - t * x * x / ((2.0 * n) * (2.0 * n + 1.0))
        s = s + t
        n = n + 1
    }
    pratiyati s
}

# Madhava's cosine series:  cos(x) = 1 - x^2/2! + x^4/4! - ...
prakriya madhava_cos(dasham x) {
    dasham s = 1.0
    dasham t = 1.0
    vitti n = 1
    yavat (n < 16) {
        t = 0.0 - t * x * x / ((2.0 * n - 1.0) * (2.0 * n))
        s = s + t
        n = n + 1
    }
    pratiyati s
}

# Madhava-Gregory arctangent series:  atan(x) = x - x^3/3 + x^5/5 - ...
prakriya madhava_atan(dasham x) {
    dasham s = 0.0
    dasham xp = x
    vitti k = 0
    vitti sign = 1
    yavat (k < 400) {
        dasham term = xp / (2.0 * k + 1.0)
        yadi (sign > 0) {
            s = s + term
        } anyatra {
            s = s - term
        }
        xp = xp * x * x
        sign = 0 - sign
        k = k + 1
    }
    pratiyati s
}
