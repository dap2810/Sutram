# lib/num.smlib — Sutram standard library: integer utilities
# layer: core
# Parameters are copied into locals before mutation (compiler fault workaround).

prakriya is_even(n)
    pratiyati (n % 2) == 0

prakriya is_odd(n)
    pratiyati (n % 2) != 0

prakriya digit_count(n) {
    vitti x = n
    vitti minv = (0 - 9223372036854775807) - 1
    # MIN: |MIN| has 19 digits, but 0 - MIN wraps to MIN.
    yadi (x == minv) { pratiyati 19 }
    yadi (x < 0) { x = 0 - x }
    vitti c = 1
    yavat (x >= 10) {
        x = x / 10
        c = c + 1
    }
    pratiyati c
}

prakriya digit_sum(n) {
    vitti x = n
    vitti minv = (0 - 9223372036854775807) - 1
    # MIN: digit sum of 9223372036854775808 is 89.
    yadi (x == minv) { pratiyati 89 }
    yadi (x < 0) { x = 0 - x }
    vitti s = 0
    yavat (x > 0) {
        s = s + (x % 10)
        x = x / 10
    }
    pratiyati s
}

prakriya reverse_num(n) {
    vitti x = n
    vitti r = 0
    vitti minv = (0 - 9223372036854775807) - 1
    # Negatives reverse with the sign: reverse_num(-123) = -321.
    # MIN: reverse of 9223372036854775808, negated.
    yadi (x == minv) { pratiyati 0 - 8085774586302733229 }
    yadi (x < 0) { pratiyati 0 - reverse_num(0 - x) }
    yavat (x > 0) {
        r = r * 10 + (x % 10)
        x = x / 10
    }
    pratiyati r
}

prakriya is_palindrome(n) {
    # Negatives are not palindromes (the '-' is not a digit).
    yadi (n < 0) { pratiyati 0 }
    vitti r = reverse_num(n)
    pratiyati r == n
}

prakriya clamp(n, lo, hi) {
    vitti x = n
    vitti a = lo
    vitti b = hi
    yadi (x < a) { pratiyati a }
    yadi (x > b) { pratiyati b }
    pratiyati x
}

prakriya fib(n) {
    vitti x = n
    yadi (x < 2) { pratiyati x }
    vitti a = 0
    vitti b = 1
    vitti i = 2
    yavat (i <= x) {
        vitti t = a + b
        a = b
        b = t
        i = i + 1
    }
    pratiyati b
}

prakriya is_perfect(n) {
    vitti x = n
    yadi (x < 2) { pratiyati 0 }
    vitti s = 1
    vitti d = 2
    # Division bound, not d * d: d * d overflows for x near MAX
    # (the square wraps negative, the condition stays true, and
    # the loop never terminates).
    yavat (d <= x / d) {
        yadi (x % d == 0) {
            s = s + d
            yadi (d != x / d) { s = s + (x / d) }
        }
        d = d + 1
    }
    pratiyati s == x
}

prakriya collatz_steps(n) {
    vitti x = n
    vitti c = 0
    # No Collatz sequence starting at x < 1 reaches 1 (0 stays 0,
    # negatives cycle), so -1 means "does not reach 1". The same
    # sentinel covers the 3x+1 overflow: 3x+1 overflows int64 when
    # x > (MAX-1)/3 = 3074457345618258602, and the wrapped value
    # would cycle forever instead of reaching 1.
    yadi (x < 1) { pratiyati 0 - 1 }
    yavat (x != 1) {
        yadi (x % 2 == 0) { x = x / 2 } anyatra {
            yadi (x > 3074457345618258602) { pratiyati 0 - 1 }
            x = 3 * x + 1
        }
        c = c + 1
    }
    pratiyati c
}
