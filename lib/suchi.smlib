# lib/list.smlib — Sutram standard library: dynamic lists, stacks, queues
# layer: alloc
#
# Elements are QWORD CELLS (the pankti/kosh convention), not byte
# strings. Users with byte strings store POINTERS (suchi_khip(l, ptr));
# the caller keeps the pointed-to buffers alive. No mixing: every
# element here is a qword. dasham elements are NOT supported — an
# untyped parameter truncates a dasham argument to its integer part.
#
# Two handle layouts (do NOT mix families on one handle):
#   - list / stack handle: header [len, cap, data_ptr]; data is a
#     separate cell array. The HANDLE address is stable across
#     growth — only the data pointer inside it moves.
#   - queue handle: header [len, cap, data_ptr, head]; a RING BUFFER
#     (see avali_pravesh). queue_* on a list handle (or list_* on a
#     queue handle) reads the wrong header and corrupts memory.
#
# Growth rule: when len == cap, capacity DOUBLES, a new data array
# is allocated, elements are copied in logical order, and the
# header's data pointer is updated. The old data array is NOT freed
# — the language has no deallocation primitive, so growth leaks the
# previous array. Capacity never shrinks.
#
# Allocation failure: if nirmmita returns 0 during growth, the
# operation returns 0 (or ok[0] = 0) and the structure is UNCHANGED.
# suchi_srij returns 0 if either allocation fails.
#
# Out-of-bounds reads: suchi_grah returns 0 for i outside [0, len).
# 0 is a legal stored value, so check suchi_maap first when it
# matters. suchi_sangrah / suchi_nivesh / suchi_apanay return
# 1 ok / 0 out of bounds (or allocation failure for insert).
# chay_apanay / chay_avalok / avali_nishkas / avali_avalok return the
# value and set ok[0] (a 1-cell pankti) to 1 on success, 0 when
# empty — the value alone cannot signal emptiness.
#
# All signatures stay within the 6-argument cap.

yoj shreni

# --- lists ---

# suchi_srij(cap) — allocate an empty list. cap clamped to >= 1.
# Returns the list handle, or 0 on allocation failure — including
# a cap so large the data size overflows (a wrapped size returned
# a handle whose data pointer was bogus, segfaulting on push).
prakriya suchi_srij(cap) {
    vitti c = cap
    vitti l = 0
    vitti d = 0
    vitti sz = 0
    yadi (c < 1) { c = 1 }
    sz = c * 8
    yadi (sz < 0) { prati 0 }
    l = nirmmita(3 * 8)
    yadi (l == 0) { prati 0 }
    d = nirmmita(sz)
    yadi (d == 0) { prati 0 }
    l[0] = 0
    l[1] = c
    l[2] = d
    prati l
}

# suchi_vardh(l) — private helper: dvigun l's capacity, copying the
# data. Returns 1 ok / 0 allocation failure (list unchanged).
prakriya suchi_vardh(l) {
    vitti lst = l
    vitti ncap = lst[1] * 2
    vitti nd = nirmmita(ncap * 8)
    vitti old = lst[2]
    vitti i = 0
    yadi (nd == 0) { prati 0 }
    yavat (i < lst[0]) {
        nd[i] = old[i]
        i = i + 1
    }
    lst[2] = nd
    lst[1] = ncap
    prati 1
}

# suchi_khip(l, v) — append v. Returns 1 ok / 0 allocation failure.
prakriya suchi_khip(l, v) {
    vitti lst = l
    vitti val = v
    yadi (lst[0] == lst[1]) {
        yadi (suchi_vardh(lst) == 0) { prati 0 }
    }
    vitti d = lst[2]
    d[lst[0]] = val
    lst[0] = lst[0] + 1
    prati 1
}

# suchi_grah(l, i) — element i, or 0 if i is out of bounds.
prakriya suchi_grah(l, i) {
    vitti lst = l
    vitti idx = i
    yadi (idx < 0) { prati 0 }
    yadi (idx >= lst[0]) { prati 0 }
    vitti d = lst[2]
    prati d[idx]
}

# suchi_sangrah(l, i, v) — set element i. Returns 1 ok / 0 out of bounds.
prakriya suchi_sangrah(l, i, v) {
    vitti lst = l
    vitti idx = i
    vitti val = v
    yadi (idx < 0) { prati 0 }
    yadi (idx >= lst[0]) { prati 0 }
    vitti d = lst[2]
    d[idx] = val
    prati 1
}

# suchi_maap(l) — element count.
prakriya suchi_maap(l) {
    prati l[0]
}

# suchi_nivesh(l, i, v) — insert v before index i (i == len
# appends). Returns 1 ok / 0 out of bounds or allocation failure.
prakriya suchi_nivesh(l, i, v) {
    vitti lst = l
    vitti idx = i
    vitti val = v
    vitti d = 0
    vitti k = 0
    yadi (idx < 0) { prati 0 }
    yadi (idx > lst[0]) { prati 0 }
    yadi (lst[0] == lst[1]) {
        yadi (suchi_vardh(lst) == 0) { prati 0 }
    }
    d = lst[2]
    k = lst[0]
    yavat (k > idx) {
        d[k] = d[k - 1]
        k = k - 1
    }
    d[idx] = val
    lst[0] = lst[0] + 1
    prati 1
}

# suchi_apanay(l, i) — remove element i, shifting the rest left.
# Returns 1 ok / 0 out of bounds.
prakriya suchi_apanay(l, i) {
    vitti lst = l
    vitti idx = i
    vitti d = 0
    vitti k = 0
    yadi (idx < 0) { prati 0 }
    yadi (idx >= lst[0]) { prati 0 }
    d = lst[2]
    k = idx
    yavat (k < lst[0] - 1) {
        d[k] = d[k + 1]
        k = k + 1
    }
    lst[0] = lst[0] - 1
    prati 1
}

# suchi_vinimay(l, i, j) — vinimay elements i and j (WS2, R20). Returns 1
# ok / 0 if either index is out of bounds (then nothing changes).
# Before this, swapping meant a temp variable plus two suchi_sangrah
# calls at every call site.
prakriya suchi_vinimay(l, i, j) {
    vitti lst = l
    vitti a = i
    vitti b = j
    vitti d = 0
    vitti t = 0
    yadi (a < 0) { prati 0 }
    yadi (a >= lst[0]) { prati 0 }
    yadi (b < 0) { prati 0 }
    yadi (b >= lst[0]) { prati 0 }
    d = lst[2]
    t = d[a]
    d[a] = d[b]
    d[b] = t
    prati 1
}

# suchi_viparyay(l) — reverse the list in place (WS3, R20). Two-pointer
# vinimay, same shape as khand_viparyay. Returns 1. Before this, reversing
# a list meant a hand-written two-index loop at every call site.
prakriya suchi_viparyay(l) {
    vitti lst = l
    vitti d = lst[2]
    vitti i = 0
    vitti j = lst[0] - 1
    vitti t = 0
    yavat (i < j) {
        t = d[i]
        d[i] = d[j]
        d[j] = t
        i = i + 1
        j = j - 1
    }
    prati 1
}

# suchi_shreni(l) — sort the list in place, ascending (WS2, R21).
# Merge sort (O(n log n)) over the list's data array. Before this,
# sorting a list meant `ayojan sort` plus a hand-written
# `mil_shreni(l[2], suchi_maap(l))` at every call site. Returns 1.
prakriya suchi_shreni(l) {
    mil_shreni(l[2], l[0])
    prati 1
}

# suchi_laghu(l, ok) — smallest element (WS2, R21); ok[0] 1, or 0 if
# the list is empty (returns 0 then). Before this, the caller wrote
# the min loop by hand or called sort.smlib's laghu on l[2] — which
# reads a stale cell on an empty list. The empty check here is the
# point.
prakriya suchi_laghu(l, ok) {
    yadi (l[0] == 0) {
        ok[0] = 0
        prati 0
    }
    ok[0] = 1
    prati laghu(l[2], l[0])
}

# suchi_adhik(l, ok) — largest element (WS2, R21); ok[0] 1, or 0 if
# the list is empty (returns 0 then). See suchi_laghu.
prakriya suchi_adhik(l, ok) {
    yadi (l[0] == 0) {
        ok[0] = 0
        prati 0
    }
    ok[0] = 1
    prati adhik(l[2], l[0])
}

# suchi_yog(l) — sum of the elements (WS2, R21); 0 for an empty list
# (well-defined, no ok channel needed). Before this, the caller wrote
# the sum loop by hand or called sort.smlib's yog on l[2].
prakriya suchi_yog(l) {
    prati yog(l[2], l[0])
}

# suchi_gan(l, v) — number of occurrences of v (WS2, R21).
# Before this, the caller wrote the count loop by hand or called
# sort.smlib's gan on l[2].
prakriya suchi_gan(l, v) {
    prati gan(l[2], l[0], v)
}

# suchi_anwesh(l, v) — first index of v, or -1 (WS2, R23). List-shaped
# form of sort.smlib's anwesh_sarak; before, the caller called
# anwesh_sarak(l[2], suchi_maap(l), v) by hand.
prakriya suchi_anwesh(l, v) {
    prati anwesh_sarak(l[2], l[0], v)
}

# suchi_asti_sorted(l) — 1 if the elements are in non-decreasing order,
# else 0; empty and single-element lists are sorted (WS2, R23).
# List-shaped form of sort.smlib's asti_sorted.
prakriya suchi_asti_sorted(l) {
    prati asti_sorted(l[2], l[0])
}

# suchi_dwi_anwesh(l, v) — index of v in a SORTED list, or -1
# (WS2, R23). List-shaped form of sort.smlib's dwi_anwesh. The
# caller must sort first (suchi_shreni); on an unsorted list the result
# is undefined, exactly as with dwi_anwesh.
prakriya suchi_dwi_anwesh(l, v) {
    prati dwi_anwesh(l[2], l[0], v)
}

# suchi_rikta(l) — empty the list, keeping the allocated capacity.
# R19: also ZEROES the data cells (was: len reset only). The old
# elements were reachable after a clear to anyone reading the data
# array through l[2], so a len-only reset left stale values readable
# — the same hazard nighantu_rikta closes. Capacity never shrinks.
# Returns 1.
prakriya suchi_rikta(l) {
    vitti d = l[2]
    vitti i = 0
    yavat (i < l[1]) {
        d[i] = 0
        i = i + 1
    }
    l[0] = 0
    prati 1
}

# suchi_antah(l, v) — 1 if any element equals v, else 0.
prakriya suchi_antah(l, v) {
    vitti lst = l
    vitti val = v
    vitti d = lst[2]
    vitti i = 0
    yavat (i < lst[0]) {
        yadi (d[i] == val) { prati 1 }
        i = i + 1
    }
    prati 0
}

# suchi_kramank(l, v) — first index with value v, or -1 if absent.
prakriya suchi_kramank(l, v) {
    vitti lst = l
    vitti val = v
    vitti d = lst[2]
    vitti i = 0
    yavat (i < lst[0]) {
        yadi (d[i] == val) { prati i }
        i = i + 1
    }
    prati 0 - 1
}

# --- stacks (built on the same list storage) ---

# chay_khip(l, v) — push v. Returns 1 ok / 0 allocation failure.
prakriya chay_khip(l, v) {
    prati suchi_khip(l, v)
}

# chay_apanay(l, ok) — pop the top value; sets ok[0] to 1 on success,
# 0 when the stack is empty (returns 0 then).
prakriya chay_apanay(l, ok) {
    vitti lst = l
    vitti okp = ok
    vitti d = 0
    vitti val = 0
    yadi (lst[0] == 0) {
        okp[0] = 0
        prati 0
    }
    d = lst[2]
    lst[0] = lst[0] - 1
    val = d[lst[0]]
    okp[0] = 1
    prati val
}

# chay_avalok(l, ok) — top value without removing it; ok[0] 1/0.
prakriya chay_avalok(l, ok) {
    vitti lst = l
    vitti okp = ok
    vitti d = 0
    yadi (lst[0] == 0) {
        okp[0] = 0
        prati 0
    }
    d = lst[2]
    okp[0] = 1
    prati d[lst[0] - 1]
}

# chay_rikta(l) — 1 if the stack is empty, else 0.
prakriya chay_rikta(l) {
    yadi (l[0] == 0) { prati 1 }
    prati 0
}

# --- queues (ring buffer) ---
#
# A queue is a RING BUFFER over the same kind of cell array: elements
# live at data[(head + k) % cap] for logical index k. Enqueue writes
# at the tail slot, dequeue reads at head and advances head by one
# (shesh cap). Dequeued slots are DEAD SPACE until the ring wraps
# around and reuses them — no shifting, so dequeue is O(1). Growth
# (len == cap) allocates a doubled array, copies elements in
# LOGICAL order, and resets head to 0, so the buffer is re-packed.
# The buffer only grows, never shrinks.

# avali_srij(cap) — allocate an empty queue. cap clamped to >= 1.
# Returns the queue handle, or 0 on allocation failure — including
# a cap so large the data size overflows (as suchi_srij).
prakriya avali_srij(cap) {
    vitti c = cap
    vitti q = 0
    vitti d = 0
    vitti sz = 0
    yadi (c < 1) { c = 1 }
    sz = c * 8
    yadi (sz < 0) { prati 0 }
    q = nirmmita(4 * 8)
    yadi (q == 0) { prati 0 }
    d = nirmmita(sz)
    yadi (d == 0) { prati 0 }
    q[0] = 0
    q[1] = c
    q[2] = d
    q[3] = 0
    prati q
}

# avali_pravesh(q, v) — append v at the tail.
# Returns 1 ok / 0 allocation failure.
prakriya avali_pravesh(q, v) {
    vitti qu = q
    vitti val = v
    vitti d = 0
    vitti tail = 0
    vitti ncap = 0
    vitti nd = 0
    vitti old = 0
    vitti k = 0
    yadi (qu[0] == qu[1]) {
        # grow: dvigun, copy in logical order, reset head to 0
        ncap = qu[1] * 2
        nd = nirmmita(ncap * 8)
        yadi (nd == 0) { prati 0 }
        old = qu[2]
        k = 0
        yavat (k < qu[0]) {
            nd[k] = old[(qu[3] + k) % qu[1]]
            k = k + 1
        }
        qu[2] = nd
        qu[1] = ncap
        qu[3] = 0
    }
    d = qu[2]
    tail = (qu[3] + qu[0]) % qu[1]
    d[tail] = val
    qu[0] = qu[0] + 1
    prati 1
}

# avali_nishkas(q, ok) — remove and return the front value; sets
# ok[0] to 1 on success, 0 when the queue is empty (returns 0 then).
prakriya avali_nishkas(q, ok) {
    vitti qu = q
    vitti okp = ok
    vitti d = 0
    vitti val = 0
    yadi (qu[0] == 0) {
        okp[0] = 0
        prati 0
    }
    d = qu[2]
    val = d[qu[3]]
    qu[3] = (qu[3] + 1) % qu[1]
    qu[0] = qu[0] - 1
    okp[0] = 1
    prati val
}

# avali_avalok(q, ok) — front value without removing it; ok[0] 1/0.
prakriya avali_avalok(q, ok) {
    vitti qu = q
    vitti okp = ok
    vitti d = 0
    yadi (qu[0] == 0) {
        okp[0] = 0
        prati 0
    }
    d = qu[2]
    okp[0] = 1
    prati d[qu[3]]
}

# avali_tak_mala(q, out) — write the queue's elements into out in
# logical (FIFO) order, one qword cell each, WITHOUT mutating the
# queue (WS2, R23). Returns avali_maap(q). Caller allocates cap cells.
# Before, reading a queue non-destructively meant a hand-rolled ring
# scan with (head + k) % cap arithmetic at every call site, or
# dequeuing everything (which destroys the queue).
prakriya avali_tak_mala(q, out) {
    vitti qu = q
    vitti d = qu[2]
    vitti k = 0
    yavat (k < qu[0]) {
        out[k] = d[(qu[3] + k) % qu[1]]
        k = k + 1
    }
    prati qu[0]
}

# avali_antah(q, v) — 1 if v is in the queue, else 0 (WS2, R21).
# Scans the ring WITHOUT mutating it (no dequeue loop). Before this,
# the caller hand-rolled the ring scan with (head + k) % cap
# arithmetic at every call site — the same hazard suchi_antah
# already removed for lists.
prakriya avali_antah(q, v) {
    vitti qu = q
    vitti val = v
    vitti d = qu[2]
    vitti k = 0
    yavat (k < qu[0]) {
        yadi (d[(qu[3] + k) % qu[1]] == val) { prati 1 }
        k = k + 1
    }
    prati 0
}

# avali_rikta(q) — empty the queue in place (WS2, R19): same handle,
# same capacity, head reset to 0, and the ring data ZEROED — the
# dequeued dead space held stale values readable through q[2], the
# same hazard nighantu_rikta/suchi_rikta close. Capacity never shrinks.
# Returns 1.
prakriya avali_rikta(q) {
    vitti d = q[2]
    vitti i = 0
    yavat (i < q[1]) {
        d[i] = 0
        i = i + 1
    }
    q[0] = 0
    q[3] = 0
    prati 1
}

# avali_shunya(q) — 1 if the queue is empty, else 0.
prakriya avali_shunya(q) {
    yadi (q[0] == 0) { prati 1 }
    prati 0
}

# avali_maap(q) — element count.
prakriya avali_maap(q) {
    prati q[0]
}
