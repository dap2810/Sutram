# phal_janchit_ghat(out, a, e) — ganita_janchit_ghat as a Result.
# Failure [0, 0] on e < 0 or overflow (see ganita_janchit_ghat).
prakriya phal_janchit_ghat(out, a, e) {
    vitti o = out
    vitti v = ganita_janchit_ghat(a, e, o)
    yadi (o[0] == 1) {
        o[1] = v
    } anya {
        o[1] = 0
    }
    prati o[0]
}

# phal_janchit_kramgun(out, n) — ganita_janchit_kramgun as a Result.
# Failure [0, 0] on n < 0 or overflow (21! overflows).
prakriya phal_janchit_kramgun(out, n) {
    vitti o = out
    vitti v = ganita_janchit_kramgun(n, o)
    yadi (o[0] == 1) {
        o[1] = v
    } anya {
        o[1] = 0
    }
    prati o[0]
}

# phal_janchit_nirapeksh(out, a) — ganita_janchit_nirapeksh as a Result.
# Failure [0, 0] on abs(MIN) (no int64 absolute value).
prakriya phal_janchit_nirapeksh(out, a) {
    vitti o = out
    vitti v = ganita_janchit_nirapeksh(a, o)
    yadi (o[0] == 1) {
        o[1] = v
    } anya {
        o[1] = 0
    }
    prati o[0]
}
