# lib/strb.smlib — Sutram standard library: byte-string surface
# layer: core
#
# The string toolkit on BYTE-PACKED strings (the representation of a
# literal and of set_char-built buffers). Own module (not inside
# string.smlib) because the compiler has a fixed AST ceiling.
#
# THE TWO REPRESENTATIONS (see also lib/string.smlib):
#   char-code array: qword cells, one char code per cell, h[i].
#   byte string: bytes packed 1-per-byte, char_at(s, i) /
#     set_char(s, i, v) / vartani_len(s). Do NOT mix them: h[i] on
#     a byte string reads 8 bytes at once; char_at on a char-code
#     array reads one byte of a qword cell.
#
# Conventions: lengths are explicit; out-buffers get a 0 terminator;
# the caller allocates generously. Empty needle matches at 0; "not
# found" is -1. All signatures stay within the 6-argument cap.
#
# SLICE-BOUNDARY RULES (R23): a slice is (pointer, length) into a
# larger buffer, with NO terminator at the slice end. Every strb_*
# function takes an explicit length and stops at it. The
# NUL-terminated forms (anwesh_akshar, gan_akshar, gan_swar,
# asti_sarv_ank, varna_sam) scan to the terminator — WRONG on
# slices. khand_maap / varna_maap / vartani_len scan to the terminator
# and cannot be used on slices. khand_pratisthap's repl is 0-terminated
# (length derived), so repl cannot be a slice; khand_pratilip it into a
# terminated buffer first.
# khand_bhed/khand_yuj use the length-prefixed segment format of
# varna_bhed/varna_yuj (R9): [len0, b0, ..., len1, b0, ...].

# khand_bandh(cells, n, out) — pack a qword-cell sequence (one byte value
# per cell, the varna_bhed/khand_bhed segment format) into contiguous
# bytes. Writes a 0 terminator at out[n]. Returns n. This is the
# boundary helper: hand-written repack loops (one per call site, each a
# chance to get the stride wrong) become one call. n <= 0 writes only
# the terminator and returns 0.
# POINTER ARITHMETIC IS IN BYTES: to pack starting at cell i of a cell
# array, pass cells + i*8, not cells + i.
prakriya khand_bandh(cells, n, out) {
    vitti c = cells
    vitti cnt = n
    vitti dst = out
    vitti i = 0
    yadi (cnt <= 0) {
        akshar_rakh(dst, 0, 0)
        prati 0
    }
    yavat (i < cnt) {
        akshar_rakh(dst, i, c[i])
        i = i + 1
    }
    akshar_rakh(dst, cnt, 0)
    prati cnt
}

# khand_mukt(bytes, n, out) — the inverse: expand n contiguous bytes
# into qword cells (one byte value per cell). Writes a 0 terminator cell
# at out[n]. Returns n. n <= 0 writes only the terminator, returns 0.
# POINTER ARITHMETIC IS IN BYTES: to unpack into cell i of a cell
# array, pass out + i*8, not out + i.
prakriya khand_mukt(bytes, n, out) {
    vitti s = bytes
    vitti cnt = n
    vitti dst = out
    vitti i = 0
    yadi (cnt <= 0) {
        dst[0] = 0
        prati 0
    }
    yavat (i < cnt) {
        dst[i] = akshar(s, i)
        i = i + 1
    }
    dst[cnt] = 0
    prati cnt
}

# khand_pratilip(src, n, out) — copy n bytes verbatim ("make me a real byte
# string from this"). Writes a 0 terminator at out[n]. Returns n.
# n <= 0 writes only the terminator, returns 0.
prakriya khand_pratilip(src, n, out) {
    vitti s = src
    vitti cnt = n
    vitti dst = out
    vitti i = 0
    yadi (cnt <= 0) {
        akshar_rakh(dst, 0, 0)
        prati 0
    }
    yavat (i < cnt) {
        akshar_rakh(dst, i, akshar(s, i))
        i = i + 1
    }
    akshar_rakh(dst, cnt, 0)
    prati cnt
}

prakriya khand_maap(s) {
    prati vartani_len(s)
}

# khand_anwesh(hay, hn, needle, nn) — byte index of first occurrence of
# needle in hay, or -1. Empty needle matches at 0.
prakriya khand_anwesh(hay, hn, needle, nn) {
    vitti h = hay
    vitti hlen = hn
    vitti nd = needle
    vitti nlen = nn
    vitti i = 0
    vitti match = 0
    vitti j = 0
    yadi (nlen < 0) { prati 0 - 1 }
    yadi (nlen == 0) { prati 0 }
    yadi (nlen > hlen) { prati 0 - 1 }
    i = 0
    yavat (i <= hlen - nlen) {
        match = 1
        j = 0
        yavat (j < nlen) {
            yadi (akshar(h, i + j) != akshar(nd, j)) { match = 0 }
            j = j + 1
        }
        yadi (match == 1) { prati i }
        i = i + 1
    }
    prati 0 - 1
}

# khand_antah(hay, hn, needle, nn) — 1 if needle occurs in hay, else 0.
prakriya khand_antah(hay, hn, needle, nn) {
    yadi (khand_anwesh(hay, hn, needle, nn) >= 0) { prati 1 }
    prati 0
}

# khand_pratisthap(src, sn, find, fn, repl, out) — copy src to out, replacing
# every (non-overlapping) occurrence of find with repl. repl is
# 0-terminated (its length is derived, so a literal works) — repl
# cannot be a slice; khand_pratilip a slice into a terminated buffer first
# (see header, slice-boundary rules). Returns the
# new byte count. Empty find: copy verbatim. Caller allocates generously.
prakriya khand_pratisthap(src, sn, find, fn, repl, out) {
    vitti s = src
    vitti slen = sn
    vitti f = find
    vitti flen = fn
    vitti r = repl
    vitti dst = out
    vitti rlen = 0
    vitti wpos = 0
    vitti rpos = 0
    vitti match = 0
    vitti j = 0
    vitti k = 0
    yavat (akshar(r, rlen) != 0) { rlen = rlen + 1 }
    yadi (flen <= 0) {
        # flen < 0: same verbatim copy as empty find (the old
        # code looped forever on a negative find length).
        yavat (rpos < slen) {
            akshar_rakh(dst, wpos, akshar(s, rpos))
            wpos = wpos + 1
            rpos = rpos + 1
        }
        akshar_rakh(dst, wpos, 0)
        prati wpos
    }
    yavat (rpos < slen) {
        match = 1
        yadi (rpos + flen > slen) {
            match = 0
        } anya {
            j = 0
            yavat (j < flen) {
                yadi (akshar(s, rpos + j) != akshar(f, j)) { match = 0 }
                j = j + 1
            }
        }
        yadi (match == 1) {
            k = 0
            yavat (k < rlen) {
                akshar_rakh(dst, wpos, akshar(r, k))
                wpos = wpos + 1
                k = k + 1
            }
            rpos = rpos + flen
        } anya {
            akshar_rakh(dst, wpos, akshar(s, rpos))
            wpos = wpos + 1
            rpos = rpos + 1
        }
    }
    akshar_rakh(dst, wpos, 0)
    prati wpos
}

# khand_bhed(src, sn, sep, sepn, parts, maxparts) — split src on sep.
# Same length-prefixed segment format as varna_bhed (R9): parts holds
# [len0, b0, b1, ..., len1, b0, ...]; cells hold one byte value each.
# Returns the segment count (capped at maxparts). Empty separator: no
# split (one segment). Empty input: one empty segment.
prakriya khand_bhed(src, sn, sep, sepn, parts, maxparts) {
    vitti s = src
    vitti slen = sn
    vitti sp = sep
    vitti splen = sepn
    vitti dst = parts
    vitti maxp = maxparts
    vitti nseg = 0
    vitti wpos = 0
    vitti segstart = 0
    vitti rpos = 0
    vitti done = 0
    vitti fpos = 0
    vitti si = 0
    vitti sj = 0
    vitti smatch = 0
    vitti segend = 0
    vitti seglen = 0
    vitti sk = 0
    vitti ci = 0
    yadi (slen == 0) {
        dst[0] = 0
        prati 1
    }
    yadi (splen <= 0) {
        # splen < 0: same one-segment result as empty separator
        # (the old code looped forever on a negative length).
        dst[0] = slen
        khand_mukt(s, slen, dst + 8)
        prati 1
    }
    done = 0
    yavat (done == 0) {
        fpos = 0 - 1
        si = rpos
        yavat (si + splen <= slen) {
            smatch = 1
            sj = 0
            yavat (sj < splen) {
                yadi (akshar(s, si + sj) != akshar(sp, sj)) { smatch = 0 }
                sj = sj + 1
            }
            yadi (smatch == 1) {
                fpos = si
                si = slen
            } anya {
                si = si + 1
            }
        }
        segend = slen
        yadi (fpos >= 0) { segend = fpos }
        yadi (nseg < maxp) {
            seglen = segend - segstart
            dst[wpos] = seglen
            # unpack writes a 0 cell at dst[wpos+1+seglen]; the next
            # segment's length overwrites it (or it trails harmlessly).
            # Cell index -> byte offset: (wpos + 1) * 8.
            khand_mukt(s + segstart, seglen, dst + (wpos + 1) * 8)
            wpos = wpos + 1 + seglen
            nseg = nseg + 1
        }
        yadi (fpos < 0) {
            done = 1
        } anya {
            segstart = fpos + splen
            rpos = segstart
            yadi (rpos >= slen) {
                yadi (nseg < maxp) {
                    dst[wpos] = 0
                    nseg = nseg + 1
                }
                done = 1
            }
        }
    }
    prati nseg
}

# khand_yuj(parts, count, sep, sepn, out) — inverse of khand_bhed for the
# length-prefixed format. Joins `count` segments with sep into a byte
# string. Returns the new byte count.
prakriya khand_yuj(parts, count, sep, sepn, out) {
    vitti p = parts
    vitti cnt = count
    vitti sp = sep
    vitti splen = sepn
    vitti dst = out
    vitti rpos = 0
    vitti wpos = 0
    vitti si = 0
    vitti seglen = 0
    vitti k = 0
    vitti q = 0
    yavat (si < cnt) {
        seglen = p[rpos]
        rpos = rpos + 1
        # pack writes a 0 byte at dst[wpos+seglen]; the separator (or
        # the final terminator below) overwrites it.
        # Cell index -> byte offset: rpos * 8.
        khand_bandh(p + rpos * 8, seglen, dst + wpos)
        wpos = wpos + seglen
        rpos = rpos + seglen
        yadi (si < cnt - 1) {
            q = 0
            yavat (q < splen) {
                akshar_rakh(dst, wpos, akshar(sp, q))
                wpos = wpos + 1
                q = q + 1
            }
        }
        si = si + 1
    }
    akshar_rakh(dst, wpos, 0)
    prati wpos
}

# khand_chhid(src, sn, out) — strip leading/trailing ASCII spaces (32).
# Returns the new byte count.
prakriya khand_chhid(src, sn, out) {
    vitti s = src
    vitti slen = sn
    vitti dst = out
    vitti lo = 0
    vitti go = 1
    vitti hi = 0
    vitti go2 = 1
    vitti wpos = 0
    vitti k = 0
    yavat (go == 1) {
        yadi (lo >= slen) {
            go = 0
        } anya {
            yadi (akshar(s, lo) == 32) { lo = lo + 1 } anya { go = 0 }
        }
    }
    hi = slen
    yavat (go2 == 1) {
        yadi (hi <= lo) {
            go2 = 0
        } anya {
            yadi (akshar(s, hi - 1) == 32) { hi = hi - 1 } anya { go2 = 0 }
        }
    }
    k = lo
    yavat (k < hi) {
        akshar_rakh(dst, wpos, akshar(s, k))
        wpos = wpos + 1
        k = k + 1
    }
    akshar_rakh(dst, wpos, 0)
    prati wpos
}

# khand_unnat(src, sn, out) / khand_avanat — ASCII case conversion on byte
# strings. Returns the byte count. sn < 0: empty output (the old
# code wrote the terminator at out[-1], out of bounds).
prakriya khand_unnat(src, sn, out) {
    vitti s = src
    vitti slen = sn
    vitti dst = out
    vitti i = 0
    vitti c = 0
    yadi (slen < 0) {
        akshar_rakh(dst, 0, 0)
        prati 0
    }
    yavat (i < slen) {
        c = akshar(s, i)
        yadi (c >= 97) {
            yadi (c <= 122) { c = c - 32 }
        }
        akshar_rakh(dst, i, c)
        i = i + 1
    }
    akshar_rakh(dst, slen, 0)
    prati slen
}

prakriya khand_avanat(src, sn, out) {
    vitti s = src
    vitti slen = sn
    vitti dst = out
    vitti i = 0
    vitti c = 0
    yadi (slen < 0) {
        akshar_rakh(dst, 0, 0)
        prati 0
    }
    yavat (i < slen) {
        c = akshar(s, i)
        yadi (c >= 65) {
            yadi (c <= 90) { c = c + 32 }
        }
        akshar_rakh(dst, i, c)
        i = i + 1
    }
    akshar_rakh(dst, slen, 0)
    prati slen
}

# khand_aadi(src, sn, pre, pn) / khand_ant — 0/1 on byte strings.
# A negative prefix/suffix length is invalid: 0 (the old code
# treated it as empty and returned 1).
prakriya khand_aadi(src, sn, pre, pn) {
    vitti s = src
    vitti slen = sn
    vitti pr = pre
    vitti plen = pn
    vitti i = 0
    yadi (plen < 0) { prati 0 }
    yadi (plen > slen) { prati 0 }
    yavat (i < plen) {
        yadi (akshar(s, i) != akshar(pr, i)) { prati 0 }
        i = i + 1
    }
    prati 1
}

prakriya khand_ant(src, sn, suf, sn2) {
    vitti s = src
    vitti slen = sn
    vitti sf = suf
    vitti sflen = sn2
    vitti i = 0
    yadi (sflen < 0) { prati 0 }
    yadi (sflen > slen) { prati 0 }
    yavat (i < sflen) {
        yadi (akshar(s, slen - sflen + i) != akshar(sf, i)) { prati 0 }
        i = i + 1
    }
    prati 1
}

# khand_tul(a, an, b, bn) — -1 / 0 / 1 (lexicographic by byte value).
prakriya khand_tul(a, an, b, bn) {
    vitti x = a
    vitti xn = an
    vitti y = b
    vitti yn = bn
    vitti i = 0
    vitti n = 0
    vitti cx = 0
    vitti cy = 0
    n = xn
    yadi (yn < n) { n = yn }
    yavat (i < n) {
        cx = akshar(x, i)
        cy = akshar(y, i)
        yadi (cx < cy) { prati 0 - 1 }
        yadi (cx > cy) { prati 1 }
        i = i + 1
    }
    yadi (xn < yn) { prati 0 - 1 }
    yadi (xn > yn) { prati 1 }
    prati 0
}

# khand_viparyay(src, sn, out) — copy src reversed into out (WS3, R19).
# Two-pointer vinimay, so it is SAFE IN PLACE (src == out works). Writes
# a 0 terminator at out[sn]. Returns sn. sn <= 0 writes only the
# terminator, returns 0. Before this, reversing a byte string meant
# a hand-written loop at every call site.
prakriya khand_viparyay(src, sn, out) {
    vitti s = src
    vitti n = sn
    vitti dst = out
    vitti i = 0
    vitti j = 0
    vitti t = 0
    yadi (n <= 0) {
        akshar_rakh(dst, 0, 0)
        prati 0
    }
    i = 0
    j = n - 1
    yavat (i < j) {
        t = akshar(s, i)
        akshar_rakh(dst, i, akshar(s, j))
        akshar_rakh(dst, j, t)
        i = i + 1
        j = j - 1
    }
    yadi (n % 2 == 1) {
        akshar_rakh(dst, n / 2, akshar(s, n / 2))
    }
    akshar_rakh(dst, n, 0)
    prati n
}

# khand_gan(hay, hn, needle, nn) — count NON-OVERLAPPING occurrences
# of needle in hay (WS3, R19). Empty needle returns 0 (khand_anwesh
# would match at 0 forever). Before this, counting meant looping
# khand_anwesh over successive suffixes at every call site.
prakriya khand_gan(hay, hn, needle, nn) {
    vitti h = hay
    vitti hlen = hn
    vitti nd = needle
    vitti nlen = nn
    vitti pos = 0
    vitti c = 0
    vitti f = 0
    yadi (nlen <= 0) { prati 0 }
    yavat (pos <= hlen - nlen) {
        f = khand_anwesh(h + pos, hlen - pos, nd, nlen)
        yadi (f < 0) { prati c }
        c = c + 1
        pos = pos + f + nlen
    }
    prati c
}

# khand_gan_swar(s, n) — count lowercase vowels (a e i o u) in the
# first n bytes (WS1, R20). Explicit-length form of gan_swar:
# unlike gan_swar (which scans to the NUL terminator), this stops
# at n, so it is correct on slices. Mirrors gan_swar exactly:
# lowercase vowels only, no uppercase.
prakriya khand_gan_swar(s, n) {
    vitti src = s
    vitti cnt = n
    vitti i = 0
    vitti c = 0
    vitti ch = 0
    yavat (i < cnt) {
        ch = akshar(src, i)
        yadi (ch == 97 || ch == 101 || ch == 105 || ch == 111 || ch == 117) {
            c = c + 1
        }
        i = i + 1
    }
    prati c
}

# khand_gan_akshar(s, n, code) — count occurrences of byte `code` in
# the first n bytes (WS1, R20). Explicit-length form of gan_akshar;
# correct on slices. (For a substring, use khand_gan.)
prakriya khand_gan_akshar(s, n, code) {
    vitti src = s
    vitti cnt = n
    vitti cd = code
    vitti i = 0
    vitti c = 0
    yavat (i < cnt) {
        yadi (akshar(src, i) == cd) { c = c + 1 }
        i = i + 1
    }
    prati c
}

# khand_anwesh_akshar(s, n, code) — first index of byte `code` in the first
# n bytes, or -1 (WS1, R20). Explicit-length form of anwesh_akshar.
prakriya khand_anwesh_akshar(s, n, code) {
    vitti src = s
    vitti cnt = n
    vitti cd = code
    vitti i = 0
    yavat (i < cnt) {
        yadi (akshar(src, i) == cd) { prati i }
        i = i + 1
    }
    prati 0 - 1
}

# khand_asti_sarv_ank(s, n) — 1 if all of the first n bytes are ASCII
# digits, else 0 (WS1, R20). Explicit-length form of asti_sarv_ank.
# Empty (n == 0) is 0, mirroring asti_sarv_ank.
prakriya khand_asti_sarv_ank(s, n) {
    vitti src = s
    vitti cnt = n
    vitti i = 0
    vitti ch = 0
    yadi (cnt <= 0) { prati 0 }
    yavat (i < cnt) {
        ch = akshar(src, i)
        yadi (ch < 48 || ch > 57) { prati 0 }
        i = i + 1
    }
    prati 1
}

# khand_sam(a, an, b, bn) — 1 if the two byte strings are equal,
# else 0 (WS1, R20). Explicit-length form of varna_sam.
prakriya khand_sam(a, an, b, bn) {
    yadi (khand_tul(a, an, b, bn) == 0) { prati 1 }
    prati 0
}
