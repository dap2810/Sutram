# lib/set.smlib — Sutram standard library: sets (set algebra over map)
# layer: alloc
#
# A set IS a map (`lib/map.smlib`) with a dummy value of 1: membership is
# nighantu_antah, iteration is nighantu_kunjika_ashtak (R17: packed-byte segments,
# passed straight to the byte-key map functions with no repacking).
#
# ELEMENTS ARE BYTE STRINGS — the same choice as `map.smlib`'s keys:
# a caller passes a literal directly ("apple"), with an explicit
# length. Do NOT pass char-code (qword-cell) arrays here. Inherited
# from map: keys longer than 32 bytes are truncated to 32 on every
# operation, consistently.
#
# CAPACITY: a set's capacity is fixed at rakh_srij and stored in the
# buffer (m[0]). Set operations that write into `out` read out's
# capacity from out[0], so the caller MUST pass a rakh_srij'd buffer
# with room for the result: cap + bcap for union, cap for difference,
# min(cap, bcap) for intersection. If `out` is too small, nighantu_khip
# silently drops the overflowing elements (map's full-table behaviour)
# and the returned size will be smaller than the true result — size
# the output generously and check the returned size.
#
# `out` for union / intersect / difference must be a FRESH, EMPTY set:
# the operations ADD into it and return nighantu_maap(out) afterwards.
# rakh_asti_upasamuh(a, ...) with an empty `a` is 1 (vacuous truth).
#
# The 6-argument cap still applies: union / intersect / difference keep
# the 5-argument shape from the round brief by reading out's capacity
# from out[0] instead of taking it as a sixth parameter.

yoj nighantu
yoj khand

# rakh_srij(cap) — allocate an empty set of capacity cap (clamped to >= 1).
prakriya rakh_srij(cap) {
    prati nighantu_srij(cap)
}

# rakh_yuj(s, cap, elem, elem_n) — add elem; 1 on success, 0 if the set
# is full (then the set is unchanged). Adding an existing element keeps
# rakh_maap unchanged (idempotent).
prakriya rakh_yuj(s, cap, elem, elem_n) {
    prati nighantu_khip(s, cap, elem, elem_n, 1)
}

# rakh_antah(s, cap, elem, elem_n) — 1 if elem is in the set, else 0.
prakriya rakh_antah(s, cap, elem, elem_n) {
    prati nighantu_antah(s, cap, elem, elem_n)
}

# rakh_apanay(s, cap, elem, elem_n) — remove elem; 1 if removed, 0 if absent.
prakriya rakh_apanay(s, cap, elem, elem_n) {
    prati nighantu_apanay(s, cap, elem, elem_n)
}

# rakh_maap(s) — number of elements.
prakriya rakh_maap(s) {
    prati nighantu_maap(s)
}

# rakh_samroop_diff(a, cap, b, bcap, out) — add every element that is in
# exactly one of a, b into out (fresh, empty, capacity >= cap + bcap
# for the worst case, disjoint sets). (a - b) union (b - a).
# Returns rakh_maap(out). Before, the caller wrote two
# rakh_bhed calls into two scratch sets plus a rakh_sangam at
# every call site.
prakriya rakh_samroop_diff(a, cap, b, bcap, out) {
    vitti ocap = out[0]
    vitti tmpa = nirmmita(cap * 33 + 1)
    vitti tmpb = nirmmita(bcap * 33 + 1)
    vitti nka = nighantu_kunjika_ashtak(a, tmpa)
    vitti nkb = nighantu_kunjika_ashtak(b, tmpb)
    vitti pos = 0
    vitti i = 0
    vitti seglen = 0
    yavat (i < nka) {
        seglen = akshar(tmpa, pos)
        yadi (nighantu_antah(b, bcap, tmpa + pos + 1, seglen) == 0) {
            nighantu_khip(out, ocap, tmpa + pos + 1, seglen, 1)
        }
        pos = pos + 1 + seglen
        i = i + 1
    }
    pos = 0
    i = 0
    yavat (i < nkb) {
        seglen = akshar(tmpb, pos)
        yadi (nighantu_antah(a, cap, tmpb + pos + 1, seglen) == 0) {
            nighantu_khip(out, ocap, tmpb + pos + 1, seglen, 1)
        }
        pos = pos + 1 + seglen
        i = i + 1
    }
    prati nighantu_maap(out)
}

# rakh_sangam(a, cap, b, bcap, out) — add every element of a and of b into
# out (fresh, empty, capacity >= cap + bcap). Returns rakh_maap(out).
# R17: iteration is nighantu_kunjika_ashtak, whose packed-byte segments go
# straight into nighantu_khip. (Before R17 this used nighantu_kunjika cell segments
# plus a khand_bandh per segment; passing a cell segment straight to
# nighantu_khip compiled fine and silently compared the wrong bytes.)
prakriya rakh_sangam(a, cap, b, bcap, out) {
    vitti ocap = out[0]
    vitti tmpa = nirmmita(cap * 33 + 1)
    vitti tmpb = nirmmita(bcap * 33 + 1)
    vitti nka = nighantu_kunjika_ashtak(a, tmpa)
    vitti nkb = nighantu_kunjika_ashtak(b, tmpb)
    vitti pos = 0
    vitti i = 0
    vitti seglen = 0
    yavat (i < nka) {
        seglen = akshar(tmpa, pos)
        nighantu_khip(out, ocap, tmpa + pos + 1, seglen, 1)
        pos = pos + 1 + seglen
        i = i + 1
    }
    pos = 0
    i = 0
    yavat (i < nkb) {
        seglen = akshar(tmpb, pos)
        nighantu_khip(out, ocap, tmpb + pos + 1, seglen, 1)
        pos = pos + 1 + seglen
        i = i + 1
    }
    prati nighantu_maap(out)
}

# rakh_sampat(a, cap, b, bcap, out) — add every element of a that is
# also in b into out (fresh, empty, capacity >= min(cap, bcap)).
# Returns rakh_maap(out).
prakriya rakh_sampat(a, cap, b, bcap, out) {
    vitti ocap = out[0]
    vitti tmpa = nirmmita(cap * 33 + 1)
    vitti nka = nighantu_kunjika_ashtak(a, tmpa)
    vitti pos = 0
    vitti i = 0
    vitti seglen = 0
    yavat (i < nka) {
        seglen = akshar(tmpa, pos)
        yadi (nighantu_antah(b, bcap, tmpa + pos + 1, seglen) == 1) {
            nighantu_khip(out, ocap, tmpa + pos + 1, seglen, 1)
        }
        pos = pos + 1 + seglen
        i = i + 1
    }
    prati nighantu_maap(out)
}

# rakh_bhed(a, cap, b, bcap, out) — add every element of a that is
# NOT in b into out (fresh, empty, capacity >= cap). Returns
# rakh_maap(out).
prakriya rakh_bhed(a, cap, b, bcap, out) {
    vitti ocap = out[0]
    vitti tmpa = nirmmita(cap * 33 + 1)
    vitti nka = nighantu_kunjika_ashtak(a, tmpa)
    vitti pos = 0
    vitti i = 0
    vitti seglen = 0
    yavat (i < nka) {
        seglen = akshar(tmpa, pos)
        yadi (nighantu_antah(b, bcap, tmpa + pos + 1, seglen) == 0) {
            nighantu_khip(out, ocap, tmpa + pos + 1, seglen, 1)
        }
        pos = pos + 1 + seglen
        i = i + 1
    }
    prati nighantu_maap(out)
}

# rakh_vardh(s, newcap) — copy the set into a fresh set of capacity
# newcap (WS2, R20). A set IS a map, so this is nighantu_vardh's copy
# with the same all-or-nothing rule: returns the new handle, or 0
# if newcap < rakh_maap(s). Rebind: s = rakh_vardh(s, 32).
prakriya rakh_vardh(s, newcap) {
    prati nighantu_vardh(s, newcap)
}

# rakh_rikta(s) — reset the set to empty in place (WS2, R19): same
# handle, same capacity. A set IS a map, so this is nighantu_rikta's full
# zero (count, state, keylens, vals, key bytes) with no stale
# elements readable afterwards. Returns 1.
prakriya rakh_rikta(s) {
    prati nighantu_rikta(s)
}

# rakh_sam(a, cap, b, bcap) — 1 if a and b hold exactly the same
# elements, else 0 (WS3, R19). Both subset checks in one call;
# two empty sets are equal. Before this, the caller wrote both
# rakh_asti_upasamuh calls by hand.
prakriya rakh_sam(a, cap, b, bcap) {
    yadi (rakh_asti_upasamuh(a, cap, b, bcap) == 0) { prati 0 }
    yadi (rakh_asti_upasamuh(b, bcap, a, cap) == 0) { prati 0 }
    prati 1
}

# rakh_asti_upasamuh(a, cap, b, bcap) — 1 if every element of a is in b, else
# 0. Empty a is a subset of everything.
prakriya rakh_asti_upasamuh(a, cap, b, bcap) {
    vitti tmpa = nirmmita(cap * 33 + 1)
    vitti nka = nighantu_kunjika_ashtak(a, tmpa)
    vitti pos = 0
    vitti i = 0
    vitti seglen = 0
    yavat (i < nka) {
        seglen = akshar(tmpa, pos)
        yadi (nighantu_antah(b, bcap, tmpa + pos + 1, seglen) == 0) {
            prati 0
        }
        pos = pos + 1 + seglen
        i = i + 1
    }
    prati 1
}

# rakh_tak_mala(s, cap, out) — write the set's elements into out in
# length-prefixed form [len0, b0, b1, ..., len1, b0, ...] (same shape as
# nighantu_kunjika / khand_bhed parts), SORTED lexicographically by byte value
# (khand_tul), so output is deterministic regardless of insertion
# order or hash layout. Returns the element count.
prakriya rakh_tak_mala(s, cap, out) {
    vitti tmp = nirmmita(cap * 33 + 1)
    vitti nk = nighantu_kunjika_ashtak(s, tmp)
    vitti scratch = nirmmita(cap * 32 + 1)
    vitti ptrs = nirmmita(cap * 8)
    vitti lens = nirmmita(cap * 8)
    vitti pos = 0
    vitti i = 0
    vitti j = 0
    vitti seglen = 0
    vitti wpos = 0
    vitti woff = 0
    vitti tp = 0
    vitti tl = 0
    vitti k = 0
    # copy every byte segment into one scratch byte area, recording
    # (byte-offset, len) pairs; khand_tul needs packed bytes.
    # R17: segments are already bytes, so this is a plain byte copy.
    yavat (i < nk) {
        seglen = akshar(tmp, pos)
        ptrs[i] = woff
        lens[i] = seglen
        k = 0
        yavat (k < seglen) {
            akshar_rakh(scratch, woff + k, akshar(tmp, pos + 1 + k))
            k = k + 1
        }
        woff = woff + seglen
        pos = pos + 1 + seglen
        i = i + 1
    }
    # bubble-sort the pairs by element bytes
    i = 0
    yavat (i < nk - 1) {
        j = 0
        yavat (j < nk - 1 - i) {
            yadi (khand_tul(scratch + ptrs[j], lens[j], scratch + ptrs[j + 1], lens[j + 1]) > 0) {
                tp = ptrs[j]
                ptrs[j] = ptrs[j + 1]
                ptrs[j + 1] = tp
                tl = lens[j]
                lens[j] = lens[j + 1]
                lens[j + 1] = tl
            }
            j = j + 1
        }
        i = i + 1
    }
    # emit in sorted order; unpack writes a 0 cell at the next length
    # slot, which the next segment's length overwrites (or trails).
    wpos = 0
    i = 0
    yavat (i < nk) {
        out[wpos] = lens[i]
        khand_mukt(scratch + ptrs[i], lens[i], out + (wpos + 1) * 8)
        wpos = wpos + 1 + lens[i]
        i = i + 1
    }
    prati nk
}
