# lib/chandas.smlib — Sutram standard library: Pingala's prosody mathematics
# layer: core
#
# After Pingala's Chandahśāstra (~2nd c. BCE). Sanskrit metre is built from two
# syllable weights — laghu (light) and guru (heavy) — so an n-syllable metre is a
# sequence of two choices: there are exactly 2^n of them. Pingala gave the doubling
# rule for 2^n, the Meru-prastāra (Pascal's triangle) to count how many metres have
# exactly k guru syllables, and the mātrā-meru, which generates the Fibonacci numbers.
#
# A pattern is carried as an integer bitmask: bit i (LSB = first syllable) is 1 for
# guru, 0 for laghu. The integer value IS the pattern's index in the prastāra.
prakriya dviguna(n) {
    vitti x = n
    vitti r = 1
    vitti i = 0
    yavat (i < x) {
        r = r * 2
        i = i + 1
    }
    nivartanam r
}

# meru(n, k) — the binomial coefficient C(n, k); 0 for k < 0 or k > n.
prakriya meru(n, k) {
    vitti top = n
    vitti r = k
    yadi (r < 0) { nivartanam 0 }
    yadi (r > top) { nivartanam 0 }
    yadi (r > top - r) { r = top - r }
    vitti res = 1
    vitti i = 1
    yavat (i <= r) {
        # R48: res * (top - r + i) / i is exact, but the product passed 2^63 for
        # answers that fit (meru(62, 31) came out negative, meru(100, 16) wrong).
        # Divide out g = mahattam(res, i) first: i / g then divides (top - r + i),
        # and no step is larger than C(top - r + i, i) <= the answer.
        vitti m = top - r + i
        vitti g = res
        vitti b = i
        yavat (b != 0) {
            vitti t = g % b
            g = b
            b = t
        }
        res = (res / g) * (m / (i / g))
        i = i + 1
    }
    nivartanam res
}

# matra_meru(n) — the nth Fibonacci number (matra_meru(0) = 0, matra_meru(1) = 1).
prakriya matra_meru(n) {
    vitti x = n
    yadi (x <= 0) { nivartanam 0 }
    yadi (x == 1) { nivartanam 1 }
    vitti a = 0
    vitti b = 1
    vitti i = 2
    yavat (i <= x) {
        vitti c = a + b
        a = b
        b = c
        i = i + 1
    }
    nivartanam b
}

# asti_guru(pat, i) — 1 if bit i of the integer pattern pat is set; 0 for i < 0 or i >= 64.
prakriya asti_guru(pat, i) {
    vitti p = pat
    vitti idx = i
    # Index must be a bit position: negative or >= 64 has no bit
    # (i >= 64 shifted the divisor to 0 and trapped with SIGFPE).
    yadi (idx < 0) { nivartanam 0 }
    yadi (idx >= 64) { nivartanam 0 }
    vitti d = 1
    vitti j = 0
    yavat (j < idx) {
        d = d * 2
        j = j + 1
    }
    nivartanam (p / d) % 2
}

# guru_gan(pat) — count of set bits in pat (population count); negatives return 0.
prakriya guru_gan(pat) {
    vitti p = pat
    vitti c = 0
    # Negative patterns return 0, as bit_gan (R28 contract).
    yavat (p > 0) {
        c = c + (p % 2)
        p = p / 2
    }
    nivartanam c
}

# meru_mala(a, n) — fills a[0..n] with the nth row of Pascal's triangle: a[i] = meru(n, i).
prakriya meru_mala(a, n) {
    vitti i = 0
    yavat (i <= n) {
        a[i] = meru(n, i)
        i = i + 1
    }
}
