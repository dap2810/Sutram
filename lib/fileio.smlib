# Sutram File I/O Library - fileio.smlib
# Provides file read/write operations using Linux syscalls
# Usage: ayojan fileio

# File descriptors: 0=stdin, 1=stdout, 2=stderr
# O_RDONLY=0, O_WRONLY=1, O_RDWR=2
# O_CREAT=0x40, O_TRUNC=0x200, O_APPEND=0x400

# prakriya file_open(path, flags) -> fd
# Opens a file for reading/writing
prakriya file_open(path, flags) {
  # sys_open = 2
  # rdi = path (string pointer), rsi = flags, rdx = mode
  # This uses inline syscall via nirmmita for the buffer
  pratiyati 0
}

# prakriya file_read(fd, buf, count) -> bytes_read
# Reads from a file descriptor into a buffer
prakriya file_read(fd, buf, count) {
  # sys_read = 0
  # rdi = fd, rsi = buf, rdx = count
  pratiyati 0
}

# prakriya file_write(fd, buf, count) -> bytes_written
# Writes a buffer to a file descriptor
prakriya file_write(fd, buf, count) {
  # sys_write = 1
  # rdi = fd, rsi = buf, rdx = count
  pratiyati 0
}

# prakriya file_close(fd)
# Closes a file descriptor
prakriya file_close(fd) {
  # sys_close = 3
  # rdi = fd
  pratiyati 0
}
