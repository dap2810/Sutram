# lib/ganit.smlib — Sutram standard library: mathematics
# layer: core
#
# Pure integer arithmetic, written only with verified language features.
# Every function copies its parameters into locals before mutating them,
# because the compiler currently faults on assignment to a parameter.
prakriya varg(n) {
    # R80: -1 when n * n is larger than 2^63 - 1 (it used to wrap: varg(3037000500) was negative)
    vitti x = n
    yadi (x > 3037000499 || x < 0 - 3037000499) { nivartanam 0 - 1 }
    nivartanam x * x
}

# vargit(n) — n squared (n * n); -1 when the square is larger than 2^63 - 1 (R80).
prakriya vargit(n) {
    # R80: -1 when n * n is larger than 2^63 - 1, as varg
    vitti x = n
    yadi (x > 3037000499 || x < 0 - 3037000499) { nivartanam 0 - 1 }
    nivartanam x * x
}

# ghan(n) — n cubed (n * n * n); saturates at 2^63 - 1 / -2^63 past int64 (R80).
prakriya ghan(n) {
    # R80: past int64 the cube saturates - 2^63 - 1 for n > 2097151, -2^63 for n < -2097152
    # ((-2097152)^3 is exactly -2^63). It used to wrap: ghan(10^9) was negative.
    vitti x = n
    yadi (x > 2097151) { nivartanam 9223372036854775807 }
    yadi (x < 0 - 2097152) { nivartanam 0 - 9223372036854775807 - 1 }
    nivartanam x * x * x
}

# nirapeksh_mulya(n) — absolute value of n (MIN wraps to MIN, as it cannot be negated).
prakriya nirapeksh_mulya(n) {
    vitti x = n
    yadi (x < 0) {
        x = 0 - x
    }
    nivartanam x
}

# laghu2(a, b) — the smaller of a and b.
prakriya laghu2(a, b) {
    vitti x = a
    vitti y = b
    yadi (x < y) { nivartanam x }
    nivartanam y
}

# adhik2(a, b) — the larger of a and b.
prakriya adhik2(a, b) {
    vitti x = a
    vitti y = b
    yadi (x > y) { nivartanam x }
    nivartanam y
}

# mahattam_samapavartak(a, b) — greatest common divisor of a and b, always non-negative (mahattam_samapavartak(0, 0) = 0).
prakriya mahattam_samapavartak(a, b) {
    vitti x = a
    vitti y = b
    yavat (y != 0) {
        vitti t = y
        y = x % y
        x = t
    }
    # mahattam_samapavartak is non-negative by definition. The loop above can return a
    # negative value when the first argument is negative (e.g.
    # mahattam_samapavartak(-6, 4) was -2), so take the absolute value. mahattam_samapavartak(MIN, 0)
    # still returns MIN: |MIN| does not fit (wrapping, as nirapeksh_mulya).
    yadi (x < 0) { x = 0 - x }
    nivartanam x
}

# laghuttam_samapavartya(a, b) — least common multiple of a and b, always non-negative (laghuttam_samapavartya(0, 0) = 0);
# -1 when it is larger than 2^63 - 1 (R80).
prakriya laghuttam_samapavartya(a, b) {
    vitti g = mahattam_samapavartak(a, b)
    # mahattam_samapavartak(0, 0) is 0; without this guard (a / g) divides by zero and
    # the program traps (SIGFPE). laghuttam_samapavartya(0, 0) = 0 by convention.
    yadi (g == 0) { nivartanam 0 }
    # R80: |a / g| * |b|, checked. It used to wrap and then take the absolute value - a plausible
    # wrong POSITIVE: laghuttam_samapavartya(4000000000, 4000000001) was 2446744069709551616.
    vitti q = a / g
    vitti c = b
    yadi (q == 0) { nivartanam 0 }
    yadi (c == 0) { nivartanam 0 }
    vitti minv = (0 - 9223372036854775807) - 1
    yadi (q == minv) { nivartanam 0 - 1 }   # |MIN| alone does not fit
    yadi (c == minv) { nivartanam 0 - 1 }
    yadi (q < 0) { q = 0 - q }
    yadi (c < 0) { c = 0 - c }
    yadi (q > 9223372036854775807 / c) { nivartanam 0 - 1 }
    nivartanam q * c
}

# ghat(base, e) — base raised to the power e (e >= 0; negative e returns 1, as the loop never runs);
# saturates at 2^63 - 1 / -2^63 past int64 (R80), as ganita_paripurna_ghat.
prakriya ghat(base, e) {
    # R80: past int64 the power saturates - 2^63 - 1 when the answer is positive, -2^63 when it is
    # negative (base < 0, e odd). It used to wrap: ghat(2, 63) was -2^63, ghat(3, 63) negative.
    vitti b = base
    vitti n = e
    yadi (n <= 0) { nivartanam 1 }
    vitti neg = 0
    yadi (b < 0 && n % 2 == 1) { neg = 1 }
    vitti minv = 0 - 9223372036854775807 - 1
    yadi (b == minv) {
        yadi (n == 1) { nivartanam minv }
        yadi (neg == 1) { nivartanam minv }
        nivartanam 9223372036854775807
    }
    vitti ab = b
    yadi (ab < 0) { ab = 0 - ab }
    vitti m = 1
    yavat (n > 0) {
        yadi (ab != 0 && m > 9223372036854775807 / ab) {
            yadi (neg == 1) { nivartanam minv }
            nivartanam 9223372036854775807
        }
        m = m * ab
        n = n - 1
    }
    yadi (neg == 1) { nivartanam 0 - m }
    nivartanam m
}

# kramgun(n) — n factorial (n!); 1 for n < 2; -1 for n >= 21, whose factorial is larger than
# 2^63 - 1 (R80: it used to wrap - kramgun(21) was negative). ganita_paripurna_kramgun saturates instead.
prakriya kramgun(n) {
    # Iterative: the recursive form overflowed the call stack at
    # kramgun(100000) (SIGSEGV).
    vitti x = n
    vitti r = 1
    vitti i = 2
    yadi (x < 2) { nivartanam 1 }
    yavat (i <= x) {
        yadi (r > 9223372036854775807 / i) { nivartanam 0 - 1 }   # R80: 21! and up do not fit
        r = r * i
        i = i + 1
    }
    nivartanam r
}

# asti_abhajya(n) — 1 if n is prime, 0 otherwise (n < 2 is not prime).
prakriya asti_abhajya(n) {
    vitti x = n
    yadi (x < 2) { nivartanam 0 }
    vitti i = 2
    # Division bound, not i * i: i * i overflows for x near MAX
    # (the vargit wraps negative, the condition stays true, and
    # the loop never terminates for a large prime).
    yavat (i <= x / i) {
        yadi (x % i == 0) { nivartanam 0 }
        i = i + 1
    }
    nivartanam 1
}

# yog_tak(n) — sum 1 + 2 + ... + n, closed form n*(n+1)/2; 0 for n <= 0; -1 when the sum is larger
# than 2^63 - 1 (n > 4294967295; R80).
prakriya yog_tak(n) {
    # Closed form n*(n+1)/2 (the old loop took n iterations, so
    # yog_tak(4294967296) was ~4.3e9 iterations). Divide before
    # multiplying, by parity: even (n/2)*(n+1), odd n*(n/2+1).
    # n <= 0: 0, as the old loop. R80: -1 for n > 4294967295, whose sum is larger than 2^63 - 1
    # (it used to wrap - yog_tak(4294967296) was pinned at -9223372034707292160, a wrong answer).
    vitti x = n
    yadi (x <= 0) { nivartanam 0 }
    yadi (x > 4294967295) { nivartanam 0 - 1 }
    yadi (x % 2 == 0) { nivartanam (x / 2) * (x + 1) }
    nivartanam x * (x / 2 + 1)
}

# dvigun(n) — n doubled (n * 2).
prakriya dvigun(n)
    nivartanam n * 2

# trigun(n) — n tripled (n * 3).
prakriya trigun(n)
    nivartanam n * 3

# vardh(n) — n incremented by 1 (n + 1).
prakriya vardh(n)
    nivartanam n + 1

# bit_gan(n) — count of set bits in n; negatives return 0.
prakriya bit_gan(n) {
    vitti x = n
    vitti c = 0
    # Negatives return 0 (R28-pinned contract: defined for n >= 0).
    yavat (x > 0) {
        c = c + (x % 2)
        x = x / 2
    }
    nivartanam c
}

# ganit_yadricch(state): Knuth MMIX LCG — state = state * 6364136223846793005
# + 1442695040888963407 (shesh 2^64, plain wrapping arithmetic). `state`
# is a 1-cell array holding the seed; it is updated in place and the new
# state is returned. The full 64-bit state is returned (it may be
# negative); use nirapeksh_mulya or a modulo to map it to a range. Any seed
# works, including 0. Deterministic: the same seed always yields the
# same sequence. There is no entropy source in the language, so the
# caller owns the seed. Not secure randomness: never use it for keys or tokens.
prakriya ganit_yadricch(state) {
    vitti s = state
    s[0] = s[0] * 6364136223846793005 + 1442695040888963407
    nivartanam s[0]
}

# ganit_seemit(v, lo, hi): lo if v < lo, hi if v > hi, else v.
# Requires lo <= hi. If lo > hi: lo when v < lo, otherwise hi (R9, F4: the
# old comment said lo always; ganit_seemit(4, 4, -2) is -2).
prakriya ganit_seemit(v, lo, hi) {
    vitti x = v
    vitti a = lo
    vitti b = hi
    yadi (x < a) { nivartanam a }
    yadi (x > b) { nivartanam b }
    nivartanam x
}
