# lib/strconv.smlib — Sutram standard library: number <-> string conversion
# layer: alloc
#
# Renders integers as decimal (or base-2/8/16) digit characters into a buffer,
# and parses them back. Buffers are pankti of integer character codes (not
# byte-packed strings — see ROUND-08 Part B: Sutram has no byte-write primitive,
# so we use cell arrays of char codes, the same idiom as lib/baseconv.smlib).
#
# All functions handle: zero, negative numbers (decimal only), empty input.

# ank_tak_varna(n, out) — write decimal representation of int n into pankti out
# as character codes. Returns the character count (excluding terminator).
# out[ count ] is set to 0 as a terminator. Caller allocates >= 22 cells.
prakriya ank_tak_varna(n, out) {
    vitti val = n
    vitti dst = out
    yadi (val == (0 - 9223372036854775807) - 1) {
        # MIN: |MIN| = 2^63 does not fit in int64, so the negation
        # below would wrap and the digit loop would emit just "-".
        # Write "-9223372036854775808" directly.
        dst[0] = 45
        dst[1] = 57
        dst[2] = 50
        dst[3] = 50
        dst[4] = 51
        dst[5] = 51
        dst[6] = 55
        dst[7] = 50
        dst[8] = 48
        dst[9] = 51
        dst[10] = 54
        dst[11] = 56
        dst[12] = 53
        dst[13] = 52
        dst[14] = 55
        dst[15] = 55
        dst[16] = 53
        dst[17] = 56
        dst[18] = 48
        dst[19] = 56
        dst[20] = 0
        prati 20
    }
    vitti neg = 0
    yadi (val < 0) {
        neg = 1
        val = 0 - val
    }
    # collect digits least-significant first
    vitti rev = nirmmita(22 * 8)
    vitti rlen = 0
    yadi (val == 0) {
        rev[0] = 48
        rlen = 1
    } anya {
        yavat (val > 0) {
            rev[rlen] = (val % 10) + 48
            rlen = rlen + 1
            val = val / 10
        }
    }
    vitti pos = 0
    yadi (neg == 1) {
        dst[0] = 45
        pos = 1
    }
    vitti p = 0
    yavat (p < rlen) {
        dst[pos + p] = rev[rlen - 1 - p]
        p = p + 1
    }
    dst[pos + rlen] = 0
    prati pos + rlen
}

# varna_tak_ank(buf, n) — parse first n character codes of pankti buf as a
# decimal integer. Leading '-' negates. Returns the value; sets ok[0] to 1
# on success, 0 on malformed input (ok is a 1-cell pankti).
prakriya varna_tak_ank(buf, n, ok) {
    vitti src = buf
    vitti cnt = n
    vitti okp = ok
    okp[0] = 1
    yadi (cnt == 0) {
        okp[0] = 0
        prati 0
    }
    vitti neg = 0
    vitti p = 0
    yadi (src[0] == 45) {
        neg = 1
        p = 1
        yadi (cnt == 1) {
            okp[0] = 0
            prati 0
        }
    }
    vitti val = 0
    yavat (p < cnt) {
        vitti c = src[p]
        yadi (c < 48) {
            okp[0] = 0
            prati 0
        }
        yadi (c > 57) {
            okp[0] = 0
            prati 0
        }
        yadi (val > 922337203685477580) {
            okp[0] = 0
            prati 0
        }
        yadi (val == 922337203685477580) {
            yadi (neg == 1) {
                yadi ((c - 48) > 8) {
                    okp[0] = 0
                    prati 0
                }
            } anya {
                yadi ((c - 48) > 7) {
                    okp[0] = 0
                    prati 0
                }
            }
        }
        val = val * 10 + (c - 48)
        p = p + 1
    }
    yadi (neg == 1) { val = 0 - val }
    prati val
}

# ank_tak_aadhar_varna(n, base, out) — write n in `base` (2/8/10/16) into out
# as character codes (0-9, a-f). Returns count. No util_chinha handling; n >= 0.
# Base outside 2..36: terminator only, returns 0 (base 0 trapped
# with SIGFPE, base 1 looped forever past the buffer).
prakriya ank_tak_aadhar_varna(n, base, out) {
    vitti val = n
    vitti b = base
    vitti dst = out
    vitti rev = nirmmita(70 * 8)
    vitti rlen = 0
    yadi (b < 2) {
        dst[0] = 0
        prati 0
    }
    yadi (b > 36) {
        dst[0] = 0
        prati 0
    }
    yadi (val == 0) {
        dst[0] = 48
        dst[1] = 0
        prati 1
    }
    yavat (val > 0) {
        vitti d = val % b
        yadi (d < 10) {
            rev[rlen] = d + 48
        } anya {
            rev[rlen] = d + 87
        }
        rlen = rlen + 1
        val = val / b
    }
    vitti p = 0
    yavat (p < rlen) {
        dst[p] = rev[rlen - 1 - p]
        p = p + 1
    }
    dst[rlen] = 0
    prati rlen
}

# varna_tak_ank_aadhar(buf, n, base, ok) — parse first n char codes of buf in
# `base` (2/8/10/16). Sets ok[0]. Returns value.
prakriya varna_tak_ank_aadhar(buf, n, base, ok) {
    vitti src = buf
    vitti cnt = n
    vitti b = base
    vitti okp = ok
    okp[0] = 1
    yadi (cnt == 0) {
        okp[0] = 0
        prati 0
    }
    vitti val = 0
    vitti p = 0
    yavat (p < cnt) {
        vitti c = src[p]
        vitti d = 0 - 1
        yadi (c >= 48) {
            yadi (c <= 57) { d = c - 48 }
        }
        yadi (c >= 97) {
            yadi (c <= 102) { d = c - 87 }
        }
        yadi (c >= 65) {
            yadi (c <= 70) { d = c - 55 }
        }
        yadi (d < 0) {
            okp[0] = 0
            prati 0
        }
        yadi (d >= b) {
            okp[0] = 0
            prati 0
        }
        yadi (val > 9223372036854775807 / b) {
            okp[0] = 0
            prati 0
        }
        yadi (val == 9223372036854775807 / b) {
            yadi (d > 9223372036854775807 - val * b) {
                okp[0] = 0
                prati 0
            }
        }
        val = val * b + d
        p = p + 1
    }
    prati val
}

# pad_vam(out, count, width, fill) — left-pad the `count` character codes
# in pankti `out` to `width` using fill character code `fill`, in place.
# Returns the new count (width if width > count, else count).
# Caller must allocate >= width cells.
prakriya pad_vam(out, count, width, fill) {
    vitti dst = out
    vitti cnt = count
    vitti w = width
    vitti f = fill
    yadi (w <= cnt) { prati cnt }
    vitti shift = w - cnt
    # move existing chars right
    vitti p = cnt - 1
    yavat (p >= 0) {
        dst[p + shift] = dst[p]
        p = p - 1
    }
    # fill the left
    vitti q = 0
    yavat (q < shift) {
        dst[q] = f
        q = q + 1
    }
    dst[w] = 0
    prati w
}

# varna_tak_dashm(buf, n, ok): parse a decimal float from a byte string.
# Grammar: [-] digits [. digits] [(e|E) [-] digits]; at least one digit
# in the integer or fraction part. No leading/trailing whitespace, no
# '+', no "inf"/"nan" — those are ok = 0 (same conventions as
# varna_tak_ank). On success ok[0] = 1 and the dasham value is returned.
# On malformed input or overflow (|value| > ~1.8e308) ok[0] = 0 and the
# return is 0.0. Extreme underflow returns 0.0 with ok[0] = 1 (as
# strtod does). Mantissa is accumulated in int64 (up to 18 significant
# digits); further digits only move the decimal exponent.
prakriya varna_tak_dashm(buf, n, ok) {
    vitti src = buf
    vitti cnt = n
    vitti okp = ok
    okp[0] = 1
    yadi (cnt == 0) {
        okp[0] = 0
        prati 0.0
    }
    vitti neg = 0
    vitti p = 0
    yadi (src[0] == 45) {
        neg = 1
        p = 1
        yadi (cnt == 1) {
            okp[0] = 0
            prati 0.0
        }
    }
    vitti mant = 0
    vitti ndig = 0
    vitti exp10 = 0
    vitti seen = 0
    vitti done = 0
    yavat ((p < cnt) && (done == 0)) {
        vitti c1 = src[p]
        yadi ((c1 == 46) || (c1 == 101) || (c1 == 69)) {
            done = 1
        } anya {
            yadi (c1 < 48) {
                okp[0] = 0
                prati 0.0
            }
            yadi (c1 > 57) {
                okp[0] = 0
                prati 0.0
            }
            yadi (ndig < 18) {
                mant = mant * 10 + (c1 - 48)
                ndig = ndig + 1
            } anya {
                exp10 = exp10 + 1
            }
            seen = seen + 1
            p = p + 1
        }
    }
    yadi (p < cnt) {
        yadi (src[p] == 46) {
            p = p + 1
            done = 0
            yavat ((p < cnt) && (done == 0)) {
                vitti c2 = src[p]
                yadi ((c2 == 101) || (c2 == 69)) {
                    done = 1
                } anya {
                    yadi (c2 < 48) {
                        okp[0] = 0
                        prati 0.0
                    }
                    yadi (c2 > 57) {
                        okp[0] = 0
                        prati 0.0
                    }
                    yadi (ndig < 18) {
                        mant = mant * 10 + (c2 - 48)
                        ndig = ndig + 1
                        exp10 = exp10 - 1
                    }
                    seen = seen + 1
                    p = p + 1
                }
            }
        }
    }
    yadi (seen == 0) {
        okp[0] = 0
        prati 0.0
    }
    yadi (p < cnt) {
        yadi (src[p] == 101) {
            p = p + 1
        } anya {
            yadi (src[p] == 69) {
                p = p + 1
            } anya {
                okp[0] = 0
                prati 0.0
            }
        }
        vitti eneg = 0
        yadi (p < cnt) {
            yadi (src[p] == 45) {
                eneg = 1
                p = p + 1
            }
        }
        yadi (p >= cnt) {
            okp[0] = 0
            prati 0.0
        }
        vitti e = 0
        vitti eseen = 0
        yavat (p < cnt) {
            vitti c3 = src[p]
            yadi (c3 < 48) {
                okp[0] = 0
                prati 0.0
            }
            yadi (c3 > 57) {
                okp[0] = 0
                prati 0.0
            }
            yadi (e < 1000) {
                e = e * 10 + (c3 - 48)
            }
            eseen = eseen + 1
            p = p + 1
        }
        yadi (eseen == 0) {
            okp[0] = 0
            prati 0.0
        }
        yadi (eneg == 1) {
            exp10 = exp10 - e
        } anya {
            exp10 = exp10 + e
        }
    }
    yadi (p != cnt) {
        okp[0] = 0
        prati 0.0
    }
    yadi (mant == 0) {
        prati 0.0
    }
    yadi (exp10 > 308) {
        okp[0] = 0
        prati 0.0
    }
    yadi (exp10 < -308) {
        prati 0.0
    }
    dasham val = mant
    yadi (exp10 > 0) {
        vitti k = 0
        yavat (k < exp10) {
            val = val * 10.0
            k = k + 1
        }
    } anya {
        vitti k2 = 0
        yavat (k2 < (0 - exp10)) {
            val = val / 10.0
            k2 = k2 + 1
        }
    }
    # Overflow guard: the exp10 > 308 check does not catch
    # mant > 1 with exp10 == 308 (e.g. "9e308" returned inf with
    # ok = 1). Halving is exact for finite doubles, so val / 2
    # == val iff val is infinite — that is the overflow.
    yadi (val != 0.0) {
        yadi (val / 2.0 == val) {
            okp[0] = 0
            prati 0.0
        }
    }
    yadi (neg == 1) { val = 0.0 - val }
    prati val
}
