# lib/samanvaya.smlib — Sutram standard library: समन्वय (linear algebra)
# layer: core
#
# Sutram has no 2-D array type, so a matrix is a FLAT `kosh dasham` of m*n elements in
# row-major order, with the dimensions passed explicitly:
#
#     A[i][j]  ==  a[i * n + j]        for an m x n matrix
#
# CONTRACT for output matrices: the caller must have pushed m*n elements already.
# A kosh's capacity is not its length, so out[i] is out of bounds until an element exists.
# Functions here never `kosh_push` a parameter — the compiler rejects that, correctly,
# because the pointer is passed by value.
#
# Inputs are read-only. Outputs are written in place and are visible to the caller.

# ---------------------------------------------------------------
# element access helpers (flat index)
# ---------------------------------------------------------------

# samanvaya_akar_ayogya(m, n, len) - R37: 1 when an m x n shape does NOT fit len
# elements (or m or n is negative), else 0. It divides, never multiplies, so it
# holds for every m and n: m x n fits exactly when n == 0 or m <= len / n.
prakriya samanvaya_akar_ayogya(m, n, len) {
    yadi (m < 0) { nivartanam 1 }
    yadi (n < 0) { nivartanam 1 }
    yadi (n == 0) { nivartanam 0 }
    yadi (m > len / n) { nivartanam 1 }
    nivartanam 0
}

# identity matrix: n x n, out must hold n*n elements
prakriya ekaka_matrika(n, kosh dasham out) {
    vitti i = 0
    yavat (i < n) {
        vitti j = 0
        yavat (j < n) {
            yadi (i == j) {
                out[i * n + j] = 1.0
            } anya {
                out[i * n + j] = 0.0
            }
            j = j + 1
        }
        i = i + 1
    }
    nivartanam n * n
}

# transpose: a is m x n, out must hold n*m elements
prakriya vivartana(kosh dasham a, m, n, kosh dasham out) {
    vitti i = 0
    yavat (i < m) {
        vitti j = 0
        yavat (j < n) {
            out[j * m + i] = a[i * n + j]
            j = j + 1
        }
        i = i + 1
    }
    nivartanam m * n
}

# element-wise sum: a and b are m x n, out must hold m*n elements.
# R37: -1 if m x n does not fit a, b and out (or m, n < 0); m * n is never
# formed until it is known to fit, so it cannot wrap to a small loop.
prakriya matrika_yoga(kosh dasham a, kosh dasham b, m, n, kosh dasham out) {
    vitti k = 0
    yadi (samanvaya_akar_ayogya(m, n, kosh_len(a)) == 1) { nivartanam 0 - 1 }
    yadi (samanvaya_akar_ayogya(m, n, kosh_len(b)) == 1) { nivartanam 0 - 1 }
    yadi (samanvaya_akar_ayogya(m, n, kosh_len(out)) == 1) { nivartanam 0 - 1 }
    yavat (k < m * n) {
        out[k] = a[k] + b[k]
        k = k + 1
    }
    nivartanam m * n
}

# scalar multiple: out must hold m*n elements. R37: -1 if m x n does not fit.
prakriya skalar(kosh dasham a, dasham c, m, n, kosh dasham out) {
    vitti k = 0
    yadi (samanvaya_akar_ayogya(m, n, kosh_len(a)) == 1) { nivartanam 0 - 1 }
    yadi (samanvaya_akar_ayogya(m, n, kosh_len(out)) == 1) { nivartanam 0 - 1 }
    yavat (k < m * n) {
        out[k] = a[k] * c
        k = k + 1
    }
    nivartanam m * n
}

# matrix product: a is m x n, b is n x p, out must hold m*p elements
prakriya matrika_gunana(kosh dasham a, kosh dasham b, m, n, p, kosh dasham out) {
    vitti i = 0
    yavat (i < m) {
        vitti j = 0
        yavat (j < p) {
            dasham acc = 0.0
            vitti k = 0
            yavat (k < n) {
                acc = acc + a[i * n + k] * b[k * p + j]
                k = k + 1
            }
            out[i * p + j] = acc
            j = j + 1
        }
        i = i + 1
    }
    nivartanam m * p
}

# trace of an n x n matrix
prakriya karna_yog(kosh dasham a, n) {
    dasham t = 0.0
    vitti i = 0
    yavat (i < n) {
        t = t + a[i * n + i]
        i = i + 1
    }
    nivartanam t
}

# determinant of a 2 x 2 matrix (a holds 4 elements)
prakriya saranik2(kosh dasham a) {
    nivartanam a[0] * a[3] - a[1] * a[2]
}

# determinant of a 3 x 3 matrix (a holds 9 elements), by cofactor expansion
prakriya saranik3(kosh dasham a) {
    dasham t1 = a[0] * (a[4] * a[8] - a[5] * a[7])
    dasham t2 = a[1] * (a[3] * a[8] - a[5] * a[6])
    dasham t3 = a[2] * (a[3] * a[7] - a[4] * a[6])
    nivartanam t1 - t2 + t3
}

# dot product of flat vectors u and v over min(kosh_len(u), kosh_len(v)) entries.
prakriya sadish_yoga(kosh dasham u, kosh dasham v) {
    vitti n = kosh_len(u)
    yadi (kosh_len(v) < n) { n = kosh_len(v) }
    dasham s = 0.0
    vitti i = 0
    yavat (i < n) {
        s = s + u[i] * v[i]
        i = i + 1
    }
    nivartanam s
}

# largest absolute row sum (a cheap norm, useful for conditioning checks)
prakriya rekha_manak(kosh dasham a, m, n) {
    dasham best = 0.0
    vitti i = 0
    yavat (i < m) {
        dasham row = 0.0
        vitti j = 0
        yavat (j < n) {
            dasham e = a[i * n + j]
            yadi (e < 0.0) { e = 0.0 - e }
            row = row + e
            j = j + 1
        }
        yadi (row > best) { best = row }
        i = i + 1
    }
    nivartanam best
}
