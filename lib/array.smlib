# lib/array.smlib — Sutram standard library: dynamic arrays
#
# Real functions over raw memory (nirmmita/likh8/pad8). Each element is
# 8 bytes (one integer). The caller tracks the length; array_new only
# allocates. Safe variants take the element count and return 0 / do
# nothing on out-of-bounds access.

prakriya array_new(n) {
    vitti c = n
    pratiyati nirmmita(c * 8)
}

prakriya array_set(arr, i, val) {
    vitti a = arr
    vitti j = i
    vitti v = val
    likh8(a + j * 8, v)
    pratiyati 0
}

prakriya array_get(arr, i) {
    vitti a = arr
    vitti j = i
    pratiyati pad8(a + j * 8)
}

prakriya array_fill(arr, val, n) {
    vitti a = arr
    vitti v = val
    vitti c = n
    vitti j = 0
    yavat (j < c) {
        likh8(a + j * 8, v)
        j = j + 1
    }
    pratiyati 0
}

prakriya array_copy(dst, src, n) {
    vitti d = dst
    vitti s = src
    vitti c = n
    vitti j = 0
    yavat (j < c) {
        likh8(d + j * 8, pad8(s + j * 8))
        j = j + 1
    }
    pratiyati 0
}

prakriya array_sum(arr, n) {
    vitti a = arr
    vitti c = n
    vitti s = 0
    vitti j = 0
    yavat (j < c) {
        s = s + pad8(a + j * 8)
        j = j + 1
    }
    pratiyati s
}

prakriya array_set_safe(arr, i, val, n) {
    vitti a = arr
    vitti j = i
    vitti v = val
    vitti c = n
    yadi (j < 0) { pratiyati 0 }
    yadi (j >= c) { pratiyati 0 }
    likh8(a + j * 8, v)
    pratiyati 1
}

prakriya array_get_safe(arr, i, n) {
    vitti a = arr
    vitti j = i
    vitti c = n
    yadi (j < 0) { pratiyati 0 }
    yadi (j >= c) { pratiyati 0 }
    pratiyati pad8(a + j * 8)
}
