# Sutram Standard Library — Array Module
# Array operations using nirmmita + likh8 + pad8

# array_new(n) -> nirmmita(n * 8)
# array_set(arr, i, val) -> likh8(arr + i * 8, val)
# array_get(arr, i) -> pad8(arr + i * 8)
# array_fill(arr, val, n) -> smaran(arr, val, n * 8)
# array_copy(dst, src, n) -> smaran_cp(dst, src, n * 8)
# array_set_safe(arr, i, val, n) -> likh8c(arr + i * 8, val, arr + n * 8)
# array_get_safe(arr, i, n) -> pad8c(arr + i * 8, arr + n * 8)

# Sum of array elements (inline):
# vitti sum = 0
# vitti i = 0
# yavat (i < n) {
#     sum = sum + pad8(arr + i * 8)
#     i = i + 1
# }

# Note: Use these patterns inline in mukhya().
