# lib/gudh.smlib — Sutram standard library: checksum/hash functions
# layer: core
#
# FNV-1a (Fowler–Noll–Vo) 32-bit hash. Deterministic, fast, good distribution
# for non-cryptographic use (hash tables, checksums, dedup keys).
#
# Reference: http://www.isthe.com/chongo/tech/comp/fnv/
#   offset_basis = 2166136261
#   prime        = 16777619
#   for each byte b: hash = (hash XOR b) * prime  (shesh 2^32)

# fnv1a(s, len) — FNV-1a hash of the first len BYTES of a packed byte-string pointer s.
# Returns an unsigned 32-bit value in the integer range 0..4294967295.
# A non-cryptographic hash: not encryption and not a secure digest.
prakriya fnv1a(s, len) {
    vitti h = 2166136261
    vitti i = 0
    vitti n = len
    vitti str = s
    yavat (i < n) {
        vitti b = akshar(str, i)
        h = h ^ b
        h = (h * 16777619) % 4294967296
        i = i + 1
    }
    nivartanam h
}

# fnv1a_varna(s) — FNV-1a of a NUL-terminated packed byte string (uses vartani_aayam).
prakriya fnv1a_varna(s) {
    nivartanam fnv1a(s, vartani_aayam(s))
}
