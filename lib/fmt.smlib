# lib/fmt.smlib — Sutram standard library: formatting
#
# Number and string formatting on BYTE strings (packed bytes, explicit
# lengths, `strb` idiom): every function writes packed bytes into `out`
# with a 0 terminator and returns the byte count. This is the modern
# idiom; the older `lib/strconv.smlib` works on CELL arrays (pankti of
# char codes) and has no width/alignment/grouping/fixed-decimal/sign
# surface — fmt is the formatting module, strconv is the conversion
# module. Do not mix the representations: fmt outputs are bytes
# (read with char_at), strconv outputs are cells (read with [i]).
#
# Defaults, stated once here and at each function:
#   - Bases: no prefix unless the _pre / flags form is used.
#   - Grouping: fmt_group defaults to INDIAN grouping (12,34,567).
#   - Rounding: fmt_fixed rounds HALF AWAY FROM ZERO (2.5 -> 3, -2.5 -> -3).
#   - Centre padding: the extra pad byte goes RIGHT.
#   - INT64_MIN (-2^63) is handled: |MIN| = 2^63 does not fit in
#     int64, so the digit writers split it (hi/lo) instead of
#     negating it. Every int64 value works.
#   - fmt_fixed is exact while |x| * 10^places < 2^52; beyond that the
#     +0.5 rounding step is below float precision. |x| * 10^places must
#     fit in int64. places is clamped to 0..9.
#
# All signatures stay within the 6-argument cap.

# --- integer digits (private helper) ---
# fmt_digits(v, out) — write the decimal digits of |v| (no sign) into
# out as packed bytes. Returns the digit count. Internal; the public
# formatters below build on it.
prakriya fmt_digits(v, out) {
    vitti val = v
    vitti dst = out
    vitti rev = nirmmita(22 * 8)
    vitti rlen = 0
    vitti i = 0
    yadi (val == 0) {
        set_char(dst, 0, 48)
        set_char(dst, 1, 0)
        pratiyati 1
    }
    yadi (val < 0) {
        yadi (val == (0 - 9223372036854775807) - 1) {
            # |MIN| = 2^63 does not fit in int64; fmt_digits_base
            # handles it (hi/lo split), so delegate for this one value.
            pratiyati fmt_digits_base(val, 10, 0, dst)
        }
        val = 0 - val
    }
    yavat (val > 0) {
        rev[rlen] = (val % 10) + 48
        rlen = rlen + 1
        val = val / 10
    }
    i = 0
    yavat (i < rlen) {
        set_char(dst, i, rev[rlen - 1 - i])
        i = i + 1
    }
    set_char(dst, rlen, 0)
    pratiyati rlen
}

# --- integer digits in a base (private helper) ---
# fmt_digits_base(v, base, upper, out) — write |v| in `base` (2..36)
# into out as packed bytes, no sign, no prefix. `upper` 1 -> A-F/A-Z.
# Base outside 2..36 writes only the terminator and returns 0.
prakriya fmt_digits_base(v, base, upper, out) {
    vitti val = v
    vitti b = base
    vitti up = upper
    vitti dst = out
    vitti rev = nirmmita(70 * 8)
    vitti rlen = 0
    vitti i = 0
    vitti d = 0
    vitti ch = 0
    yadi (b < 2) {
        set_char(dst, 0, 0)
        pratiyati 0
    }
    yadi (b > 36) {
        set_char(dst, 0, 0)
        pratiyati 0
    }
    yadi (val == 0) {
        set_char(dst, 0, 48)
        set_char(dst, 1, 0)
        pratiyati 1
    }
    yadi (val < 0) {
        yadi (val == (0 - 9223372036854775807) - 1) {
            # |MIN| = 2^63 does not fit in int64. Split it: |MIN| =
            # hi * b + lo with hi = -(MIN / b), lo = -(MIN % b),
            # both fitting. Convert hi, then append the lo digit.
            vitti hi = 0 - (val / b)
            vitti lo = 0 - (val % b)
            vitti hn = fmt_digits_base(hi, b, up, dst)
            yadi (lo < 10) {
                set_char(dst, hn, lo + 48)
            } anyatra {
                yadi (up == 1) {
                    set_char(dst, hn, lo + 55)
                } anyatra {
                    set_char(dst, hn, lo + 87)
                }
            }
            set_char(dst, hn + 1, 0)
            pratiyati hn + 1
        }
        val = 0 - val
    }
    yavat (val > 0) {
        d = val % b
        yadi (d < 10) {
            ch = d + 48
        } anyatra {
            yadi (up == 1) {
                ch = d + 55
            } anyatra {
                ch = d + 87
            }
        }
        rev[rlen] = ch
        rlen = rlen + 1
        val = val / b
    }
    i = 0
    yavat (i < rlen) {
        set_char(dst, i, rev[rlen - 1 - i])
        i = i + 1
    }
    set_char(dst, rlen, 0)
    pratiyati rlen
}

# fmt_int_base(v, base, out) — write v in `base` (2..36), lowercase
# digits, '-' for negatives, no prefix. Returns the byte count.
# Base outside 2..36: terminator only, returns 0. Digits are written
# directly at dst + neg, so the sign just fills position 0.
prakriya fmt_int_base(v, base, out) {
    vitti val = v
    vitti dst = out
    vitti neg = 0
    vitti n = 0
    yadi (val < 0) {
        neg = 1
        val = 0 - val
    }
    n = fmt_digits_base(val, base, 0, dst + neg)
    yadi (n == 0) {
        set_char(dst, 0, 0)
        pratiyati 0
    }
    yadi (neg == 1) {
        set_char(dst, 0, 45)
    }
    pratiyati n + neg
}

# fmt_int_flags(v, base, flags, out) — fmt_int_base plus flags:
# bit 0 (1) = prefix: "0b" / "0o" / "0x" for bases 2 / 8 / 16
# (no prefix for other bases, including 10); bit 1 (2) = uppercase
# hex digits (the prefix itself stays lowercase). Returns byte count.
prakriya fmt_int_flags(v, base, flags, out) {
    vitti val = v
    vitti b = base
    vitti fl = flags
    vitti dst = out
    vitti neg = 0
    vitti pre = 0
    vitti up = 0
    vitti n = 0
    vitti i = 0
    yadi (val < 0) {
        neg = 1
        val = 0 - val
    }
    yadi (fl % 2 == 1) {
        yadi (b == 2) { pre = 2 }
        yadi (b == 8) { pre = 2 }
        yadi (b == 16) { pre = 2 }
    }
    yadi ((fl / 2) % 2 == 1) { up = 1 }
    n = fmt_digits_base(val, b, up, dst + neg + pre)
    yadi (n == 0) {
        set_char(dst, 0, 0)
        pratiyati 0
    }
    # digits already sit at [neg+pre, ...); fill in sign + prefix.
    yadi (neg == 1) { set_char(dst, 0, 45) }
    yadi (pre == 2) {
        set_char(dst, neg, 48)
        yadi (b == 2) { set_char(dst, neg + 1, 98) }
        yadi (b == 8) { set_char(dst, neg + 1, 111) }
        yadi (b == 16) { set_char(dst, neg + 1, 120) }
    }
    pratiyati neg + pre + n
}

# fmt_dec(v, out) — decimal, no prefix. fmt_hex / fmt_hex_upper /
# fmt_oct / fmt_bin — base 16 (lower / upper), 8, 2, no prefix.
prakriya fmt_dec(v, out) {
    pratiyati fmt_int_base(v, 10, out)
}

prakriya fmt_hex(v, out) {
    pratiyati fmt_int_base(v, 16, out)
}

prakriya fmt_hex_upper(v, out) {
    pratiyati fmt_int_flags(v, 16, 2, out)
}

prakriya fmt_oct(v, out) {
    pratiyati fmt_int_base(v, 8, out)
}

prakriya fmt_bin(v, out) {
    pratiyati fmt_int_base(v, 2, out)
}

# fmt_int_pre(v, base, upper, out) — any base with its prefix
# ("0b"/"0o"/"0x" for 2/8/16; none for other bases). `upper` 1 ->
# uppercase digits, prefix stays lowercase.
prakriya fmt_int_pre(v, base, upper, out) {
    vitti fl = 1
    yadi (upper == 1) { fl = 3 }
    pratiyati fmt_int_flags(v, base, fl, out)
}

# --- padding / alignment ---
# fmt_pad_left(src, sn, width, padbyte, out) — pad on the LEFT with
# `padbyte` (32 space, 48 '0') to `width`. width <= sn: copy unchanged.
prakriya fmt_pad_left(src, sn, width, padbyte, out) {
    vitti s = src
    vitti cnt = sn
    vitti w = width
    vitti f = padbyte
    vitti dst = out
    vitti npad = 0
    vitti i = 0
    yadi (w <= cnt) {
        i = 0
        yavat (i < cnt) {
            set_char(dst, i, char_at(s, i))
            i = i + 1
        }
        set_char(dst, cnt, 0)
        pratiyati cnt
    }
    npad = w - cnt
    i = 0
    yavat (i < npad) {
        set_char(dst, i, f)
        i = i + 1
    }
    i = 0
    yavat (i < cnt) {
        set_char(dst, npad + i, char_at(s, i))
        i = i + 1
    }
    set_char(dst, w, 0)
    pratiyati w
}

# fmt_pad_right(src, sn, width, padbyte, out) — pad on the RIGHT.
prakriya fmt_pad_right(src, sn, width, padbyte, out) {
    vitti s = src
    vitti cnt = sn
    vitti w = width
    vitti f = padbyte
    vitti dst = out
    vitti npad = 0
    vitti i = 0
    yadi (w <= cnt) {
        i = 0
        yavat (i < cnt) {
            set_char(dst, i, char_at(s, i))
            i = i + 1
        }
        set_char(dst, cnt, 0)
        pratiyati cnt
    }
    npad = w - cnt
    i = 0
    yavat (i < cnt) {
        set_char(dst, i, char_at(s, i))
        i = i + 1
    }
    i = 0
    yavat (i < npad) {
        set_char(dst, cnt + i, f)
        i = i + 1
    }
    set_char(dst, w, 0)
    pratiyati w
}

# fmt_pad_center(src, sn, width, padbyte, out) — npad on BOTH sides;
# when width-sn is odd, the extra npad byte goes RIGHT.
prakriya fmt_pad_center(src, sn, width, padbyte, out) {
    vitti s = src
    vitti cnt = sn
    vitti w = width
    vitti f = padbyte
    vitti dst = out
    vitti npad = 0
    vitti left = 0
    vitti i = 0
    yadi (w <= cnt) {
        i = 0
        yavat (i < cnt) {
            set_char(dst, i, char_at(s, i))
            i = i + 1
        }
        set_char(dst, cnt, 0)
        pratiyati cnt
    }
    npad = w - cnt
    left = npad / 2
    i = 0
    yavat (i < left) {
        set_char(dst, i, f)
        i = i + 1
    }
    i = 0
    yavat (i < cnt) {
        set_char(dst, left + i, char_at(s, i))
        i = i + 1
    }
    i = 0
    yavat (i < npad - left) {
        set_char(dst, left + cnt + i, f)
        i = i + 1
    }
    set_char(dst, w, 0)
    pratiyati w
}

# --- thousands grouping (private helper) ---
# fmt_group_impl(src, sn, step, out) — group the integer part of a digit
# string. step 2 = Indian (3, then 2s: 12,34,567), step 3 = international
# (3s: 1,234,567). A leading '-' or '+' is kept as a sign; a '.' splits
# off a fraction, copied verbatim. Empty input copies to empty.
prakriya fmt_group_impl(src, sn, step, out) {
    vitti s = src
    vitti cnt = sn
    vitti st = step
    vitti dst = out
    vitti start = 0
    vitti dot = 0
    vitti wpos = 0
    vitti i = 0
    vitti k = 0
    vitti rem = 0
    yadi (cnt == 0) {
        set_char(dst, 0, 0)
        pratiyati 0
    }
    yadi (char_at(s, 0) == 45) { start = 1 }
    yadi (char_at(s, 0) == 43) { start = 1 }
    dot = cnt
    i = start
    yavat (i < cnt) {
        yadi (char_at(s, i) == 46) {
            dot = i
            i = cnt
        } anyatra {
            i = i + 1
        }
    }
    # copy the sign, if any
    yadi (start == 1) {
        set_char(dst, 0, char_at(s, 0))
        wpos = 1
    }
    # emit the integer part with ',' separators. A comma goes after
    # digit i iff rem (digits after i) marks a group boundary:
    # international: rem % 3 == 0; Indian: rem == 3, or rem > 3 with
    # (rem - 3) % 2 == 0 (rightmost group is 3, then 2s).
    i = start
    yavat (i < dot) {
        set_char(dst, wpos, char_at(s, i))
        wpos = wpos + 1
        rem = dot - i - 1
        yadi (rem > 0) {
            yadi (st == 3) {
                yadi (rem % 3 == 0) {
                    set_char(dst, wpos, 44)
                    wpos = wpos + 1
                }
            } anyatra {
                yadi (rem == 3) {
                    set_char(dst, wpos, 44)
                    wpos = wpos + 1
                } anyatra {
                    yadi (rem > 3) {
                        yadi ((rem - 3) % 2 == 0) {
                            set_char(dst, wpos, 44)
                            wpos = wpos + 1
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    # copy the fraction (including the '.') verbatim
    k = dot
    yavat (k < cnt) {
        set_char(dst, wpos, char_at(s, k))
        wpos = wpos + 1
        k = k + 1
    }
    set_char(dst, wpos, 0)
    pratiyati wpos
}

# fmt_group_indian(src, sn, out) — 1234567 -> 12,34,567.
prakriya fmt_group_indian(src, sn, out) {
    pratiyati fmt_group_impl(src, sn, 2, out)
}

# fmt_group_intl(src, sn, out) — 1234567 -> 1,234,567.
prakriya fmt_group_intl(src, sn, out) {
    pratiyati fmt_group_impl(src, sn, 3, out)
}

# fmt_group(src, sn, out) — DEFAULT grouping: Indian (12,34,567).
# The default is Indian because the audience is Indian.
prakriya fmt_group(src, sn, out) {
    pratiyati fmt_group_indian(src, sn, out)
}

# fmt_group_int(v, indian, out) — format integer v, then group it.
# `indian` 1 -> Indian grouping, 0 -> international.
prakriya fmt_group_int(v, indian, out) {
    vitti tmp = nirmmita(32)
    vitti n = fmt_int_base(v, 10, tmp)
    yadi (indian == 1) {
        pratiyati fmt_group_indian(tmp, n, out)
    }
    pratiyati fmt_group_intl(tmp, n, out)
}

# --- fixed decimals (private helper) ---
# fmt_fixed_impl(dasham x, places, always_sign, out) — |x| rounded HALF AWAY
# FROM ZERO to `places` digits after '.', exactly `places` digits
# emitted (zero-padded). places clamped to 0..9. `always_sign` 1 emits
# '+' for non-negative values. places 0 emits no '.'.
prakriya fmt_fixed_impl(dasham x, places, always_sign, out) {
    dasham v = x
    vitti pl = places
    vitti asign = always_sign
    vitti dst = out
    dasham p10f = 1.0
    vitti p10i = 1
    vitti i = 0
    vitti neg = 0
    dasham mag = 0.0
    dasham scaled = 0.0
    vitti rounded = 0
    vitti intpart = 0
    vitti fracpart = 0
    vitti wpos = 0
    vitti ndig = 0
    vitti rev = nirmmita(22 * 8)
    vitti rlen = 0
    vitti k = 0
    yadi (pl < 0) { pl = 0 }
    yadi (pl > 9) { pl = 9 }
    yavat (i < pl) {
        p10f = p10f * 10.0
        p10i = p10i * 10
        i = i + 1
    }
    yadi (v < 0.0) {
        neg = 1
        mag = 0.0 - v
    } anyatra {
        mag = v
    }
    scaled = mag * p10f + 0.5
    rounded = scaled
    intpart = rounded / p10i
    fracpart = rounded % p10i
    # sign
    yadi (neg == 1) {
        set_char(dst, 0, 45)
        wpos = 1
    } anyatra {
        yadi (asign == 1) {
            set_char(dst, 0, 43)
            wpos = 1
        }
    }
    # integer part
    ndig = fmt_digits(intpart, dst + wpos)
    wpos = wpos + ndig
    # fraction part, zero-padded to exactly pl digits
    yadi (pl > 0) {
        set_char(dst, wpos, 46)
        wpos = wpos + 1
        rlen = 0
        yadi (fracpart == 0) {
            rev[0] = 48
            rlen = 1
        } anyatra {
            yavat (fracpart > 0) {
                rev[rlen] = (fracpart % 10) + 48
                rlen = rlen + 1
                fracpart = fracpart / 10
            }
        }
        k = 0
        yavat (k < pl - rlen) {
            set_char(dst, wpos, 48)
            wpos = wpos + 1
            k = k + 1
        }
        k = 0
        yavat (k < rlen) {
            set_char(dst, wpos, rev[rlen - 1 - k])
            wpos = wpos + 1
            k = k + 1
        }
    }
    set_char(dst, wpos, 0)
    pratiyati wpos
}

# fmt_fixed(dasham x, places, out) — fixed decimals, '-' for negatives only.
# 3.14159 at 2 places -> "3.14". Rounding: half away from zero.
prakriya fmt_fixed(dasham x, places, out) {
    pratiyati fmt_fixed_impl(x, places, 0, out)
}

# fmt_fixed_signed(dasham x, places, out) — fixed decimals, always a sign:
# "+3.14" / "-3.14".
prakriya fmt_fixed_signed(dasham x, places, out) {
    pratiyati fmt_fixed_impl(x, places, 1, out)
}

# --- signed formatting ---
# fmt_signed(v, out) — always a sign: "+42" / "-42" / "+0".
prakriya fmt_signed(v, out) {
    vitti val = v
    vitti dst = out
    vitti tmp = nirmmita(32)
    vitti n = 0
    vitti i = 0
    n = fmt_int_base(val, 10, tmp)
    yadi (val < 0) {
        i = 0
        yavat (i < n) {
            set_char(dst, i, char_at(tmp, i))
            i = i + 1
        }
        set_char(dst, n, 0)
        pratiyati n
    }
    set_char(dst, 0, 43)
    i = 0
    yavat (i < n) {
        set_char(dst, i + 1, char_at(tmp, i))
        i = i + 1
    }
    set_char(dst, n + 1, 0)
    pratiyati n + 1
}

# fmt_sign_char(v, signch, out) — `signch` (a byte value, e.g. 32 for a
# blank, 43 for '+') in place of '+' for non-negative values; negatives
# always get '-'.
prakriya fmt_sign_char(v, signch, out) {
    vitti val = v
    vitti sc = signch
    vitti dst = out
    vitti tmp = nirmmita(32)
    vitti n = 0
    vitti i = 0
    n = fmt_int_base(val, 10, tmp)
    yadi (val < 0) {
        i = 0
        yavat (i < n) {
            set_char(dst, i, char_at(tmp, i))
            i = i + 1
        }
        set_char(dst, n, 0)
        pratiyati n
    }
    set_char(dst, 0, sc)
    i = 0
    yavat (i < n) {
        set_char(dst, i + 1, char_at(tmp, i))
        i = i + 1
    }
    set_char(dst, n + 1, 0)
    pratiyati n + 1
}
