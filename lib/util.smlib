# Sutram Utility Library - util.smlib
# layer: core
# General-purpose utility functions
# Usage: ayojan util
#
# Edge rules (R30): mod/div_ceil return 0 on a zero divisor (no
# SIGFPE); sum_range returns 0 for end < start; div_ceil is true
# ceiling division for every sign combination.


prakriya lerp(a, b, t)
    pratiyati a + (b - a) * t / 100

prakriya sum_range(start, end) {
    yadi (end < start) { pratiyati 0 }
    pratiyati (start + end) * (end - start + 1) / 2
}



prakriya mod(a, b) {
    yadi (b == 0) { pratiyati 0 }
    pratiyati a - (a / b) * b
}

prakriya div_ceil(a, b) {
    # Ceiling division: q = a / b (truncating), round up iff the
    # remainder is nonzero and has the divisor's sign. The old
    # (a + b - 1) / b was only correct for a >= 0, b > 0.
    yadi (b == 0) { pratiyati 0 }
    vitti q = a / b
    vitti r = a % b
    yadi (r != 0) {
        yadi (r > 0) {
            yadi (b > 0) { q = q + 1 }
        } anyatra {
            yadi (b < 0) { q = q + 1 }
        }
    }
    pratiyati q
}

prakriya sign(n)
    pratiyati (n > 0) - (n < 0)

prakriya bool_to_int(b)
    pratiyati b * 1

prakriya int_max()
    pratiyati 9223372036854775807
