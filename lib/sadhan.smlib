# Sutram Utility Library - sadhan.smlib
# layer: core
# General-purpose utility functions
# Usage: yoj sadhan
#
# Edge rules (R30): shesh/bhaj_urdhva return 0 on a zero divisor (no
# SIGFPE); yog_seema returns 0 for end < start; bhaj_urdhva is true
# ceiling division for every util_chinha combination.
prakriya antarveshan(a, b, t)
    nivartanam a + (b - a) * t / 100

# yog_seema(start, end) — sum of the integers from start to end inclusive; 0 if end < start.
# Past int64 it saturates: 2^63 - 1 for a positive sum, -2^63 for a negative one (R80).
prakriya yog_seema(start, end) {
    yadi (end < start) { nivartanam 0 }
    # R80: the old (start + end) * (end - start + 1) / 2 wrapped in the product before halving -
    # yog_seema(0, 4294967296) was 2147483648. Halve the even factor first, then multiply checked.
    vitti maxv = 9223372036854775807
    vitti minv = (0 - 9223372036854775807) - 1
    vitti a = start
    vitti b = end
    yadi (a > 0) {
        yadi (b > maxv - a) { nivartanam maxv }   # start + end itself does not fit
    }
    yadi (a < 0) {
        yadi (b < minv - a) { nivartanam minv }
    }
    vitti s = a + b
    yadi (s == 0) { nivartanam 0 }
    vitti n = 0
    yadi (b - maxv + 1 > a) {                      # end - start + 1 does not fit: the sum cannot
        yadi (s > 0) { nivartanam maxv }           # (more than 2^63 terms, s != 0)
        nivartanam minv
    }
    n = b - a + 1
    vitti x = s
    vitti y = n
    yadi (x % 2 == 0) { x = x / 2 } anya { y = y / 2 }   # s and n have opposite parity
    vitti ax = x
    yadi (ax < 0) { ax = 0 - ax }
    yadi (ax > maxv / y) {
        yadi (x > 0) { nivartanam maxv }
        nivartanam minv
    }
    nivartanam x * y
}

# shesh(a, b) — remainder a % b computed as a - (a / b) * b; 0 if b == 0.
prakriya shesh(a, b) {
    yadi (b == 0) { nivartanam 0 }
    nivartanam a - (a / b) * b
}

# bhaj_urdhva(a, b) — ceiling division of a by b (rounds up when the remainder is nonzero); 0 if b == 0.
# That 0 cannot be told apart from a real quotient of 0: check b first.
prakriya bhaj_urdhva(a, b) {
    # Ceiling division: q = a / b (truncating), round up iff the
    # remainder is nonzero and has the divisor's util_chinha. The old
    # (a + b - 1) / b was only correct for a >= 0, b > 0.
    yadi (b == 0) { nivartanam 0 }
    vitti q = a / b
    vitti r = a % b
    yadi (r != 0) {
        yadi (r > 0) {
            yadi (b > 0) { q = q + 1 }
        } anya {
            yadi (b < 0) { q = q + 1 }
        }
    }
    nivartanam q
}

# ank_chihna(n) — sign of n: 1 if n > 0, -1 if n < 0, 0 if n == 0.
prakriya ank_chihna(n)
    nivartanam (n > 0) - (n < 0)

# satya_tak_ank(b) — boolean b converted to an integer (b * 1).
prakriya satya_tak_ank(b)
    nivartanam b * 1

# ank_adhik() — the maximum int64 value, 9223372036854775807.
prakriya ank_adhik()
    nivartanam 9223372036854775807
