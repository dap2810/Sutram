# lib/set.smlib — Sutram standard library: sets (set algebra over map)
#
# A set IS a map (`lib/map.smlib`) with a dummy value of 1: membership is
# map_contains, iteration is map_keys. The set functions are thin
# wrappers plus the algebra (union / intersect / difference / subset)
# and a sorted dump (set_to_array).
#
# ELEMENTS ARE BYTE STRINGS — the same choice as `map.smlib`'s keys, for
# the same reason: a caller passes a literal directly ("apple"), with an
# explicit length, and the whole strb_* surface (compare, pack, unpack)
# works on the elements unchanged. Do NOT pass char-code (qword-cell)
# arrays here; see the lib/strb.smlib header for the two
# representations. Consequences inherited from map: keys longer than 32
# bytes are truncated to 32 on every operation, consistently.
#
# CAPACITY: a set's capacity is fixed at set_init and stored in the
# buffer (m[0]). Set operations that write into `out` read out's
# capacity from out[0], so the caller MUST pass a set_init'd buffer
# with room for the result: cap + bcap for union, cap for difference,
# min(cap, bcap) for intersection. If `out` is too small, map_put
# silently drops the overflowing elements (map's full-table behaviour)
# and the returned size will be smaller than the true result — size
# the output generously and check the returned size.
#
# `out` for union / intersect / difference must be a FRESH, EMPTY set:
# the operations ADD into it and return map_size(out) afterwards.
# set_is_subset(a, ...) with an empty `a` is 1 (vacuous truth).
#
# The 6-argument cap still applies: union / intersect / difference keep
# the 5-argument shape from the round brief by reading out's capacity
# from out[0] instead of taking it as a sixth parameter.

ayojan map
ayojan strb

# set_init(cap) — allocate an empty set of capacity cap (clamped to >= 1).
prakriya set_init(cap) {
    pratiyati map_init(cap)
}

# set_add(s, cap, elem, elem_n) — add elem; 1 on success, 0 if the set
# is full (then the set is unchanged). Adding an existing element keeps
# set_size unchanged (idempotent).
prakriya set_add(s, cap, elem, elem_n) {
    pratiyati map_put(s, cap, elem, elem_n, 1)
}

# set_contains(s, cap, elem, elem_n) — 1 if elem is in the set, else 0.
prakriya set_contains(s, cap, elem, elem_n) {
    pratiyati map_contains(s, cap, elem, elem_n)
}

# set_remove(s, cap, elem, elem_n) — remove elem; 1 if removed, 0 if absent.
prakriya set_remove(s, cap, elem, elem_n) {
    pratiyati map_remove(s, cap, elem, elem_n)
}

# set_size(s) — number of elements.
prakriya set_size(s) {
    pratiyati map_size(s)
}

# set_union(a, cap, b, bcap, out) — add every element of a and of b into
# out (fresh, empty, capacity >= cap + bcap). Returns set_size(out).
# NOTE: map_keys segments are CELLS, but map_put takes packed BYTES —
# each segment is repacked with strb_pack first. Passing the cell
# pointer straight to map_put compiles fine and silently compares the
# wrong bytes (the first cell's low byte, then zeroes). That is the
# R12 repack trap; strb_pack is the fix.
prakriya set_union(a, cap, b, bcap, out) {
    vitti ocap = out[0]
    vitti tmpa = nirmmita((cap * 33 + 1) * 8)
    vitti tmpb = nirmmita((bcap * 33 + 1) * 8)
    vitti buf = nirmmita(40)
    vitti nka = map_keys(a, tmpa)
    vitti nkb = map_keys(b, tmpb)
    vitti pos = 0
    vitti i = 0
    vitti seglen = 0
    yavat (i < nka) {
        seglen = tmpa[pos]
        strb_pack(tmpa + (pos + 1) * 8, seglen, buf)
        map_put(out, ocap, buf, seglen, 1)
        pos = pos + 1 + seglen
        i = i + 1
    }
    pos = 0
    i = 0
    yavat (i < nkb) {
        seglen = tmpb[pos]
        strb_pack(tmpb + (pos + 1) * 8, seglen, buf)
        map_put(out, ocap, buf, seglen, 1)
        pos = pos + 1 + seglen
        i = i + 1
    }
    pratiyati map_size(out)
}

# set_intersect(a, cap, b, bcap, out) — add every element of a that is
# also in b into out (fresh, empty, capacity >= min(cap, bcap)).
# Returns set_size(out). Segments are repacked with strb_pack before
# map_contains (see set_union note).
prakriya set_intersect(a, cap, b, bcap, out) {
    vitti ocap = out[0]
    vitti tmpa = nirmmita((cap * 33 + 1) * 8)
    vitti buf = nirmmita(40)
    vitti nka = map_keys(a, tmpa)
    vitti pos = 0
    vitti i = 0
    vitti seglen = 0
    yavat (i < nka) {
        seglen = tmpa[pos]
        strb_pack(tmpa + (pos + 1) * 8, seglen, buf)
        yadi (map_contains(b, bcap, buf, seglen) == 1) {
            map_put(out, ocap, buf, seglen, 1)
        }
        pos = pos + 1 + seglen
        i = i + 1
    }
    pratiyati map_size(out)
}

# set_difference(a, cap, b, bcap, out) — add every element of a that is
# NOT in b into out (fresh, empty, capacity >= cap). Returns
# set_size(out). Segments are repacked with strb_pack before
# map_contains (see set_union note).
prakriya set_difference(a, cap, b, bcap, out) {
    vitti ocap = out[0]
    vitti tmpa = nirmmita((cap * 33 + 1) * 8)
    vitti buf = nirmmita(40)
    vitti nka = map_keys(a, tmpa)
    vitti pos = 0
    vitti i = 0
    vitti seglen = 0
    yavat (i < nka) {
        seglen = tmpa[pos]
        strb_pack(tmpa + (pos + 1) * 8, seglen, buf)
        yadi (map_contains(b, bcap, buf, seglen) == 0) {
            map_put(out, ocap, buf, seglen, 1)
        }
        pos = pos + 1 + seglen
        i = i + 1
    }
    pratiyati map_size(out)
}

# set_is_subset(a, cap, b, bcap) — 1 if every element of a is in b, else
# 0. Empty a is a subset of everything. Segments are repacked with
# strb_pack before map_contains (see set_union note).
prakriya set_is_subset(a, cap, b, bcap) {
    vitti tmpa = nirmmita((cap * 33 + 1) * 8)
    vitti buf = nirmmita(40)
    vitti nka = map_keys(a, tmpa)
    vitti pos = 0
    vitti i = 0
    vitti seglen = 0
    yavat (i < nka) {
        seglen = tmpa[pos]
        strb_pack(tmpa + (pos + 1) * 8, seglen, buf)
        yadi (map_contains(b, bcap, buf, seglen) == 0) {
            pratiyati 0
        }
        pos = pos + 1 + seglen
        i = i + 1
    }
    pratiyati 1
}

# set_to_array(s, cap, out) — write the set's elements into out in
# length-prefixed form [len0, b0, b1, ..., len1, b0, ...] (same shape as
# map_keys / strb_split parts), SORTED lexicographically by byte value
# (strb_compare), so output is deterministic regardless of insertion
# order or hash layout. Returns the element count.
prakriya set_to_array(s, cap, out) {
    vitti tmp = nirmmita((cap * 33 + 1) * 8)
    vitti nk = map_keys(s, tmp)
    vitti scratch = nirmmita(cap * 32 + 1)
    vitti ptrs = nirmmita(cap * 8)
    vitti lens = nirmmita(cap * 8)
    vitti pos = 0
    vitti i = 0
    vitti j = 0
    vitti seglen = 0
    vitti wpos = 0
    vitti woff = 0
    vitti tp = 0
    vitti tl = 0
    # pack every segment's cells into one scratch byte area, recording
    # (byte-offset, len) pairs; strb_compare needs packed bytes.
    yavat (i < nk) {
        seglen = tmp[pos]
        ptrs[i] = woff
        lens[i] = seglen
        strb_pack(tmp + (pos + 1) * 8, seglen, scratch + woff)
        woff = woff + seglen
        pos = pos + 1 + seglen
        i = i + 1
    }
    # bubble-sort the pairs by element bytes
    i = 0
    yavat (i < nk - 1) {
        j = 0
        yavat (j < nk - 1 - i) {
            yadi (strb_compare(scratch + ptrs[j], lens[j], scratch + ptrs[j + 1], lens[j + 1]) > 0) {
                tp = ptrs[j]
                ptrs[j] = ptrs[j + 1]
                ptrs[j + 1] = tp
                tl = lens[j]
                lens[j] = lens[j + 1]
                lens[j + 1] = tl
            }
            j = j + 1
        }
        i = i + 1
    }
    # emit in sorted order; unpack writes a 0 cell at the next length
    # slot, which the next segment's length overwrites (or trails).
    wpos = 0
    i = 0
    yavat (i < nk) {
        out[wpos] = lens[i]
        strb_unpack(scratch + ptrs[i], lens[i], out + (wpos + 1) * 8)
        wpos = wpos + 1 + lens[i]
        i = i + 1
    }
    pratiyati nk
}
