--- /dev/null
+++ b/tests/r159_float_narrow/test_float_narrow.py
@@ -0,0 +1,43 @@
+#!/usr/bin/env python3
+"""Prototype checks for scalar float-to-integer declarations/assignments."""
+import pathlib
+import subprocess
+import sys
+import tempfile
+
+ROOT = pathlib.Path(__file__).resolve().parents[2]
+CASES = (
+    ('decl_var', 'dasham x = 3.7\n vitti i = x\n likha(i)', 1, 'E_DASHAM_VITTI'),
+    ('assign_var', 'dasham x = 3.7\n vitti i = 0\n i = x\n likha(i)', 1, 'E_DASHAM_VITTI'),
+    ('decl_expr', 'dasham x = 3.7\n vitti i = x + 1.0\n likha(i)', 1, 'E_DASHAM_VITTI'),
+    ('int_control', 'vitti i = 3\n i = i + 1\n likha(i)', 0, '4\n'),
+    ('float_control', 'dasham x = 3.7\n dasham y = x\n likha(y)', 0, '3.700000\n'),
+    ('comparison_control', 'dasham x = 3.7\n vitti i = x > 2.0\n likha(i)', 0, '1\n'),
+)
+
+def main():
+    compiler = pathlib.Path(sys.argv[1]).resolve()
+    failed = 0
+    with tempfile.TemporaryDirectory(prefix='sutram-r159-narrow-', dir=ROOT.parent) as tmp:
+        for name, body, compile_status, expected in CASES:
+            source = pathlib.Path(tmp) / (name + '.sm')
+            binary = pathlib.Path(tmp) / (name + '.exe')
+            source.write_text('mukhya() {\n ' + body + '\n}\n', encoding='utf-8')
+            c = subprocess.run([str(compiler), str(source), str(binary)], cwd=ROOT,
+                               capture_output=True, text=True, timeout=15)
+            if compile_status:
+                ok = c.returncode == compile_status and expected in c.stdout and not binary.exists()
+                print('PASS' if ok else 'FAIL', name, 'compile', c.returncode, repr(c.stdout))
+            elif c.returncode or not binary.exists():
+                ok = False
+                print('FAIL', name, 'compile', c.returncode, repr(c.stdout), repr(c.stderr))
+            else:
+                run = subprocess.run([str(binary)], capture_output=True, text=True, timeout=10)
+                ok = run.returncode == 0 and run.stdout == expected and not run.stderr
+                print('PASS' if ok else 'FAIL', name, 'run', run.returncode, repr(run.stdout))
+            failed += not ok
+    print('r159 float narrowing:', len(CASES) - failed, 'pass,', failed, 'fail')
+    return int(bool(failed))
+
+if __name__ == '__main__':
+    sys.exit(main())
