  "conclusions": {
    "warning_subject": "runtime keyword alias file lang/<pack>.lang load, not embedded message translation .sandesh",
    "translated_warning_cause": "set_lang_id changes cur_lang_id before file load; print_str_z uses r11_tr from compiled-in r11_sandesh.inc, so a failed keyword-file load still prints selected-language messages",
    "load_success_condition": "load_lang_file opens and reads .lang then accepts only when lang_kw_cnt > 0; failed open/empty or no recognized keyword maps to same generic warning",
    "linux_behavior": "shared source path warns under failed file load on Linux too; standard repo-root run with .lang files present normally will not. No Linux run performed here.",
    "windows_behavior": "Windows also attempts executable-directory lang/<pack>.lang; actual Windows package content and failing resolved path not in log, so specific physical failure remains UNDETERMINED.",
    "automated_gate": "tools/test_lang_packs.py discards compiler stdout/stderr whenever output file exists, so warning is not asserted absent",
    "scope": "Do not equate message localization with native-script keyword availability; no compiler changes, Windows fixes owned by Claude."
  }
