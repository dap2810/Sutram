@@ -22836,6 +22836,48 @@ gen_expr:
     call emit_byte
     jmp .gfb_arith_done
 .gfb_div:
+    ; Float division: reject either signed zero before DIVSD.  Unordered
+    ; (NaN) is not zero: preserve its propagation and let comparisons handle it.
+    push r12
+    push r13
+    mov dil, 0x66                 ; xorpd xmm2,xmm2
+    call emit_byte
+    mov dil, 0x0F
+    call emit_byte
+    mov dil, 0x57
+    call emit_byte
+    mov dil, 0xD2
+    call emit_byte
+    mov dil, 0x66                 ; ucomisd xmm1,xmm2
+    call emit_byte
+    mov dil, 0x0F
+    call emit_byte
+    mov dil, 0x2E
+    call emit_byte
+    mov dil, 0xCA
+    call emit_byte
+    mov dil, 0x0F                 ; jp .divide (unordered)
+    call emit_byte
+    mov dil, 0x8A
+    call emit_byte
+    mov r12, [rel code_sz]
+    xor edi, edi
+    call emit_u32
+    mov dil, 0x0F                 ; jne .divide (nonzero)
+    call emit_byte
+    mov dil, 0x85
+    call emit_byte
+    mov r13, [rel code_sz]
+    xor edi, edi
+    call emit_u32
+    xor edi, edi
+    call r80_emit_div_fatal        ; zero: diagnostic + exit 1
+    mov rdi, r12
+    call r73_patch32
+    mov rdi, r13
+    call r73_patch32
+    pop r13
+    pop r12
     mov dil, 0xF2
     call emit_byte
     mov dil, 0x0F
@@ -25214,8 +25256,7 @@ try_emit_xmm_cached_assignment:
     je .txca_op_ok
     cmp r15, OP_MUL
     je .txca_op_ok
-    cmp r15, OP_DIV
-    jne .txca_no
+    jmp .txca_no                ; division guard lives in general lowering
 .txca_op_ok:
     mov r14, [r13+16]
     cmp qword [r14], AST_VAR
@@ -25389,8 +25430,7 @@ try_emit_float_reg_self_update:
     je .tfrsu_op_ok
     cmp r14, OP_MUL
     je .tfrsu_op_ok
-    cmp r14, OP_DIV
-    jne .tfrsu_no
+    jmp .tfrsu_no               ; division guard lives in general lowering
 .tfrsu_op_ok:
     mov r15, [r13+16]
     cmp qword [r15], AST_VAR
@@ -25462,8 +25502,7 @@ try_emit_float_reg_destination:
     je .tfrd_op_ok
     cmp r15, OP_MUL
     je .tfrd_op_ok
