new file mode 100644
index 00000000..8a7cb1c7
--- /dev/null
+++ b/examples/291_r160_nan_comparisons.sm
@@ -0,0 +1,18 @@
+# R160: each comparison of a NaN with a finite number follows IEEE unordered rules.
+# Create infinity by repeated multiplication, then NaN by infinity - infinity.
+# This remains valid when float division by zero is rejected.
+mukhya() {
+    dasham h = 100000000000000000000.0
+    h = h * h
+    h = h * h
+    h = h * h
+    h = h * h
+    dasham n = h - h
+    dasham p = 5.0
+    likha(n == p)
+    likha(n != p)
+    likha(n < p)
+    likha(n <= p)
+    likha(n > p)
+    likha(n >= p)
+}
