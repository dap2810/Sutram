     call gen_expr
-    ; emit: mov rsi, rax (48 89 C6)
-    mov dil, 0x48
+    mov dil, 0x50                 ; push flags
     call emit_byte
-    mov dil, 0x89
-    call emit_byte
-    mov dil, 0xC6
