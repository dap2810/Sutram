+    jne .ge_dvaram_default
+    mov rax, [rbx+40]
+    call gen_expr
+    mov dil, 0x48                 ; mov rdx,rax = 48 89 C2
     call emit_byte
-    ; emit: pop rdi (5F)
-    mov dil, 0x5F
+    mov dil, 0x89
     call emit_byte
-    ; emit: mov eax, 2 (B8 02 00 00 00)
-    mov dil, 0xB8
+    mov dil, 0xC2
     call emit_byte
-    mov dil, 0x02
+    jmp .ge_dvaram_ready
