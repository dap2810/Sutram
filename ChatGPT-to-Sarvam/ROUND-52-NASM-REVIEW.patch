+    mov dil, 0xBA                 ; mov edx,420 = 0644
     call emit_byte
-    xor edi, edi
+    mov edi, 420
+    call emit_u32
+.ge_dvaram_ready:
+    mov dil, 0x5E                 ; pop rsi = flags
     call emit_byte
-    xor edi, edi
+    mov dil, 0x5F                 ; pop rdi = path
