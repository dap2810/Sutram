-    ; emit: syscall (0F 05)
+    mov edi, 2
+    call emit_u32
     call emit_syscall
     jmp .ge_call_done
+.ge_dvaram_arity:
+    lea rdi, [rel r52_msg_dvaram_arity]
+    jmp capacity_fail
 
