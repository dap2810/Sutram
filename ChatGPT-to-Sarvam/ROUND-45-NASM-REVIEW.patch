+    mov [r10+48], rax
+    ; One syscall instead of two: ELF header + program header.
     mov rdi, [rel out_fd]
     mov rsi, rsp
-    mov rdx, 56
+    mov rdx, 120
     call os_write
-    add rsp, 64
+    add rsp, 128
     ; Write code
     mov rdi, [rel out_fd]
