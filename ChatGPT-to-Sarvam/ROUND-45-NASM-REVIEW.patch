+    cmp rbx, 6
+    jae .r45_done
+    mov rdi, rbx
+    call r45_print
+    inc rbx
+    jmp .r45_print_stages
+.r45_done:
+%endif
 
     ; Print success
     lea rdi, [rel msg_ok]
