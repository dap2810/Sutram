-    ; Program header
-    mov dword [rsp], 1
-    mov dword [rsp+4], 7
+    ; Program header at [rsp + 64], immediately after ELF header.
+    lea r10, [rsp+64]
+    mov dword [r10], 1
+    mov dword [r10+4], 7
     mov rax, HEADERS_SIZE
